---
interface Props {
  M: any;
}

const { M } = Astro.props;
---
<span id="site-comp-data" hidden>{JSON.stringify(M)}</span>
<!-- DEMO 2: Compresor PDF para Moodle -->
<div class="demo-card">
  <div class="demo-card-hdr">
    <span class="sticker-pill cyan font-mono">📄 COMPRESOR OFFLINE</span>
    <span class="badge b-info font-mono">Límite 5 MB</span>
  </div>
  <h2>Reduce entregas pesadas para Moodle</h2>
  <p class="fine">Comprime informes de 25 MB a menos de 4 MB sin salir de tu teléfono.</p>
  <div class="gauge-card">
    <div class="gauge-hdr">
      <b class="num">informe_laboratorio.pdf</b>
      <span class="num font-mono" id="gnow">24.8 MB</span>
    </div>
    <div class="gauge" role="img" aria-label="Medidor de compresión">
      <i id="gfill"></i>
      <span class="lim"></span>
    </div>
    <span class="badge b-crit font-mono" id="gb">Supera el límite: Moodle lo rechazaría</span>
    <button class="btn btn-p" id="gbtn" type="button">Probar compresión</button>
    <!-- Reacción interactiva de Pilo en el compresor -->
    <div class="gauge-mascot-reaction" id="gauge-mascot-box">
      <img src={M.scared} alt="Pilo asustado porque el archivo supera el límite" class="gauge-mascot-img" id="gauge-mascot-img" width="48" height="48" loading="lazy" />
      <div class="gauge-mascot-balloon">
        <b class="gauge-mascot-status" id="gauge-mascot-status">¡Cuidado con la entrega!</b>
        <span class="gauge-mascot-quote" id="gauge-mascot-quote">Moodle rechaza archivos mayores a 5 MB. Comprímelo en 1 toque.</span>
      </div>
    </div>
  </div>
</div>

<style is:global>
.gauge-card {
  background: rgba(11, 16, 26, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 6px;
  box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.4);
}
.gauge-hdr { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px; }
.gauge {
  position: relative;
  height: 16px;
  border: none;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  border-radius: 9999px;
  background: var(--bg-base);
  overflow: hidden;
}
.gauge i { display: block; height: 100%; width: 100%; background: var(--critical); transition: width 0.3s ease; }
.lim { position: absolute; top: -2px; bottom: -2px; left: 16.67%; width: 3px; background: #ffffff; }

.gauge-mascot-reaction {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(17, 23, 35, 0.7);
  border: none;
  border-radius: 14px;
  padding: 12px 14px;
  margin-top: 4px;
}
.gauge-mascot-img {
  width: 48px;
  height: 48px;
  object-fit: contain;
  flex-shrink: 0;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4));
}
.gauge-mascot-balloon {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.gauge-mascot-status {
  font-family: var(--f-d);
  font-size: 0.92rem;
  font-weight: 800;
  color: var(--title);
}
.gauge-mascot-quote {
  font-size: 0.84rem;
  color: var(--muted);
  line-height: 1.35;
}
</style>

<script>
  import { initCompressorDemo } from '../scripts/compressor-demo';
  const dataEl = document.getElementById('site-comp-data');
  const masc = JSON.parse(dataEl?.textContent || '{}');
  initCompressorDemo(masc);
</script>

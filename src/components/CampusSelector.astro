---
---
<div class="mode-switch-wrapper">
  <span class="mode-switch-legend font-mono">SELECCIONA TU CAMPUS:</span>
  <div class="mode-switch-group" role="group" aria-label="Elige tu universidad">
    <button type="button" data-mode-btn="espe" aria-pressed="true">
      <div class="mode-btn-row">
        <span class="mode-icon">⚡</span>
        <b>Modo ESPE</b>
      </div>
      <small>Sangolquí, Latacunga y Santo Domingo</small>
    </button>
    <button type="button" data-mode-btn="multi" aria-pressed="false">
      <div class="mode-btn-row">
        <span class="mode-icon">⭐</span>
        <b>Multi-Universidad</b>
      </div>
      <small>UTA, UCE, EPN, UNACH confirmadas y más</small>
    </button>
  </div>
</div>

<style is:global>
/* Selector de Modo - Dark Glass Segmented Switch */
.mode-switch-wrapper {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.mode-switch-legend {
  font-size: 0.8rem;
  color: var(--muted);
  font-weight: 700;
}
.mode-switch-group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  max-width: 520px;
  background: rgba(13, 18, 28, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 6px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.mode-switch-group button {
  text-align: left;
  min-height: 62px;
  padding: 10px 14px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
  color: var(--body);
  font: inherit;
  cursor: pointer;
  transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}
.mode-btn-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.mode-icon {
  font-size: 1.15rem;
  line-height: 1;
}
.mode-btn-row b {
  font: 800 1.05rem var(--f-d);
  color: var(--title);
  letter-spacing: -0.01em;
}
.mode-switch-group small {
  display: block;
  color: var(--muted);
  line-height: 1.3;
  margin-top: 3px;
  font-size: 0.78rem;
  transition: color 180ms ease;
}
.mode-switch-group button:hover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.1);
}
.mode-switch-group button[aria-pressed="true"] {
  background: linear-gradient(135deg, rgba(255, 51, 133, 0.16) 0%, rgba(255, 51, 133, 0.05) 100%);
  border-color: rgba(255, 51, 133, 0.45);
  box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
}
.mode-switch-group button[data-mode-btn="multi"][aria-pressed="true"] {
  background: linear-gradient(135deg, rgba(255, 71, 102, 0.16) 0%, rgba(255, 71, 102, 0.05) 100%);
  border-color: rgba(255, 71, 102, 0.45);
  box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
}
.mode-switch-group button[aria-pressed="true"] b {
  color: #ffffff;
}
.mode-switch-group button[aria-pressed="true"] small {
  color: #e2e8f0;
}
.mode-switch-group button:active {
  transform: scale(0.98);
}
@media (max-width: 500px) {
  .mode-switch-group {
    grid-template-columns: 1fr;
  }
}
</style>

---
---
          <div class="mode-switch-wrapper">
            <span class="mode-switch-legend font-mono">SELECCIONA TU CAMPUS:</span>
            <div class="mode-switch-group" role="group" aria-label="Elige tu universidad">
              <button type="button" data-mode-btn="espe" aria-pressed="true">
                <div class="mode-btn-row">
                  <span class="mode-icon">⚡</span>
                  <b>Modo ESPE</b>
                </div>
                <small>Sangolquí, Latacunga y Santo Domingo</small>
              </button>
              <button type="button" data-mode-btn="multi" aria-pressed="false">
                <div class="mode-btn-row">
                  <span class="mode-icon">⭐</span>
                  <b>Multi-Universidad</b>
                </div>
                <small>UCE, EPN, PUCE, ESPOL, UNACH y más</small>
              </button>
            </div>
          </div>

<style is:global>
/* Selector de Modo */
.mode-switch-wrapper {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.mode-switch-legend {
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.08em;
  font-weight: 700;
}
.mode-switch-group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  max-width: 520px;
}
.mode-switch-group button {
  text-align: left;
  min-height: 64px;
  padding: 10px 14px;
  border: 2px solid var(--border-control);
  border-radius: 12px;
  background: var(--bg-elevated);
  color: var(--title);
  font: inherit;
  cursor: pointer;
  transition: transform 100ms, box-shadow 100ms, border-color 150ms;
  box-shadow: 2px 2px 0 #000;
}
.mode-btn-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.mode-icon {
  font-size: 1.15rem;
  line-height: 1;
}
.mode-btn-row b {
  font: 800 1.05rem var(--f-d);
  color: inherit;
}
.mode-switch-group small {
  display: block;
  color: var(--muted);
  line-height: 1.3;
  margin-top: 3px;
  font-size: 0.8rem;
}
.mode-switch-group button:hover {
  border-color: var(--accent);
}
.mode-switch-group button[aria-pressed="true"] {
  background: var(--accent);
  color: #000;
  border-color: #000;
  box-shadow: 4px 4px 0 #000;
}
.mode-switch-group button[aria-pressed="true"] b {
  color: #000;
}
.mode-switch-group button[aria-pressed="true"] small {
  color: #000;
  font-weight: 600;
}
.mode-switch-group button:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}

</style>

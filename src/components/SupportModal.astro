---
// SupportModal.astro - Modal nativo accesible <dialog> para apoyar el proyecto
import { SHOW_DONATION_QR } from '../config/donation';
import CssQrCode from './CssQrCode.astro';
---

<dialog id="support-dialog" class="support-native-dialog">
  <div class="modal-card card-app amber-accent">

    <div class="modal-top">
      <div class="modal-badge-group">
        <span class="badge-app amber">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          </svg>
          Aporte Voluntario
        </span>
        <h3>Ayúdanos a llegar a la Play Store</h3>
      </div>
      <button type="button" class="btn-close-modal" id="close-support-dialog" aria-label="Cerrar ventana emergente">✕</button>
    </div>

    <p class="modal-lead">
      Publicar la app en la tienda oficial de Google cuesta <strong>25 dólares, una sola vez</strong>. Con eso cualquiera podrá instalarla en dos toques, sin permisos ni avisos raros. Aportes o no, la app sigue siendo gratis para todos.
    </p>

    <div class="modal-body-grid">
      <!-- QR de Deuna -->
      <div class="modal-qr-area">
        {SHOW_DONATION_QR ? (
          <>
            <div class="modal-qr-frame">
              <CssQrCode variant="deuna" size={140} label="Código QR de Deuna para aportar al proyecto" />
            </div>
            <span class="modal-qr-hint">Ábrelo con la app de Deuna o con cualquier app de banco del Ecuador</span>
            <p class="modal-voluntary-notice">Aporte voluntario. No es el pago de un servicio y la ESPE no participa.</p>
          </>
        ) : (
          <div class="modal-coming-soon-box">
            <span class="badge-app amber">Próximamente</span>
            <p class="modal-cs-p">El canal de donaciones voluntarias se habilitará más adelante. ¡Gracias por tu interés en apoyar!</p>
          </div>
        )}
      </div>
    </div>
  </div>
</dialog>

<style>
  .support-native-dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 620px;
    width: calc(100% - 32px);
    border-radius: var(--radius-lg);
  }

  /* La animación de apertura/cierre y el backdrop viven en global.css
     (dialog[open] > *, dialog.is-closing > *, ::backdrop). */

  .modal-card {
    background: var(--bg-surface);
    border: 2px solid var(--accent-amber);
    box-shadow: 8px 8px 0px #000;
    padding: 28px;
    color: var(--text-primary);
    max-height: calc(100vh - 48px);
    overflow-y: auto;
  }

  .modal-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 12px;
  }

  .modal-badge-group h3 {
    font-size: 1.4rem;
    margin-top: 8px;
    line-height: 1.2;
  }

  .btn-close-modal {
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-app);
    color: var(--text-primary);
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000;
    transition: background-color 150ms ease,
                color 150ms ease,
                border-color 150ms ease,
                transform 150ms var(--ease-apple);
  }

  .btn-close-modal:hover {
    background: var(--accent-critical);
    color: #000;
    border-color: #000;
    transform: rotate(90deg);
  }

  .modal-lead {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 20px;
  }

  .modal-body-grid {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 18px;
    align-items: start;
    background: var(--bg-surface-elevated);
    border: 2px solid var(--border-bold);
    border-radius: var(--radius-md);
    padding: 16px;
    box-shadow: 3px 3px 0px #000;
    margin-bottom: 20px;
  }

  @media (max-width: 620px) {
    .modal-body-grid {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }

  .modal-qr-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .modal-qr-frame {
    background: #FFFFFF;
    padding: 6px;
    border-radius: var(--radius-sm);
    border: 2px solid #000;
    box-shadow: 2px 2px 0px #000;
  }

  .modal-qr-img {
    width: 120px;
    height: 120px;
    object-fit: cover;
    display: block;
  }

  .modal-qr-hint {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1.3;
    text-align: center;
    max-width: 190px;
  }

  .modal-bank-info {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
    width: 100%;
  }

  .btn-modal-deuna {
    width: 100%;
    padding: 11px 16px;
    font-size: 0.86rem;
  }

  .m-bank-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.85rem;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .m-bank-row.highlight {
    background: rgba(0, 255, 135, 0.08);
    padding: 4px 6px;
    border-radius: 4px;
    border-bottom-color: transparent;
  }

  .m-label {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.82rem;
    flex-shrink: 0;
  }

  .m-val-group {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .m-val {
    font-weight: 700;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }

  .m-val.mono {
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }

  .modal-voluntary-notice {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.4;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    margin-top: 10px;
    text-align: center;
  }

  /* Botones "Copiar": se usa :global() para evitar la especificidad extra del
     scope de Astro, que si no deja los botones con aspecto nativo. */
  :global(.modal-bank-info .btn-app-copy) {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    box-shadow: 1.5px 1.5px 0px #000;
    cursor: pointer;
    white-space: nowrap;
    text-transform: uppercase;
    transition: background-color 150ms ease,
                border-color 150ms ease,
                color 150ms ease,
                transform 150ms var(--ease-apple),
                box-shadow 150ms var(--ease-apple);
  }

  :global(.modal-bank-info .btn-app-copy:not(.copied):hover) {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000;
  }

  :global(.modal-bank-info .btn-app-copy:active) {
    transform: translate(1px, 1px);
    box-shadow: 0px 0px 0px #000;
  }

  :global(.modal-bank-info .btn-app-copy.copied) {
    background: var(--accent-primary);
    color: var(--on-primary);
    border-color: #000;
    transform: scale(1.05);
  }

  .modal-footer {
    display: flex;
  }

  .btn-modal-done {
    width: 100%;
    padding: 12px;
  }

  @media (max-width: 480px) {
    .modal-card {
      padding: 20px 16px;
      box-shadow: 4px 4px 0px #000;
    }

    .modal-badge-group h3 {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  const dialog = document.getElementById('support-dialog') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('close-support-dialog');
  const understandBtn = document.getElementById('dialog-understand-btn');

  // Elemento que tenía el foco antes de abrir, para devolvérselo al cerrar
  let lastFocused: HTMLElement | null = null;

  function openDialog() {
    if (!dialog || typeof dialog.showModal !== 'function' || dialog.open) return;
    lastFocused = document.activeElement as HTMLElement | null;
    dialog.showModal();
  }

  function closeDialog() {
    if (!dialog || !dialog.open) return;

    // Pequeña animación de salida antes de cerrar de verdad
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      dialog.close();
      return;
    }

    dialog.classList.add('is-closing');
    window.setTimeout(() => {
      dialog.classList.remove('is-closing');
      dialog.close();
    }, 170);
  }

  // NOTA: el botón #open-support-btn se vincula aquí. El listener duplicado que
  // existía en Header.astro se eliminó porque ambos llamaban a showModal() y el
  // segundo lanzaba InvalidStateError.
  const openHeaderBtn = document.getElementById('open-support-btn');
  if (openHeaderBtn) openHeaderBtn.addEventListener('click', openDialog);

  // Cualquier otro disparador declarativo ([data-open-support]) abre el modal.
  // Si es un <a href="#apoyar"> se anula el desplazamiento suave del layout.
  document.querySelectorAll<HTMLElement>('[data-open-support]').forEach(trigger => {
    trigger.addEventListener('click', (event) => {
      if (trigger.tagName === 'A' && dialog && typeof dialog.showModal === 'function') {
        event.preventDefault();
      }
      openDialog();
    });
  });

  if (closeBtn) closeBtn.addEventListener('click', closeDialog);
  if (understandBtn) understandBtn.addEventListener('click', closeDialog);

  if (dialog) {
    // Al cerrarse (por Escape, backdrop o botón) se restaura el foco
    dialog.addEventListener('close', () => {
      lastFocused?.focus?.();
      lastFocused = null;
    });

    // Cerrar al hacer clic fuera del contenido. Se compara contra la caja del
    // contenido real, no contra la del <dialog>, que abarca el backdrop entero.
    dialog.addEventListener('click', (event) => {
      const card = dialog.querySelector('.modal-card');
      if (!card) return;
      const rect = card.getBoundingClientRect();
      const isInside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!isInside) closeDialog();
    });
  }

  // Copiado dentro del modal
  const modalCopyBtns = document.querySelectorAll<HTMLButtonElement>('.modal-bank-info .btn-app-copy');
  modalCopyBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (!textToCopy) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch (_) {
        // Fallback para contextos sin permiso de clipboard
        const helper = document.createElement('textarea');
        helper.value = textToCopy;
        helper.setAttribute('readonly', '');
        helper.style.position = 'fixed';
        helper.style.opacity = '0';
        document.body.appendChild(helper);
        helper.select();
        try {
          document.execCommand('copy');
        } catch (_) {
          helper.remove();
          return;
        }
        helper.remove();
      }

      const originalText = btn.textContent;
      btn.textContent = '✓ Copiado';
      btn.classList.add('copied');
      window.setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('copied');
      }, 2000);
    });
  });
</script>

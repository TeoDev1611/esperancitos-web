<script>
  // Secuencia 1-2-3 de la guía de instalación, ligada al scroll.
  // Antes se ejecutaba como una cascada de setTimeout con unobserve(), así que
  // si el usuario subía y bajaba de la sección los pasos quedaban encendidos
  // para siempre y la línea nunca volvía a 0. Ahora es reversible y el ancho se
  // calcula según la posición real de la sección en el viewport.
  const guideTrack = document.getElementById("install-guide-track");
  const lineFill = document.getElementById("steps-line-fill");
  const stepBoxes = [
    document.getElementById("step-box-1"),
    document.getElementById("step-box-2"),
    document.getElementById("step-box-3"),
  ];

  if (guideTrack && lineFill) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    // Progreso: 0 cuando el bloque entra por abajo, 1 cuando llega al centro
    const computeProgress = () => {
      const rect = guideTrack.getBoundingClientRect();
      const viewport =
        window.innerHeight || document.documentElement.clientHeight;
      const start = viewport;
      const end = viewport * 0.45;
      const raw = (start - rect.top) / (start - end);
      return Math.min(Math.max(raw, 0), 1);
    };

    const paint = (progress: number) => {
      // La línea sólo cubre el tramo entre el centro del paso 1 y el del paso 3
      lineFill.style.width = `${(progress * 100).toFixed(1)}%`;

      stepBoxes.forEach((box, index) => {
        if (!box) return;
        const threshold = (index + 1) / (stepBoxes.length + 0.35);
        const isOn = progress >= threshold;
        box.classList.toggle("illuminated", isOn);
        box.classList.toggle("current", isOn && progress < threshold + 0.34);
      });
    };

    if (prefersReducedMotion.matches) {
      paint(1);
    } else {
      let ticking = false;
      const update = () => {
        paint(computeProgress());
        ticking = false;
      };
      const requestUpdate = () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
      update();
    }
  }

  // Copiado de las huellas SHA-256 y comandos al portapapeles
  const copyButtons = document.querySelectorAll<HTMLButtonElement>(
    ".hash-row .btn-app-copy, .manual-cmd-row .btn-app-copy",
  );

  copyButtons.forEach((btn) => {
    const label = btn.querySelector("span") ?? btn;
    const originalText = label.textContent ?? "Copiar";

    btn.addEventListener("click", async () => {
      const textToCopy = btn.getAttribute("data-copy");
      if (!textToCopy) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch (_) {
        // Fallback para contextos sin permiso de clipboard
        const helper = document.createElement("textarea");
        helper.value = textToCopy;
        helper.setAttribute("readonly", "");
        helper.style.position = "fixed";
        helper.style.opacity = "0";
        document.body.appendChild(helper);
        helper.select();
        try {
          document.execCommand("copy");
        } catch (_) {
          helper.remove();
          return;
        }
        helper.remove();
      }

      label.textContent = "✓ Copiado";
      btn.classList.add("copied");
      window.setTimeout(() => {
        label.textContent = originalText;
        btn.classList.remove("copied");
      }, 2000);
    });
  });

  // Clic directo en el código de la huella también copia la huella completa
  const hashCodes = document.querySelectorAll<HTMLElement>(".hash-value");
  hashCodes.forEach((code) => {
    code.addEventListener("click", async () => {
      const textToCopy = code.getAttribute("data-copy");
      if (!textToCopy) return;
      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch (_) {
        const helper = document.createElement("textarea");
        helper.value = textToCopy;
        document.body.appendChild(helper);
        helper.select();
        document.execCommand("copy");
        helper.remove();
      }
      const parentRow = code.closest(".hash-row");
      const btn = parentRow?.querySelector<HTMLButtonElement>(".btn-app-copy");
      if (btn) {
        const label = btn.querySelector("span") ?? btn;
        const originalText = label.textContent ?? "Copiar";
        label.textContent = "✓ Copiado";
        btn.classList.add("copied");
        window.setTimeout(() => {
          label.textContent = originalText;
          btn.classList.remove("copied");
        }, 2000);
      }
    });
  });

  // Sincronización del contador de descargas al hacer clic en los botones de APK
  const downloadLinks = document.querySelectorAll<HTMLAnchorElement>(
    "#primary-apk-download-btn, .apk-option-btn",
  );
  const sectionBadge = document.getElementById("section-dl-counter");
  const BASE_COUNT = parseInt(sectionBadge?.getAttribute("data-base-count") || "100", 10) || 100;
  const STORAGE_KEY = "pilas_app_dl_v1";

  function getStoredDownloads() {
    try {
      const stored = parseInt(localStorage.getItem(STORAGE_KEY) || "", 10);
      return stored && stored >= BASE_COUNT ? stored : BASE_COUNT;
    } catch (_) {
      return BASE_COUNT;
    }
  }

  function updateSectionCounter(count: number) {
    const formatted = "+" + count.toLocaleString();
    const countEl = document.getElementById("section-dl-count-val");
    if (countEl) countEl.textContent = formatted;
    const specEl = document.getElementById("spec-dl-count-val");
    if (specEl) specEl.textContent = formatted + " descargas";
  }

  updateSectionCounter(getStoredDownloads());

  downloadLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const next = getStoredDownloads() + 1;
      try {
        localStorage.setItem(STORAGE_KEY, String(next));
      } catch (_) {}
      updateSectionCounter(next);
      window.dispatchEvent(
        new CustomEvent("pilas-download-registered", {
          detail: { count: next },
        }),
      );
    });
  });

  window.addEventListener("pilas-download-registered", (e: Event) => {
    const custom = e as CustomEvent<{ count: number }>;
    if (custom.detail?.count) {
      updateSectionCounter(custom.detail.count);
    }
  });
</script>

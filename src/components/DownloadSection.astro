<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('post-download-dialog');
    if (!dialog) return;

    // Abrir modal tras hacer clic en descargas
    document.querySelectorAll('a[download], a[href*=".apk"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        setTimeout(() => {
          if (typeof dialog.showModal === 'function' && !dialog.open) {
            dialog.showModal();
          }
        }, 500);
      });
    });

    // Cerrar modal
    document.getElementById('post-dl-close-btn')?.addEventListener('click', () => dialog.close());
    document.getElementById('post-dl-ok-btn')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>


---
// DownloadSection.astro - Centro de descargas con verificación de integridad
import { SITE } from '../config/site';

const primaryFile = 'esperancitos-v1.0.0-arm64.apk';
const secondaryFile = 'esperancitos-v1.0.0-arm32.apk';
const primarySha = SITE.apkChecksums[primaryFile] ?? '';
const secondarySha = SITE.apkChecksums[secondaryFile] ?? '';
---

<section class="download-section scroll-reveal" id="descargar">
  <div class="container">
    <div class="download-card card-app reveal-init">
      
      <!-- Encabezado de la Sección -->
      <div class="download-header">
        <span class="badge-app green">GRATIS · SIN ANUNCIOS · SE INSTALA EN 1 MINUTO</span>
        <h2>Descarga Esperancitos para Android</h2>
        <p>
          La app se instala directo desde aquí, sin pasar por ninguna tienda. Elige la opción recomendada y listo.
        </p>
      </div>

      <!-- Aviso Legal antes de la descarga -->
      <div class="download-legal-notice reveal-init" role="note">
        <div class="notice-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div class="notice-body">
          <p>
            <strong>Aviso legal.</strong> Esperancitos es un proyecto independiente y no está afiliado a la Universidad de las Fuerzas Armadas ESPE. Los nombres y marcas pertenecen a sus dueños. Se ofrece gratis y "tal cual", sin garantías. La información (horarios, fechas de entrega, notas, malla) puede estar retrasada o ser incorrecta: verifícala siempre en miESPE y en Moodle. Usa únicamente tu propia cuenta; eres responsable de lo que se haga desde ella y de cumplir los reglamentos de la ESPE. La app puede dejar de funcionar si la universidad cambia o restringe sus sistemas. Los aportes son voluntarios y la universidad no participa en ellos.
          </p>
        </div>
      </div>

      <!-- Tarjeta Principal Dominante -->
      <div class="apk-primary-showcase card-app live">
        <div class="apk-identity">
          <div class="apk-logo-frame">
            <img src="/logo_esperancitos.jpg" alt="Logo de Esperancitos" class="apk-logo-img" width="68" height="68" />
            <span class="apk-release-tag">v1.0.0</span>
          </div>

          <div class="apk-details">
            <div class="apk-title-row">
              <h3>Descarga la app</h3>
              <span class="chip-live">Recomendada</span>
            </div>
            
            <div class="apk-specs-grid">
              <div class="spec-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                  <path d="M12 18h.01"></path>
                </svg>
                <span>Funciona en <strong>casi cualquier celular Android</strong> (del 2019 en adelante)</span>
              </div>
              <div class="spec-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                <span>Pesa solo <strong>31 MB</strong></span>
              </div>
              <div class="spec-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Necesitas <strong>Android 8.0 o superior</strong></span>
              </div>
            </div>
          </div>
        </div>

        <div class="apk-action-area">
          <a href="/downloads/esperancitos-v1.0.0-arm64.apk" download class="btn-app btn-app-primary btn-download-main" id="primary-apk-download-btn">
            <svg class="download-bounce-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <div class="btn-text-block">
              <span class="btn-main-label">DESCARGAR AHORA</span>
              <small class="btn-sub-label">Descarga directa, sin registrarte</small>
            </div>
          </a>
        </div>
      </div>

      <!-- Capturas de la app: es lo que más ayuda a decidir la descarga -->
      <div class="download-preview-row reveal-init">
        <figure class="preview-item">
          <img src="/images/mockup-malla.webp" alt="Pantalla de la malla curricular con el progreso de créditos y el año estimado de graduación" width="640" height="1147" loading="lazy" />
          <figcaption>Tu malla con cálculo de graduación</figcaption>
        </figure>
        <figure class="preview-item">
          <img src="/images/mockup-horario.webp" alt="Pantalla del horario semanal con el aula y el bloque de cada clase" width="640" height="1147" loading="lazy" />
          <figcaption>Tu horario con el aula de cada clase</figcaption>
        </figure>
      </div>

      <!-- Variantes Secundarias por Arquitectura -->
      <div class="secondary-architectures">
        <span class="secondary-title">¿Tu celular es antiguo o no sabes cuál elegir?</span>
        <div class="arch-pills-row">
          <a href={`/downloads/${secondaryFile}`} download class="btn-app btn-app-surface btn-arch-pill" title="Para celulares de más de 5 años o de gama baja">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
              <path d="M12 18h.01"></path>
            </svg>
            <span>Celular antiguo o de gama baja</span>
            <span class="arch-size">26.9 MB</span>
          </a>
        </div>
      </div>

      <!-- Aviso de instalación fuera de la tienda + verificación de integridad -->
      <div class="install-notice reveal-init">
        <div class="notice-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M12 8v4"></path>
            <path d="M12 16h.01"></path>
          </svg>
        </div>
        <div class="notice-body">
          <h4>Por ahora se instala así (pronto estará en Play Store)</h4>
          <p>
            Estamos juntando los <strong>25 dólares</strong> que cuesta la cuenta de desarrollador de Google Play. Mientras tanto, la app se descarga desde aquí. Como no viene de la tienda, el sistema te pedirá autorizar la instalación y puede mostrar un aviso de <strong>Google Play Protect</strong>. Le pasa a cualquier aplicación descargada directamente, no significa que el archivo tenga un virus. Si quieres comprobarlo tú mismo, estas son las huellas digitales de los archivos publicados aquí:
          </p>

          {primarySha && (
            <div class="hash-row">
              <span class="hash-label">Recomendada · {primaryFile}</span>
              <code class="hash-value">{primarySha}</code>
              <button type="button" class="btn-app-copy" data-copy={primarySha} aria-label="Copiar la huella SHA-256 del APK recomendado">
                <span>Copiar</span>
              </button>
            </div>
          )}

          {secondarySha && (
            <div class="hash-row">
              <span class="hash-label">Gama baja · {secondaryFile}</span>
              <code class="hash-value">{secondarySha}</code>
              <button type="button" class="btn-app-copy" data-copy={secondarySha} aria-label="Copiar la huella SHA-256 del APK para celulares antiguos">
                <span>Copiar</span>
              </button>
            </div>
          )}

          <details class="hash-help">
            <summary>¿Cómo verifico la huella en mi computadora?</summary>
            <p>
              Descarga el archivo y ejecuta uno de estos comandos en la carpeta de descargas. El resultado debe coincidir exactamente con el texto de arriba:
            </p>
            <pre><code>Windows (PowerShell):  Get-FileHash .\{primaryFile} -Algorithm SHA256
macOS / Linux:         shasum -a 256 {primaryFile}</code></pre>
          </details>
        </div>
      </div>

      <!-- 3 Pasos de Instalación Conectados por una Línea Dinámica -->
      <div class="install-guide-block" id="install-guide-track">
        <h3 class="steps-heading">Instalarla te toma 3 pasos y menos de un minuto</h3>
        
        <div class="steps-container">
          <!-- Línea conectora animada al scroll -->
          <div class="steps-connecting-line" aria-hidden="true">
            <div class="steps-line-fill" id="steps-line-fill"></div>
          </div>

          <div class="steps-grid">
            <!-- Paso 1 -->
            <div class="step-box card-app" id="step-box-1">
              <div class="step-number-circle">1</div>
              <h4>Descarga el archivo</h4>
              <p>Toca el botón de arriba. El archivo se guarda en la carpeta <em>Descargas</em> de tu celular.</p>
            </div>

            <!-- Paso 2 -->
            <div class="step-box card-app" id="step-box-2">
              <div class="step-number-circle">2</div>
              <h4>Dale permiso</h4>
              <p>Abre el archivo descargado. Android te va a preguntar si confías en el origen: marca <em>"Permitir desde esta fuente"</em>. Es normal, pasa con cualquier app que no venga de la tienda.</p>
            </div>

            <!-- Paso 3 -->
            <div class="step-box card-app" id="step-box-3">
              <div class="step-number-circle">3</div>
              <h4>Abre y úsala</h4>
              <p>Elige tu carrera, conecta tu horario y tu Moodle, y empieza a planificar tus semestres. ¡Ya está!</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .download-section {
    padding: 80px 0 100px 0;
  }

  .download-card {
    padding: 44px;
    background: var(--bg-surface);
  }

  .download-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px auto;
  }

  .download-header h2 {
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    margin: 14px 0 12px 0;
  }

  .download-header p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Tarjeta Dominante APK */
  .apk-primary-showcase {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 32px;
    gap: 30px;
    background: var(--bg-surface-elevated);
    margin-bottom: 30px;
  }

  .apk-identity {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .apk-logo-frame {
    position: relative;
    flex-shrink: 0;
  }

  .apk-logo-img {
    width: 68px;
    height: 68px;
    border-radius: var(--radius-md);
    border: 2.5px solid #000;
    box-shadow: 3px 3px 0px #000;
    object-fit: cover;
  }

  .apk-release-tag {
    position: absolute;
    bottom: -6px;
    right: -6px;
    background: var(--accent-primary);
    color: var(--on-primary);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid #000;
    box-shadow: 1px 1px 0px #000;
  }

  .apk-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .apk-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .apk-title-row h3 {
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .apk-specs-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spec-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .spec-pill strong {
    color: var(--text-primary);
  }

  .spec-pill svg {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .apk-action-area {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .btn-download-main {
    padding: 16px 30px;
    gap: 14px;
  }

  .download-bounce-icon {
    animation: download-bounce 2s ease-in-out infinite;
  }

  @keyframes download-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  .btn-text-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .btn-main-label {
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  .btn-sub-label {
    font-size: 0.72rem;
    font-weight: 700;
    opacity: 0.85;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  /* Variantes Secundarias */
  .secondary-architectures {
    border-top: 1.5px solid var(--border-app);
    padding-top: 24px;
    margin-bottom: 40px;
    text-align: center;
  }

  .secondary-title {
    font-size: 0.92rem;
    color: var(--text-secondary);
    font-weight: 700;
    display: block;
    margin-bottom: 14px;
  }

  .arch-pills-row {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-arch-pill {
    padding: 10px 18px;
    font-size: 0.85rem;
    gap: 10px;
    text-transform: none;
  }

  .arch-size {
    font-family: var(--font-mono);
    color: var(--accent-primary);
    font-weight: 800;
    font-size: 0.8rem;
  }

  /* Capturas de la app */
  .download-preview-row {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin: 8px 0 34px 0;
  }

  .preview-item {
    margin: 0;
    width: 190px;
    max-width: 42%;
  }

  .preview-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
    border: 2px solid var(--border-app);
    box-shadow: var(--shadow-hard-sm);
    background: var(--bg-primary);
    transition: transform var(--duration-hover) var(--ease-apple),
                border-color var(--duration-hover) ease;
  }

  .preview-item img:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary);
  }

  .preview-item figcaption {
    margin-top: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.35;
  }

  /* Aviso Legal previo a la descarga */
  .download-legal-notice {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-app);
    border-left: 4px solid var(--accent-amber);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    margin-bottom: 24px;
    text-align: left;
  }

  .download-legal-notice .notice-body p {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .download-legal-notice .notice-body strong {
    color: var(--text-primary);
  }

  /* Aviso de instalación + verificación */
  .install-notice {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-app);
    border-left: 4px solid var(--accent-amber);
    border-radius: var(--radius-md);
    padding: 20px 22px;
    margin-bottom: 38px;
    text-align: left;
  }

  .notice-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: rgba(255, 219, 121, 0.14);
    color: var(--accent-amber);
    border: 1.5px solid rgba(255, 219, 121, 0.45);
  }

  .notice-body {
    min-width: 0;
    flex: 1;
  }

  .notice-body h4 {
    font-size: 1.06rem;
    margin-bottom: 8px;
  }

  .notice-body p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .notice-body strong {
    color: var(--text-primary);
  }

  .hash-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: var(--bg-surface);
    border: 1px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    margin-bottom: 8px;
  }

  .hash-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--accent-amber);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .hash-value {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
    flex: 1;
    min-width: 0;
  }

  .hash-help {
    margin-top: 10px;
  }

  .hash-help summary {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent-primary);
    cursor: pointer;
    list-style: none;
  }

  .hash-help summary::-webkit-details-marker {
    display: none;
  }

  .hash-help summary::before {
    content: '▸ ';
  }

  .hash-help[open] summary::before {
    content: '▾ ';
  }

  .hash-help summary:hover {
    text-decoration: underline;
  }

  .hash-help pre {
    overflow-x: auto;
    background: var(--bg-primary);
    border: 1px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--text-secondary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .hash-help p {
    font-size: 0.84rem;
    margin-bottom: 0;
  }

  /* Botón de copiado de la huella. Se usa :global() porque Astro añade un
     atributo de scope que eleva la especificidad por encima de global.css. */
  :global(.hash-row .btn-app-copy) {
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-app);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    box-shadow: 1.5px 1.5px 0px #000;
    cursor: pointer;
    white-space: nowrap;
    text-transform: uppercase;
    transition: background-color 150ms ease,
                border-color 150ms ease,
                color 150ms ease,
                transform 150ms var(--ease-apple),
                box-shadow 150ms var(--ease-apple);
  }

  :global(.hash-row .btn-app-copy:not(.copied):hover) {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000;
  }

  :global(.hash-row .btn-app-copy:active) {
    transform: translate(1px, 1px);
    box-shadow: 0px 0px 0px #000;
  }

  :global(.hash-row .btn-app-copy.copied) {
    background: var(--accent-primary);
    color: var(--on-primary);
    border-color: #000;
  }

  /* Guía de Instalación en 3 Pasos */
  .install-guide-block {
    border-top: 1.5px solid var(--border-app);
    padding-top: 36px;
    position: relative;
  }

  .steps-heading {
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: 30px;
  }

  .steps-container {
    position: relative;
  }

  /* Línea conectora entre pasos: alineada con el centro de los círculos
     numerados (padding 24px + radio 19px) para que el trazo los atraviese */
  .steps-connecting-line {
    position: absolute;
    top: 43px;
    left: 10%;
    right: 10%;
    height: 3px;
    background: var(--bg-surface-elevated);
    z-index: 0;
  }

  .steps-line-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-primary);
    transition: width 420ms var(--ease-apple);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    position: relative;
    z-index: 1;
  }

  .step-box {
    background: var(--bg-surface-elevated);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: border-color 300ms var(--ease-apple),
                box-shadow 300ms var(--ease-apple),
                transform 300ms var(--ease-apple);
  }

  .step-box.illuminated {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-hard-green-sm);
  }

  /* Micro-realce del paso activo para que la secuencia se lea como progreso */
  .step-box.current {
    transform: translateY(-4px);
  }

  .step-number-circle {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 2px solid var(--border-bold);
    box-shadow: 2px 2px 0px #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: 16px;
    transition: background-color 300ms ease,
                color 300ms ease,
                transform 300ms var(--ease-apple),
                box-shadow 300ms ease;
  }

  .step-box.illuminated .step-number-circle {
    background: var(--accent-primary);
    color: var(--on-primary);
    box-shadow: 2px 2px 0px #000;
    transform: scale(1.06);
  }

  .step-box h4 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }

  .step-box p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Dos columnas en tablet: los párrafos de cada paso son largos y en tres
     columnas quedaban demasiado estrechos antes de llegar al móvil */
  @media (max-width: 900px) {
    .apk-primary-showcase {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .apk-identity {
      flex-direction: column;
    }
    .apk-action-area {
      align-items: center;
      width: 100%;
    }
    .btn-download-main {
      width: 100%;
    }
    .steps-connecting-line {
      display: none;
    }
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    /* El 3.º paso ocupa la fila completa para no quedar descolgado */
    .steps-grid > .step-box:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .download-card {
      padding: 24px 16px;
    }

    .steps-grid {
      grid-template-columns: 1fr;
    }

    .steps-grid > .step-box:last-child {
      grid-column: auto;
    }

    .apk-primary-showcase {
      padding: 22px 18px;
    }

    .apk-title-row {
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .apk-title-row h3 {
      font-size: 1.25rem;
    }

    .secondary-title {
      font-size: 0.86rem;
    }

    .arch-pills-row .btn-arch-pill {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Secuencia 1-2-3 de la guía de instalación, ligada al scroll.
  // Antes se ejecutaba como una cascada de setTimeout con unobserve(), así que
  // si el usuario subía y bajaba de la sección los pasos quedaban encendidos
  // para siempre y la línea nunca volvía a 0. Ahora es reversible y el ancho se
  // calcula según la posición real de la sección en el viewport.
  const guideTrack = document.getElementById('install-guide-track');
  const lineFill = document.getElementById('steps-line-fill');
  const stepBoxes = [
    document.getElementById('step-box-1'),
    document.getElementById('step-box-2'),
    document.getElementById('step-box-3'),
  ];

  if (guideTrack && lineFill) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Progreso: 0 cuando el bloque entra por abajo, 1 cuando llega al centro
    const computeProgress = () => {
      const rect = guideTrack.getBoundingClientRect();
      const viewport = window.innerHeight || document.documentElement.clientHeight;
      const start = viewport;
      const end = viewport * 0.45;
      const raw = (start - rect.top) / (start - end);
      return Math.min(Math.max(raw, 0), 1);
    };

    const paint = (progress: number) => {
      // La línea sólo cubre el tramo entre el centro del paso 1 y el del paso 3
      lineFill.style.width = `${(progress * 100).toFixed(1)}%`;

      stepBoxes.forEach((box, index) => {
        if (!box) return;
        const threshold = (index + 1) / (stepBoxes.length + 0.35);
        const isOn = progress >= threshold;
        box.classList.toggle('illuminated', isOn);
        box.classList.toggle('current', isOn && progress < threshold + 0.34);
      });
    };

    if (prefersReducedMotion.matches) {
      paint(1);
    } else {
      let ticking = false;
      const update = () => {
        paint(computeProgress());
        ticking = false;
      };
      const requestUpdate = () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      };

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);
      update();
    }
  }

  // Copiado de las huellas SHA-256 al portapapeles
  const hashButtons = document.querySelectorAll<HTMLButtonElement>('.hash-row .btn-app-copy');

  hashButtons.forEach(btn => {
    const label = btn.querySelector('span') ?? btn;
    const originalText = label.textContent ?? 'Copiar';

    btn.addEventListener('click', async () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (!textToCopy) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch (_) {
        // Fallback para contextos sin permiso de clipboard
        const helper = document.createElement('textarea');
        helper.value = textToCopy;
        helper.setAttribute('readonly', '');
        helper.style.position = 'fixed';
        helper.style.opacity = '0';
        document.body.appendChild(helper);
        helper.select();
        try {
          document.execCommand('copy');
        } catch (_) {
          helper.remove();
          return;
        }
        helper.remove();
      }

      label.textContent = '✓ Copiado';
      btn.classList.add('copied');
      window.setTimeout(() => {
        label.textContent = originalText;
        btn.classList.remove('copied');
      }, 2000);
    });
  });
</script>

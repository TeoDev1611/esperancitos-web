    background: rgba(255, 219, 121, 0.12);
    border: 1.5px solid rgba(255, 219, 121, 0.35);
    flex-shrink: 0;
  }

  .sec-verify-text {
    min-width: 0;
  }

  .sec-verify-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .sec-verify-title-row h4 {
    font-size: 1.05rem;
    margin: 0;
    color: var(--text-primary);
  }

  .sec-verify-subtitle {
    font-size: 0.84rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .sec-verify-arrow {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent-amber);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .security-verify-accordion[open] .sec-verify-arrow {
    transform: rotate(180deg);
  }

  .sec-verify-body {
    padding: 20px 24px 24px 24px;
    border-top: 1px solid var(--border-app);
    background: rgba(0, 0, 0, 0.2);
  }

  .sec-verify-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .sec-verify-desc strong {
    color: var(--text-primary);
  }

  .hash-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 8px 14px;
    margin-bottom: 8px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .hash-row:hover {
    border-color: rgba(255, 219, 121, 0.4);
    background: rgba(30, 34, 48, 0.85);
  }

  .hash-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--accent-amber);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .hash-value {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 3px 10px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    cursor: copy;
    transition: all 0.15s ease;
    user-select: all;
  }

  .hash-value:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: rgba(0, 0, 0, 0.75);
  }

  /* Manual Comprimido */
  .hash-help {
    margin-top: 14px;
  }

  .hash-help summary {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent-primary);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.15s ease;
  }

  .hash-help summary::-webkit-details-marker {
    display: none;
  }

  .hash-help summary::before {
    content: "▸";
    font-size: 0.75rem;
    color: var(--accent-primary);
  }

  .hash-help[open] summary::before {
    content: "▾";
  }

  .hash-help summary:hover {
    text-decoration: underline;
  }

  .hash-help-body {
    margin-top: 10px;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid var(--border-app);
    border-radius: var(--radius-sm);
  }

  .hash-help-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .manual-cmd-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }

  .manual-cmd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--bg-surface);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    padding: 6px 12px;
  }

  .manual-os-badge {
    font-size: 0.7rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-amber);
    flex-shrink: 0;
    min-width: 115px;
  }

  .manual-cmd-code {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #FAF7F7;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.35);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .manual-verify-tip {
    font-size: 0.76rem;
    color: var(--text-tertiary);
    line-height: 1.4;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
    padding-top: 8px;
    margin-top: 6px;
  }

  .manual-verify-tip code {
    font-family: var(--font-mono);
    color: var(--color-success, #00FF87);
    font-weight: 700;
    background: rgba(0, 0, 0, 0.45);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid rgba(0, 255, 135, 0.2);
  }

  @media (max-width: 600px) {
    .hash-row {
      padding: 7px 10px;
      gap: 8px;
    }

    .hash-label {
      font-size: 0.65rem;
      letter-spacing: 0.02em;
    }

    .hash-value {
      font-size: 0.68rem;
      padding: 2px 6px;
    }

    .manual-cmd-row {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
    }

    .manual-os-badge {
      min-width: unset;
      font-size: 0.68rem;
    }

    .manual-cmd-row :global(.btn-app-copy) {
      align-self: flex-end;
      width: 100%;
      text-align: center;
      padding: 5px;
    }
  }

  /* Botón de copiado de la huella. Se usa :global() porque Astro añade un
     atributo de scope que eleva la especificidad por encima de global.css. */
  :global(.hash-row .btn-app-copy) {
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-app);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    box-shadow: 1.5px 1.5px 0px #000;
    cursor: pointer;
    white-space: nowrap;
    text-transform: uppercase;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease,
      transform 150ms var(--ease-apple),
      box-shadow 150ms var(--ease-apple);
  }

  :global(.hash-row .btn-app-copy:not(.copied):hover) {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000;
  }

  :global(.hash-row .btn-app-copy:active) {
    transform: translate(1px, 1px);
    box-shadow: 0px 0px 0px #000;
  }

  :global(.hash-row .btn-app-copy.copied) {
    background: var(--accent-primary);
    color: var(--on-primary);
    border-color: #000;
  }

  /* Guía de Instalación en 3 Pasos */
  .install-guide-block {
    border-top: 1.5px solid var(--border-app);
    padding-top: 36px;
    position: relative;
  }

  .steps-heading {
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: 30px;
  }

  .steps-container {
    position: relative;
  }

  /* Línea conectora entre pasos: alineada con el centro de los círculos
     numerados (padding 24px + radio 19px) para que el trazo los atraviese */
  .steps-connecting-line {
    position: absolute;
    top: 43px;
    left: 10%;
    right: 10%;
    height: 3px;
    background: var(--bg-surface-elevated);
    z-index: 0;
  }

  .steps-line-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-primary);
    transition: width 420ms var(--ease-apple);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    position: relative;
    z-index: 1;
  }

  .step-box {
    background: var(--bg-surface-elevated);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition:
      border-color 240ms var(--ease-apple),
      box-shadow 240ms var(--ease-apple),
      transform 240ms var(--ease-spring);
  }

  .step-box:hover {
    transform: translateY(-5px);
    border-color: var(--accent-primary);
    box-shadow:
      4px 4px 0px #000,
      0 8px 24px rgba(0, 255, 135, 0.18);
  }

  .step-box.illuminated {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-hard-green-sm);
  }

  /* Micro-realce del paso activo para que la secuencia se lea como progreso */
  .step-box.current {
    transform: translateY(-4px);
  }

  .step-number-circle {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    border: 2px solid var(--border-bold);
    box-shadow: 2px 2px 0px #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: 16px;
    transition:
      background-color 240ms ease,
      color 240ms ease,
      transform 240ms var(--ease-spring),
      box-shadow 240ms ease;
  }

  .step-box:hover .step-number-circle {
    transform: scale(1.15) rotate(-4deg);
    border-color: var(--accent-primary);
  }

  .step-box.illuminated .step-number-circle {
    background: var(--accent-primary);
    color: var(--on-primary);
    box-shadow: 2px 2px 0px #000;
    transform: scale(1.06);
  }

  .step-box h4 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }

  .step-box p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Dos columnas en tablet: los párrafos de cada paso son largos y en tres
     columnas quedaban demasiado estrechos antes de llegar al móvil */
  @media (max-width: 900px) {
    .apk-primary-showcase {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .apk-identity {
      flex-direction: column;
    }
    .apk-action-area {
      align-items: center;
      width: 100%;
    }
    .btn-download-main {
      width: 100%;
    }
    .steps-connecting-line {
      display: none;
    }
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    /* El 3.º paso ocupa la fila completa para no quedar descolgado */
    .steps-grid > .step-box:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .download-card {
      padding: 20px 14px;
    }

    .steps-grid {
      grid-template-columns: 1fr;
    }

    .steps-grid > .step-box:last-child {
      grid-column: auto;
    }

    .apk-primary-showcase {
      padding: 20px 14px;
    }

    .btn-download-main {
      padding: 12px 16px;
      font-size: 0.95rem;
    }

    .apk-title-row {
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .apk-title-row h3 {
      font-size: 1.25rem;
    }

    .secondary-title {
      font-size: 0.86rem;
    }

    .arch-pills-row .btn-arch-pill {
      width: 100%;
      justify-content: center;
    }

    .release-highlights-grid {
      grid-template-columns: 1fr;
    }

    .release-banner-card {
      padding: 20px 14px;
    }
  }

  /* Acordeón de Novedades y Ficha Técnica v1.1-beta.2 */
  .version-release-accordion {
    margin-top: 28px;
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .version-release-accordion[open] {
    border-color: var(--accent-primary);
  }

  .release-accordion-summary {
    padding: 18px 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    list-style: none;
    user-select: none;
    transition: background 0.15s ease;
  }

  .release-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .release-accordion-summary:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .release-summary-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .release-summary-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .release-summary-left h4 {
    font-size: 1.05rem;
    color: var(--text-primary);
    margin: 0;
  }

  .release-accordion-arrow {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent-primary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .version-release-accordion[open] .release-accordion-arrow {
    transform: rotate(180deg);
  }

  .release-accordion-body {
    border-top: 1px solid var(--border-app);
  }

  .release-banner-card {
    background: var(--bg-surface-elevated);
    padding: 28px 32px;
  }

  .release-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .release-badge-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .release-build-pill {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border-app);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .release-status-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-primary);
    background: rgba(0, 255, 135, 0.1);
    border: 1px solid rgba(0, 255, 135, 0.35);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .release-main-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.3;
    margin: 0 0 10px 0;
    color: var(--text-primary);
  }

  .release-intro {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 26px;
  }

  /* Grid de lo más destacado */
  .release-highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 36px;
  }

  .highlight-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    box-shadow: 2px 2px 0px #000;
    transition:
      transform 200ms var(--ease-spring),
      border-color 200ms ease;
  }

  .highlight-item:hover {
    transform: translateY(-2px);
    border-color: var(--accent-primary);
  }

  .highlight-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .highlight-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .highlight-content strong {
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .highlight-content span {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  /* Ficha Técnica */
  .tech-sheet-block {
    margin-bottom: 30px;
    border-top: 1.5px solid var(--border-app);
    padding-top: 24px;
  }

  .tech-sheet-title {
    font-size: 1.15rem;
    margin-bottom: 14px;
    color: var(--text-primary);
  }

  .specs-table-wrapper {
    overflow-x: auto;
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    box-shadow: 3px 3px 0px #000;
  }

  .specs-table {
    width: 100%;
    min-width: 440px;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .specs-table th,
  .specs-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-app);
  }

  .specs-table tr:last-child th,
  .specs-table tr:last-child td {
    border-bottom: none;
  }

  .specs-table th {
    width: 28%;
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: rgba(0, 0, 0, 0.2);
  }

  .specs-table td {
    color: var(--text-secondary);
  }

  .specs-table td code {
    background: rgba(0, 255, 135, 0.1);
    color: var(--accent-primary);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  /* Changelog Acordeón */
  .changelog-details {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .changelog-summary {
    padding: 14px 18px;
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }

  .changelog-summary::-webkit-details-marker {
    display: none;
  }

  .changelog-summary:hover {
    color: var(--accent-primary);
  }

  .changelog-badge-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-app);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    color: var(--accent-amber);
  }

  .changelog-list-body {
    padding: 16px 20px 22px 20px;
    border-top: 1px solid var(--border-app);
  }

  .changelog-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    margin: 0;
  }

  .changelog-items li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .change-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 2px;
    border: 1px solid transparent;
  }

  .change-tag.new {
    background: rgba(0, 255, 135, 0.15);
    color: var(--accent-primary);
    border-color: rgba(0, 255, 135, 0.35);
  }

  .change-tag.feature,
  .change-tag.chat,
  .change-tag.moodle {
    background: rgba(79, 142, 247, 0.15);
    color: #79aeff;
    border-color: rgba(79, 142, 247, 0.35);
  }

  .change-tag.storage,
  .change-tag.files {
    background: rgba(255, 219, 121, 0.15);
    color: var(--accent-amber);
    border-color: rgba(255, 219, 121, 0.35);
  }

  .change-tag.perf,
  .change-tag.os,
  .change-tag.sync {
    background: rgba(167, 139, 250, 0.15);
    color: #c4b5fd;
    border-color: rgba(167, 139, 250, 0.35);
  }

  .change-tag.haptic,
  .change-tag.a11y,
  .change-tag.dash,
  .change-tag.acad,
  .change-tag.nav {
    background: rgba(244, 114, 182, 0.15);
    color: #f472b6;
    border-color: rgba(244, 114, 182, 0.35);
  }

  @media (max-width: 768px) {
    .release-highlights-grid {
      grid-template-columns: 1fr;
    }

    .specs-table th {
      width: 38%;
    }
  }

  /* Modal Post-Descarga Brutalista */
  .post-download-modal {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 560px;
    width: 90%;
    margin: auto;
  }

  .post-download-modal::backdrop {
    background: rgba(16, 19, 25, 0.85);
    backdrop-filter: blur(10px);
  }

  .post-dl-card {
    background: #161A23;
    border: 3px solid #000000;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 8px 8px 0px #000000;
    position: relative;
    color: var(--color-text-body);
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  @media (max-width: 600px) {
    .post-dl-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 24px 20px;
    }
  }

  .post-dl-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #1E2230;
    color: #FAF7F7;
    border: 2px solid #000000;
    border-radius: 8px;
    width: 32px;
    height: 32px;
    font-size: 1rem;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;

---
// DownloadSection.astro - Centro de descargas con verificación de integridad
import { SITE } from "../config/site";

const primaryFile = "pilas-v1.1-beta.2-arm64-v8a.apk";
const secondaryFile = "pilas-v1.1-beta.2-armeabi-v7a.apk";
const universalFile = "pilas-v1.1-beta.2-universal.apk";
const x86File = "pilas-v1.1-beta.2-x86_64.apk";

const primarySha = SITE.apkChecksums[primaryFile] ?? "";
const secondarySha = SITE.apkChecksums[secondaryFile] ?? "";
const universalSha = SITE.apkChecksums[universalFile] ?? "";
const x86Sha = SITE.apkChecksums[x86File] ?? "";

function shortHash(hash: string): string {
  if (!hash || hash.length <= 20) return hash;
  return `${hash.slice(0, 10)}…${hash.slice(-8)}`;
}
---

<section class="download-section scroll-reveal" id="descargar">
  <div class="container">
    <div class="download-card card-app reveal-init">
      <!-- Encabezado de la Sección -->
      <div class="download-header">
        <span class="badge-app fuchsia"
          >¡PONTE PILAS! · DESCARGA GRATUITA · SIN PUBLICIDAD INVASIVA</span
        >
        <h2>Descarga Pilas! para Android</h2>
        <p>
          ¡Pilas, ñañ@s! La app se instala directo desde aquí, sin pasar por
          tiendas. Elige la opción recomendada para tu celular y listo.
        </p>
      </div>


      <!-- Tarjeta Principal Dominante -->
      <div class="apk-primary-showcase card-app live">
        <div class="apk-identity">
          <div class="apk-logo-frame">
            <img
              src="/logos/icono_logo2.svg"
              alt="Logo de Pilas!"
              class="apk-logo-img"
              width="68"
              height="68"
            />
            <span class="apk-release-tag">v1.1-beta.2 (Build 5)</span>
          </div>

          <div class="apk-details">
            <div class="apk-title-row">
              <h3>Descarga Pilas! Directo</h3>
              <span class="chip-live">Recomendada (ARM64)</span>
              <span class="chip-dl-counter" id="section-dl-counter" data-base-count={SITE.downloads.baseCount} title="Descargas acumuladas en la comunidad ESPE">
                <span class="dl-live-dot" aria-hidden="true"></span>
                <span class="chip-dl-num" id="section-dl-count-val">{SITE.downloads.formatted}</span>
                <span class="chip-dl-lbl">descargas</span>
              </span>
            </div>

            <div class="apk-specs-grid">
              <div class="spec-pill">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                  <path d="M12 18h.01"></path>
                </svg>
                <span
                  >Funciona en <strong>casi cualquier celular Android</strong> (del
                  2019 en adelante)</span
                >
              </div>
              <div class="spec-pill">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                  ></polygon>
                </svg>
                <span
                  >Pesa <strong>37.1 MB</strong> (Arquitectura `arm64-v8a`)</span
                >
              </div>
              <div class="spec-pill">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"
                  ></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>Necesitas <strong>Android 8.0 o superior</strong></span>
              </div>
              <div class="spec-pill spec-pill-downloads">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span
                  ><strong id="spec-dl-count-val">{SITE.downloads.formatted} descargas</strong> registradas en la ESPE</span
                >
              </div>
            </div>
          </div>
        </div>

        <div class="apk-action-area">
          <a
            href={`/downloads/${primaryFile}`}
            download
            class="btn-app btn-app-primary btn-download-main"
            id="primary-apk-download-btn"
          >
            <svg
              class="download-bounce-icon"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <div class="btn-text-block">
              <span class="btn-main-label">DESCARGAR PILAS! v1.1-BETA.2</span>
              <small class="btn-sub-label"
                >APK Oficial Directo · ARM64 (37.1 MB) · Gratis</small
              >
            </div>
          </a>
          <div class="download-trust-row">
            <span class="trust-item"><span class="trust-check" aria-hidden="true">✓</span> 100% Gratuito</span>
            <span class="trust-item"><span class="trust-check" aria-hidden="true">✓</span> Sin Anuncios</span>
            <span class="trust-item"><span class="trust-check" aria-hidden="true">✓</span> Verificado Seguro</span>
          </div>
        </div>
      </div>

      <!-- Variantes Secundarias por Arquitectura (Colapsable / Limpio) -->
      <details class="secondary-arch-dropdown">
        <summary class="secondary-arch-summary">
          <div class="sec-arch-summary-content">
            <span class="sec-arch-icon" aria-hidden="true">⚙️</span>
            <span>¿Celular antiguo de más de 5 años o emulador en PC? <strong>Ver otras versiones del APK</strong></span>
          </div>
          <span class="sec-arch-badge">Otras versiones ▾</span>
        </summary>
        <div class="secondary-arch-body">
          <div class="arch-pills-row">
            <a
              href={`/downloads/${secondaryFile}`}
              download
              class="btn-app btn-app-surface btn-arch-pill apk-option-btn"
              title="Para celulares de más de 5 años o de gama baja (ARMv7 32-bit)"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                <path d="M12 18h.01"></path>
              </svg>
              <span>Celular antiguo (ARMv7 32-bit)</span>
              <span class="arch-size">33.6 MB</span>
            </a>

            <a
              href={`/downloads/${universalFile}`}
              download
              class="btn-app btn-app-surface btn-arch-pill apk-option-btn"
              title="Universal: compatible con cualquier procesador o dispositivo Android"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
              <span>Universal (Todo-en-uno)</span>
              <span class="arch-size">94.7 MB</span>
            </a>

            <a
              href={`/downloads/${x86File}`}
              download
              class="btn-app btn-app-surface btn-arch-pill apk-option-btn"
              title="Para emuladores en PC (Windows Subsystem for Android, BlueStacks, LDPlayer)"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              <span>Emulador / PC (x86_64)</span>
              <span class="arch-size">39.6 MB</span>
            </a>
          </div>
        </div>
      </details>

      <!-- 3 Pasos de Instalación Conectados por una Línea Dinámica -->
      <div class="install-guide-block" id="install-guide-track">
        <h3 class="steps-heading">
          Instalarla te toma 3 pasos y menos de un minuto
        </h3>

        <div class="steps-container">
          <!-- Línea conectora animada al scroll -->
          <div class="steps-connecting-line" aria-hidden="true">
            <div class="steps-line-fill" id="steps-line-fill"></div>
          </div>

          <div class="steps-grid">
            <!-- Paso 1 -->
            <div class="step-box card-app" id="step-box-1">
              <div class="step-number-circle">1</div>
              <h4>Descarga el archivo</h4>
              <p>
                Toca el botón de arriba. El archivo se guarda en la carpeta <em
                  >Descargas</em
                > de tu celular.
              </p>
            </div>

            <!-- Paso 2 -->
            <div class="step-box card-app" id="step-box-2">
              <div class="step-number-circle">2</div>
              <h4>Dale permiso</h4>
              <p>
                Abre el archivo descargado. Android te va a preguntar si confías
                en el origen: marca <em>"Permitir desde esta fuente"</em>. Es
                normal, pasa con cualquier app que no venga de la tienda.
              </p>
            </div>

            <!-- Paso 3 -->
            <div class="step-box card-app" id="step-box-3">
              <div class="step-number-circle">3</div>
              <h4>¡Ponte pilas y úsala!</h4>
              <p>
                Elige tu carrera, conecta tu horario y tu Moodle, y ponte pilas
                con tus materias. ¡Ya está, ñañ@s!
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Banner de Comunidad / Canal de WhatsApp -->
      <div class="download-channel-banner card-app green-accent reveal-init">
        <div class="channel-banner-icon-col">
          <div class="channel-wa-icon-frame" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
        </div>
        <div class="channel-banner-info">
          <div class="channel-banner-badges">
            <span class="badge-app green">💬 CANAL OFICIAL EN WHATSAPP</span>
            <span class="channel-live-chip">COMUNIDAD PILAS!</span>
          </div>
          <h3>Aparte de descargarte la app, ¡únete al canal de Pilas!</h3>
          <p>
            Entérate de nuevas versiones, actualizaciones, avisos académicos del campus e información oficial sin rodeos. ¡Ponte pilas y súmate a la comunidad!
          </p>
        </div>
        <div class="channel-banner-action">
          <a
            href={SITE.social.whatsappChannel}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp-channel-cta"
            aria-label="Unirse al canal oficial de WhatsApp de Pilas!"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Unirme al Canal de WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Seguridad, Google Play Protect y Verificación de Integridad SHA-256 (Acordeón Limpio) -->
      <details class="security-verify-accordion card-app reveal-init">
        <summary class="sec-verify-summary">
          <div class="sec-verify-header-left">
            <span class="sec-verify-icon-frame" aria-hidden="true">🛡️</span>
            <div class="sec-verify-text">
              <div class="sec-verify-title-row">
                <h4>Seguridad, Google Play Protect y Huellas SHA-256</h4>
                <span class="badge-app amber">OPCIONAL · VERIFICACIÓN</span>
              </div>
              <p class="sec-verify-subtitle">
                ¿Por qué Android muestra aviso de instalación y cómo verificar la autenticidad del APK?
              </p>
            </div>
          </div>
          <span class="sec-verify-arrow" aria-hidden="true">▾</span>
        </summary>

        <div class="sec-verify-body">
          <p class="sec-verify-desc">
            Estamos juntando los <strong>25 dólares</strong> que cuesta la cuenta de desarrollador de Google Play. Mientras tanto, la app se descarga directamente desde aquí. Como no proviene de la tienda oficial, el sistema te pedirá autorizar la instalación y puede mostrar un aviso preventivo de <strong>Google Play Protect</strong>. Es el comportamiento habitual de Android para cualquier APK directo. Si deseas verificar la autenticidad e integridad del paquete antes de instalarlo, aquí tienes las huellas criptográficas SHA-256 oficiales:
          </p>

          {
            primarySha && (
              <div class="hash-row">
                <span class="hash-label">Recomendada · ARM64-v8a</span>
                <code
                  class="hash-value"
                  title={`Huella SHA-256 completa:\n${primarySha}\n(Clic para copiar)`}
                  data-copy={primarySha}
                >
                  {shortHash(primarySha)}
                </code>
                <button
                  type="button"
                  class="btn-app-copy"
                  data-copy={primarySha}
                  aria-label="Copiar la huella SHA-256 del APK recomendado"
                  title="Copiar huella SHA-256 completa"
                >
                  <span>Copiar</span>
                </button>
              </div>
            )
          }

          {
            secondarySha && (
              <div class="hash-row">
                <span class="hash-label">Gama baja · ARMeabi-v7a</span>
                <code
                  class="hash-value"
                  title={`Huella SHA-256 completa:\n${secondarySha}\n(Clic para copiar)`}
                  data-copy={secondarySha}
                >
                  {shortHash(secondarySha)}
                </code>
                <button
                  type="button"
                  class="btn-app-copy"
                  data-copy={secondarySha}
                  aria-label="Copiar la huella SHA-256 del APK para celulares antiguos"
                  title="Copiar huella SHA-256 completa"
                >
                  <span>Copiar</span>
                </button>
              </div>
            )
          }

          {
            universalSha && (
              <div class="hash-row">
                <span class="hash-label">Universal · Multi-Arch</span>
                <code
                  class="hash-value"
                  title={`Huella SHA-256 completa:\n${universalSha}\n(Clic para copiar)`}
                  data-copy={universalSha}
                >
                  {shortHash(universalSha)}
                </code>
                <button
                  type="button"
                  class="btn-app-copy"
                  data-copy={universalSha}
                  aria-label="Copiar la huella SHA-256 del APK universal"
                  title="Copiar huella SHA-256 completa"
                >
                  <span>Copiar</span>
                </button>
              </div>
            )
          }

          {
            x86Sha && (
              <div class="hash-row">
                <span class="hash-label">Emulador · x86_64</span>
                <code
                  class="hash-value"
                  title={`Huella SHA-256 completa:\n${x86Sha}\n(Clic para copiar)`}
                  data-copy={x86Sha}
                >
                  {shortHash(x86Sha)}
                </code>
                <button
                  type="button"
                  class="btn-app-copy"
                  data-copy={x86Sha}
                  aria-label="Copiar la huella SHA-256 del APK x86_64"
                  title="Copiar huella SHA-256 completa"
                >
                  <span>Copiar</span>
                </button>
              </div>
            )
          }

          <!-- Manual de Verificación Comprimido -->
          <details class="hash-help">
            <summary>¿Cómo verifico la huella en mi computadora?</summary>
            <div class="hash-help-body">
              <p class="hash-help-desc">
                Abre la terminal en tu carpeta de <strong>Descargas</strong> y ejecuta:
              </p>

              <div class="manual-cmd-list">
                <div class="manual-cmd-row">
                  <span class="manual-os-badge">PowerShell</span>
                  <code class="manual-cmd-code">Get-FileHash .\pilas-*.apk</code>
                  <button
                    type="button"
                    class="btn-app-copy"
                    data-copy="Get-FileHash .\pilas-*.apk"
                    aria-label="Copiar comando PowerShell"
                    title="Copiar comando para Windows PowerShell"
                  >
                    <span>Copiar</span>
                  </button>
                </div>

                <div class="manual-cmd-row">
                  <span class="manual-os-badge">macOS / Linux</span>
                  <code class="manual-cmd-code">shasum -a 256 pilas-*.apk</code>
                  <button
                    type="button"
                    class="btn-app-copy"
                    data-copy="shasum -a 256 pilas-*.apk"
                    aria-label="Copiar comando macOS y Linux"
                    title="Copiar comando para Mac y Linux"
                  >
                    <span>Copiar</span>
                  </button>
                </div>
              </div>

              <div class="manual-verify-tip">
                <span>💡 El resultado debe empezar con <code>{primarySha.slice(0, 10)}</code> y terminar en <code>{primarySha.slice(-8)}</code>.</span>
              </div>
            </div>
          </details>
        </div>
      </details>

      <!-- Ficha Técnica y Changelog Oficial de la Versión 1.1-beta.2 (Acordeón Limpio) -->
      <details class="version-release-accordion card-app reveal-init" id="novedades-v1">
        <summary class="release-accordion-summary">
          <div class="release-summary-left">
            <div class="release-summary-badges">
              <span class="badge-app green">NOVEDADES · v1.1-BETA.2</span>
              <span class="release-build-pill">Build 5 · Octubre 2026</span>
            </div>
            <h4>🚀 Ver novedades de la versión, ficha técnica y changelog completo</h4>
          </div>
          <span class="release-accordion-arrow" aria-hidden="true">▾</span>
        </summary>

        <div class="release-accordion-body">
          <div class="release-banner-card">

          <h3 class="release-main-title">
            🚀 ¡Pilas, ñañ@s! Llegó Pilas! v1.1-beta.2: Parche para Moodle y Permisos
          </h3>
          <p class="release-intro">
            Diseñada por y para estudiantes de la Universidad de las Fuerzas
            Armadas ESPE. Edición oficial estable con widgets nativos para tu pantalla de inicio,
            horario Banner con resolución de aulas, Moodle multi-cuenta con chat y alarmas,
            calculadora de parciales, carnet digital y malla curricular interactiva.
          </p>

          <!-- Lo más destacado en grid neo-brutalista -->
          <div class="release-highlights-grid">
            <div class="highlight-item">
              <div class="highlight-icon">🚀</div>
              <div class="highlight-content">
                <strong>Widgets Nativos de Pantalla de Inicio</strong>
                <span
                  >Widgets completos en Kotlin (Android) y Swift (iOS) con tu horario,
                  próximas clases y tareas pendientes directo en tu pantalla principal.</span
                >
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">📲</div>
              <div class="highlight-content">
                <strong>Apertura Directa Push</strong>
                <span
                  >Abre tareas al instante desde notificaciones push sin pantallas
                  intermedias ni pantallas en blanco.</span
                >
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">📚</div>
              <div class="highlight-content">
                <strong>Modo 'Vista Moodle'</strong>
                <span
                  >Extracción y lectura completa de avisos, foros, guías de práctica
                  y tareas organizadas por asignatura.</span
                >
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">⚡</div>
              <div class="highlight-content">
                <strong>Compartir por Código QR</strong>
                <span
                  >Comparte archivos, documentos y guías en 1-Tap con tus compañeros
                  mediante código QR instantáneo.</span
                >
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">🪪</div>
              <div class="highlight-content">
                <strong>Carnet Digital Inmersivo</strong>
                <span
                  >Muestra tu carnet al instante en la garita para el guardia,
                  con zoom nítido y sin pantallas intermedias.</span
                >
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">🏢</div>
              <div class="highlight-content">
                <strong>Aulas Inteligentes</strong>
                <span>Códigos oficiales concisos (G-201, G-102) o con detalle de
                  piso y bloque con un solo toque.</span>
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">⏰</div>
              <div class="highlight-content">
                <strong>Horario "En Vivo"</strong>
                <span
                  >Tu clase actual destacada en esmeralda con barra de tiempo
                  restante y auto-scroll al día de hoy.</span
                >
              </div>
            </div>
            <div class="highlight-item">
              <div class="highlight-icon">📊</div>
              <div class="highlight-content">
                <strong>Calculadora Ponderada Oficial</strong>
                <span
                  >Conoce con cuántos puntos pasas según el reglamento oficial
                  ESPE (33.34% / 33.33% / 33.33%) con simulador en vivo.</span
                >
              </div>
            </div>
          </div>

          <!-- Ficha Técnica Oficial -->
          <div class="tech-sheet-block">
            <h4 class="tech-sheet-title">📱 Ficha Técnica Oficial para la Descarga</h4>
            <div class="specs-table-wrapper">
              <table class="specs-table">
                <tbody>

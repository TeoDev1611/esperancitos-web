---
import { SITE } from '../config/site';

interface Props {
  V?: any;
  M?: any;
  PLAY?: string;
  PLAY_STORE_BETA?: any;
  PRIMARY_ARCH?: any;
  ARCHITECTURES_LIST?: any[];
}

const {
  V = {},
  M = {
    neutral: '/logos/mascota_neutro.svg',
    success: '/logos/mascota_aprobacion.svg',
    scared: '/logos/mascota_asustado.svg',
  },
} = Astro.props;

const WA_CHANNEL = 'https://www.whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g';
const WA_TESTERS = 'https://chat.whatsapp.com/FAwkWyYVK2x3sEtGuoLVzc';
---

<section id="acceso" class="hub-access-section card">
  <!-- Ancla oculta para compatibilidad con links antiguos #descargar -->
  <span id="descargar" class="sr-only-anchor" aria-hidden="true"></span>

  <!-- 1. ENCABEZADO PRINCIPAL ESTILO PLAY STORE PREVIEW -->
  <div class="access-hero-header">
    <div class="access-title-lockup">
      <div class="starburst-badge-wrap">
        <span class="starburst-badge">PRUEBA<br/>CERRADA</span>
      </div>
      <h2 class="access-main-title">
        PILAS! YA ESTÁ<br />
        <span class="access-title-glow">EN PLAY STORE</span>
      </h2>
      <p class="access-main-subtitle font-mono">
        Es prueba cerrada: entra primero quien pide acceso
      </p>
    </div>

    <!-- Banner Destacado: Requisitos Mínimos -->
    <div class="access-callout-banner">
      <div class="callout-icon-box">🔓</div>
      <div class="callout-text-content">
        <strong class="callout-headline">Estamos en prueba cerrada y abrimos cupos para cualquier universidad.</strong>
        <p class="callout-sub">Solo necesitas un correo <span class="badge-inline-gmail">@gmail.com</span> y un celular <span class="badge-inline-android">Android</span>.</p>
      </div>
    </div>
  </div>

  <!-- 2. GRID PRINCIPAL: MOCKUP DE PLAY STORE + GUÍA PASO A PASO -->
  <div class="access-core-grid">
    <!-- COLUMNA IZQUIERDA: Mockup Fidedigno de Google Play Store -->
    <div class="play-store-mockup-card">
      <div class="play-mock-bar">
        <div class="mock-nav-left">
          <svg class="mock-ico" viewBox="0 0 24 24"><path d="M20 12H4M10 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="mock-play-brand">Google Play</span>
        </div>
        <div class="mock-nav-right">
          <svg class="mock-ico" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="mock-ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
        </div>
      </div>

      <div class="mock-app-row">
        <div class="mock-app-icon-frame">
          <img src={M.success || '/logos/mascota_aprobacion.svg'} alt="Pilas! Icono Oficial" class="mock-app-icon-img" width="76" height="76" />
        </div>
        <div class="mock-app-meta">
          <h3 class="mock-app-name">Pilas! Horario y Moodle</h3>
          <span class="mock-app-tag">(acceso anticipado)</span>
          <span class="mock-app-dev">Teo Apps Ec</span>
        </div>
      </div>

      <div class="mock-stats-row">
        <div class="mock-stat-col">
          <svg class="mock-stat-ico" viewBox="0 0 24 24"><path d="M12 3v13M7 11l5 5 5-5M4 21h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="mock-stat-val">23 MB</span>
        </div>
        <div class="mock-stat-divider"></div>
        <div class="mock-stat-col">
          <span class="mock-e-rating">E</span>
          <span class="mock-stat-val">Apto para todo público <small>ⓘ</small></span>
        </div>
      </div>

      <div class="mock-actions-wrap">
        <a class="btn mock-install-btn" href={WA_CHANNEL} target="_blank" rel="noopener noreferrer">
          <svg class="ico" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          <span>Pedir acceso con mi @gmail.com</span>
        </a>
        <a class="btn mock-secondary-btn" href={WA_TESTERS} target="_blank" rel="noopener noreferrer">
          <span>Unirme al Grupo de Testers</span>
        </a>
      </div>

      <div class="mock-disclaimer-box">
        <span class="mock-info-i">ⓘ</span>
        <p class="mock-disclaimer-text">
          Esta app está en desarrollo. Sé una de las primeras personas en probarla y envía tus comentarios. <a href={WA_TESTERS} target="_blank" rel="noopener noreferrer" class="mock-link">Ver detalles</a>
        </p>
      </div>

      <!-- Badges estilo sticker al pie del mockup con Pilo asomándose -->
      <div class="mock-footer-stickers">
        <div class="mock-stickers-left">
          <span class="store-badge green-badge">● Disponible en Google Play</span>
          <span class="store-badge dark-badge">Acceso anticipado</span>
        </div>
        <div class="mock-peeking-mascot">
          <img src={M.neutral || '/logos/mascota_neutro.svg'} alt="Pilo asomándose" class="peeking-pilo-img" width="56" height="56" />
        </div>
      </div>
    </div>

    <!-- COLUMNA DERECHA: Pasos para Entrar y Validación -->
    <div class="access-steps-column">
      <div class="steps-box-hdr">
        <span class="badge b-info font-mono">PASO A PASO OFICIAL</span>
        <h3 class="steps-title">¿Cómo entrar a la preview cerrada?</h3>
      </div>

      <ol class="access-steps-list">
        <li class="access-step-card">
          <div class="step-badge-num">1️⃣</div>
          <div class="step-card-body">
            <h4 class="step-card-title">Entra al canal y pide tu acceso con tu @gmail.com</h4>
            <p class="step-card-desc">Publicamos los formularios y abrimos cupos directos para testers de cualquier universidad del país.</p>
            <div class="step-action-row">
              <a href={WA_CHANNEL} target="_blank" rel="noopener noreferrer" class="step-mini-cta canal-cta">
                📲 Entrar al Canal de WhatsApp
              </a>
            </div>
          </div>
        </li>

        <li class="access-step-card">
          <div class="step-badge-num">2️⃣</div>
          <div class="step-card-body">
            <h4 class="step-card-title">Instala directamente desde Google Play Store</h4>
            <p class="step-card-desc">Una vez registrado tu correo, el enlace de Play Store se te habilitará al instante. Sin APKs manuales ni advertencias raras.</p>
          </div>
        </li>

        <li class="access-step-card">
          <div class="step-badge-num">3️⃣</div>
          <div class="step-card-body">
            <h4 class="step-card-title">Conecta tu Moodle y cuéntanos si funciona</h4>
            <p class="step-card-desc">Prueba tus materias, horarios, notas y carnet digital. Tu retroalimentación en el grupo hace que la app mejore cada día.</p>
            <div class="step-action-row">
              <a href={WA_TESTERS} target="_blank" rel="noopener noreferrer" class="step-mini-cta testers-cta">
                👥 Unirme al Grupo de Testers
              </a>
            </div>
          </div>
        </li>
      </ol>

      <!-- Advertencia Institucional de Moodle Mobile -->
      <div class="moodle-compatibility-warning">
        <div class="warning-tag">⚠️ COMPATIBILIDAD MOODLE</div>
        <p class="warning-text">
          Funciona con Moodles que tengan la <strong>app móvil habilitada por la institución</strong> (protocolo estándar oficial de Moodle Mobile).
        </p>
      </div>
    </div>
  </div>

  <!-- 3. SECCIÓN: ¿POR QUÉ SOLO CON ACCESO? (3 Tarjetas de Color + Aviso Importante) -->
  <div class="why-access-wrap">
    <div class="why-access-header">
      <span class="badge-pill-closed">Prueba cerrada</span>
      <h3 class="why-title">
        ¿POR QUÉ SOLO CON <span class="accent-magenta">ACCESO?</span>
      </h3>
    </div>

    <div class="why-cards-grid">
      <!-- Tarjeta 1: Magenta / Pink -->
      <div class="why-card card-magenta">
        <div class="why-card-top">
          <span class="why-card-num">1</span>
          <h4 class="why-card-heading">Google lo exige a cuentas nuevas</h4>
        </div>
        <p class="why-card-body">
          Para publicar abierto a todo público, Google Play exige un mínimo de <strong>12 testers activos durante 14 días seguidos</strong>.
        </p>
      </div>

      <!-- Tarjeta 2: Mint / Emerald -->
      <div class="why-card card-mint">
        <div class="why-card-top">
          <span class="why-card-num">2</span>
          <h4 class="why-card-heading">Tú la usas antes que todos</h4>
        </div>
        <p class="why-card-body">
          Entras a Pilas! antes del lanzamiento masivo, con todas sus funciones activas: mallas, horarios, carnet y herramientas.
        </p>
      </div>

      <!-- Tarjeta 3: Yellow / Gold -->
      <div class="why-card card-yellow">
        <div class="why-card-top">
          <span class="why-card-num">3</span>
          <h4 class="why-card-heading">Tus reportes la mejoran</h4>
        </div>
        <p class="why-card-body">
          Si algo falla (un bug, pantalla rara o el Moodle de tu universidad), lo arreglamos y lo publicamos antes de abrir para todos.
        </p>
      </div>
    </div>

    <!-- Tarjeta Dark: IMPORTANTE 14 DÍAS -->
    <div class="why-important-box">
      <div class="important-label font-mono">⚠️ IMPORTANTE</div>
      <p class="important-text">
        Una vez dentro, <strong>no te salgas del programa de pruebas durante 14 días</strong>: así Google cuenta tu participación y logramos el pase al lanzamiento abierto para todo el Ecuador.
      </p>
    </div>
  </div>
</section>

<style is:global>
/* ============================================================== */
/* ESTILOS DEL HUB DE ACCESO A PRUEBA CERRADA GOOGLE PLAY        */
/* ============================================================== */
.sr-only-anchor {
  display: block;
  position: relative;
  top: -80px;
  visibility: hidden;
  height: 0;
}

.hub-access-section {
  background: var(--bg-surface);
  border: 2px solid #000;
  border-radius: 20px;
  box-shadow: 6px 6px 0 #000;
  padding: clamp(20px, 4vw, 40px);
  margin-top: 40px;
  position: relative;
  overflow: hidden;
}

/* 1. Header */
.access-hero-header {
  margin-bottom: 32px;
}
.access-title-lockup {
  position: relative;
  text-align: center;
  max-width: 640px;
  margin: 0 auto 24px;
}
.starburst-badge-wrap {
  position: absolute;
  top: -12px;
  right: clamp(-8px, 2vw, 24px);
  transform: rotate(12deg);
  z-index: 2;
}
.starburst-badge {
  display: inline-block;
  background: #ffdb60;
  color: #000;
  font: 900 0.82rem/1 var(--f-d);
  padding: 8px 12px;
  border: 2px solid #000;
  border-radius: 8px;
  box-shadow: 3px 3px 0 #000;
  text-align: center;
  letter-spacing: -0.02em;
}
.access-main-title {
  font-family: var(--f-d);
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: #fff;
  text-shadow: 2px 2px 0 #000;
  margin: 0 0 10px;
}
.access-title-glow {
  color: var(--primary);
  display: inline-block;
}
html[data-mode="multi"] .access-title-glow {
  color: var(--primary-coral);
}
.access-main-subtitle {
  font-size: 0.96rem;
  color: var(--muted);
  letter-spacing: 0.02em;
  margin: 0;
}

/* Callout Banner */
.access-callout-banner {
  display: flex;
  align-items: center;
  gap: 16px;
  background: rgba(255, 63, 164, 0.09);
  border: 2px solid var(--primary);
  border-radius: 14px;
  padding: 14px 20px;
  box-shadow: 3px 3px 0 #000;
  margin: 0 auto;
  max-width: 820px;
}
html[data-mode="multi"] .access-callout-banner {
  background: rgba(255, 61, 94, 0.09);
  border-color: var(--primary-coral);
}
.callout-icon-box {
  font-size: 1.8rem;
  flex-shrink: 0;
}
.callout-text-content {
  flex: 1;
  font-size: 0.98rem;
  line-height: 1.4;
}
.callout-headline {
  color: var(--title);
  display: block;
  margin-bottom: 2px;
}
.callout-sub {
  margin: 0;
  color: var(--body);
}
.badge-inline-gmail {
  background: #ea4335;
  color: #fff;
  font-weight: 800;
  font-size: 0.85rem;
  padding: 1px 7px;
  border-radius: 4px;
  border: 1px solid #000;
}
.badge-inline-android {
  background: #34a853;
  color: #000;
  font-weight: 800;
  font-size: 0.85rem;
  padding: 1px 7px;
  border-radius: 4px;
  border: 1px solid #000;
}

/* 2. Core Grid: Mockup + Pasos */
.access-core-grid {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 32px;
  align-items: start;
  margin-bottom: 48px;
}

/* Mockup Google Play */
.play-store-mockup-card {
  background: #0f141d;
  border: 2.5px solid #232c3d;
  border-radius: 22px;
  padding: 22px;
  box-shadow: 6px 6px 0 #000;
  position: relative;
}
.play-mock-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #94a3b8;
  margin-bottom: 18px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.mock-nav-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.mock-ico {
  width: 20px;
  height: 20px;
}
.mock-play-brand {
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.95rem;
  color: #e2e8f0;
  letter-spacing: -0.01em;
}
.mock-nav-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.mock-app-row {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-bottom: 20px;
}
.mock-app-icon-frame {
  width: 78px;
  height: 78px;
  border-radius: 18px;
  background: linear-gradient(135deg, #ff3fa4 0%, #a21caf 100%);
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(255, 63, 164, 0.3);
  border: 2px solid rgba(255, 255, 255, 0.2);
}
.mock-app-icon-img {
  width: 60px;
  height: 60px;
  object-fit: contain;
}
.mock-app-meta {
  flex: 1;
  min-width: 0;
}
.mock-app-name {
  font-family: var(--f-d);
  font-size: 1.25rem;
  font-weight: 900;
  color: #fff;
  line-height: 1.15;
  margin: 0;
}
.mock-app-tag {
  display: block;
  font-size: 0.85rem;
  color: #94a3b8;
  margin-top: 2px;
}
.mock-app-dev {
  display: block;
  font-size: 0.85rem;
  font-weight: 700;
  color: #38bdf8;
  margin-top: 4px;
}

.mock-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 20px;
  border: 1px solid rgba(255, 255, 255, 0.06);
}
.mock-stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.mock-stat-ico {
  width: 18px;
  height: 18px;
  color: #94a3b8;
}
.mock-e-rating {
  display: inline-block;
  background: #fff;
  color: #000;
  font-weight: 900;
  font-size: 0.72rem;
  padding: 1px 5px;
  border-radius: 3px;
}
.mock-stat-val {
  font-size: 0.78rem;
  color: #cbd5e1;
  font-weight: 600;
}
.mock-stat-val small {
  color: #94a3b8;
}
.mock-stat-divider {
  width: 1px;
  height: 28px;
  background: rgba(255, 255, 255, 0.12);
}

.mock-actions-wrap {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 18px;
}
.mock-install-btn {
  background: #1a73e8;
  color: #fff !important;
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.95rem;
  border: 2px solid #000;
  border-radius: 10px;
  padding: 12px 16px;
  box-shadow: 3px 3px 0 #000;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  transition: transform 0.1s ease;
}
.mock-install-btn:hover {
  background: #1557b0;
  transform: translateY(-2px);
}
.mock-secondary-btn {
  background: #1e293b;
  color: #f1f5f9 !important;
  font-family: var(--f-d);
  font-weight: 700;
  font-size: 0.88rem;
  border: 2px solid #000;
  border-radius: 10px;
  padding: 10px 14px;
  box-shadow: 2px 2px 0 #000;
  text-align: center;
  text-decoration: none;
}
.mock-secondary-btn:hover {
  background: #334155;
}

.mock-disclaimer-box {
  display: flex;
  gap: 10px;
  font-size: 0.78rem;
  color: #94a3b8;
  line-height: 1.4;
  background: rgba(0, 0, 0, 0.3);
  padding: 10px 12px;
  border-radius: 8px;
  margin-bottom: 16px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}
.mock-info-i {
  color: #38bdf8;
  font-weight: 800;
}
.mock-link {
  color: #38bdf8;
  text-decoration: underline;
}

.mock-footer-stickers {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  position: relative;
  padding-top: 8px;
}
.mock-stickers-left {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.store-badge {
  font-family: var(--f-d);
  font-size: 0.72rem;
  font-weight: 800;
  padding: 3px 8px;
  border-radius: 6px;
  border: 1.5px solid #000;
  display: inline-block;
}
.store-badge.green-badge {
  background: #059669;
  color: #fff;
}
.store-badge.dark-badge {
  background: #f8fafc;
  color: #0f172a;
}
.mock-peeking-mascot {
  position: relative;
  margin-bottom: -10px;
  margin-right: -4px;
}
.peeking-pilo-img {
  width: 52px;
  height: 52px;
  object-fit: contain;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
}

/* Pasos para entrar */
.access-steps-column {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.steps-box-hdr {
  margin-bottom: 6px;
}
.steps-title {
  font-family: var(--f-d);
  font-size: 1.4rem;
  font-weight: 800;
  margin: 6px 0 0;
  color: var(--title);
}
.access-steps-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.access-step-card {
  display: flex;
  gap: 14px;
  background: var(--bg-card);
  border: 2px solid var(--border-control);
  border-radius: 14px;
  padding: 14px 16px;
  box-shadow: 3px 3px 0 #000;
}
.step-badge-num {
  font-size: 1.5rem;
  line-height: 1;
  flex-shrink: 0;
}
.step-card-body {
  flex: 1;
  min-width: 0;
}
.step-card-title {
  font-family: var(--f-d);
  font-size: 1rem;
  font-weight: 800;
  margin: 0 0 4px;
  color: var(--title);
  line-height: 1.25;
}
.step-card-desc {
  font-size: 0.85rem;
  color: var(--muted);
  line-height: 1.4;
  margin: 0 0 8px;
}
.step-action-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.step-mini-cta {
  display: inline-block;
  font-family: var(--f-d);
  font-size: 0.78rem;
  font-weight: 800;
  padding: 5px 10px;
  border-radius: 6px;
  border: 1.5px solid #000;
  text-decoration: none;
  box-shadow: 2px 2px 0 #000;
  transition: transform 0.1s ease;
}
.step-mini-cta:hover {
  transform: translateY(-1px);
}
.step-mini-cta.canal-cta {
  background: #25d366;
  color: #000;
}
.step-mini-cta.testers-cta {
  background: #128c7e;
  color: #fff;
}

/* Advertencia Moodle */
.moodle-compatibility-warning {
  background: rgba(255, 184, 0, 0.08);
  border: 2px solid #ffb800;
  border-radius: 12px;
  padding: 12px 16px;
  box-shadow: 3px 3px 0 #000;
  margin-top: 4px;
}
.warning-tag {
  font-family: var(--f-d);
  font-size: 0.76rem;
  font-weight: 900;
  color: #ffb800;
  letter-spacing: 0.06em;
  margin-bottom: 4px;
}
.warning-text {
  font-size: 0.86rem;
  line-height: 1.4;
  color: var(--body);
  margin: 0;
}

/* 3. SECCIÓN: ¿POR QUÉ SOLO CON ACCESO? */
.why-access-wrap {
  border-top: 2px dashed rgba(255, 255, 255, 0.12);
  padding-top: 36px;
}
.why-access-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

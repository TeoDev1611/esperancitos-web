---
/**
 * DownloadCenter.astro
 * Sección de descarga: Android (Google Play) + iPhone (instalación desde Safari).
 * Todo lo que se promete aquí sale de docs/marketing/CATALOGO_FUNCIONES_APP_MARKETING.md.
 */
import QRCode from 'qrcode';
import { SITE } from '../config/site';

interface Props {
  M?: Record<string, string>;
}

const {
  M = {
    neutral: '/logos/mascota_neutro.svg',
    success: '/logos/mascota_aprobacion.svg',
  },
} = Astro.props;

const PLAY_URL = SITE.playStoreUrl;
const IOS_URL = SITE.iosPwaUrl;

// QR generados en build: útiles si la persona entra a la web desde una computadora.
const qrOptions = { type: 'svg' as const, margin: 1, errorCorrectionLevel: 'M' as const, color: { dark: '#080b11', light: '#ffffff' } };
const playQr = await QRCode.toString(PLAY_URL, qrOptions);
const iosQr = await QRCode.toString(IOS_URL, qrOptions);
---

<section id="acceso" class="dl-section" aria-labelledby="dl-title">
  <!-- Anclas antiguas (#descargar) siguen funcionando -->
  <span id="descargar" class="dl-anchor" aria-hidden="true"></span>

  <header class="dl-head">
    <span class="sticker-pill green font-mono">YA ESTÁ PARA TODOS</span>
    <h2 id="dl-title" class="dl-title">Descárgala gratis.<br /><span class="dl-title-accent">En Android y en iPhone.</span></h2>
    <p class="dl-lead">Sin anuncios, sin cuentas de Pilas y sin formularios. Elige tu teléfono y en un minuto estás adentro.</p>
  </header>

  <div class="dl-grid">
    <!-- ANDROID -->
    <article class="dl-card dl-android" aria-labelledby="dl-android-title">
      <div class="dl-card-top">
        <span class="dl-os-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M17.6 9.48l1.84-3.18a.38.38 0 00-.66-.38l-1.86 3.22A11.4 11.4 0 0012 8.1c-1.77 0-3.42.38-4.92 1.04L5.22 5.92a.38.38 0 10-.66.38L6.4 9.48A10.8 10.8 0 001 18h22a10.8 10.8 0 00-5.4-8.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z"/></svg>
        </span>
        <div>
          <h3 id="dl-android-title" class="dl-card-title">Android</h3>
          <p class="dl-card-sub">Google Play · Android {SITE.minAndroid} o superior</p>
        </div>
      </div>

      <a class="dl-store-btn" href={PLAY_URL} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
          <path fill="#00d2ff" d="M3.6 1.8l10.6 10.2L3.6 22.2c-.4-.2-.6-.6-.6-1.1V2.9c0-.5.2-.9.6-1.1z"/>
          <path fill="#00f076" d="M17.6 8.6l-3.4 3.4L3.6 1.8c.2-.1.5-.1.8.1l13.2 6.7z"/>
          <path fill="#ff3a44" d="M17.6 15.4L4.4 22.1c-.3.2-.6.2-.8.1l10.6-10.2 3.4 3.4z"/>
          <path fill="#ffd500" d="M21.2 12c0 .5-.3 1-.8 1.2l-2.8 1.4-3.4-3.4 3.4-3.4 2.8 1.4c.5.3.8.7.8 1.2z"/>
        </svg>
        <span class="dl-store-text">
          <small>Disponible en</small>
          <b>Google Play</b>
        </span>
      </a>

      <ul class="dl-perks" aria-label="Lo que trae Pilas! en Android">
        <li><span aria-hidden="true">⏰</span> Alarma de entregas que suena con el teléfono bloqueado</li>
        <li><span aria-hidden="true">🔔</span> Avisos de notas, tareas y mensajes en segundo plano</li>
        <li><span aria-hidden="true">🧩</span> Widgets en tu pantalla de inicio</li>
        <li><span aria-hidden="true">🔍</span> OCR: texto desde una foto</li>
      </ul>

      <div class="dl-qr-row">
        <div class="dl-qr" set:html={playQr} role="img" aria-label="Código QR para abrir Pilas! en Google Play"></div>
        <p class="dl-qr-hint">¿Estás en la compu? Escanea con tu celular y te lleva directo a la ficha de Google Play.</p>
      </div>
    </article>

    <!-- IPHONE -->
    <article class="dl-card dl-ios" aria-labelledby="dl-ios-title">
      <div class="dl-card-top">
        <span class="dl-os-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-4.2zM13.9 5c.7-.8 1.1-1.9 1-3-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.2-.6 2.9-1.4z"/></svg>
        </span>
        <div>
          <h3 id="dl-ios-title" class="dl-card-title">iPhone</h3>
          <p class="dl-card-sub">Se instala desde Safari · no está en el App Store</p>
        </div>
      </div>

      <a class="dl-ios-url" href={IOS_URL} target="_blank" rel="noopener noreferrer">
        <span class="dl-ios-url-label">Abre en Safari</span>
        <b class="font-mono">{SITE.iosPwaLabel}</b>
        <span class="btn-arrow" aria-hidden="true">➔</span>
      </a>

      <ol class="dl-steps">
        <li><b>Abre</b> {SITE.iosPwaLabel} en <b>Safari</b>.</li>
        <li>Toca <b>Compartir</b> <span class="dl-share-ico" aria-hidden="true">⬆︎</span> y luego <b>Agregar a pantalla de inicio</b>.</li>
        <li>Abre <b>Pilas!</b> desde el ícono. En la ESPE conecta Mi Campus y Banner con el <b>Puente Pilas</b>.</li>
      </ol>

      <div class="dl-qr-row">
        <div class="dl-qr" set:html={iosQr} role="img" aria-label="Código QR para abrir pilas-pwa.vercel.app en el iPhone"></div>
        <p class="dl-qr-hint">Escanea con la cámara del iPhone y ábrelo en Safari.</p>
      </div>
    </article>
  </div>

  <!-- Honestidad sobre iPhone: lo que cambia -->
  <div class="dl-ios-diff">
    <div class="dl-ios-diff-head">
      <img src={M.neutral} alt="" width="44" height="44" loading="lazy" />
      <div>
        <b>¿Qué cambia en iPhone?</b>
        <p>Casi nada: Moodle, horario, notas, amigos, Wrapped y herramientas funcionan igual. Esto es lo único distinto:</p>
      </div>
    </div>
    <ul class="dl-ios-diff-list">
      <li><b>Alarma de entregas</b><span>Tus entregas se exportan al <b>Calendario de iPhone</b>, que te avisa aunque Pilas esté cerrada.</span></li>
      <li><b>Avisos nuevos</b><span>Aparecen al abrir Pilas, y el ícono muestra el número de pendientes.</span></li>
      <li><b>Widgets</b><span>Los widgets del Calendario de iPhone muestran tus entregas.</span></li>
      <li><b>OCR</b><span>Por ahora solo está en Android.</span></li>
    </ul>
  </div>

  <p class="dl-moodle-note">
    <span class="badge b-info font-mono">MOODLE</span>
    Funciona con los Moodle que tienen habilitada la app móvil oficial por parte de la universidad.
  </p>
</section>

<style is:global>
.dl-section {
  position: relative;
  scroll-margin-top: 100px;
}
.dl-anchor {
  position: absolute;
  top: 0;
  width: 1px;
  height: 1px;
  overflow: hidden;
}
.dl-head {
  max-width: 44em;
  margin-bottom: 28px;
}
.dl-title {
  font-size: clamp(2rem, 4.4vw, 3.1rem);
  line-height: 1.08;
  letter-spacing: -0.035em;
}
.dl-title-accent {
  color: var(--accent);
}
.dl-lead {
  margin-top: 12px;
  color: var(--body);
  font-size: 1.05rem;
  line-height: 1.55;
}

.dl-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}
@media (max-width: 860px) {
  .dl-grid { grid-template-columns: 1fr; }
}

.dl-card {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: clamp(20px, 3vw, 28px);
  border-radius: 22px;
  background: rgba(17, 23, 35, 0.72);
  border: 1px solid var(--border);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 16px 40px -16px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  min-width: 0;
}
.dl-android { border-top: 3px solid var(--success); }
.dl-ios { border-top: 3px solid var(--cyan); }

.dl-card-top {
  display: flex;
  align-items: center;
  gap: 14px;
}
.dl-os-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border-control);
}
.dl-android .dl-os-icon { color: var(--success); }
.dl-ios .dl-os-icon { color: #e2e8f0; }
.dl-card-title {
  font-size: 1.5rem;
}
.dl-card-sub {
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: 2px;
}

/* Botón estilo insignia de tienda */
.dl-store-btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  align-self: flex-start;
  min-height: 60px;
  padding: 8px 22px 8px 16px;
  border-radius: 14px;
  background: #000;
  border: 1px solid rgba(255, 255, 255, 0.35);
  color: #fff;
  text-decoration: none;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), border-color 160ms ease, box-shadow 160ms ease;
}
.dl-store-btn:hover {
  transform: translateY(-2px);
  border-color: var(--success);
  box-shadow: 0 10px 28px -8px rgba(0, 255, 135, 0.35);
}
.dl-store-btn:focus-visible,
.dl-ios-url:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 3px;
}
.dl-store-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.dl-store-text small {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #cbd5e1;
}
.dl-store-text b {
  font-family: var(--f-d);
  font-size: 1.35rem;
  font-weight: 700;
}

.dl-ios-url {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px 12px;
  min-height: 60px;
  padding: 10px 18px;
  border-radius: 14px;
  background: rgba(0, 240, 255, 0.08);
  border: 1px solid rgba(0, 240, 255, 0.35);
  color: var(--title);
  text-decoration: none;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), background 160ms ease;
}
.dl-ios-url:hover {
  transform: translateY(-2px);
  background: rgba(0, 240, 255, 0.14);
}
.dl-ios-url-label {
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #8cffff;
  font-weight: 700;
}
.dl-ios-url b {
  font-size: 1.05rem;
  overflow-wrap: anywhere;
}
.dl-ios-url .btn-arrow {
  margin-left: auto;
  color: #8cffff;
}

.dl-perks,
.dl-steps {
  margin: 0;
  display: grid;
  gap: 10px;
  font-size: 0.95rem;
  line-height: 1.45;
}
.dl-perks {
  list-style: none;
  padding: 0;
}
.dl-perks li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.dl-steps {
  padding-left: 22px;
}
.dl-steps li::marker {
  color: #8cffff;
  font-weight: 800;
}
.dl-steps b,
.dl-perks b { color: var(--title); }
.dl-share-ico {
  display: inline-block;
  padding: 0 6px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.08);
  font-size: 0.85em;
}

.dl-qr-row {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
}
.dl-qr {
  width: 96px;
  height: 96px;
  flex-shrink: 0;
  padding: 6px;
  border-radius: 12px;
  background: #fff;
}
.dl-qr svg {
  display: block;
  width: 100%;
  height: 100%;
}
.dl-qr-hint {
  color: var(--muted);
  font-size: 0.86rem;
  line-height: 1.45;
}
/* En el celular el QR no sirve: se oculta para no ocupar espacio */
@media (max-width: 640px) {
  .dl-qr-row { display: none; }
}

.dl-ios-diff {
  margin-top: 18px;
  padding: clamp(18px, 3vw, 24px);
  border-radius: 20px;
  background: rgba(13, 18, 28, 0.7);
  border: 1px dashed var(--border-control);
}
.dl-ios-diff-head {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  margin-bottom: 16px;
}
.dl-ios-diff-head img { flex-shrink: 0; }
.dl-ios-diff-head b {
  font-family: var(--f-d);
  font-size: 1.15rem;
  color: var(--title);
}
.dl-ios-diff-head p {
  color: var(--body);
  font-size: 0.94rem;
  margin-top: 4px;
}
.dl-ios-diff-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}
@media (max-width: 960px) {
  .dl-ios-diff-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 520px) {
  .dl-ios-diff-list { grid-template-columns: 1fr; }
}
.dl-ios-diff-list li {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
}
.dl-ios-diff-list li > b {
  font-family: var(--f-d);
  color: var(--title);
  font-size: 0.98rem;
}
.dl-ios-diff-list span {
  font-size: 0.86rem;
  color: var(--body);
  line-height: 1.45;
}

.dl-moodle-note {
  margin-top: 16px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  color: var(--muted);
  font-size: 0.9rem;
}

@media (prefers-reduced-motion: reduce) {
  .dl-store-btn,
  .dl-ios-url { transition: none; }
  .dl-store-btn:hover,
  .dl-ios-url:hover { transform: none; }
}
</style>

</style>

<script>
  // Control de Tabs en la maqueta del teléfono
  const segBtns = document.querySelectorAll<HTMLButtonElement>(
    ".phone-segmented-control .seg-btn",
  );
  const layers = document.querySelectorAll<HTMLElement>(".screen-layer");

  const selectView = (btn: HTMLButtonElement, moveFocus = false) => {
    segBtns.forEach((b) => {
      b.classList.remove("active");
      b.setAttribute("aria-selected", "false");
    });
    layers.forEach((l) => l.classList.remove("active"));

    btn.classList.add("active");
    btn.setAttribute("aria-selected", "true");
    if (moveFocus) btn.focus();

    const targetView = btn.getAttribute("data-view");
    const targetLayer = document.getElementById(`layer-${targetView}`);
    if (targetLayer) {
      targetLayer.classList.add("active");
    }
  };

  segBtns.forEach((btn) => {
    btn.addEventListener("click", () => selectView(btn));

    // Navegación por teclado dentro del tablist
    btn.addEventListener("keydown", (event: KeyboardEvent) => {
      const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
      if (!keys.includes(event.key)) return;
      event.preventDefault();

      const list = Array.from(segBtns);
      const current = list.indexOf(btn);
      let next = current;

      if (event.key === "ArrowRight") next = (current + 1) % list.length;
      if (event.key === "ArrowLeft")
        next = (current - 1 + list.length) % list.length;
      if (event.key === "Home") next = 0;
      if (event.key === "End") next = list.length - 1;

      selectView(list[next], true);
    });
  });

  // El botón "Apoyar Proyecto" del héroe abre el modal global a través del
  // atributo data-open-support (ver SupportModal.astro). Antes había aquí un
  // listener propio que, junto al de Header.astro, llamaba a showModal() dos
  // veces y provocaba un InvalidStateError.

  // 3D Tilt Sutil en Desktop (Solo si no hay prefers-reduced-motion)
  const tiltTarget = document.getElementById("phone-tilt-target");
  const stage = document.getElementById("phone-stage");

  if (
    tiltTarget &&
    stage &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    window.matchMedia("(min-width: 960px)").matches
  ) {
    stage.addEventListener("mousemove", (e) => {
      const rect = stage.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // Inclinación máxima de solo 6 grados para suavidad estilo Apple
      const rotateX = ((y - centerY) / centerY) * -6;
      const rotateY = ((x - centerX) / centerX) * 6;

      tiltTarget.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale(1.01)`;
    });

    stage.addEventListener("mouseleave", () => {
      tiltTarget.style.transform =
        "perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)";
    });
  }

  // Animación del chip de minutos restantes dentro de la tarjeta de clase en curso
  const chip = document.getElementById("countdown-chip");
  function startChipCountdown() {
    if (!chip) return;
    const target = 119;
    let val = 125;
    chip.classList.add("is-ticking");

    const timer = setInterval(() => {
      val -= 1;
      if (val <= target) {
        val = target;
        clearInterval(timer);
        chip.classList.remove("is-ticking");
      }
      chip.textContent = `${val} MIN RESTANTES`;
    }, 150);
  }

  // Ejecución sincronizada o salto inmediato si el usuario prefiere reducción de movimiento
  const heroLiveCard = document.getElementById("hero-live-card");

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    if (chip) chip.textContent = "119 MIN RESTANTES";
    document.getElementById("hero-download-btn")?.classList.add("is-static");
    heroLiveCard?.classList.add("revealed");
  } else {
    setTimeout(startChipCountdown, 800);
    // La tarjeta de clase en curso escala de 0.96 a 1 en sincronía con su fundido
    setTimeout(() => heroLiveCard?.classList.add("revealed"), 460);
  }

  // 4. Animación Typewriter Ecuatoriana e Inclusiva (ñaño -> ñaña -> socio -> socia -> mijin -> mija -> panas)
  const heroRotatorWord = document.getElementById("hero-rotator-word");
  const appRotatorWord = document.getElementById("app-rotator-word");
  const ecuadorianWords = [
    "ñaño",
    "ñaña",
    "socio",
    "socia",
    "mijin",
    "mija",
    "panas",
  ];

  if (heroRotatorWord) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      heroRotatorWord.textContent = "ñañ@s";
      if (appRotatorWord) appRotatorWord.textContent = "ñañ@s";
    } else {
      let wordIdx = 0;
      let charIdx = ecuadorianWords[0].length;
      let isDeleting = false;

      const typeStep = () => {
        const currentTarget = ecuadorianWords[wordIdx];

        if (isDeleting) {
          charIdx--;
          const partial = currentTarget.substring(0, charIdx);
          heroRotatorWord.textContent = partial;
          if (appRotatorWord) appRotatorWord.textContent = partial;

          if (charIdx <= 0) {
            isDeleting = false;
            wordIdx = (wordIdx + 1) % ecuadorianWords.length;
            setTimeout(typeStep, 320);
            return;
          }
          setTimeout(typeStep, 60);
        } else {
          charIdx++;
          const partial = currentTarget.substring(0, charIdx);
          heroRotatorWord.textContent = partial;
          if (appRotatorWord) appRotatorWord.textContent = partial;

          if (charIdx >= currentTarget.length) {
            isDeleting = true;
            setTimeout(typeStep, 2100);
            return;
          }
          setTimeout(typeStep, 95);
        }
      };

      // Inicia después de 2.4s para que el usuario disfrute la vista inicial
      setTimeout(() => {
        isDeleting = true;
        typeStep();
      }, 2400);
    }
  }

  // 5. Manejo dinámico del contador de descargas (persistencia local + incremento al descargar)
  (function () {
    const heroCountEl = document.getElementById("hero-dl-count-val");
    const heroBadgeEl = document.getElementById("hero-dl-counter");
    const heroDlBtn = document.getElementById("hero-download-btn");
    const BASE_COUNT =
      parseInt(heroBadgeEl?.getAttribute("data-base-count") || "100", 10) ||
      100;
    const STORAGE_KEY = "pilas_app_dl_v1";

    function getDownloads() {
      try {
        const stored = parseInt(localStorage.getItem(STORAGE_KEY) || "", 10);
        return stored && stored >= BASE_COUNT ? stored : BASE_COUNT;
      } catch (e) {
        return BASE_COUNT;
      }
    }

    function formatNumber(num: number) {
      return "+" + num.toLocaleString();
    }

    function syncCounter(val: number) {
      const formatted = formatNumber(val);
      if (heroCountEl) heroCountEl.textContent = formatted;
      const secVal = document.getElementById("section-dl-count-val");
      if (secVal) secVal.textContent = formatted;
      const specVal = document.getElementById("spec-dl-count-val");
      if (specVal) specVal.textContent = formatted + " descargas";
    }

    const currentCount = getDownloads();
    syncCounter(currentCount);

    function onDownloadClick() {
      const next = getDownloads() + 1;
      try {
        localStorage.setItem(STORAGE_KEY, String(next));
      } catch (e) {}
      syncCounter(next);

      if (heroBadgeEl) {
        heroBadgeEl.classList.remove("celebrate");
        void heroBadgeEl.offsetWidth;
        heroBadgeEl.classList.add("celebrate");
      }

      window.dispatchEvent(
        new CustomEvent("pilas-download-registered", {
          detail: { count: next },
        }),
      );
    }

    if (heroDlBtn) {
      heroDlBtn.addEventListener("click", onDownloadClick);
    }

    window.addEventListener("pilas-download-registered", (e: Event) => {
      const custom = e as CustomEvent<{ count: number }>;
      if (custom.detail?.count) {
        syncCounter(custom.detail.count);
      }
    });
  })();
</script>

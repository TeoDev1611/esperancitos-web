---
// Hero.astro - Héroe Cinético Estilo Neo-Brutalista con Recreación Real de la App en HTML/CSS
import { SITE } from "../config/site";
import QRCode from "qrcode";

interface Props {
  mode?: "portal" | "espe" | "multi";
}

const { mode = "portal" } = Astro.props;

const heroSticker =
  mode === "espe"
    ? "🟢 100% NATIVO PARA LA ESPE · SANGOLQUÍ · LATACUNGA · STO. DOMINGO"
    : mode === "multi"
    ? "🟣 100% UNIVERSAL · CUALQUIER CAMPUS CON MOODLE EN ECUADOR"
    : "⚡ NATIVO PARA ANDROID · ESPE & MULTI-UNIVERSIDAD ECUADOR";

const heroHeadline1 =
  mode === "espe"
    ? "La app estudiantil que"
    : mode === "multi"
    ? "Tu universidad en el bolsillo:"
    : "La app estudiantil que";

const heroHeadline2 =
  mode === "espe"
    ? "la ESPE nunca te dio."
    : mode === "multi"
    ? "Moodle offline y cero estrés."
    : "tu universidad nunca te dio.";

const downloadQrSvg = await QRCode.toString(`${SITE.url}/#descargar`, {
  type: "svg",
  margin: 1,
  color: {
    dark: "#000000",
    light: "#FFFFFF",
  },
});
---

<section class="hero-section" id="hero-section">
  <!-- Malla de cuadrícula que se enciende en 0.0s -->
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-text-col">
      <!-- Switch Bar para páginas dedicadas /espe y /multi-u -->
      {mode === 'espe' && (
        <div class="hero-mode-switch-bar espe">
          <div class="switch-bar-left">
            <span class="switch-dot green"></span>
            <span>Versión ESPE activa</span>
          </div>
          <a href="/multi-u" class="switch-bar-link">
            ¿Estudias en otra U (UCE, EPN, PUCE...)? Ver versión Multi-U →
          </a>
        </div>
      )}

      {mode === 'multi' && (
        <div class="hero-mode-switch-bar multi">
          <div class="switch-bar-left">
            <span class="switch-dot fuchsia"></span>
            <span>Versión Multi-Universidad (Moodle Universal) activa</span>
          </div>
          <a href="/espe" class="switch-bar-link">
            ¿Estudias en la ESPE? Ver versión oficial ESPE →
          </a>
        </div>
      )}

      <!-- Radar Telemetría de Campus en Vivo (Iconic Student Real-time Vibe) -->
      <div class="hero-campus-radar" role="region" aria-label="Estado de campus universitarios en vivo">
        <div class="radar-tag">
          <span class="radar-live-dot" aria-hidden="true"></span>
          <span class="radar-tag-text">RADAR CAMPUS EC</span>
        </div>
        <div class="radar-ticker-window">
          <div class="radar-ticker-track">
            <span class="radar-item">📍 <strong>ESPE Sangolquí</strong>: Bloque G detectado · 0ms offline</span>
            <span class="radar-sep">/</span>
            <span class="radar-item">⚠️ <strong>UCE & EPN</strong>: Moodle 2MB activo · Compresor listo</span>
            <span class="radar-sep">/</span>
            <span class="radar-item">⏱️ <strong>Alerta 23:55</strong>: En guardia para tareas de medianoche</span>
            <span class="radar-sep">/</span>
            <span class="radar-item">📶 <strong>Modo Avión / Sin Saldo</strong>: 100% Funcional</span>
          </div>
        </div>
      </div>

      <!-- Badge de Proyecto Estudiantil con Animación Typewriter Ecuatoriana -->
      <div class="hero-badge-row">
        <div class="sticker-pill">{heroSticker}</div>
        <span
          class="badge-app neutral hero-rotator-pill"
          aria-label="¡Ponte pilas, ñaño, ñaña, socio, socia, mijin, mija!"
        >
          <span class="pulse-circle"></span>
          <span
            >¡Ponte pilas, <strong
              class="badge-rotator-word"
              id="hero-rotator-word">ñaño</strong
            ><span class="badge-rotator-cursor" aria-hidden="true">|</span
            >!</span
          >
        </span>
      </div>

      <!-- Titular Gigante Oficial ESPE & Multi-U -->
      <h1 class="hero-title hero-headline" id="hero-headline">
        <span class="hero-line hero-line-1">{heroHeadline1}</span>
        <span class="hero-line hero-line-2">
          {mode === "portal" ? (
            <><span class="text-fuchsia">tu universidad</span> nunca te dio.</>
          ) : mode === "espe" ? (
            <><span class="text-green" style="color: #00FF87;">la ESPE</span> nunca te dio.</>
          ) : (
            <><span class="text-fuchsia">Moodle offline</span> y cero estrés.</>
          )}
        </span>
      </h1>

      <!-- Párrafo Descriptivo Oficial -->
      <p class="hero-subtitle hero-description">
        {mode === "espe" ? (
          <>Diseñada a la medida de la <strong>Universidad de las Fuerzas Armadas ESPE</strong>. Resuelve tus aulas en Bloque G a las 6:58 AM, calcula el mítico 14.01 con la regla oficial de 42 puntos, proyecta 23 mallas curriculares y pasa torniquetes con tu carnet espemático 100% offline.</>
        ) : mode === "multi" ? (
          <>Conéctate en 1 segundo con tu código QR de Moodle. Diseñada para estudiantes de la <strong>UCE, EPN, PUCE, ESPOL, UTPL, UDLA</strong> y cualquier campus de Ecuador. Con compresor de PDF para el límite de 2MB-5MB, alarma despertador anti-23:55 y horario visual offline.</>
        ) : (
          <><strong>Pilas!</strong> conecta tu Moodle, tus horarios con aulas exactas, tu carnet digital y una suite de 13 herramientas offline en una app ultra rápida, privada y sin publicidad. Diseñada para la ESPE y lista para cualquier campus universitario con Moodle.</>
        )}
      </p>

      <!-- Botones de Acción Brutalistas y Mascota Interactiva (Easter Egg Vivo) -->
      <div class="hero-actions-wrapper">
        <div class="hero-actions-group">
          <!-- Botón 1: Descarga Directa APK v1.2.0 -->
          <a
            href={SITE.primaryApkPath}
            download
            class="btn-pilas-primary btn-hero-cta"
            id="hero-download-btn"
            aria-label={`Descargar Pilas! ${SITE.versionTag} para Android`}
          >
            <svg
              class="w-5 h-5 mr-2 hero-dl-icon"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              ></path>
            </svg>
            <div class="btn-cta-labels">
              <span class="cta-title">Descargar APK Android ({SITE.versionTag})</span>
              <span class="cta-subtitle">Gratis · 0 Anuncios · Sin servidores intermedios</span>
            </div>
            <span class="hero-version-tag">{SITE.versionTag}</span>
          </a>

          <!-- Botón 2: Google Play Store Beta -->
          <a
            href={SITE.playStoreBetaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-hero-beta"
            id="hero-beta-btn"
            aria-label="Unirse a la Beta cerrada de Google Play Store"
            title="Google exige 20 evaluadores por 14 días. ¡Inscríbete y ayúdanos a publicar en Play Store!"
          >
            <span class="beta-rocket-icon" aria-hidden="true">🚀</span>
            <div class="btn-cta-labels">
              <span class="cta-title">Beta Play Store</span>
              <span class="cta-subtitle">Meta 20 evaluadores · ¡Súmate!</span>
            </div>
            <span class="hero-beta-tag">BETA</span>
          </a>
        </div>

        <!-- Mascota Interactiva (Amigable y con reacciones interactivas orgánicas) -->
        <div
          class="hero-mascot-sticker interactive-mascot"
          id="hero-interactive-mascot"
          role="button"
          tabindex="0"
          aria-label="Pilo, mascota de Pilas"
        >
          <img
            src="/logos/icono_var1_sin_fondo.svg"
            alt="Pilo, mascota de Pilas!"
            class="mascot-img hero-mascot-img"
            id="hero-mascot-img-el"
            width="110"
            height="110"
          />
          <div class="hero-mascot-bubble" id="hero-mascot-bubble">
            <span id="mascot-bubble-text">¡Pilas ñaño, al día! ⚡</span>
          </div>
        </div>
      </div>

      <!-- Barra de Confianza y Estado Compacto (Despeja la vista y unifica datos) -->
      <div class="hero-trust-bar">
        <span class="trust-item"><span class="trust-dot green"></span> 100% Offline</span>
        <span class="trust-sep">·</span>
        <span class="trust-item">🔒 Cero Servidores</span>
        <span class="trust-sep">·</span>
        <span class="trust-item">📱 Android {SITE.minAndroid}+</span>
        <span class="trust-sep">·</span>
        <div class="trust-item hero-dl-counter-badge" id="hero-dl-counter" data-base-count={SITE.downloads.count} title="Descargas acumuladas">
          <span class="dl-counter-icon" aria-hidden="true">📥</span>
          <strong id="hero-dl-count-val">{SITE.downloads.formatted}</strong>
          <span class="dl-counter-lbl">descargas</span>
        </div>
      </div>

      <!-- Setup Portal: Pases de Supervivencia Universitaria (Credenciales Hápticas Neo-Brutalistas) -->
      {mode === 'portal' && (
        <div class="hero-boarding-terminal" id="selector-setup">
          <div class="terminal-topbar">
            <div class="terminal-leds" aria-hidden="true">
              <span class="led red"></span>
              <span class="led yellow"></span>
              <span class="led green"></span>
            </div>
            <span class="terminal-title">TERMINAL DE ACCESO · ELIGE TU PASE UNIVERSITARIO</span>
            <span class="terminal-status-tag">LISTO PARA ANDROID</span>
          </div>

          <div class="boarding-passes-grid">
            <!-- Pase 1: Credencial ESPE -->
            <a href="/espe" class="boarding-pass-card espe-pass" aria-label="Validar credencial para la ESPE">
              <div class="pass-notch notch-left" aria-hidden="true"></div>
              <div class="pass-notch notch-right" aria-hidden="true"></div>
              
              <!-- Tira Holográfica Tornasol -->
              <div class="pass-holo-foil espe-foil" aria-hidden="true">
                <span class="foil-glimmer"></span>
                <span class="foil-text">ESPE OFICIAL · MATRIZ & SEDES · 100% OFFLINE</span>
              </div>

              <div class="pass-body">
                <div class="pass-header">
                  <div class="pass-identity">
                    <span class="pass-tag espe-tag">PASE ESTUDIANTIL ESPE</span>
                    <strong class="pass-title">Universidad de las Fuerzas Armadas ESPE</strong>
                    <span class="pass-campuses">Sangolquí (Matriz) · Latacunga · Santo Domingo</span>
                  </div>
                  <!-- Sello Vintage Tilted -->
                  <div class="pass-stamp espe-stamp" aria-hidden="true">
                    <span>14.01</span>
                    <small>CERTIFICADO</small>
                  </div>
                </div>

                <div class="pass-specs-grid">
                  <div class="pass-spec">
                    <span class="spec-label">AULAS</span>
                    <strong class="spec-val">Bloque G & H</strong>
                  </div>
                  <div class="pass-spec">
                    <span class="spec-label">MALLAS</span>
                    <strong class="spec-val">23 Carreras</strong>
                  </div>
                  <div class="pass-spec">
                    <span class="spec-label">ESTATUTO</span>
                    <strong class="spec-val">42/60 Pts</strong>
                  </div>
                  <div class="pass-spec">
                    <span class="spec-label">ACCESO</span>
                    <strong class="spec-val">Espemático</strong>
                  </div>
                </div>

                <div class="pass-barcode-row">
                  <div class="fake-barcode green-bars" aria-hidden="true">
                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                  </div>
                  <span class="pass-serial">ESPE-OFFLINE-2026</span>
                </div>

                <div class="pass-action-bar">
                  <span class="pass-action-label">EMBARCAR EN MODO ESPE</span>
                  <span class="pass-action-arrow">→</span>
                </div>
              </div>
            </a>

            <!-- Pase 2: Pasaporte Multi-U -->
            <a href="/multi-u" class="boarding-pass-card multi-pass" aria-label="Activar pasaporte Multi-Universidad Ecuador">
              <div class="pass-notch notch-left" aria-hidden="true"></div>
              <div class="pass-notch notch-right" aria-hidden="true"></div>
              
              <!-- Tira Holográfica Tornasol -->
              <div class="pass-holo-foil multi-foil" aria-hidden="true">
                <span class="foil-glimmer"></span>
                <span class="foil-text">UNIVERSAL ECUADOR · MOODLE MOBILE QR · BYPASS 2MB</span>
              </div>

              <div class="pass-body">
                <div class="pass-header">
                  <div class="pass-identity">
                    <span class="pass-tag multi-tag">PASAPORTE UNIVERSAL</span>
                    <strong class="pass-title">Multi-Universidad Ecuador</strong>
                    <span class="pass-campuses">UCE · EPN · PUCE · ESPOL · UTPL · UDLA · UIDE...</span>
                  </div>
                  <!-- Sello Vintage Tilted -->
                  <div class="pass-stamp multi-stamp" aria-hidden="true">
                    <span>MOODLE</span>
                    <small>QR DIRECT</small>
                  </div>
                </div>

                <div class="pass-specs-grid">
                  <div class="pass-spec">
                    <span class="spec-label">LOGIN</span>
                    <strong class="spec-val">QR 1 Segundo</strong>
                  </div>
                  <div class="pass-spec">
                    <span class="spec-label">PDF MOODLE</span>
                    <strong class="spec-val">Bypass 2MB</strong>
                  </div>
                  <div class="pass-spec">
                    <span class="spec-label">ALERTA</span>
                    <strong class="spec-val">Anti-23:55</strong>
                  </div>
                  <div class="pass-spec">
                    <span class="spec-label">HORARIO</span>
                    <strong class="spec-val">Offline P2P</strong>
                  </div>
                </div>

                <div class="pass-barcode-row">
                  <div class="fake-barcode fuchsia-bars" aria-hidden="true">
                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                  </div>
                  <span class="pass-serial">MOODLE-UNIVERSAL-EC</span>
                </div>

                <div class="pass-action-bar">
                  <span class="pass-action-label">ACTIVAR MODO MULTI-U</span>
                  <span class="pass-action-arrow">→</span>
                </div>
              </div>
            </a>
          </div>
        </div>
      )}

      <!-- 4 Puntos Fuertes Esenciales en Grid 2x2 Limpio (Descongestiona y estructura) -->
      <div class="hero-features-chips grid-2x2">
        <div class="feature-chip" title="Cero servidores intermediarios (Zero-Backend). Conexión directa y cifrada">
          <div class="chip-icon-box green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <div class="chip-info">
            <strong>100% Privado (Zero-Backend)</strong>
            <span>Sin servidores intermedios ni rastreo</span>
          </div>
        </div>

        <div class="feature-chip" title="Consulta tu horario, carnet, malla y tareas sin gastar megas">
          <div class="chip-icon-box amber">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div class="chip-info">
            <strong>100% Offline-First</strong>
            <span>Horarios, aulas y carnet sin gastar datos</span>
          </div>
        </div>

        <div class="feature-chip" title="ESPE 3 campus + Modo Universal para Moodle en cualquier universidad">
          <div class="chip-icon-box fuchsia">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </div>
          <div class="chip-info">
            <strong>ESPE + Modo Multi-Universidad</strong>
            <span>Sedes Matriz/Lat/SD + UCE, EPN, PUCE, ESPOL</span>
          </div>
        </div>

        <div class="feature-chip" title="13 herramientas académicas offline sin publicidad">
          <div class="chip-icon-box blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <div class="chip-info">
            <strong>Suite de 13 Pilas Tools</strong>
            <span>PDFs, escáner, carátulas y calculadora</span>
          </div>
        </div>
      </div>

      <!-- Barra Comunitaria Minimalista -->
      <div class="hero-community-bar">
        <span class="comm-label">Comunidad y avisos:</span>
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="comm-link ig-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
          <span>@pilas_ec.app</span>
        </a>
        <a href={SITE.social.whatsappChannel} target="_blank" rel="noopener noreferrer" class="comm-link wa-link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Canal de WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- Columna Visual: Marco de Teléfono Limpio con Recreación Real de la App -->
    <div class="hero-device-col">
      <div class="hero-ambient-glow" aria-hidden="true"></div>
      <div class="phone-perspective-stage" id="phone-stage">
        <!-- Segmented Control de Vistas Rápidas con SVGs finos -->
        <div
          class="phone-segmented-control"
          role="tablist"
          aria-label="Vistas interactivas de la app"
        >
          <button
            class="seg-btn active"
            role="tab"
            aria-selected="true"
            data-view="home"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
              ></polygon>
            </svg>
            <span>En Vivo</span>
          </button>
          <button
            class="seg-btn"
            role="tab"
            aria-selected="false"
            data-view="malla"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span>Malla</span>
          </button>
          <button
            class="seg-btn"
            role="tab"
            aria-selected="false"
            data-view="horario"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Horario</span>
          </button>
        </div>

        <!-- Marco Físico de Teléfono Android con Bordes Brutalistas -->
        <div class="phone-chassis" id="phone-tilt-target">
          <!-- Altavoz y cámara frontal sutil -->
          <div class="phone-dynamic-island" aria-hidden="true">
            <div class="phone-camera-dot"></div>
          </div>

          <!-- Pantalla del Celular -->
          <div class="phone-screen-content">
            <!-- VISTA 1: UI REAL DE LA APP (Home Dashboard) -->
            <div class="screen-layer active" id="layer-home">
              <div class="app-ui-canvas">
                <!-- Barra superior de la app -->
                <div class="app-topbar">
                  <div class="user-greeting">
                    <span class="user-title"
                      >¡Pilas, <span id="app-rotator-word">ñaño</span>!</span
                    >
                    <span class="user-campus">Campus Sangolquí · 2026-1</span>
                  </div>
                  <div class="app-topbar-icons">
                    <span class="app-example-tag">EJEMPLO</span>
                    <span class="app-status-pill">SIN CONEXIÓN</span>
                  </div>
                </div>

                <!-- Tarjeta Emblemática: Clase en curso con barra de progreso -->
                <div class="app-live-class-card" id="hero-live-card">
                  <div class="card-time-row">
                    <div class="time-meta">
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="clock-icon"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span class="time-text">09:15 - 11:15</span>
                    </div>
                    <!-- Chip con cuenta regresiva -->
                    <span class="countdown-chip" id="countdown-chip"
                      >119 MIN RESTANTES</span
                    >
                  </div>


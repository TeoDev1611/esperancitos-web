  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(0, 255, 135, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 255, 135, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center center;
    opacity: 0;
    animation: grid-glow 1.2s var(--ease-apple) forwards;
    pointer-events: none;
  }

  @keyframes grid-glow {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 40px;
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Columna de Texto Centrada */
  .hero-text-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  /* Titular Gigante estilo Apple Centrado */
  .hero-headline {
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 900;
    line-height: 1.16;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-row {
    margin-bottom: 20px;
  }

  /* Fade de opacidad puro: no toca `transform`, así el `both` (que mantiene el
     fotograma final) no bloquea los :hover de estos elementos. */
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  html.js-anim .hero-badge-row {
    opacity: 0;
    animation: hero-fade 650ms var(--ease-apple) 60ms both;
  }

  .hero-line {
    display: block;
    opacity: 1;
    transform: none;
    filter: none;
  }

  html.js-anim .hero-line {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(6px);
    animation: text-reveal 700ms var(--ease-apple) forwards;
  }

  html.js-anim .hero-line-1 {
    animation-delay: 180ms;
  }
  html.js-anim .hero-line-2 {
    animation-delay: 340ms;
  }
  html.js-anim .hero-line-3 {
    animation-delay: 500ms;
  }

  @keyframes text-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Badge Typewriter Ecuatoriano */
  .badge-rotator-word {
    color: var(--accent-amber);
    font-weight: 700;
    display: inline-block;
  }

  .badge-rotator-cursor {
    color: var(--color-primary);
    font-weight: 300;
    margin-left: 1px;
    animation: cursor-blink 0.9s steps(2, start) infinite;
  }

  @keyframes cursor-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-rotator-cursor {
      display: none;
    }
  }

  .hero-independent-notice {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-tertiary);
    margin-top: 6px;
    margin-bottom: 28px;
    max-width: 580px;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-independent-notice .notice-inline-icon {
    color: var(--accent-amber);
    flex-shrink: 0;
    margin-top: 2px;
  }

  html.js-anim .hero-independent-notice {
    animation: hero-fade-up 700ms var(--ease-apple) 600ms both;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 30px;
    max-width: 680px;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  html.js-anim .hero-description {
    animation: hero-fade-up 700ms var(--ease-apple) 650ms both;
  }

  .hero-description strong {
    color: var(--text-primary);
  }

  /* Wrapper de Acciones y Mascota Centrados */
  .hero-actions-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 22px;
    position: relative;
    flex-wrap: wrap;
    width: 100%;
  }

  .hero-actions-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero-mascot-sticker.interactive-mascot {
    display: flex;
    align-items: center;
    gap: 10px;
    user-select: none;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-mascot-sticker.interactive-mascot:hover {
    transform: scale(1.06);
  }

  .hero-mascot-img {
    width: 82px;
    height: 82px;
    filter: drop-shadow(4px 4px 0px #000000);
    transition: transform 0.25s ease;
  }

  .hero-mascot-bubble {
    background: #ffe500;
    color: #000000;
    font-family: "Outfit", sans-serif;
    font-weight: 800;
    font-size: 0.78rem;
    padding: 6px 12px;
    border: 2px solid #000000;
    border-radius: 10px;
    box-shadow: 2px 2px 0px #000000;
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: left;
    max-width: 210px;
    white-space: normal;
  }

  .mascot-touch-hint {
    font-size: 0.64rem;
    color: #475569;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mascot-wobble {
    animation: mascotWobble 0.4s ease;
  }

  @keyframes mascotWobble {
    0% { transform: scale(1); }
    25% { transform: scale(1.18) rotate(-10deg); }
    50% { transform: scale(1.12) rotate(10deg); }
    75% { transform: scale(1.16) rotate(-6deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  .mascot-spin {
    animation: mascotSpin 0.75s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes mascotSpin {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.25); }
    100% { transform: rotate(360deg) scale(1); }
  }

  .mascot-celebrate {
    animation: mascotCelebrate 0.8s ease;
  }

  @keyframes mascotCelebrate {
    0%, 100% { transform: translateY(0) scale(1); }
    25% { transform: translateY(-16px) scale(1.2); }
    50% { transform: translateY(0) scale(1.08); }
    75% { transform: translateY(-8px) scale(1.14); }
  }

  .hero-version-tag {
    background: #000000;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 999px;
    margin-left: 6px;
  }

  /* Badge Contador de Descargas Chiquito */
  .hero-dl-counter-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #11151f;
    border: 1.5px solid #283042;
    border-radius: var(--radius-pill, 999px);
    padding: 6px 14px;
    font-size: 0.78rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-secondary, #c4cad4);
    box-shadow: 2px 2px 0px #000000;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
    user-select: none;
    cursor: default;
  }

  .hero-dl-counter-badge:hover {
    border-color: var(--color-success, #00ff87);
    transform: translateY(-1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .dl-live-dot {
    width: 7px;
    height: 7px;
    background: var(--color-success, #00ff87);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(0, 255, 135, 0.7);
    animation: livePulse 2s infinite ease-in-out;
    flex-shrink: 0;
  }

  @keyframes livePulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.3);
      opacity: 1;
    }
  }

  .dl-counter-icon {
    font-size: 0.82rem;
  }

  .dl-counter-num {
    font-weight: 800;
    color: var(--color-success, #00ff87);
    font-size: 0.88rem;
  }

  .dl-counter-text {
    font-size: 0.74rem;
    color: var(--text-tertiary, #8f9cae);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero-dl-counter-badge.celebrate {
    animation: counterPop 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border-color: var(--color-primary, #ff3fa4);
  }

  @keyframes counterPop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1);
    }
  }

  html.js-anim .hero-actions-group {
    animation: hero-fade-up 750ms var(--ease-spring) 800ms both;
  }

  /* Callout de Canal de WhatsApp en el Hero */
  .hero-channel-callout {
    display: flex;
    justify-content: center;
    margin-bottom: 22px;
    width: 100%;
  }

  .channel-callout-inner {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    background: rgba(37, 211, 102, 0.08);
    border: 1.5px solid rgba(37, 211, 102, 0.4);
    border-radius: var(--radius-pill);
    box-shadow: 2px 2px 0px #064e3b;
    flex-wrap: wrap;
    justify-content: center;
    transition:
      transform 200ms var(--ease-spring),
      border-color 200ms ease;
  }

  .channel-callout-inner:hover {
    border-color: #25d366;
    transform: translateY(-1px);
  }

  .channel-callout-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #000000;
    color: #25d366;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid rgba(37, 211, 102, 0.3);
    letter-spacing: 0.04em;
  }

  .channel-dot-pulse {
    width: 6px;
    height: 6px;
    background: #25d366;
    border-radius: 50%;
    animation: channelPulse 2s infinite ease-in-out;
  }

  @keyframes channelPulse {
    0%,
    100% {
      opacity: 0.6;
      box-shadow: 0 0 2px #25d366;
    }
    50% {
      opacity: 1;
      box-shadow: 0 0 8px #25d366;
    }
  }

  .channel-callout-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  .channel-callout-text strong {
    color: #faf7f7;
  }

  .btn-channel-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: #25d366;
    color: #000000;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 900;
    border: 1.5px solid #000000;
    border-radius: var(--radius-pill);
    box-shadow: 2px 2px 0px #000000;
    text-decoration: none;
    transition:
      transform 150ms var(--ease-apple),
      background-color 150ms ease;
    white-space: nowrap;
  }

  .btn-channel-pill:hover {
    background: #2bf075;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .btn-channel-ig {
    background: linear-gradient(135deg, #E1306C 0%, #C13584 100%);
    color: #FFFFFF;
    box-shadow: 2px 2px 0px #000000;
  }

  .btn-channel-ig:hover {
    background: linear-gradient(135deg, #FD1D1D 0%, #E1306C 100%);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  @media (max-width: 640px) {
    .channel-callout-inner {
      border-radius: var(--radius-md);
      padding: 12px 14px;
      text-align: center;
      gap: 10px;
    }
    .btn-channel-pill {
      width: 100%;
      justify-content: center;
      padding: 8px 12px;
    }
  }

  .btn-hero-cta {
    padding: 13px 26px;
    gap: 14px;
    background-color: var(--color-primary);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    position: relative;
  }

  .btn-hero-cta:hover {
    background-color: var(--color-primary-hover);
    color: #ffffff;
  }

  .btn-hero-secondary {
    padding: 14px 22px;
  }

  .btn-hero-cta .hero-download-icon {
    transition: transform 220ms var(--ease-spring);
  }

  .btn-hero-cta:hover .hero-download-icon {
    transform: translateY(3px);
  }

  @keyframes download-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        var(--shadow-hard),
        0 0 16px rgba(0, 255, 135, 0.22);
    }
    50% {
      transform: scale(1.025);
      box-shadow:
        6px 6px 0px #000000,
        0 0 24px rgba(0, 255, 135, 0.4);
    }
  }

  /* El pulso infinito controla el transform, así que hay que cederle el paso
     al hover/active/focus: si no, el botón principal "ignora" el puntero. */
  .btn-hero-cta:hover,
  .btn-hero-cta:focus-visible,
  .btn-hero-cta:active,
  .btn-hero-cta.is-static {
    animation: none;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .btn-cta-labels {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }

  .cta-title {
    font-size: 1.05rem;
    font-weight: 900;
  }

  .cta-subtitle {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    opacity: 0.88;
  }

  .btn-hero-support {
    padding: 14px 22px;
    font-size: 0.92rem;
  }

  .btn-hero-support svg {
    transition: transform 220ms var(--ease-spring);
  }

  .btn-hero-support:hover svg {
    transform: scale(1.15);
  }

  /* Barra de Confianza Compacta */
  .hero-trust-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    background: #141722;
    border: 1.5px solid #283042;
    border-radius: var(--radius-pill, 999px);
    padding: 6px 16px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary, #c4cad4);
    margin: 8px auto 20px auto;
    box-shadow: 2px 2px 0px #000000;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .trust-dot.green {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00FF87;
    box-shadow: 0 0 6px rgba(0, 255, 135, 0.7);
    animation: livePulse 2s infinite ease-in-out;
  }
  .trust-sep {
    color: #475569;
  }

  /* Grid 2x2 Descongestionado */
  .hero-features-chips.grid-2x2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding-top: 16px;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }
  @media (max-width: 640px) {
    .hero-features-chips.grid-2x2 {
      grid-template-columns: 1fr;
    }
  }

  html.js-anim .hero-features-chips .feature-chip {
    opacity: 0;
    animation: hero-fade 560ms var(--ease-apple) both;
  }

  html.js-anim .hero-features-chips .feature-chip:nth-child(1) {
    animation-delay: 920ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(2) {
    animation-delay: 1000ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(3) {
    animation-delay: 1080ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(4) {
    animation-delay: 1160ms;
  }

  .feature-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-md);
    box-shadow: 2px 2px 0px #000000;
    transition:
      transform 220ms var(--ease-spring),
      box-shadow 220ms var(--ease-apple),
      border-color 220ms ease;
  }

  .feature-chip:hover {
    transform: translateY(-3px);
    border-color: var(--accent-primary);
    box-shadow:
      3px 3px 0px rgba(0, 255, 135, 0.4),
      0 6px 16px rgba(0, 0, 0, 0.4);
  }

  .chip-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1.5px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 2px 2px 0px #000000;
  }
  .chip-icon-box.green { background: #00FF87; color: #000000; }
  .chip-icon-box.amber { background: #FFD700; color: #000000; }
  .chip-icon-box.fuchsia { background: #FF3FA4; color: #000000; }
  .chip-icon-box.blue { background: #38BDF8; color: #000000; }

  .chip-info {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .chip-info strong {
    font-size: 0.88rem;
    color: var(--text-primary);
    font-weight: 800;
  }

  .chip-info span {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  /* Barra Comunitaria Minimalista */
  .hero-community-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }
  .comm-label {
    font-weight: 600;
  }
  .comm-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #F8FAFC;
    text-decoration: none;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }
  .comm-link:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
  }
  .comm-link.ig-link:hover {
    color: #FF3FA4;
    border-color: #FF3FA4;
  }
  .comm-link.wa-link:hover {
    color: #00FF87;
    border-color: #00FF87;
  }

  /* Columna Visual / Teléfono Centrado */
  .hero-device-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }

  .hero-ambient-glow {
    position: absolute;
    width: 380px;
    height: 380px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(0, 255, 135, 0.15) 0%,
      rgba(255, 219, 121, 0.06) 45%,
      transparent 70%
    );
    filter: blur(45px);
    pointer-events: none;
    z-index: 1;
    animation: ambient-breathe 7s ease-in-out infinite alternate;
  }

  @keyframes ambient-breathe {
    0% {
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0.6;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 1;
    }
  }

  .phone-perspective-stage {
    position: relative;
    width: 320px;
    max-width: 100%;
    perspective: 1200px;
    z-index: 2;
  }

  html.js-anim .phone-perspective-stage {
    animation: stage-entrance 850ms var(--ease-spring) 280ms both;
  }

  @keyframes stage-entrance {
    0% {
      opacity: 0;
      transform: translateY(35px) scale(0.94);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Segmented control para alternar vista */
  .phone-segmented-control {
    display: flex;
    background: var(--bg-surface);
    border: 2px solid var(--border-bold);
    border-radius: var(--radius-md);
    padding: 4px;
    box-shadow: var(--shadow-hard-sm);
    margin-bottom: 16px;
    gap: 4px;
  }

  .seg-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 7px 4px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 180ms ease;
  }

  .seg-btn svg {
    flex-shrink: 0;
    transition: transform 180ms var(--ease-spring);
  }

  .seg-btn:hover:not(.active) svg {
    transform: scale(1.15);
  }

  .seg-btn:hover:not(.active) {
    color: var(--text-primary);
  }

  .seg-btn.active {
    background: var(--accent-primary);
    color: var(--on-primary);
    box-shadow: 2px 2px 0px #000000;
  }

  /* Chasis del teléfono */
  .phone-chassis {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 18.5;
    background: #000000;
    border: 9px solid #161a23;
    border-radius: 40px;
    box-shadow:
      0 25px 60px -15px rgba(0, 0, 0, 0.9),
      6px 6px 0px #000000,
      0 0 0 2px var(--accent-primary);
    overflow: hidden;
    transition:
      transform 180ms var(--ease-apple),
      box-shadow 180ms ease;
    transform-style: preserve-3d;
  }

  .phone-dynamic-island {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 18px;
    background: #000000;
    border-radius: 20px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 12px;
  }

  .phone-camera-dot {
    width: 6px;
    height: 6px;
    background: #111a24;
    border-radius: 50%;
    border: 1px solid #1f2e3d;
  }

  .phone-screen-content {
    width: 100%;
    height: 100%;
    position: relative;
    background: var(--bg-primary);
  }

  .screen-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-apple);
    overflow: hidden;
  }

  .screen-layer.active {
    opacity: 1;
    pointer-events: auto;
  }

  .screen-layer-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* El <picture> debe llenar la capa para que la imagen conserve el encuadre */
  .screen-layer picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ==========================================================================
     RECREACIÓN EXACTA DE LA APP EN HTML/CSS (.app-ui-canvas)
     ========================================================================== */
  .app-ui-canvas {
    width: 100%;
    height: 100%;
    padding: 34px 12px 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-primary);
    box-sizing: border-box;
  }

  .app-topbar {
    display: flex;

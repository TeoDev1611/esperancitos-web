---
// Hero.astro - Héroe Cinético Estilo Apple con Recreación Real de la App en HTML/CSS
import { SITE } from "../config/site";
---

<section class="hero-section" id="hero-section">
  <!-- Malla de cuadrícula que se enciende en 0.0s -->
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-text-col">
      <!-- Badge de Proyecto Estudiantil con Animación Typewriter Ecuatoriana -->
      <div class="hero-badge-row">
        <div class="sticker-pill">⚡ ESPE — HECHO POR ESTUDIANTES</div>
        <span
          class="badge-app neutral hero-rotator-pill"
          aria-label="¡Ponte pilas  , ñaño, ñaña, socio, socia, mijin, mija!"
        >
          <span class="pulse-circle"></span>
          <span
            >¡Ponte pilas, <strong
              class="badge-rotator-word"
              id="hero-rotator-word">ñaño</strong
            ><span class="badge-rotator-cursor" aria-hidden="true">|</span
            >!</span
          >
        </span>
      </div>

      <!-- Titular Gigante Oficial ESPE -->
      <h1 class="hero-title hero-headline" id="hero-headline">
        <span class="hero-line hero-line-1"
          >Todo tu semestre universitario bajo control.</span
        >
        <span class="hero-line hero-line-2"
          ><span class="text-fuchsia">Rápido, privado</span> y sin internet.</span
        >
      </h1>

      <!-- Párrafo Descriptivo Oficial -->
      <p class="hero-subtitle hero-description">
        La aplicación académica definitiva para estudiantes de la <strong
          >Universidad de las Fuerzas Armadas ESPE</strong
        >. Horario de clases de Banner, tareas y chat de Moodle con alarmas,
        calculadora de parciales ESPE, malla curricular interactiva, carnet
        digital y widgets de pantalla de inicio: tus credenciales nunca salen de
        tu teléfono. Disponible <strong
          >100% gratis para todos los estudiantes</strong
        >.
      </p>

      <!-- Botones de Acción Brutalistas y Mascota Sticker -->
      <div class="hero-actions-wrapper">
        <div class="hero-actions-group">
          <a
            href={SITE.primaryApkPath}
            download
            class="btn-pilas-primary btn-hero-cta"
            id="hero-download-btn"
            aria-label={`Descargar Pilas! ${SITE.versionTag} para Android`}
          >
            <svg
              class="w-5 h-5 mr-2 hero-dl-icon"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              ></path>
            </svg>
            <div class="btn-cta-labels">
              <span class="cta-title"
                >Descargar Pilas! {SITE.versionTag} (APK Gratis)</span
              >
              <span class="cta-subtitle"
                >Gratis · {SITE.fileSize} · Android {SITE.minAndroid}+</span
              >
            </div>
            <span class="hero-version-tag">{SITE.versionTag}</span>
          </a>

          <a href="/#descargar" class="btn-pilas-secondary btn-hero-secondary">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
              ></polygon>
            </svg>
            <span>Ver Novedades y Guía de Instalación</span>
          </a>

          <!-- Contador chiquito de descargas oficial -->
          <div
            class="hero-dl-counter-badge"
            id="hero-dl-counter"
            data-base-count={SITE.downloads.baseCount}
            title="Descargas acumuladas en la comunidad ESPE"
          >
            <span class="dl-live-dot" aria-hidden="true"></span>
            <span class="dl-counter-icon" aria-hidden="true">📥</span>
            <span class="dl-counter-num" id="hero-dl-count-val"
              >{SITE.downloads.formatted}</span
            >
            <span class="dl-counter-text">descargas ESPE</span>
          </div>
        </div>

        <!-- Mascota Variación 1 (Neutro / Enérgico / Bienvenida) -->
        <div class="hero-mascot-sticker" aria-hidden="true">
          <img
            src="/logos/icono_var1_sin_fondo.svg"
            alt="Pilas Mascota Bienvenida"
            class="mascot-img hero-mascot-img"
            width="130"
            height="130"
          />
          <div class="hero-mascot-bubble">
            <span>¡Pilas ñaño, al día! ⚡</span>
          </div>
        </div>
      </div>

      <!-- Invitación al Canal de WhatsApp para Noticias, Actualizaciones y Comunicados -->
      <div
        class="hero-channel-callout"
        role="region"
        aria-label="Canal oficial de WhatsApp de Pilas!"
      >
        <div class="channel-callout-inner">
          <span class="channel-callout-badge">
            <span class="channel-dot-pulse" aria-hidden="true"></span>
            CANAL DE WHATSAPP
          </span>
          <span class="channel-callout-text">
            Aparte de descargártela, <strong
              >únete al canal oficial de Pilas!</strong
            > para noticias, actualizaciones y comunicados:
          </span>
          <a
            href={SITE.social.whatsappChannel}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-channel-pill"
            aria-label="Unirse al canal oficial de WhatsApp de Pilas!"
            title="Abre el canal de WhatsApp de Pilas!"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
              ></path>
            </svg>
            <span>Unirme al Canal →</span>
          </a>
        </div>
      </div>

      <!-- Aviso de Proyecto Independiente Discreto -->
      <div class="hero-independent-notice" role="note">
        <svg
          class="notice-inline-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span
          >Proyecto estudiantil independiente · Cero servidores intermedios</span
        >
      </div>

      <!-- Nota de compatibilidad y modelo -->
      <p
        class="hero-apk-note"
        style="margin-top: 10px; margin-bottom: 14px; font-size: 0.78rem; color: var(--text-tertiary); font-weight: 500;"
      >
        *Compatible con Android 8.0 o superior, tablets y iPhone/iPad. 100%
        gratis para estudiantes de la ESPE, sin publicidad ni intermediarios
        (código privado).*
      </p>

      <!-- Fila Compacta de Chips de Confianza (6 Puntos Fuertes Oficiales) -->
      <div class="hero-features-chips">
        <div
          class="feature-chip"
          title="Cero servidores intermediarios (Zero-Backend). Conexión directa y cifrada a Banner y Moodle"
        >
          <svg
            class="chip-svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <div class="chip-info">
            <strong>100% Privado y Seguro</strong>
            <span>Zero-Backend · Conexión directa</span>
          </div>
        </div>

        <div
          class="feature-chip"
          title="Consulta tu horario, carnet, malla y tareas en el aula o garita sin gastar megas"
        >
          <svg
            class="chip-svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <div class="chip-info">
            <strong>Sin conexión (Offline-First)</strong>
            <span>Horario, carnet y malla sin megas</span>
          </div>
        </div>

        <div
          class="feature-chip"
          title="Sin publicidad, sin muros de pago ni suscripciones (software de código privado, no es open source)"
        >
          <svg
            class="chip-svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
            ></path>
          </svg>
          <div class="chip-info">
            <strong>100% Gratis Estudiantes</strong>
            <span>Sin anuncios · Código privado</span>
          </div>
        </div>

        <div
          class="feature-chip"
          title="3 temas oscuros calibrados y 3 colores de acento oficiales (Fucsia, Carmesí y Verde Esmeralda)"
        >
          <svg
            class="chip-svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a10 10 0 0 1 0 20z"></path>
          </svg>
          <div class="chip-info">
            <strong>Diseño Neo-Brutalista</strong>
            <span>3 temas oscuros · 3 acentos ESPE</span>
          </div>
        </div>

        <div
          class="feature-chip"
          title="Revisa tu próxima clase y tareas urgentes sin abrir la app en Android e iOS"
        >
          <svg
            class="chip-svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M3 9h18M9 21V9"></path>
          </svg>
          <div class="chip-info">
            <strong>Widgets Nativos</strong>
            <span>Android & iOS · Pantalla de inicio</span>
          </div>
        </div>

        <div
          class="feature-chip"
          title="Entiende el sistema de parciales de 20 puntos, aulas de los campus y mallas de más de 20 carreras"
        >
          <svg
            class="chip-svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <div class="chip-info">
            <strong>Específico para la ESPE</strong>
            <span>Parciales 20 pts · Aulas · +20 Mallas</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Visual: Marco de Teléfono Limpio con Recreación Real de la App -->
    <div class="hero-device-col">
      <div class="hero-ambient-glow" aria-hidden="true"></div>
      <div class="phone-perspective-stage" id="phone-stage">
        <!-- Segmented Control de Vistas Rápidas con SVGs finos -->
        <div
          class="phone-segmented-control"
          role="tablist"
          aria-label="Vistas interactivas de la app"
        >
          <button
            class="seg-btn active"
            role="tab"
            aria-selected="true"
            data-view="home"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
              ></polygon>
            </svg>
            <span>En Vivo</span>
          </button>
          <button
            class="seg-btn"
            role="tab"
            aria-selected="false"
            data-view="malla"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span>Malla</span>
          </button>
          <button
            class="seg-btn"
            role="tab"
            aria-selected="false"
            data-view="horario"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Horario</span>
          </button>
        </div>

        <!-- Marco Físico de Teléfono Android con Bordes Brutalistas -->
        <div class="phone-chassis" id="phone-tilt-target">
          <!-- Altavoz y cámara frontal sutil -->
          <div class="phone-dynamic-island" aria-hidden="true">
            <div class="phone-camera-dot"></div>
          </div>

          <!-- Pantalla del Celular -->
          <div class="phone-screen-content">
            <!-- VISTA 1: UI REAL DE LA APP (Home Dashboard) -->
            <div class="screen-layer active" id="layer-home">
              <div class="app-ui-canvas">
                <!-- Barra superior de la app -->
                <div class="app-topbar">
                  <div class="user-greeting">
                    <span class="user-title"
                      >¡Pilas, <span id="app-rotator-word">ñaño</span>!</span
                    >
                    <span class="user-campus">Campus Sangolquí · 2026-1</span>
                  </div>
                  <div class="app-topbar-icons">
                    <span class="app-example-tag">EJEMPLO</span>
                    <span class="app-status-pill">SIN CONEXIÓN</span>
                  </div>
                </div>

                <!-- Tarjeta Emblemática: Clase en curso con barra de progreso -->
                <div class="app-live-class-card" id="hero-live-card">
                  <div class="card-time-row">
                    <div class="time-meta">
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="clock-icon"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span class="time-text">09:15 - 11:15</span>
                    </div>
                    <!-- Chip con cuenta regresiva -->
                    <span class="countdown-chip" id="countdown-chip"
                      >119 MIN RESTANTES</span
                    >
                  </div>

                  <!-- Barra de progreso de clase en curso -->
                  <div class="class-progress-track">
                    <div class="class-progress-bar" id="hero-class-bar"></div>
                  </div>

                  <div class="class-subject-info">
                    <h3 class="subject-title">TERMODINÁMICA I</h3>
                    <span class="subject-nrc">NRC: 14205</span>
                  </div>

                  <div class="class-location-row">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="pin-icon"
                      aria-hidden="true"
                    >
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                      ></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span class="location-text"
                      >Aula G-201 · Bloque G (Mecánica)</span
                    >
                  </div>

                  <div class="class-card-actions">
                    <span class="mini-btn-view">Ver aula</span>
                    <span class="mini-btn-join">Unirse a clase</span>
                  </div>
                </div>

                <!-- Grid de Métricas de la App: PROMEDIO y TAREAS -->
                <div class="app-metrics-grid">
                  <div class="app-metric-box metric-promedio">
                    <span class="metric-label">PROMEDIO</span>
                    <div class="metric-value-row">
                      <span class="metric-num">17.85</span>
                      <span class="metric-scale">/20</span>
                    </div>
                    <span class="metric-status">Tu promedio general</span>
                  </div>

                  <div class="app-metric-box metric-tareas">
                    <span class="metric-label">TAREAS</span>
                    <div class="metric-value-row">
                      <span class="metric-num">3</span>
                      <span class="metric-unit">activas</span>
                    </div>
                    <span class="metric-status">Próxima entrega hoy</span>
                  </div>
                </div>

                <!-- Bottom Navigation Bar de la App con SVGs finos -->
                <div class="app-bottom-nav">
                  <div class="bottom-nav-item active">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                      ></path>
                      <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>INICIO</span>
                  </div>
                  <div class="bottom-nav-item">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2"
                      ></rect>
                      <line x1="16" x2="16" y1="2" y2="6"></line>
                      <line x1="8" x2="8" y1="2" y2="6"></line>
                      <line x1="3" x2="21" y1="10" y2="10"></line>
                    </svg>
                    <span>HORARIO</span>
                  </div>
                  <div class="bottom-nav-item">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m9 11 3 3L22 4"></path>
                      <path
                        d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
                      ></path>
                    </svg>
                    <span>TAREAS</span>
                  </div>
                  <div class="bottom-nav-item">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path
                        d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                      ></path>
                    </svg>
                    <span>MENSAJES</span>
                  </div>
                  <div class="bottom-nav-item">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path
                        d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"
                      ></path>
                      <path d="M6 6h10"></path>
                      <path d="M6 10h10"></path>
                    </svg>
                    <span>MALLA</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- VISTA 2: Captura Real Malla Curricular -->
            <div class="screen-layer" id="layer-malla">
              <picture>
                <source srcset="/images/mockup-malla.webp" type="image/webp" />
                <img
                  src="/images/mockup-malla.jpg"
                  alt="Malla curricular de la carrera con materias aprobadas, en curso y pendientes en Pilas!"
                  class="screen-layer-img"
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="1459"
                />
              </picture>
            </div>

            <!-- VISTA 3: Captura Real Horario Semanal -->
            <div class="screen-layer" id="layer-horario">
              <picture>
                <source
                  srcset="/images/mockup-horario.webp"
                  type="image/webp"
                />
                <img
                  src="/images/mockup-horario.jpg"
                  alt="Horario semanal con el aula, el bloque y el docente de cada clase en Pilas!"
                  class="screen-layer-img"
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="1459"
                />
              </picture>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 70px 0 90px 0;
    overflow: hidden;
    min-height: calc(100vh - 110px);
    min-height: calc(100dvh - 110px);
    display: flex;
    align-items: center;
  }

  /* Cuadrícula sutil que se enciende progresivamente */
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(0, 255, 135, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 255, 135, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center center;
    opacity: 0;
    animation: grid-glow 1.2s var(--ease-apple) forwards;
    pointer-events: none;
  }

  @keyframes grid-glow {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 40px;
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Columna de Texto Centrada */
  .hero-text-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  /* Titular Gigante estilo Apple Centrado */
  .hero-headline {
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 900;
    line-height: 1.16;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-row {
    margin-bottom: 20px;
  }

  /* Fade de opacidad puro: no toca `transform`, así el `both` (que mantiene el
     fotograma final) no bloquea los :hover de estos elementos. */
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  html.js-anim .hero-badge-row {
    opacity: 0;
    animation: hero-fade 650ms var(--ease-apple) 60ms both;
  }

  .hero-line {
    display: block;
    opacity: 1;
    transform: none;
    filter: none;
  }

  html.js-anim .hero-line {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(6px);
    animation: text-reveal 700ms var(--ease-apple) forwards;
  }

  html.js-anim .hero-line-1 {
    animation-delay: 180ms;
  }
  html.js-anim .hero-line-2 {
    animation-delay: 340ms;
  }
  html.js-anim .hero-line-3 {
    animation-delay: 500ms;
  }

  @keyframes text-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Badge Typewriter Ecuatoriano */
  .badge-rotator-word {
    color: var(--accent-amber);
    font-weight: 700;
    display: inline-block;
  }

  .badge-rotator-cursor {
    color: var(--color-primary);
    font-weight: 300;
    margin-left: 1px;
    animation: cursor-blink 0.9s steps(2, start) infinite;
  }

  @keyframes cursor-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-rotator-cursor {
      display: none;
    }
  }

  .hero-independent-notice {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-tertiary);
    margin-top: 6px;
    margin-bottom: 28px;
    max-width: 580px;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-independent-notice .notice-inline-icon {
    color: var(--accent-amber);
    flex-shrink: 0;
    margin-top: 2px;
  }

  html.js-anim .hero-independent-notice {
    animation: hero-fade-up 700ms var(--ease-apple) 600ms both;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 30px;
    max-width: 680px;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  html.js-anim .hero-description {
    animation: hero-fade-up 700ms var(--ease-apple) 650ms both;
  }

  .hero-description strong {
    color: var(--text-primary);
  }

  /* Wrapper de Acciones y Mascota Centrados */
  .hero-actions-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 22px;
    position: relative;
    flex-wrap: wrap;
    width: 100%;
  }

  .hero-actions-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hero-mascot-sticker {
    display: flex;
    align-items: center;
    gap: 10px;
    animation: float 4s ease-in-out infinite;
    user-select: none;
  }

  .hero-mascot-img {
    width: 84px;
    height: 84px;
    filter: drop-shadow(4px 4px 0px #000000);
    transition: transform 0.2s ease;
  }

  .hero-mascot-sticker:hover .hero-mascot-img {
    transform: scale(1.08);
  }

  .hero-mascot-bubble {
    background: #ffe500;
    color: #000000;
    font-family: "Outfit", sans-serif;
    font-weight: 800;
    font-size: 0.78rem;
    padding: 6px 12px;
    border: 2px solid #000000;
    border-radius: 10px;
    box-shadow: 2px 2px 0px #000000;
    transform: none;
    white-space: nowrap;
  }

  .hero-version-tag {
    background: #000000;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 999px;
    margin-left: 6px;
  }

  /* Badge Contador de Descargas Chiquito */
  .hero-dl-counter-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #11151f;
    border: 1.5px solid #283042;
    border-radius: var(--radius-pill, 999px);
    padding: 6px 14px;
    font-size: 0.78rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-secondary, #c4cad4);
    box-shadow: 2px 2px 0px #000000;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
    user-select: none;
    cursor: default;
  }

  .hero-dl-counter-badge:hover {
    border-color: var(--color-success, #00ff87);
    transform: translateY(-1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .dl-live-dot {
    width: 7px;
    height: 7px;
    background: var(--color-success, #00ff87);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(0, 255, 135, 0.7);
    animation: livePulse 2s infinite ease-in-out;
    flex-shrink: 0;
  }

  @keyframes livePulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.3);
      opacity: 1;
    }
  }

  .dl-counter-icon {
    font-size: 0.82rem;
  }

  .dl-counter-num {
    font-weight: 800;
    color: var(--color-success, #00ff87);
    font-size: 0.88rem;
  }

  .dl-counter-text {
    font-size: 0.74rem;
    color: var(--text-tertiary, #8f9cae);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero-dl-counter-badge.celebrate {
    animation: counterPop 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border-color: var(--color-primary, #ff3fa4);
  }

  @keyframes counterPop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1);
    }
  }

  html.js-anim .hero-actions-group {
    animation: hero-fade-up 750ms var(--ease-spring) 800ms both;
  }

  /* Callout de Canal de WhatsApp en el Hero */
  .hero-channel-callout {
    display: flex;
    justify-content: center;
    margin-bottom: 22px;
    width: 100%;
  }

  .channel-callout-inner {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    background: rgba(37, 211, 102, 0.08);
    border: 1.5px solid rgba(37, 211, 102, 0.4);
    border-radius: var(--radius-pill);
    box-shadow: 2px 2px 0px #064e3b;
    flex-wrap: wrap;
    justify-content: center;
    transition:
      transform 200ms var(--ease-spring),
      border-color 200ms ease;
  }

  .channel-callout-inner:hover {
    border-color: #25d366;
    transform: translateY(-1px);
  }

  .channel-callout-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #000000;
    color: #25d366;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid rgba(37, 211, 102, 0.3);
    letter-spacing: 0.04em;
  }

  .channel-dot-pulse {
    width: 6px;
    height: 6px;
    background: #25d366;
    border-radius: 50%;
    animation: channelPulse 2s infinite ease-in-out;
  }

  @keyframes channelPulse {
    0%,
    100% {
      opacity: 0.6;
      box-shadow: 0 0 2px #25d366;
    }
    50% {
      opacity: 1;
      box-shadow: 0 0 8px #25d366;
    }
  }

  .channel-callout-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  .channel-callout-text strong {
    color: #faf7f7;
  }

  .btn-channel-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: #25d366;
    color: #000000;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 900;
    border: 1.5px solid #000000;
    border-radius: var(--radius-pill);
    box-shadow: 2px 2px 0px #000000;
    text-decoration: none;
    transition:
      transform 150ms var(--ease-apple),
      background-color 150ms ease;
    white-space: nowrap;
  }

  .btn-channel-pill:hover {
    background: #2bf075;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  @media (max-width: 640px) {
    .channel-callout-inner {
      border-radius: var(--radius-md);
      padding: 12px 14px;
      text-align: center;
      gap: 10px;
    }
    .btn-channel-pill {
      width: 100%;
      justify-content: center;
      padding: 8px 12px;
    }
  }

  .btn-hero-cta {
    padding: 13px 26px;
    gap: 14px;
    background-color: var(--color-primary);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    position: relative;
  }

  .btn-hero-cta:hover {
    background-color: var(--color-primary-hover);
    color: #ffffff;
  }

  .btn-hero-secondary {
    padding: 14px 22px;
  }

  .btn-hero-cta .hero-download-icon {
    transition: transform 220ms var(--ease-spring);
  }

  .btn-hero-cta:hover .hero-download-icon {
    transform: translateY(3px);
  }

  @keyframes download-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        var(--shadow-hard),
        0 0 16px rgba(0, 255, 135, 0.22);
    }
    50% {
      transform: scale(1.025);
      box-shadow:
        6px 6px 0px #000000,
        0 0 24px rgba(0, 255, 135, 0.4);
    }
  }

  /* El pulso infinito controla el transform, así que hay que cederle el paso
     al hover/active/focus: si no, el botón principal "ignora" el puntero. */
  .btn-hero-cta:hover,
  .btn-hero-cta:focus-visible,
  .btn-hero-cta:active,
  .btn-hero-cta.is-static {
    animation: none;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .btn-cta-labels {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }

  .cta-title {
    font-size: 1.05rem;
    font-weight: 900;
  }

  .cta-subtitle {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    opacity: 0.88;
  }

  .btn-hero-support {
    padding: 14px 22px;
    font-size: 0.92rem;
  }

  .btn-hero-support svg {
    transition: transform 220ms var(--ease-spring);
  }

  .btn-hero-support:hover svg {
    transform: scale(1.15);
  }

  /* Fila compacta de Chips Centrada (Matriz Simétrica 3 x 2 para los 6 chips) */
  .hero-features-chips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 980px;
    border-top: 1.5px solid var(--border-app);
    padding-top: 24px;
    margin: 0 auto;
  }

  html.js-anim .hero-features-chips .feature-chip {
    opacity: 0;
    animation: hero-fade 560ms var(--ease-apple) both;
  }

  html.js-anim .hero-features-chips .feature-chip:nth-child(1) {
    animation-delay: 920ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(2) {
    animation-delay: 1000ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(3) {
    animation-delay: 1080ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(4) {
    animation-delay: 1160ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(5) {
    animation-delay: 1240ms;
  }
  html.js-anim .hero-features-chips .feature-chip:nth-child(6) {
    animation-delay: 1320ms;
  }

  .feature-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-md);
    box-shadow: 2px 2px 0px #000000;
    transition:
      transform 220ms var(--ease-spring),
      box-shadow 220ms var(--ease-apple),
      border-color 220ms ease;
  }

  .feature-chip:hover {
    transform: translateY(-3px);
    border-color: var(--accent-primary);
    box-shadow:
      3px 3px 0px rgba(0, 255, 135, 0.4),
      0 6px 16px rgba(0, 0, 0, 0.4);
  }

  .chip-svg {
    color: var(--accent-primary);
    flex-shrink: 0;
    transition:
      transform 240ms var(--ease-spring),
      color 240ms ease;
  }

  .feature-chip:hover .chip-svg {
    transform: scale(1.18);
    color: var(--color-primary);
  }

  .chip-info {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .chip-info strong {
    font-size: 0.88rem;
    color: var(--text-primary);
    font-weight: 800;
  }

  .chip-info span {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  /* Columna Visual / Teléfono Centrado */
  .hero-device-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }

  .hero-ambient-glow {
    position: absolute;
    width: 380px;
    height: 380px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(0, 255, 135, 0.15) 0%,
      rgba(255, 219, 121, 0.06) 45%,
      transparent 70%
    );
    filter: blur(45px);
    pointer-events: none;
    z-index: 1;
    animation: ambient-breathe 7s ease-in-out infinite alternate;
  }

  @keyframes ambient-breathe {
    0% {
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0.6;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.15);
      opacity: 1;
    }
  }

  .phone-perspective-stage {
    position: relative;
    width: 320px;
    max-width: 100%;
    perspective: 1200px;
    z-index: 2;
  }

  html.js-anim .phone-perspective-stage {
    animation: stage-entrance 850ms var(--ease-spring) 280ms both;
  }

  @keyframes stage-entrance {
    0% {
      opacity: 0;
      transform: translateY(35px) scale(0.94);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Segmented control para alternar vista */
  .phone-segmented-control {
    display: flex;
    background: var(--bg-surface);
    border: 2px solid var(--border-bold);
    border-radius: var(--radius-md);
    padding: 4px;
    box-shadow: var(--shadow-hard-sm);
    margin-bottom: 16px;
    gap: 4px;
  }

  .seg-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 7px 4px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 180ms ease;
  }

  .seg-btn svg {
    flex-shrink: 0;
    transition: transform 180ms var(--ease-spring);
  }

  .seg-btn:hover:not(.active) svg {
    transform: scale(1.15);
  }

  .seg-btn:hover:not(.active) {
    color: var(--text-primary);
  }

  .seg-btn.active {
    background: var(--accent-primary);
    color: var(--on-primary);
    box-shadow: 2px 2px 0px #000000;
  }

  /* Chasis del teléfono */
  .phone-chassis {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 18.5;
    background: #000000;
    border: 9px solid #161a23;
    border-radius: 40px;
    box-shadow:
      0 25px 60px -15px rgba(0, 0, 0, 0.9),
      6px 6px 0px #000000,
      0 0 0 2px var(--accent-primary);
    overflow: hidden;
    transition:
      transform 180ms var(--ease-apple),
      box-shadow 180ms ease;
    transform-style: preserve-3d;
  }

  .phone-dynamic-island {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 18px;
    background: #000000;
    border-radius: 20px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 12px;
  }

  .phone-camera-dot {
    width: 6px;
    height: 6px;
    background: #111a24;
    border-radius: 50%;
    border: 1px solid #1f2e3d;
  }

  .phone-screen-content {
    width: 100%;
    height: 100%;
    position: relative;
    background: var(--bg-primary);
  }

  .screen-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-apple);
    overflow: hidden;
  }

  .screen-layer.active {
    opacity: 1;
    pointer-events: auto;
  }

  .screen-layer-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* El <picture> debe llenar la capa para que la imagen conserve el encuadre */
  .screen-layer picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ==========================================================================
     RECREACIÓN EXACTA DE LA APP EN HTML/CSS (.app-ui-canvas)
     ========================================================================== */
  .app-ui-canvas {
    width: 100%;
    height: 100%;
    padding: 34px 12px 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-primary);
    box-sizing: border-box;
  }

  .app-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .user-greeting {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .user-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .user-campus {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .app-status-pill {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    background: rgba(0, 255, 135, 0.15);
    color: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    padding: 2px 6px;
    border-radius: var(--radius-pill);
  }

  .app-example-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 800;
    color: var(--accent-amber);
    background: rgba(255, 219, 121, 0.15);
    border: 1px solid var(--accent-amber);
    padding: 2px 5px;
    border-radius: 4px;
    margin-right: 5px;
  }

  /* Tarjeta de clase en curso: pieza central de la recreación de la UI */
  .app-live-class-card {
    background: var(--bg-surface-elevated);
    border: 2px solid var(--accent-primary);
    border-radius: var(--radius-md);
    padding: 12px;
    box-shadow: 3px 3px 0px var(--accent-primary);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transform: scale(0.96);
  }

  /* La recreación de la UI de la app se "arma" sola con delays en cascada.
     Antes esto vivía en animation-delay fijos incrustados en el shorthand; ahora
     el retardo fluye por --arm-delay, así que cada pieza comparte un único
     keyframe y basta con cambiar la variable. El estado base NO está oculto y
     sólo se oculta cuando JS añade .js-anim: sin JS el panel se ve completo. */
  html.js-anim .app-ui-canvas .app-topbar,
  html.js-anim .app-ui-canvas .app-live-class-card,
  html.js-anim .app-ui-canvas .app-metrics-grid,
  html.js-anim .app-ui-canvas .app-bottom-nav {
    opacity: 0;
    animation: arm-ui-piece 620ms var(--ease-apple) both;
    animation-delay: var(--arm-delay, 0ms);
  }

  html.js-anim .app-live-class-card {
    --arm-delay: 420ms;
    transition: transform 620ms var(--ease-apple);
  }

  html.js-anim .app-live-class-card.revealed {
    transform: scale(1);
  }

  /* Sin JS la escala inicial nunca podría animarse hasta 1, así que el panel se
     muestra completo desde el principio */
  html:not(.js-anim) .app-ui-canvas .app-live-class-card {
    transform: none !important;

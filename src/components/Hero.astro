  .class-progress-bar::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.65),
      transparent
    );
    animation: shimmer-pass 3.2s ease-in-out infinite 2.2s;
  }

  @keyframes shimmer-pass {
    0% {
      left: -100%;
    }
    50%,
    100% {
      left: 160%;
    }
  }

  @keyframes fill-class-bar {

---
interface Props {
  M: any;
}

const { M } = Astro.props;
---
        <div class="pass-container">
          <button
            type="button"
            class="pass"
            id="hub-carnet"
            aria-pressed="false"
            aria-label="Carnet estudiantil 3D interactivo. Cara visible: Pase ESPE. Presiona Enter o Espacio para voltear."
            title="Toca o presiona Enter para voltear"
          >
            <div class="pass-in">
              <!-- Cara Frontal ESPE -->
              <div class="face front">
                <header class="pass-hdr-espe">
                  <div class="crest-row">
                    <span class="crest-stars">★ ★ ★</span>
                    <span class="crest-sub">ESPE DIGITAL</span>
                  </div>
                  <span class="pass-title">Pase Estudiantil</span>
                </header>
                <div class="fb">
                  <div class="pass-student-row">
                    <div class="pass-avatar-wrap">
                      <img src={M.neutral} alt="Pilo, estudiante de la ESPE" class="pass-avatar-img" width="68" height="68" />
                      <span class="pass-avatar-tag">PILAS!</span>
                    </div>
                    <div class="pass-student-info">
                      <h2>Universidad de las Fuerzas Armadas ESPE</h2>
                      <span class="campus-sub">SEDE MATRIZ SANGOLQUÍ · PREGRADO</span>
                      <span class="pass-badge-active">ESTUDIANTE REGULAR</span>
                    </div>
                  </div>

                  <dl class="pass-data-grid">
                    <div><dt>Aulas</dt><dd>Bloques A al H</dd></div>
                    <div><dt>Mallas</dt><dd class="num">23 carreras</dd></div>
                    <div><dt>Regla</dt><dd class="num">42 / 60 pts</dd></div>
                    <div><dt>Cifrado</dt><dd>AES-256 local</dd></div>
                  </dl>

                  <!-- Holograma de Seguridad -->
                  <div class="hologram-strip">
                    <span class="holo-symbol">⬡</span>
                    <span class="holo-text font-mono">CHIP GARITA · OFFLINE VERIFIED</span>
                  </div>

                  <div class="barcode-box">
                    <div class="barcode-lines"></div>
                    <span class="barcode-num font-mono">ID BANNER · L00412890</span>
                  </div>

                  <div class="pass-footer">
                    <span class="badge b-info"><svg class="ico"><use href="#i-off"/></svg>100% Offline</span>
                    <span class="badge b-ok">✓ Modo local</span>
                  </div>
                </div>
              </div>

              <!-- Cara Posterior Multi-U -->
              <div class="face back">
                <header class="pass-hdr-multi">
                  <div class="crest-row">
                    <span class="crest-stars">★ ★ ★</span>
                    <span class="crest-sub">RED ECUADOR</span>
                  </div>
                  <span class="pass-title">Pasaporte Estudiantil</span>
                </header>
                <div class="fb">
                  <div class="pass-student-row">
                    <div class="pass-avatar-wrap back-wrap">
                      <img src={M.success} alt="Pilas Pasaporte Multi-U" class="pass-avatar-img" width="68" height="68" />
                      <span class="pass-avatar-tag back-tag">UNIVERSAL</span>
                    </div>
                    <div class="pass-student-info">
                      <h2>Multi-Universidad Ecuador</h2>
                      <span class="campus-sub">CAMPUS NACIONAL MOODLE</span>
                      <span class="pass-badge-active back-active">CONECTADO</span>
                    </div>
                  </div>

                  <dl class="pass-data-grid">
                    <div><dt>Entrada</dt><dd>QR en 1 segundo</dd></div>
                    <div><dt>Moodle</dt><dd>Cualquier sede</dd></div>
                    <div><dt>Escala</dt><dd class="num">10, 20 o 100 pts</dd></div>
                    <div><dt>Carátulas</dt><dd>Con tu escudo</dd></div>
                  </dl>

                  <!-- Holograma Multi-U -->
                  <div class="hologram-strip back-holo">
                    <span class="holo-symbol">⬡</span>
                    <span class="holo-text font-mono">PROTOCOLO MOODLE MOBILE DIRECTO</span>
                  </div>

                  <div class="qr-pass-box">
                    <span class="qr-pill-tag">ACCESO ESTUDIANTIL UNIVERSAL</span>
                    <span class="qr-sub">Moodle Mobile Protocol · Cifrado AES-256</span>
                  </div>

                  <div class="pass-footer">
                    <span class="badge b-info"><svg class="ico"><use href="#i-off"/></svg>100% Offline</span>
                    <span class="badge b-ok">✓ Compatible</span>
                  </div>
                </div>
              </div>
            </div>
          </button>
          <div class="pass-disclaimer font-mono">
            <span class="badge b-info" style="font-size:0.75rem">PROYECTO INDEPENDIENTE</span>
            <span>No afiliado a la ESPE. Desarrollado por estudiantes para la comunidad.</span>
          </div>
        </div>

<style is:global>
/* Carnet 3D */
.pass-container {
  display: flex;
  justify-content: center;
}
.pass {
  perspective: 1200px;
  width: min(100%, 370px);
  aspect-ratio: 3 / 4.4;
  cursor: pointer;
  touch-action: pan-y;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  text-align: left;
  color: inherit;
  font: inherit;
  border-radius: 20px;
}
.pass:focus-visible {
  outline: 3px solid var(--primary);
  outline-offset: 6px;
}
.pass-in {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}
html[data-mode="multi"] .pass-in {
  transform: rotateY(180deg);
}
.face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
  border: 2px solid #000;
  border-radius: 16px;
  box-shadow: 6px 6px 0 #000;
  overflow: hidden;
  background: var(--bg-surface);
  display: flex;
  flex-direction: column;
}
.face.back {
  transform: rotateY(180deg) translate3d(0, 0, 0);
  -webkit-transform: rotateY(180deg) translate3d(0, 0, 0);
}
.pass-hdr-espe {
  background: var(--primary);
  color: #000;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font: 800 1.05rem var(--f-d);
  border-bottom: 2px solid #000;
}
.pass-hdr-multi {
  background: var(--primary-coral);
  color: #000;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font: 800 1.05rem var(--f-d);
  border-bottom: 2px solid #000;
}
.crest-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
}
.crest-stars {
  font-size: 0.75rem;
  letter-spacing: 2px;
}
.crest-sub {
  font: 800 0.68rem var(--f-d);
  letter-spacing: 0.06em;
}
.pass-title {
  font-weight: 800;
}
.fb {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}
.pass-student-row {
  display: flex;
  gap: 12px;
  align-items: center;
}
.pass-avatar-wrap {
  width: 66px;
  height: 66px;
  border-radius: 10px;
  background: #0b0e14;
  border: 2px solid var(--primary);
  padding: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  box-shadow: 2px 2px 0 #000;
}
.pass-avatar-wrap.back-wrap {
  border-color: var(--primary-coral);
}
.pass-avatar-img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}
.pass-avatar-tag {
  position: absolute;
  bottom: -6px;
  background: var(--primary);
  color: #000;
  font: 800 0.55rem var(--f-d);
  padding: 1px 4px;
  border-radius: 4px;
  letter-spacing: 0.05em;
}
.pass-avatar-tag.back-tag {
  background: var(--primary-coral);
}
.pass-student-info {
  flex: 1;
  min-width: 0;
}
.pass-student-info h2 {
  font-size: 1.05rem;
  line-height: 1.15;
}
.campus-sub {
  font: 800 0.68rem var(--f-d);
  color: var(--muted);
  letter-spacing: 0.05em;
  display: block;
  margin-top: 2px;
}
.pass-badge-active {
  display: inline-block;
  font: 800 0.65rem var(--f-d);
  color: var(--primary);
  background: rgba(255, 63, 164, 0.14);
  padding: 2px 6px;
  border-radius: 4px;
  margin-top: 4px;
  border: 1px solid var(--primary);
}
.pass-badge-active.back-active {
  color: var(--primary-coral);
  background: rgba(255, 61, 94, 0.14);
  border-color: var(--primary-coral);
}
.pass-data-grid {
  margin: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 10px;
  background: #11141c;
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
}
.pass-data-grid dt {
  color: var(--muted);
  font-size: 0.76rem;
}
.pass-data-grid dd {
  margin: 0;
  color: var(--title);
  font-weight: 700;
  font-size: 0.85rem;
  line-height: 1.2;
}

/* Holograma */
.hologram-strip {
  display: flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(90deg, #131a26, #1c2638, #131a26);
  border: 1.5px solid #36445c;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 0.68rem;
  color: #93c5fd;
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.08);
}
.hologram-strip.back-holo {
  border-color: #55333f;
  color: #fda4af;
}
.holo-symbol {
  font-size: 0.85rem;
  line-height: 1;
}
.barcode-box {
  background: #000;
  border: 1.5px solid var(--border-control);
  border-radius: 8px;
  padding: 6px 8px;
  text-align: center;
}
.barcode-lines {
  height: 24px;
  background: repeating-linear-gradient(90deg, #fff, #fff 2px, #000 2px, #000 5px, #fff 5px, #fff 8px, #000 8px, #000 10px, #fff 10px, #fff 14px);
}
.barcode-num {
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.1em;
  display: block;
  margin-top: 3px;
}
.qr-pass-box {
  background: #11141c;
  border: 1.5px solid var(--border-control);
  border-radius: 8px;
  padding: 8px;
  text-align: center;
}
.qr-pill-tag {
  font: 800 0.72rem var(--f-d);
  color: var(--primary-coral);
  display: block;
}
.qr-sub {
  font-size: 0.72rem;
  color: var(--muted);
}
.pass-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

/* Deslinde de Carnet Independiente */
.pass-disclaimer {
  margin-top: 14px;
  text-align: center;
  font-size: 0.8rem;
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
}

</style>

<script>
  import { initCarnetFlip } from '../scripts/carnet-flip';
  initCarnetFlip();
</script>

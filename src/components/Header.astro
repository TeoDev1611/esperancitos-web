---
// Header.astro - Vidrio esmerilado que se compacta al scroll con indicador deslizante y ticker

// El marquee se desplaza exactamente 1/3 del ancho del track, por lo que se
// necesitan 3 bloques idénticos para que el bucle sea continuo y sin costuras.
const tickerLoops = [0, 1, 2];
---

<!-- Ticker Cinta Superior con Animación Continua -->
<div class="top-ticker" aria-hidden="true">
  <div class="ticker-track">
    {tickerLoops.map((loop) => (
      <div class:list={['ticker-content', { 'is-first': loop === 0 }]} aria-hidden="true">
        <span class="ticker-item">
          {loop === 0 && <span class="dot-green"></span>}
          PROYECTO INDEPENDIENTE · NO OFICIAL
        </span>
        <span class="ticker-sep">•</span>
        <span class="ticker-item">TU HORARIO CON EL AULA DE CADA CLASE</span>
        <span class="ticker-sep">•</span>
        <span class="ticker-item">23 MALLAS CURRICULARES SIN INTERNET</span>
        <span class="ticker-sep">•</span>
        <span class="ticker-item">ENTRA A MOODLE CON UN CÓDIGO QR</span>
        <span class="ticker-sep">•</span>
        <span class="ticker-item">GRATIS Y SIN PUBLICIDAD</span>
        <span class="ticker-sep">•</span>
        <span class="ticker-item">DESCARGA DIRECTA, SIN TIENDA</span>
        <span class="ticker-sep">•</span>
      </div>
    ))}
  </div>
</div>

<header class="site-header" id="main-header">
  <div class="container header-inner">
    <a href="#" class="brand-logo" aria-label="Inicio Esperancitos">
      <div class="logo-wrapper">
        <img src="/logo_esperancitos.jpg" alt="Logo Esperancitos" class="logo-img" width="42" height="42" />
        <span class="logo-live-indicator" aria-hidden="true"></span>
      </div>
      <div class="brand-text">
        <span class="brand-name">ESPERANCITOS</span>
        <span class="brand-tag">Gratis · v1.0.0-beta.2</span>
      </div>
    </a>

    <!-- Navegación de Escritorio con indicador deslizante -->
    <nav class="desktop-nav" id="desktop-nav" aria-label="Navegación principal">
      <div class="nav-slider-pill" id="nav-slider-pill" aria-hidden="true"></div>
      <a href="/#funciones" class="nav-link" data-nav="funciones">
        <span>Qué hace</span>
      </a>
      <a href="/#vistas" class="nav-link" data-nav="vistas">
        <span>Cómo se ve</span>
      </a>
      <a href="/avisos" class="nav-link" data-nav="avisos">
        <span>Avisos</span>
      </a>
      <a href="/negocios" class="nav-link" data-nav="negocios">
        <span>Negocios</span>
      </a>
      <a href="/#docs" class="nav-link" data-nav="docs">
        <span>Guías</span>
      </a>
    </nav>

    <div class="header-actions">
      <!-- Botón de Donaciones / Apoyo Rápido -->
      <button type="button" class="btn-support-quick" id="open-support-btn" aria-label="Ayudar a mantener este proyecto">
        <svg class="support-cup-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <line x1="6" y1="2" x2="6" y2="4"></line>
          <line x1="10" y1="2" x2="10" y2="4"></line>
          <line x1="14" y1="2" x2="14" y2="4"></line>
        </svg>
        <span>Ayudar</span>
      </button>

      <!-- Botón Principal de Descarga -->
      <a href="/#descargar" class="btn-app btn-app-primary btn-nav-download" aria-label="Ir a la sección de descarga de la app">
        <span class="nav-download-label">Descargar la app</span>
        <svg class="download-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </a>

      <!-- Botón Menú Móvil -->
      <button type="button" class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="mobile-drawer">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </div>

  <!-- Drawer Menú Móvil con SVGs en lugar de emojis -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Navegación móvil">
      <a href="/#funciones" class="mobile-link">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </span>
        <span>Qué puede hacer la app</span>
      </a>
      <a href="/#vistas" class="mobile-link">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
            <path d="M12 18h.01"></path>
          </svg>
        </span>
        <span>Cómo se ve por dentro</span>
      </a>
      <a href="/avisos" class="mobile-link">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
        </span>
        <span>Avisos de la comunidad</span>
      </a>
      <a href="/negocios" class="mobile-link">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </span>
        <span>Directorio de negocios</span>
      </a>
      <a href="/#docs" class="mobile-link">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
        </span>
        <span>Guías paso a paso y dudas</span>
      </a>
      <a href="/#colaborar" class="mobile-link">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </span>
        <span>Buscar colaboradores (iPhone)</span>
      </a>
      <a href="/#comentarios" class="mobile-link">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </span>
        <span>Reportar errores o sugerir ideas</span>
      </a>
      <a href="/#descargar" class="mobile-link highlight-green">
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </span>
        <span>Descargar la app</span>
      </a>
      <a href="/#apoyar" class="mobile-link highlight-amber" data-open-support>
        <span class="m-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
            <line x1="6" y1="2" x2="6" y2="4"></line>
            <line x1="10" y1="2" x2="10" y2="4"></line>
            <line x1="14" y1="2" x2="14" y2="4"></line>
          </svg>
        </span>
        <span>Ayudar a mantener la app</span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* Ticker Superior de Ancho Completo */
  .top-ticker {
    background: #000000;
    border-bottom: 1.5px solid var(--border-app);
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    z-index: 101;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 6px 0;
  }

  .ticker-track {
    display: inline-flex;
    align-items: center;
    /* 3 bloques idénticos: desplazar exactamente 1/3 del ancho total deja el
       bloque 2 justo donde empezó el bloque 1, así el bucle no da saltos.
       Antes eran 2 bloques con padding-right, por lo que el -50% nunca
       coincidía con el ancho real de un bloque y se veía un tirón cada ciclo. */
    animation: marquee-infinite 36s linear infinite;
    will-change: transform;
  }

  .ticker-track:hover,
  .ticker-track:focus-within {
    animation-play-state: paused;
  }

  .ticker-content {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-right: 16px;
    color: var(--text-secondary);
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .dot-green {
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
    border-radius: 50%;
    display: inline-block;
    animation: tickerDotGlow 2.4s ease-in-out infinite;
  }

  @keyframes tickerDotGlow {
    0%, 100% { opacity: 0.6; box-shadow: 0 0 2px var(--accent-primary); }
    50% { opacity: 1; box-shadow: 0 0 8px var(--accent-primary); }
  }

  .ticker-sep {
    color: var(--accent-primary);
    font-size: 0.85rem;
  }

  @keyframes marquee-infinite {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-33.3333%, 0, 0); }
  }

  /* Header Estilo Apple Vidrio Esmerilado */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 15, 20, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 2px solid var(--border-app);
    transition: height var(--duration-hover) var(--ease-apple),
                border-color var(--duration-hover) ease,
                background-color var(--duration-hover) ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    transition: height var(--duration-hover) var(--ease-apple);
  }

  /* Compactación suave al hacer scroll */
  .site-header.scrolled {
    background: rgba(11, 15, 20, 0.96);
    border-bottom-color: var(--border-highlight);
  }
  .site-header.scrolled .header-inner {
    height: 60px;
  }

  /* Logotipo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform var(--duration-hover) var(--ease-apple);
  }

  .brand-logo:hover {
    transform: scale(1.02);
  }

  .logo-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .logo-img {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px var(--accent-primary);
    object-fit: cover;
    transition: box-shadow var(--duration-hover) ease;
  }

  .brand-logo:hover .logo-img {
    box-shadow: 3px 3px 0px var(--accent-primary);
  }

  .logo-live-indicator {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    background: var(--accent-primary);
    border: 2px solid #000000;
    border-radius: 50%;
    animation: liveIndicatorPulse 2.4s infinite;
  }

  @keyframes liveIndicatorPulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 255, 135, 0.7); }
    70% { box-shadow: 0 0 0 5px rgba(0, 255, 135, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 255, 135, 0); }
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .brand-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--accent-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Navegación Desktop con Segmented Pill */
  .desktop-nav {
    display: flex;
    align-items: center;
    position: relative;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-pill);
    padding: 4px;
    box-shadow: var(--shadow-hard-sm);
  }

  .nav-slider-pill {
    position: absolute;
    top: 4px;
    left: 4px;
    height: calc(100% - 8px);
    width: 0;
    background: var(--bg-surface-elevated);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-app);
    transition: transform 250ms var(--ease-apple),
                width 250ms var(--ease-apple),
                opacity 180ms ease;
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-secondary);
    border-radius: var(--radius-pill);
    transition: color var(--duration-hover) ease;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--accent-primary);
  }

  /* Acciones de Cabecera */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-support-quick {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(255, 219, 121, 0.12);
    border: 1.5px solid var(--accent-amber);
    color: var(--accent-amber);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.85rem;
    border-radius: var(--radius-md);
    box-shadow: 2px 2px 0px #000000;
    cursor: pointer;
    transition: transform var(--duration-sink) var(--ease-apple),
                box-shadow var(--duration-sink) var(--ease-apple),
                background-color var(--duration-hover) ease,
                color var(--duration-hover) ease;
  }

  .btn-support-quick:hover {
    background: var(--accent-amber);
    color: var(--on-amber);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .btn-support-quick:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px #000000;
  }

  .support-cup-svg {
    transition: transform var(--duration-hover) ease;
  }
  .btn-support-quick:hover .support-cup-svg {
    transform: rotate(-10deg) scale(1.15);
  }

  .btn-nav-download {
    padding: 8px 16px;
    font-size: 0.85rem;
    gap: 6px;
  }

  .download-arrow {
    transition: transform var(--duration-hover) ease;
  }
  .btn-nav-download:hover .download-arrow {
    transform: translateY(2px);
  }

  /* Botón Hamburguesa */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 38px;
    height: 38px;
    background: var(--bg-surface);
    border: 2px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 7px;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;
  }

  .mobile-menu-btn .bar {
    width: 100%;
    height: 2.5px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all var(--duration-hover) ease;
  }

  .mobile-menu-btn.open .bar-1 {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-btn.open .bar-2 {
    opacity: 0;
  }
  .mobile-menu-btn.open .bar-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Menú desplegable móvil.
     Antes alternaba display:none/block, así que la animación de entrada no
     llegaba a reproducirse nunca (no hay transición desde display:none).
     Ahora se oculta con visibility + max-height para poder animar de verdad. */
  .mobile-drawer {
    display: block;
    overflow: hidden;
    visibility: hidden;
    max-height: 0;
    background: var(--bg-surface-elevated);
    border-bottom: 0 solid var(--border-app);
    padding: 0 20px;
    opacity: 0;
    transform: translateY(-10px);
    transition: max-height 320ms var(--ease-apple),
                opacity 220ms ease,
                transform 320ms var(--ease-apple),
                padding 320ms var(--ease-apple),
                visibility 0s linear 320ms,
                border-bottom-width 320ms var(--ease-apple);
  }

  .mobile-drawer.open {
    visibility: visible;
    /* 9 enlaces con padding: holgura para mostrar todos los elementos */
    max-height: 900px;
    padding: 16px 20px;
    opacity: 1;
    transform: translateY(0);
    border-bottom-width: 2px;
    transition: max-height 380ms var(--ease-spring),
                opacity 240ms ease,
                transform 380ms var(--ease-spring),
                padding 380ms var(--ease-spring),
                visibility 0s linear 0s,
                border-bottom-width 380ms var(--ease-spring);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--text-primary);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
  }

  .mobile-link:hover {
    background: var(--bg-surface);
    border-color: var(--border-app);
  }

  .mobile-link.highlight-green {
    color: var(--accent-primary);
    background: rgba(0, 255, 135, 0.08);
    border-color: rgba(0, 255, 135, 0.3);
  }

  .mobile-link.highlight-amber {
    color: var(--accent-amber);
    background: rgba(255, 219, 121, 0.08);
    border-color: rgba(255, 219, 121, 0.3);
  }

  /* Con 5 enlaces en la navegación, el header tiene suficiente espacio y holgura:
     por debajo de 1024px se activa el menú móvil para evitar desbordes */
  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
    /* Descargar es la acción principal del sitio, así que en móvil se mantiene
       visible con una etiqueta corta en lugar de esconderse tras el menú. */
    .btn-nav-download {
      padding: 8px 12px;
      font-size: 0.78rem;
      gap: 6px;
    }
    .btn-nav-download .nav-download-label {
      display: none;
    }
    .btn-nav-download::after {
      content: 'Descargar';
      font-weight: 800;
    }

    .header-actions {
      gap: 8px;
    }

    /* El botón de apoyo pasa al menú desplegable para no saturar la barra */
    .btn-support-quick {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .brand-tag {
      display: none;
    }

    .btn-nav-download::after {
      content: 'Bajar';
    }

    .btn-nav-download {
      padding: 7px 10px;
      font-size: 0.72rem;
    }
  }
</style>

<script>
  // Compactación del Header al hacer scroll
  const header = document.getElementById('main-header');

  if (header) {
    let ticking = false;
    const syncHeaderState = () => {
      header.classList.toggle('scrolled', window.scrollY > 25);
      ticking = false;
    };

    // rAF-throttle: evita recalcular en cada evento de scroll
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(syncHeaderState);
      }
    }, { passive: true });

    // Estado correcto al recargar la página ya desplazada (p. ej. con #hash)
    syncHeaderState();
  }

  // Control del Menú Móvil
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  if (toggleBtn && drawer) {
    const setDrawerState = (isOpen: boolean) => {
      drawer.classList.toggle('open', isOpen);
      toggleBtn.classList.toggle('open', isOpen);
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      drawer.setAttribute('aria-hidden', String(!isOpen));
    };

    toggleBtn.addEventListener('click', () => {
      setDrawerState(!drawer.classList.contains('open'));
    });

    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => setDrawerState(false));
    });

    // Cerrar con Escape devolviendo el foco al botón
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && drawer.classList.contains('open')) {
        setDrawerState(false);
        toggleBtn.focus();
      }
    });
  }

  // Indicador deslizante de enlaces en Desktop
  const navContainer = document.getElementById('desktop-nav');
  const pill = document.getElementById('nav-slider-pill');
  const links = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav .nav-link');

  if (navContainer && pill && links.length > 0) {
    const movePillTo = (link: HTMLAnchorElement) => {
      const rect = link.getBoundingClientRect();
      const parentRect = navContainer.getBoundingClientRect();
      pill.style.width = `${rect.width}px`;
      pill.style.transform = `translateX(${rect.left - parentRect.left - 4}px)`;
      pill.style.opacity = '1';
    };

    links.forEach(link => {
      link.addEventListener('mouseenter', () => movePillTo(link));
      // Navegación por teclado: el indicador también debe seguir al foco
      link.addEventListener('focus', () => movePillTo(link));
    });

    navContainer.addEventListener('mouseleave', () => {
      pill.style.opacity = '0';
    });

    navContainer.addEventListener('focusout', (event) => {
      if (!navContainer.contains(event.relatedTarget as Node | null)) {
        pill.style.opacity = '0';
      }
    });
  }
</script>

<script>
  function setupCarnetFlip() {
    const btnFlip = document.getElementById('btn-flip-carnet');
    const flipper = document.getElementById('carnet-flipper');
    if (!btnFlip || !flipper) return;

    btnFlip.addEventListener('click', () => {
      flipper.classList.toggle('is-flipped');
    });
  }

  // Ejecución en carga inicial y soporte para transiciones de Astro
  setupCarnetFlip();
  document.addEventListener('astro:page-load', setupCarnetFlip);
</script>


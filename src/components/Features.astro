  /* ==========================================================================
     MICRO-ANIMACIONES Y EFECTOS VISUALES EN LAS TARJETAS
     ========================================================================== */

  /* 1. Malla: Brillo que recorre la barra de progreso */
  @keyframes shimmerTrack {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .malla-glow-bar {
    background: linear-gradient(
      90deg,
      #10b981 0%,
      var(--accent-primary) 50%,
      #34d399 100%
    );
    background-size: 200% 100%;
    animation: shimmerTrack 4s linear infinite;
  }

  /* Nodo de ruta crítica pulsante */
  @keyframes warningPulse {
    0%,
    100% {
      box-shadow: 0 0 6px rgba(255, 219, 121, 0.25);
      border-color: var(--accent-amber);
    }
    50% {
      box-shadow: 0 0 16px rgba(255, 219, 121, 0.65);
      border-color: #ffe082;
      transform: scale(1.02);
    }
  }

  .graph-node.warning-active {
    animation: warningPulse 2.4s ease-in-out infinite;
  }

  /* 2. HomeWidget: Punto de baliza en vivo y reacción del botón */
  @keyframes liveBeaconPulse {
    0% {
      transform: scale(0.9);
      opacity: 0.8;
      box-shadow: 0 0 0 0 rgba(255, 219, 121, 0.8);
    }
    70% {
      transform: scale(1.1);
      opacity: 1;
      box-shadow: 0 0 0 6px rgba(255, 219, 121, 0);
    }
    100% {
      transform: scale(0.9);
      opacity: 0.8;
      box-shadow: 0 0 0 0 rgba(255, 219, 121, 0);
    }
  }

  .live-dot-pulse {
    animation: liveBeaconPulse 1.8s infinite;
  }

  .widget-teams-btn:hover {
    transform: translateY(-2px);
    background: rgba(79, 82, 178, 0.32);
    border-color: rgba(123, 131, 235, 0.6);
    box-shadow: 0 6px 16px rgba(79, 82, 178, 0.35);
  }

  .widget-teams-btn:hover .teams-action-arrow {
    transform: translateX(4px);
  }

  .teams-action-arrow {
    transition: transform 200ms ease;
  }

  /* 3. Carnet: Reflejo holográfico sutil */
  .carnet-vertical-card::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      60deg,
      transparent 40%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(0, 255, 135, 0.08) 55%,
      transparent 65%
    );
    transform: rotate(25deg);
    pointer-events: none;
    animation: holoReflect 6s ease-in-out infinite;
  }

  @keyframes holoReflect {
    0%,
    70% {
      opacity: 0;
      transform: translateX(-80%) rotate(25deg);
    }
    80% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
      transform: translateX(80%) rotate(25deg);
    }
  }

  /* 4. Calculadora: Brillo en la nota meta requerida */
  @keyframes targetGlow {
    0%,
    100% {
      box-shadow: 0 0 6px var(--accent-amber);
    }
    50% {
      box-shadow:
        0 0 16px var(--accent-amber),
        0 0 24px rgba(255, 219, 121, 0.4);
    }
  }

  .slider-thumb-dot.amber {
    animation: targetGlow 2.5s ease-in-out infinite;
  }

  .calc-slider-card:hover .slider-thumb-dot {
    transform: translate(-50%, -50%) scale(1.25);

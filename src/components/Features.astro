<!-- Scripts Interactivos: Carnet Vertical ESPE y Simulador de Notas (Regla 42 pts) -->
<script>
  function setupCarnetInteractions() {
    const btnPrivacy = document.getElementById("btn-carnet-privacy");
    const cedulaDisplay = document.getElementById("carnet-cedula-display");
    const privacyLabel = document.getElementById("privacy-label-text");
    const btnBright = document.getElementById("btn-carnet-bright");
    const carnetCard = document.getElementById("carnet-card");

    let isHidden = false;
    let isBright = false;

    if (btnPrivacy && cedulaDisplay) {
      btnPrivacy.addEventListener("click", () => {
        isHidden = !isHidden;
        if (isHidden) {
          cedulaDisplay.textContent = "1729••••••";
          if (privacyLabel) privacyLabel.textContent = "Mostrar Cédula";
        } else {
          cedulaDisplay.textContent = "1729384710";
          if (privacyLabel) privacyLabel.textContent = "Ocultar Cédula";
        }
      });
    }

    if (btnBright && carnetCard) {
      btnBright.addEventListener("click", () => {
        isBright = !isBright;
        carnetCard.classList.toggle("mode-garita-active", isBright);
      });
    }
  }

  function setupGradeSimulator() {
    const inputP1 = document.getElementById("calc-input-p1") as HTMLInputElement | null;
    const inputP2 = document.getElementById("calc-input-p2") as HTMLInputElement | null;
    if (!inputP1 || !inputP2) return;

    const displayP1 = document.getElementById("p1-display");
    const displayP2 = document.getElementById("p2-display");
    const p1Contrib = document.getElementById("p1-contrib-text");
    const p2Contrib = document.getElementById("p2-contrib-text");
    const p3NeededDisplay = document.getElementById("p3-needed-display");
    const p3FillVisual = document.getElementById("p3-fill-visual");
    const p3ThumbDot = document.getElementById("p3-thumb-dot");
    const p3StatusDesc = document.getElementById("p3-status-desc");
    const sumVal = document.getElementById("calc-sum-val");
    const verdictBadge = document.getElementById("calc-verdict-badge");

    function recalculate() {
      const p1 = Math.min(20, Math.max(0, parseFloat(inputP1?.value || "0") || 0));
      const p2 = Math.min(20, Math.max(0, parseFloat(inputP2?.value || "0") || 0));
      const sum2 = p1 + p2;
      const neededP3 = 42.0 - sum2;

      if (displayP1) displayP1.textContent = `${p1.toFixed(2)} / 20`;
      if (displayP2) displayP2.textContent = `${p2.toFixed(2)} / 20`;
      if (p1Contrib) p1Contrib.textContent = `Aporta ${p1.toFixed(2)} pts acumulados al umbral de 42 pts`;
      if (p2Contrib) p2Contrib.textContent = `Llegas a ${sum2.toFixed(2)} / 40 pts acumulados en los 2 primeros parciales`;

      if (neededP3 <= 0) {
        // Supera el umbral sin necesidad de nota en Parcial 3
        if (sumVal) {
          sumVal.textContent = sum2.toFixed(2);
          sumVal.className = "calc-big-val text-green";
        }
        if (verdictBadge) {
          verdictBadge.textContent = `✓ ¡YA APROBASTE! (${(sum2 / 3).toFixed(2)})`;
          verdictBadge.className = "calc-verdict-badge approved";
        }
        if (p3NeededDisplay) {
          p3NeededDisplay.textContent = "0.00 / 20 (Asegurado)";
          p3NeededDisplay.className = "slider-target-result text-green";
        }
        if (p3FillVisual) {
          p3FillVisual.style.width = "0%";
          p3FillVisual.className = "slider-fill-visual green-gradient";
        }
        if (p3ThumbDot) {
          p3ThumbDot.style.left = "0%";
          p3ThumbDot.className = "slider-thumb-dot green";
        }
        if (p3StatusDesc) {
          p3StatusDesc.textContent = `¡Ponte pilas, ñaño! Ya superaste los 42.00 puntos requeridos. El Parcial 3 solo sumará a tu récord y promedio.`;
          p3StatusDesc.className = "slider-contrib-text text-green";
        }
      } else if (neededP3 <= 20.0) {
        // Alcanzable con Parcial 3
        if (sumVal) {
          sumVal.textContent = "42.00";
          sumVal.className = "calc-big-val text-amber";
        }
        if (verdictBadge) {
          verdictBadge.textContent = `⚡ REQUIERE ${neededP3.toFixed(2)} EN P3 (14.00)`;
          verdictBadge.className = "calc-verdict-badge approved";
        }
        if (p3NeededDisplay) {
          p3NeededDisplay.textContent = `MÍNIMO ${neededP3.toFixed(2)} / 20`;
          p3NeededDisplay.className = "slider-target-result text-amber";
        }
        const pct = Math.min(100, Math.max(0, (neededP3 / 20) * 100));
        if (p3FillVisual) {
          p3FillVisual.style.width = `${pct}%`;
          p3FillVisual.className = "slider-fill-visual amber-gradient";
        }
        if (p3ThumbDot) {
          p3ThumbDot.style.left = `${pct}%`;
          p3ThumbDot.className = "slider-thumb-dot amber";
        }
        if (p3StatusDesc) {
          p3StatusDesc.textContent = `Necesitas ${neededP3.toFixed(2)} en el Parcial 3 para alcanzar los 42.00 puntos reglamentarios. Si obtienes menos de 42 pts no hay supletorios: repites materia.`;
          p3StatusDesc.className = "slider-contrib-text amber";
        }
      } else {
        // Menor a 42 incluso sacando 20/20 -> REPITIENDO MATERIA / JALANDO MATERIA
        const maxScore = sum2 + 20.0;
        if (sumVal) {
          sumVal.textContent = maxScore.toFixed(2);
          sumVal.className = "calc-big-val text-error";
        }
        if (verdictBadge) {
          verdictBadge.textContent = `✕ REPITIENDO MATERIA (Jalando materia)`;
          verdictBadge.className = "calc-verdict-badge failed";
        }
        if (p3NeededDisplay) {
          p3NeededDisplay.textContent = `IMPOSIBLE (Faltan ${neededP3.toFixed(2)} pts)`;
          p3NeededDisplay.className = "slider-target-result text-error";
        }
        if (p3FillVisual) {
          p3FillVisual.style.width = "100%";
          p3FillVisual.className = "slider-fill-visual error-gradient";
        }
        if (p3ThumbDot) {
          p3ThumbDot.style.left = "100%";
          p3ThumbDot.className = "slider-thumb-dot error";
        }
        if (p3StatusDesc) {
          p3StatusDesc.textContent = `⚠️ Matemáticamente imposible alcanzar los 42.00 pts (máximo posible: ${maxScore.toFixed(2)}/60). En la ESPE no hay examen supletorio: quedas repitiendo materia.`;
          p3StatusDesc.className = "slider-contrib-text text-error";
        }
      }

      // Actualizar desglose en pills oficiales
      const fp1 = document.getElementById("f-p1-sum");
      const fp2 = document.getElementById("f-p2-sum");
      const fp3 = document.getElementById("f-p3-sum");
      const fTot = document.getElementById("f-total-sum");
      if (fp1) fp1.textContent = p1.toFixed(2);
      if (fp2) fp2.textContent = p2.toFixed(2);
      if (fp3) fp3.textContent = (neededP3 <= 0 ? 0 : Math.min(20, neededP3)).toFixed(2);
      if (fTot) {
        const simTotal = neededP3 > 20 ? (sum2 + 20) : Math.max(42, sum2);
        fTot.textContent = `${simTotal.toFixed(2)} / 60`;
        fTot.className = neededP3 > 20 ? "f-val text-error" : "f-val text-green";
      }
    }

    inputP1.addEventListener("input", recalculate);
    inputP2.addEventListener("input", recalculate);

    // Conexión de chips de escenarios rápidos
    const chips = document.querySelectorAll<HTMLButtonElement>(".calc-target-selector .target-chip");
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.classList.remove("active"));
        chip.classList.add("active");
        const val1 = chip.getAttribute("data-p1");
        const val2 = chip.getAttribute("data-p2");
        if (val1 && val2 && inputP1 && inputP2) {
          inputP1.value = val1;
          inputP2.value = val2;
          recalculate();
        }
      });
    });

    recalculate();
  }

  function initFeaturesInteractivity() {
    setupCarnetInteractions();
    setupGradeSimulator();
  }

  initFeaturesInteractivity();
  document.addEventListener("astro:page-load", initFeaturesInteractivity);
</script>


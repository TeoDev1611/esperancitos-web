---
// NocturnalDetector.astro - Easter Egg Nocturno Auténtico (1:00 AM - 5:59 AM)
// Aparece únicamente en la madrugada para acompañar a los estudiantes que trasnochan estudiando.
---

<div
  id="nocturnal-toast"
  class="nocturnal-toast"
  role="status"
  aria-live="polite"
  style="display: none;"
>
  <div class="nocturnal-toast-inner">
    <div class="nocturnal-header">
      <span class="nocturnal-moon" aria-hidden="true">🌙</span>
      <div class="nocturnal-time-pill" id="nocturnal-time-pill">02:30 AM</div>
      <button
        type="button"
        class="nocturnal-close-btn"
        id="nocturnal-close-btn"
        aria-label="Cerrar aviso nocturno"
      >
        ✕
      </button>
    </div>
    <div class="nocturnal-body">
      <h4 class="nocturnal-title">¿Salvando el semestre de madrugada?</h4>
      <p class="nocturnal-msg" id="nocturnal-msg">
        Pilas con ese café o V220. Hidrátate, respira hondo y dale con fe: con 14.01 también se gradúa la gente. ¡Tú puedes, loco!
      </p>
    </div>
    <div class="nocturnal-footer">
      <span class="nocturnal-badge">☕ COMPAÑERO DE TRASNOCHO</span>
      <button type="button" class="btn-nocturnal-ack" id="btn-nocturnal-ack">
        ¡Pilas, gracias! ⚡
      </button>
    </div>
  </div>
</div>

<style>
  .nocturnal-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    max-width: 360px;
    width: calc(100vw - 36px);
    animation: toast-slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes toast-slide-up {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .nocturnal-toast-inner {
    background: #141721;
    border: 2px solid #FFD700;
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: 6px 6px 0px #000000;
    color: #F8FAFC;
    position: relative;
    overflow: hidden;
  }

  .nocturnal-toast-inner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #FFD700, #FF3FA4, #00FF87);
  }

  .nocturnal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .nocturnal-moon {
    font-size: 1.3rem;
    filter: drop-shadow(0 0 6px rgba(255, 215, 0, 0.6));
    animation: moon-wobble 3s ease-in-out infinite;
  }

  @keyframes moon-wobble {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-10deg) scale(1.1); }
  }

  .nocturnal-time-pill {
    background: rgba(255, 215, 0, 0.15);
    color: #FFD700;
    border: 1px solid rgba(255, 215, 0, 0.35);
    font-size: 0.75rem;
    font-weight: 800;
    font-family: "JetBrains Mono", monospace;
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 0.04em;
  }

  .nocturnal-close-btn {
    background: transparent;
    border: none;
    color: #94A3B8;
    font-size: 1rem;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    line-height: 1;
  }

  .nocturnal-close-btn:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.1);
  }

  .nocturnal-title {
    margin: 0 0 6px 0;
    font-size: 0.95rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.3;
  }

  .nocturnal-msg {
    margin: 0 0 14px 0;
    font-size: 0.84rem;
    color: #CBD5E1;
    line-height: 1.45;
  }

  .nocturnal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 10px;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }

  .nocturnal-badge {
    font-size: 0.68rem;
    font-weight: 800;
    color: #94A3B8;
    letter-spacing: 0.05em;
  }

  .btn-nocturnal-ack {
    background: #FFD700;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .btn-nocturnal-ack:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #FFE44D;
  }

  @media (max-width: 480px) {
    .nocturnal-toast {
      bottom: 16px;
      right: 18px;
      left: 18px;
      max-width: none;
      width: auto;
    }
  }
</style>

<script>
  (function () {
    const STORAGE_KEY = "pilas_nocturnal_dismissed_session";

    function checkNocturnal() {
      // Si ya lo cerró en esta pestaña/sesión, no molestar más
      if (sessionStorage.getItem(STORAGE_KEY)) return;

      const now = new Date();
      const hour = now.getHours();

      // Madrugada universitaria: entre la 1:00 AM y las 5:59 AM
      // (Opcional para pruebas manuales si la URL tiene ?test_night=1)
      const isTest = new URLSearchParams(window.location.search).has("test_night");
      const isLateNight = (hour >= 1 && hour < 6) || isTest;

      if (!isLateNight) return;

      const toast = document.getElementById("nocturnal-toast");
      const timePill = document.getElementById("nocturnal-time-pill");
      const closeBtn = document.getElementById("nocturnal-close-btn");
      const ackBtn = document.getElementById("btn-nocturnal-ack");

      if (!toast) return;

      if (timePill) {
        const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        timePill.textContent = timeStr;
      }

      // Mostrar con sutil retardo de 1.5s para no interrumpir la carga
      setTimeout(() => {
        toast.style.display = "block";
      }, 1500);

      const dismiss = () => {
        toast.style.animation = "toast-slide-up 0.25s ease reverse forwards";
        setTimeout(() => {
          toast.remove();
        }, 260);
        try {
          sessionStorage.setItem(STORAGE_KEY, "true");
        } catch (e) {}
      };

      if (closeBtn) closeBtn.addEventListener("click", dismiss);
      if (ackBtn) ackBtn.addEventListener("click", dismiss);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", checkNocturnal);
    } else {
      checkNocturnal();
    }
  })();
</script>

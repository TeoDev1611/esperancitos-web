---
// DeepLinksSection.astro - Integración con la App Móvil (Esquema pilas://)
---

<section class="deeplinks-section scroll-reveal" id="deeplinks">
  <div class="container">
    <div class="deeplinks-card reveal-init">
      <div class="deeplinks-header">
        <span class="sticker-pill fuchsia">
          ⚡ PROTOCOLO OFICIAL · DEEP LINKS
        </span>
        <h2>¿Ya tienes Pilas! instalada en tu teléfono?</h2>
        <p>
          Usa los enlaces directos del protocolo <code>pilas://</code> para saltar
          instantáneamente a tus pantallas favoritas de la app desde cualquier navegador,
          chat o widget.
        </p>
      </div>

      <!-- Grid de Deep Links Interactivos -->
      <div class="deeplinks-grid">
        <!-- Deep Link 1: Horario -->
        <div class="deeplink-item">
          <div class="dl-meta">
            <span class="dl-code">pilas://schedule</span>
            <h4>Mi Horario Semanal</h4>
            <p>
              Abre directamente tu horario con aulas resueltas y bloque
              correspondiente.
            </p>
          </div>
          <button
            type="button"
            class="link-deep"
            data-deep="schedule"
            aria-label="Abrir Horario en la App"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Abrir Mi Horario</span>
          </button>
        </div>

        <!-- Deep Link 2: Tareas -->
        <div class="deeplink-item">
          <div class="dl-meta">
            <span class="dl-code">pilas://assignments</span>
            <h4>Tareas Pendientes Moodle</h4>
            <p>
              Revisa qué entregas vencen hoy con orden de urgencia y alarmas.
            </p>
          </div>
          <button
            type="button"
            class="link-deep"
            data-deep="assignments"
            aria-label="Abrir Tareas en la App"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 11 3 3L22 4"></path>
              <path
                d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
              ></path>
            </svg>
            <span>Ver Mis Tareas</span>
          </button>
        </div>

        <!-- Deep Link 3: Dashboard -->
        <div class="deeplink-item">
          <div class="dl-meta">
            <span class="dl-code">pilas://dashboard</span>
            <h4>Dashboard</h4>
            <p>
              Tu centro de mando con la clase actual, tareas activas y carnet.
            </p>
          </div>
          <button
            type="button"
            class="link-deep"
            data-deep="dashboard"
            aria-label="Abrir Dashboard en la App"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
              ></polygon>
            </svg>
            <span>Ir al Dashboard</span>
          </button>
        </div>
      </div>

      <div class="deeplinks-footer-note">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span
          >Si aún no tienes la app instalada, el enlace te redirigirá
          automáticamente a la sección de descarga.</span
        >
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function openPilasApp(path) {
    const deepLink = `pilas://${path}`;
    const fallbackUrl = "https://pilas-ec.vercel.app/#descargar";

    // Intento de apertura con fallback a descarga
    const start = Date.now();
    window.location.href = deepLink;
    setTimeout(() => {
      if (Date.now() - start < 1500) {
        window.location.href = fallbackUrl;
      }
    }, 1000);
  }

  document.querySelectorAll("[data-deep]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.getAttribute("data-deep");
      if (target) {
        openPilasApp(target);
      }
    });
  });
</script>

<style>
  .deeplinks-section {
    padding: 40px 0 80px 0;
    position: relative;
    background: #101319;
    content-visibility: auto;
    contain-intrinsic-size: auto 450px;
  }

  .deeplinks-card {
    background: #161a23;
    border: 2px solid var(--color-border);
    border-radius: 16px;
    padding: 36px 40px;
    box-shadow: 4px 4px 0px #000000;
  }

  @media (max-width: 640px) {
    .deeplinks-card {
      padding: 24px 20px;
    }
  }

  .deeplinks-header {
    margin-bottom: 32px;
  }

  .deeplinks-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin: 8px 0;
  }

  .deeplinks-header p {
    color: var(--color-text-body);
    font-size: 1rem;
    max-width: 760px;
  }

  .deeplinks-header code {
    background: #000000;
    color: var(--color-primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--color-primary-extrude);
  }

  .deeplinks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }

  @media (max-width: 900px) {
    .deeplinks-grid {
      grid-template-columns: 1fr;
    }
  }

  .deeplink-item {
    background: #1e2230;
    border: 2px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 3px 3px 0px #000000;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .deeplink-item:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  .dl-code {
    display: inline-block;
    background: #000000;
    color: var(--color-success);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid #2a3142;
    margin-bottom: 8px;
  }

  .dl-meta h4 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin-bottom: 6px;
  }

  .dl-meta p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .deeplinks-footer-note {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.84rem;
    color: var(--color-text-muted);
    border-top: 1.5px solid var(--color-border);
    padding-top: 18px;
  }

  .deeplinks-footer-note svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .deeplinks-card {
      padding: 22px 14px;
    }

    .deeplink-item {
      padding: 16px 14px;
    }

    .link-deep {
      width: 100%;
      justify-content: center;
    }
  }
</style>

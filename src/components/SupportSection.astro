---
// SupportSection.astro - Sección de Apoyo al Proyecto (Deuna + QR)
import { DONATION_CONFIG, DEUNA_LINK_READY } from '../config/donation';

const { deunaLink, deunaHolder, qrImage, goals } = DONATION_CONFIG;
const hasDeunaLink = DEUNA_LINK_READY && deunaLink.trim().length > 0 && !deunaLink.includes('tu-enlace-de-cobro');
---

<section class="support-section scroll-reveal" id="apoyar">
  <div class="container">
    <div class="section-header reveal-init">
      <span class="section-kicker amber">Hecho por un estudiante</span>
      <h2>Ayúdanos a llegar a la Play Store</h2>
      <p>
        Publicar la app en la tienda oficial de Google cuesta <strong>25 dólares, una sola vez</strong>. Con eso dejamos de depender de las descargas por enlace y <strong>cualquiera podrá instalarla en dos toques</strong>. La descarga siempre será gratuita y sin publicidad invasiva.
      </p>
    </div>

    <div class="support-wrapper card-app amber-accent reveal-init">
      <div class="support-grid">
        
        <!-- Columna Izquierda: Mensaje + métodos de aporte -->
        <div class="support-text-col reveal-init reveal-left">
          <div class="support-badge-row">
            <span class="badge-app green">Ningún estudiante paga nada para usarla</span>
          </div>

          <h3>En qué se usa tu aporte</h3>
          <p class="support-lead-p">
            Pilas! la hago yo, un estudiante politécnico como tú, en mi tiempo libre. No hay empresa detrás ni publicidad que lo financie, así que los gastos salen del bolsillo. ¡Ponte pilas y apoya al proyecto! Esto es exactamente a lo que se destina lo recaudado:
          </p>

          <!-- Destino de los aportes -->
          <ul class="goals-list">
            {goals.map((goal) => (
              <li class="goal-item">
                <span class:list={['goal-check', goal.status === 'listo' ? 'done' : 'pending']} aria-hidden="true">
                  {goal.status === 'listo' ? '✓' : '→'}
                </span>
                <span class="goal-text">
                  <strong>{goal.label}</strong>
                  <small>{goal.detail}</small>
                </span>
                <span class:list={['goal-status', goal.status === 'listo' ? 'done' : 'active']}>{goal.status}</span>
              </li>
            ))}
          </ul>

          <!-- MÉTODO PRINCIPAL: Deuna -->
          <div class="deuna-box card-app">
            <div class="deuna-box-top">
              <div class="deuna-icon-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="deuna-svg" aria-hidden="true">
                  <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                  <path d="M12 18h.01"></path>
                </svg>
                <strong>¿Quieres aportar? Usa Deuna</strong>
              </div>
              <span class="deuna-badge">Rápido y sin comisiones</span>
            </div>

            <div class="deuna-body">
              <p class="deuna-hint">
                Toca el botón si estás en el celular, o escanea el código QR de al lado con la app de Deuna. El monto lo eliges tú y no hay mínimo.
              </p>

              <div class="deuna-actions">
                {hasDeunaLink ? (
                  <a
                    href={deunaLink}
                    class="btn-app btn-app-primary btn-deuna"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Abrir el enlace de aporte en Deuna"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>Aportar con Deuna</span>
                  </a>
                ) : (
                  <span class="deuna-missing">
                    El enlace aún no está listo · por ahora usa el código QR
                  </span>
                )}

                <div class="deuna-titular">
                  <span class="deuna-titular-label">A nombre de</span>
                  <div class="deuna-titular-value">
                    <span class="row-value">{deunaHolder}</span>
                    <button type="button" class="btn-app-copy" data-copy={deunaHolder} aria-label="Copiar nombre del titular">
                      <span>Copiar</span>
                    </button>
                  </div>
                </div>

                <p class="deuna-voluntary-notice">
                  Aporte voluntario. No es el pago de un servicio y la ESPE no participa.
                </p>
              </div>
            </div>
          </div>

          <p class="transparency-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block; vertical-align:middle; margin-right:4px; color:var(--accent-primary);">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <em>Transparencia:</em> todo lo que se recaude se usa para pagar el servidor, el dominio y el tiempo que dedico a mantener la app actualizada. Aportar es opcional: la app sigue siendo gratis para todos.
          </p>        </div>

        <!-- Columna Derecha: Código QR de Deuna con escáner láser -->
        <div class="support-qr-col reveal-init reveal-right">
          <div class="qr-display-card card-app" id="qr-target-card">
            <div class="qr-card-header">
              <span class="pulse-circle"></span>
              <span class="qr-card-title">ESCANEA AQUÍ</span>
            </div>

            <div class="qr-viewport">
              <div class="qr-laser-scanner" aria-hidden="true"></div>
              <img 
                src={qrImage}
                alt="Código QR de Deuna para aportar al proyecto Pilas!" 
                class="qr-main-img" 
                width="240" 
                height="240" 
                loading="lazy"
              />
            </div>

            <p class="qr-supported-apps">
              Ábrelo con la app de <strong>Deuna</strong><br/>
              o con cualquier app de banco del Ecuador
            </p>

            <p class="qr-voluntary-notice">
              Aporte voluntario. No es el pago de un servicio y la ESPE no participa.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .support-section {
    padding: 80px 0 100px 0;
  }

  .support-wrapper {
    padding: 44px;
    background: var(--bg-surface);
  }

  .support-grid {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: 50px;
    align-items: center;
  }

  .support-badge-row {
    margin-bottom: 14px;
  }

  .support-text-col h3 {
    font-size: 1.95rem;
    line-height: 1.25;
    margin-bottom: 14px;
  }

  .support-lead-p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  /* ==========================================================================
     Destino de los aportes
     ========================================================================== */
  .goals-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }

  .goal-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 11px 14px;
    transition: transform 220ms var(--ease-spring),
                border-color 220ms ease,
                box-shadow 220ms var(--ease-apple);
  }

  .goal-item:hover {
    transform: translateY(-2px) translateX(3px);
    border-color: rgba(255, 219, 121, 0.45);
    box-shadow: 3px 3px 0px #000;
  }

  .goal-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    font-weight: 900;
    font-size: 0.8rem;
    border: 2px solid #000;
    box-shadow: 1.5px 1.5px 0px #000;
    transition: transform 220ms var(--ease-spring);
  }

  .goal-item:hover .goal-check {
    transform: scale(1.15) rotate(5deg);
  }

  .goal-check.pending {
    background: var(--accent-amber);
    color: var(--on-amber);
  }

  .goal-check.done {
    background: var(--accent-primary);
    color: var(--on-primary);
  }

  .goal-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    flex: 1;
    min-width: 0;
  }

  .goal-text strong {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .goal-text small {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .goal-status {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--border-app);
    background: var(--bg-surface);
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .goal-status.active {
    background: rgba(255, 219, 121, 0.14);
    border-color: rgba(255, 219, 121, 0.5);
    color: var(--accent-amber);
  }

  .goal-status.done {
    background: rgba(0, 255, 135, 0.14);
    border-color: rgba(0, 255, 135, 0.5);
    color: var(--accent-primary);
  }

  /* ==========================================================================
     MÉTODO PRINCIPAL: tarjeta de Deuna
     ========================================================================== */
  .deuna-box {
    background: var(--bg-surface-elevated);
    padding: 0;
    overflow: hidden;
    margin-bottom: 14px;
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-hard-green);
    transition: transform 260ms var(--ease-spring),
                box-shadow 260ms var(--ease-apple),
                border-color 260ms ease;
  }

  .deuna-box:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0px #000000, 0 8px 24px rgba(0, 255, 135, 0.2);
  }

  .deuna-box-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 18px;
    background: rgba(0, 255, 135, 0.1);
    border-bottom: 1.5px solid var(--border-app);
  }

  .deuna-icon-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: var(--accent-primary);
    font-weight: 800;
  }

  .deuna-svg {
    color: var(--accent-primary);
    flex-shrink: 0;
    transition: transform 220ms var(--ease-spring);
  }

  .deuna-box:hover .deuna-svg {
    transform: scale(1.15) rotate(-3deg);
  }

  .deuna-badge {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 800;
    background: var(--accent-primary);
    color: var(--on-primary);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid #000;
    white-space: nowrap;
  }

  .deuna-body {
    padding: 16px 18px;
  }

  .deuna-hint {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .deuna-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .btn-deuna {
    width: 100%;
    padding: 12px 20px;
    font-size: 0.92rem;
  }

  .deuna-missing {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent-amber);
    background: rgba(255, 219, 121, 0.1);
    border: 1px dashed rgba(255, 219, 121, 0.45);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    text-align: center;
  }

  .deuna-titular {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
  }

  .deuna-titular-label {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .deuna-titular-value {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .row-value {
    font-weight: 700;
    color: var(--text-primary);
  }

  .deuna-voluntary-notice,
  .qr-voluntary-notice {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.45;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-app);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    margin-top: 12px;
    text-align: center;
  }

  /* Botón de Copiado Táctil.
     Se envuelve en :global() porque de lo contrario Astro añade un atributo de
     scope que eleva la especificidad por encima de la regla de global.css y
     estas declaraciones (que además no incluían text-transform) ganaban,
     dejando los botones con estilos incoherentes. */
  :global(.btn-app-copy) {
    background: var(--bg-surface);
    border: 1.5px solid var(--border-app);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    box-shadow: 1.5px 1.5px 0px #000;
    cursor: pointer;
    white-space: nowrap;
    text-transform: uppercase;
    transition: background-color 150ms ease,
                border-color 150ms ease,
                color 150ms ease,
                transform 150ms var(--ease-apple),
                box-shadow 150ms var(--ease-apple);
  }

  :global(.btn-app-copy:not(.copied):hover) {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000;
  }

  :global(.btn-app-copy:active) {
    transform: translate(1px, 1px);
    box-shadow: 0px 0px 0px #000;
  }

  :global(.btn-app-copy.copied) {
    background: var(--accent-primary);
    color: var(--on-primary);
    border-color: #000;
    transform: scale(1.05);
  }

  .transparency-note {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Columna QR */
  .support-qr-col {
    display: flex;
    justify-content: center;
  }

  .qr-display-card {
    background: var(--bg-surface-elevated);
    border: 2px solid var(--accent-amber);
    box-shadow: var(--shadow-hard-amber);
    padding: 24px;
    text-align: center;
    max-width: 320px;
    width: 100%;
    transition: transform 260ms var(--ease-spring),
                box-shadow 260ms ease;
  }

  .qr-display-card:hover {
    transform: translateY(-4px) rotate(0.4deg);
    box-shadow: 6px 6px 0px #000, 0 8px 24px rgba(255, 219, 121, 0.22);
  }

  .qr-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .qr-card-title {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--accent-amber);
    letter-spacing: 0.08em;
  }

  .qr-viewport {
    background: #FFFFFF;
    padding: 10px;
    border-radius: var(--radius-md);
    border: 2px solid #000;
    box-shadow: 3px 3px 0px #000;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Láser de Escaneo Verde */
  .qr-laser-scanner {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-primary), 0 0 4px #FFFFFF;
    z-index: 5;
    animation: laser-bounce 2.8s ease-in-out infinite alternate;
  }

  @keyframes laser-bounce {
    0% { top: 4%; }
    100% { top: 94%; }
  }

  .qr-main-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    position: relative;
    z-index: 1;
  }

  .qr-supported-apps {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .qr-supported-apps strong {
    color: var(--text-secondary);
  }

  @media (max-width: 920px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
    .support-wrapper {
      padding: 24px 16px;
    }
    /* El QR pasa debajo del texto: se limita para que no quede desproporcionado */
    .qr-display-card {
      max-width: 340px;
    }
  }

  @media (max-width: 560px) {
    .support-text-col h3 {
      font-size: 1.6rem;
    }

    .deuna-box-top {
      padding: 11px 14px;
    }

    .deuna-badge {
      font-size: 0.62rem;
    }

    .deuna-body {
      padding: 14px;
    }

    .goal-item {
      flex-wrap: wrap;
      gap: 10px;
    }

    .goal-status {
      margin-left: 38px;
    }

    .deuna-titular {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .deuna-titular-value {
      width: 100%;
      justify-content: space-between;
      gap: 8px;
    }

    .row-value {
      min-width: 0;
      overflow-wrap: anywhere;
    }
  }
</style>

<script>
  // Copiado al portapapeles con confirmación animada "✓ Copiado".
  // El rótulo vive dentro de un <span>, así que se actualiza ESE span: antes se
  // reemplazaba el textContent del botón, lo que borraba el span, dejaba texto
  // suelto y hacía que la restauración perdiera el estilo original.
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('.support-text-col .btn-app-copy');

  copyButtons.forEach(btn => {
    const label = btn.querySelector('span') ?? btn;
    const originalText = label.textContent ?? 'Copiar';
    let resetTimer: number | undefined;

    btn.addEventListener('click', async () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (!textToCopy) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch (_) {
        // Fallback para navegadores sin permiso de clipboard (p. ej. sin HTTPS)
        const helper = document.createElement('textarea');
        helper.value = textToCopy;
        helper.setAttribute('readonly', '');
        helper.style.position = 'fixed';
        helper.style.opacity = '0';
        document.body.appendChild(helper);
        helper.select();
        try {
          document.execCommand('copy');
        } catch (_) {
          helper.remove();
          return;
        }
        helper.remove();
      }

      label.textContent = '✓ Copiado';
      btn.classList.add('copied');

      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        label.textContent = originalText;
        btn.classList.remove('copied');
      }, 2000);
    });
  });
</script>

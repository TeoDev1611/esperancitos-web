---
// PainPointsSection.astro - Sección de Dolores con Selector Dual de Universidad (ESPE vs Multi-U)
interface Props {
  initialMood?: 'espe' | 'multi';
  showSelector?: boolean;
}

const { initialMood = 'espe', showSelector = true } = Astro.props;
const isEspe = initialMood === 'espe';
---

<section class="pain-section scroll-reveal" id="problemas">
  <div id="dolores" style="position: absolute; top: -80px;"></div>
  <div class="container">
    <div class="section-header reveal-init">
      <span class="sticker-pill" style="background: #FFDB79; color: #000; margin-bottom: 14px;">
        {isEspe ? '¿TE HA PASADO EN LA ESPE? · DOLORES DEL SEMESTRE' : '¿TE HA PASADO? · DOLORES REALES DE LA U'}
      </span>
      <h2 id="pain-heading">
        {isEspe ? 'Los problemas de siempre en la ESPE, resueltos' : 'Los dolores universitarios del Ecuador, resueltos'}
      </h2>
      <p id="pain-subheading">
        {isEspe
          ? 'Estudiar en la ESPE ya es bastante exigente como para perder tiempo con MiESPE caído a las 6:58 AM, notas a ciegas o aulas dudosas.'
          : 'Estudiar ya es bastante exigente como para perder tiempo con servidores caídos a medianoche, PDFs rebotados por Moodle o notas a ciegas.'}
      </p>

      {showSelector ? (
        <div class="mood-selector-wrapper">
          <span class="mood-label">ELIGE TU CAMPUS / UNIVERSIDAD:</span>
          <div class="mood-toggle-container" role="tablist" aria-label="Elige tu universidad">
            <button
              type="button"
              class:list={["mood-tab-btn", { active: isEspe }]}
              data-mood="espe"
              role="tab"
              aria-selected={isEspe}
              id="tab-mood-espe"
            >
              <span class="mood-tag espe">ESPE</span>
              <span class="mood-name">Modo ESPE</span>
              <span class="mood-campus-hint">Sangolquí · Latacunga · Sto. Domingo</span>
            </button>
            <button
              type="button"
              class:list={["mood-tab-btn", { active: !isEspe }]}
              data-mood="multi"
              role="tab"
              aria-selected={!isEspe}
              id="tab-mood-multi"
            >
              <span class="mood-tag multi">MULTI-U</span>
              <span class="mood-name">Modo Multi-Universidad</span>
              <span class="mood-campus-hint">UCE · EPN · PUCE · ESPOL · Moodle</span>
            </button>
          </div>
        </div>
      ) : (
        <div class="pain-campus-tagline">
          {isEspe ? (
            <span>🟢 Modo ESPE · Sangolquí · Latacunga · Santo Domingo · <a href="/multi-u">¿Estudias en otra U? Ver Multi-U →</a></span>
          ) : (
            <span>🟣 Modo Multi-Universidad · Moodle Universal Ecuador · <a href="/espe">¿Estudias en la ESPE? Ver versión ESPE →</a></span>
          )}
        </div>
      )}
    </div>

    <!-- Layout: Mascota con Speech Bubble Reactivo + Grid de Dolores -->
    <div class="pain-showcase-layout">
      <!-- Columna Mascota (Variación 2: Alerta / "Algo está mal") -->
      <div class="pain-mascot-col reveal-init">
        <div class="pain-mascot-frame">
          <img
            src="/logos/icono_var2_sin_fondo.svg"
            alt="Pilo en alerta y preocupación"
            class="mascot-img pain-mascot-img"
            width="280"
            height="280"
            loading="lazy"
          />
          <div class="pain-speech-bubble" id="pain-speech-bubble" style={isEspe ? "background: #FF3D5E;" : "background: #FF3FA4;"}>
            <span class="speech-tag" id="speech-tag">{isEspe ? "¡CHUTA! 🤦‍♂️" : "¡NO PUEDE SER! 📑"}</span>
            <p id="speech-text">
              {isEspe ? "¡Otra vez MiESPE caído a las 6:58 AM en el Bloque G!" : "¡Moodle me rechazó el PDF por pesar más de 2MB y son las 23:57!"}
            </p>
          </div>
        </div>
      </div>

      <!-- Contenido 1: MODO ESPE -->
      <div class:list={["pain-cards-grid", "mood-grid", { active: isEspe }]} id="grid-espe" style={isEspe ? "display: grid;" : "display: none;"}>
        <!-- Dolor 1 ESPE: MiESPE Caído -->
        <article class="pilas-card pain-card">
          <div class="pain-card-header">
            <span class="pain-badge critical">BLOQUE G · 6:58 AM</span>
            <div class="pain-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
          </div>
          <h3>MiESPE y Banner colgados cuando vas a ver tu aula</h3>
          <p>
            Son las <strong>6:58 AM</strong>, no hay señal en el Bloque G y el portal web no responde. No sabes si tu clase es en el Lab de Fluidos o en el <code>G-201</code>. Con Pilas!, tu horario completo y traducción exacta de bloques están <strong>100% en tu teléfono sin internet</strong>.
          </p>

          <!-- Micro-Tool 1: Decodificador Banner Interactivo en Vivo -->
          <div class="interactive-micro-tool decoder-tool-box">
            <span class="micro-tool-label">⚡ PRUÉBALO EN VIVO: TOCA UN CÓDIGO BANNER</span>
            <div class="decoder-chips-row" role="group" aria-label="Ejemplos de códigos de aula">
              <button type="button" class="btn-decoder-chip active" data-code="BLOQ G AUL 201" data-trans="🏢 Bloque G · Piso 2 · Aula 201 (Ingeniería Mecánica)">BLOQ G AUL 201</button>
              <button type="button" class="btn-decoder-chip" data-code="BLOQ H LAB FLUID" data-trans="🏢 Bloque H · Planta Baja · Lab. Fluidos e Hidráulica">BLOQ H LAB FLUID</button>
              <button type="button" class="btn-decoder-chip" data-code="BLOQ B AUL 304" data-trans="🏢 Bloque B · Piso 3 · Aula 304 (Sistemas y Software)">BLOQ B AUL 304</button>
            </div>
            <div class="decoder-live-display">
              <span class="decoder-cursor">></span>
              <span class="decoder-output" id="decoder-output-text">🏢 Bloque G · Piso 2 · Aula 201 (Ingeniería Mecánica)</span>
              <span class="decoder-pill">100% OFFLINE</span>
            </div>
          </div>

          <div class="pain-solution-tag">
            <span class="check-dot">✓</span>
            <span>Resuelto: Horario traducido con aulas exactas</span>
          </div>
        </article>

        <!-- Dolor 2 ESPE: El 14.01 y los 42 puntos -->
        <article class="pilas-card pain-card">
          <div class="pain-card-header">
            <span class="pain-badge warning">REGLA 42/60 PTS · EL MÍTICO 14.01</span>
            <div class="pain-icon-box amber">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                <line x1="8" x2="16" y1="6" y2="6"></line>
                <line x1="16" x2="16" y1="14" y2="18"></line>
                <path d="M16 10h.01"></path>
                <path d="M12 10h.01"></path>
                <path d="M8 10h.01"></path>
                <path d="M12 14h.01"></path>
                <path d="M8 14h.01"></path>
                <path d="M12 18h.01"></path>
                <path d="M8 18h.01"></path>
              </svg>
            </div>
          </div>
          <h3>No sabes con cuánto pasas o si te quedas a suspensión</h3>
          <p>
            Haciendo cuentas en servilletas con decimales dudosos sin saber si necesitas 14.01 o si repites la materia directo. Nuestro simulador oficial ESPE aplica la regla de <strong>42 puntos acumulados</strong> y predice exactamente tu nota final.
          </p>

          <!-- Micro-Tool 2: Simulador 14.01 Interactivo en Vivo -->
          <div class="interactive-micro-tool calc-1401-tool-box">
            <span class="micro-tool-label">⚡ SIMULA TUS NOTAS EN TIEMPO REAL:</span>
            <div class="calc-sliders-grid">
              <div class="slider-field">
                <div class="slider-header-row">
                  <span>Parcial 1:</span>
                  <strong class="slider-val-badge" id="lbl-p1">13.5</strong>
                </div>
                <input type="range" id="input-p1" min="0" max="20" step="0.5" value="13.5" class="custom-range-slider" aria-label="Nota Parcial 1" />
              </div>
              <div class="slider-field">
                <div class="slider-header-row">
                  <span>Parcial 2:</span>
                  <strong class="slider-val-badge" id="lbl-p2">14.0</strong>
                </div>
                <input type="range" id="input-p2" min="0" max="20" step="0.5" value="14.0" class="custom-range-slider" aria-label="Nota Parcial 2" />
              </div>
            </div>

            <div class="calc-dynamic-card">
              <div class="calc-stat-line">
                <span class="stat-lbl">Acumulado P1 + P2:</span>
                <strong class="stat-num" id="stat-acumulado">27.5 / 60</strong>
              </div>
              <div class="calc-stat-line highlight">
                <span class="stat-lbl">Necesitas en Parcial 3:</span>
                <strong class="stat-num glow" id="stat-needed">14.50</strong>
              </div>
              <div class="calc-status-callout" id="calc-status-callout">
                <span>🎯 Con 14.50 sumas 42.0 pts y salvas el semestre con 14.00</span>
              </div>
            </div>
          </div>

          <div class="pain-solution-tag">
            <span class="check-dot">✓</span>
            <span>Resuelto: Simulador oficial "¿Con cuánto paso?"</span>
          </div>
        </article>

        <!-- Dolor 3 ESPE: miCampus Moodle 23:55 -->
        <article class="pilas-card pain-card">
          <div class="pain-card-header">
            <span class="pain-badge alert">ENTREGAS 23:55 PM</span>
            <div class="pain-icon-box coral">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                <line x1="1" x2="23" y1="1" y2="23"></line>
              </svg>
            </div>
          </div>
          <h3>miCampus se satura y la tarea se cierra en tu cara</h3>
          <p>
            A las <strong>23:55</strong> todo el mundo intenta subir el laboratorio al mismo tiempo y la plataforma colapsa. Pilas! te despierta con una <strong>alarma sonora continua a pantalla completa</strong> para que entregues con tiempo y descargues tus diapositivas offline.
          </p>

          <!-- Micro-Tool 3: Simulador Alarma 23:55 en Vivo -->
          <div class="interactive-micro-tool alarm-tool-box">
            <span class="micro-tool-label">⚡ SIMULA LA ALARMA ANTI-DORMIRSE:</span>
            <div class="alarm-clock-bar">
              <div class="clock-display">
                <span class="clock-icon">⏰</span>
                <span class="clock-digits" id="clock-display-val">23:54:55</span>
              </div>
              <button type="button" class="btn-fire-alarm" id="btn-fire-alarm">
                <span>¡Probar Alarma! 🔔</span>
              </button>
            </div>
            <div class="alarm-live-toast" id="alarm-live-toast" style="display: none;">
              <span class="alarm-toast-pill">🚨 ALARMA SONORA EN PANTALLA COMPLETA</span>
              <p>¡Pilas! Faltan 5 minutos. Tu laboratorio está respaldado 100% offline.</p>
            </div>
          </div>

          <div class="pain-solution-tag">
            <span class="check-dot">✓</span>
            <span>Resuelto: Alarma despertador anti-23:55</span>
          </div>
        </article>
      </div>

      <!-- Contenido 2: MODO MULTI-UNIVERSIDAD (Universal) -->
      <div class:list={["pain-cards-grid", "mood-grid", { active: !isEspe }]} id="grid-multi" style={!isEspe ? "display: grid;" : "display: none;"}>
        <!-- Dolor 1 Multi-U: PDF pesado rebotado por Moodle -->
        <article class="pilas-card pain-card">
          <div class="pain-card-header">
            <span class="pain-badge critical">LÍMITE 2MB - 5MB · REBOTADO</span>
            <div class="pain-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <line x1="9" y1="15" x2="15" y2="15"></line>
              </svg>
            </div>
          </div>
          <h3>Moodle te rechaza el deber por exceso de peso a las 23:57</h3>
          <p>
            Tomas fotos a tu informe, el PDF pesa 18 MB y el Moodle de tu universidad solo permite 2 MB o 5 MB. Vas a webs de compresión llenas de anuncios y virus. Pilas! incluye un <strong>Compresor PDF offline</strong> que reduce tu archivo a menos de 3 MB en 2 segundos en tu propio celular.
          </p>

          <!-- Micro-Tool 4: Simulador de Compresión PDF Moodle -->
          <div class="interactive-micro-tool compress-tool-box">
            <span class="micro-tool-label">⚡ PRUEBA LA COMPRESIÓN OFFLINE EN VIVO:</span>
            <div class="compress-panel">
              <div class="compress-file-row">
                <span class="doc-icon">📑</span>
                <span class="doc-name">informe_laboratorio.pdf</span>
                <span class="doc-badge-orig" id="compress-file-orig">24.8 MB ❌</span>
              </div>
              <button type="button" class="btn-run-compress" id="btn-run-compress">
                <span>Comprimir en 1 Clic</span>
              </button>
              <div class="compress-track" id="compress-track" style="display: none;">
                <div class="compress-fill" id="compress-fill"></div>
              </div>
              <div class="compress-success-banner" id="compress-success-banner" style="display: none;">
                <span class="compress-check">✓ REDUCIDO A 1.84 MB (-92%)</span>
                <small>¡Listo para subir a Moodle sin error de peso!</small>
              </div>
            </div>
          </div>

          <div class="pain-solution-tag">
            <span class="check-dot">✓</span>
            <span>Resuelto: Compresor PDF offline de 25MB a 2MB</span>
          </div>
        </article>

        <!-- Dolor 2 Multi-U: Portales lentos y sin señal -->
        <article class="pilas-card pain-card">
          <div class="pain-card-header">
            <span class="pain-badge warning">PORTALES LENTOS · SIN SEÑAL</span>
            <div class="pain-icon-box amber">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
          </div>
          <h3>Entrar a la intranet de tu facultad cada vez que buscas tu aula</h3>
          <p>
            Los sistemas universitarios son lentos, piden doble autenticación y en los pasillos no hay señal. Con Pilas!, vinculas tu Moodle mediante escáner QR (<code>moodlemobile://</code>) una sola vez y consultas tus horarios y tareas <strong>100% offline</strong>.
          </p>

          <!-- Micro-Tool 5: Token QR Moodle Mobile -->
          <div class="interactive-micro-tool qr-tool-box">
            <span class="micro-tool-label">⚡ CONEXIÓN DIRECTA POR QR (MOODLE MOBILE):</span>
            <div class="qr-protocol-row">
              <div class="qr-badge-preview">
                <span class="qr-mini-icon">📱</span>
                <code>moodlemobile://token=ec_auth_token</code>
              </div>
              <span class="qr-status-pill">CERO CONTRASEÑAS EN LA NUBE</span>
            </div>
          </div>

          <div class="pain-solution-tag">
            <span class="check-dot">✓</span>
            <span>Resuelto: Vinculación QR instantánea y offline</span>
          </div>
        </article>

        <!-- Dolor 3 Multi-U: Carátulas, firmas y horas huecas -->
        <article class="pilas-card pain-card">
          <div class="pain-card-header">
            <span class="pain-badge alert">TRÁMITES & GRUPOS</span>
            <div class="pain-icon-box coral">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
          </div>
          <h3>Gastar en impresiones para firmar y horas huecas desaprovechadas</h3>
          <p>
            Corriendo a un ciber para imprimir un trámite solo por firmarlo, o sin saber cuándo tus amigos tienen tiempo libre para hacer un trabajo grupal. Pilas! te permite <strong>estampar tu firma transparente</strong> en PDFs y <strong>cruzar horarios por QR sin internet</strong>.
          </p>
          <div class="pain-solution-tag">
            <span class="check-dot">✓</span>
            <span>Resuelto: Firma digital manuscrita + Cruce P2P</span>
          </div>
        </article>
      </div>
    </div>

    <!-- Banner Conector hacia las Características -->
    <div class="pain-bottom-banner reveal-init">
      <div class="banner-sticker" id="banner-sticker-text">⚡ TRANQUILO, ÑAÑO</div>
      <div class="banner-text">
        <h3 id="banner-h3">Con Pilas!, todo esto queda completamente resuelto</h3>
        <p id="banner-p">Una app ultra rápida, privada y 100% gratuita que te da una ventaja injusta en el semestre.</p>
      </div>
      <a href="#funciones" class="btn-pilas-primary">
        <span>Ver todas las funciones</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Lógica interactiva para alternar entre el Modo ESPE y Modo Multi-Universidad
  const buttons = document.querySelectorAll<HTMLButtonElement>('.mood-tab-btn');
  const gridEspe = document.getElementById('grid-espe');
  const gridMulti = document.getElementById('grid-multi');
  const speechBubble = document.getElementById('pain-speech-bubble');
  const speechTag = document.getElementById('speech-tag');
  const speechText = document.getElementById('speech-text');
  const painHeading = document.getElementById('pain-heading');

  function setMood(mood: 'espe' | 'multi') {
    buttons.forEach((btn) => {
      const isSelected = btn.dataset.mood === mood;
      btn.classList.toggle('active', isSelected);
      btn.setAttribute('aria-selected', String(isSelected));
    });

    if (mood === 'espe') {
      if (gridEspe) gridEspe.style.display = 'grid';
      if (gridMulti) gridMulti.style.display = 'none';
      if (speechTag) speechTag.textContent = '¡CHUTA! 🤦‍♂️';
      if (speechText) speechText.textContent = '¡Otra vez MiESPE caído a las 6:58 AM en el Bloque G!';
      if (painHeading) painHeading.textContent = 'Los problemas de siempre en la ESPE, resueltos';
      if (speechBubble) {
        speechBubble.style.borderColor = '#000000';
        speechBubble.style.background = '#FF3D5E';
      }
    } else {
      if (gridEspe) gridEspe.style.display = 'none';
      if (gridMulti) gridMulti.style.display = 'grid';
      if (speechTag) speechTag.textContent = '¡NO PUEDE SER! 📑';
      if (speechText) speechText.textContent = '¡Moodle me rechazó el PDF por pesar más de 2MB y son las 23:57!';
      if (painHeading) painHeading.textContent = 'Los dolores universitarios del Ecuador, resueltos';
      if (speechBubble) {
        speechBubble.style.borderColor = '#000000';
        speechBubble.style.background = '#FF3FA4';
      }
    }

    // Guardar preferencia
    try {
      localStorage.setItem('pilas_user_mood', mood);
    } catch {}
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mood = (btn.dataset.mood ?? 'espe') as 'espe' | 'multi';
      setMood(mood);
    });
  });

  // Cargar preferencia guardada si existe
  try {
    const savedMood = localStorage.getItem('pilas_user_mood') as 'espe' | 'multi' | null;
    if (savedMood === 'multi') {
      setMood('multi');
    }
  } catch {}

  // 1. Decodificador Banner Interactivo
  const decoderChips = document.querySelectorAll<HTMLButtonElement>('.btn-decoder-chip');
  const decoderOutput = document.getElementById('decoder-output-text');
  decoderChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      decoderChips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      if (decoderOutput) {
        decoderOutput.textContent = chip.dataset.trans ?? '';
      }
    });
  });

  // 2. Simulador 14.01 Interactivo
  const p1Input = document.getElementById('input-p1') as HTMLInputElement | null;
  const p2Input = document.getElementById('input-p2') as HTMLInputElement | null;
  const p1Lbl = document.getElementById('lbl-p1');
  const p2Lbl = document.getElementById('lbl-p2');
  const statAcum = document.getElementById('stat-acumulado');
  const statNeed = document.getElementById('stat-needed');
  const statCallout = document.getElementById('calc-status-callout');

  function update1401() {
    if (!p1Input || !p2Input) return;
    const p1 = parseFloat(p1Input.value);
    const p2 = parseFloat(p2Input.value);
    if (p1Lbl) p1Lbl.textContent = p1.toFixed(1);
    if (p2Lbl) p2Lbl.textContent = p2.toFixed(1);

    const acum = p1 + p2;
    const needed = Math.max(0, 42 - acum);

    if (statAcum) statAcum.textContent = `${acum.toFixed(1)} / 60`;
    if (statNeed) {
      if (needed <= 0) {
        statNeed.textContent = '0.00 (¡YA PASASTE!)';
      } else if (needed > 20) {
        statNeed.textContent = `${needed.toFixed(2)} (Suspensión)`;
      } else {
        statNeed.textContent = needed.toFixed(2);
      }
    }

    if (statCallout) {
      if (needed <= 0) {
        statCallout.innerHTML = `<span>🎉 ¡Ya tienes ${acum.toFixed(1)} puntos acumulados! Materia aprobada.</span>`;
        statCallout.style.background = 'rgba(0, 255, 135, 0.15)';
      } else if (needed > 20) {
        statCallout.innerHTML = `<span>⚠️ Requieres más de 20 en P3. Tendrías que ir a Examen de Suspensión.</span>`;
        statCallout.style.background = 'rgba(255, 61, 94, 0.15)';
      } else {
        statCallout.innerHTML = `<span>🎯 Sacando ${needed.toFixed(2)} en P3 sumas 42.0 pts y salvas el semestre con 14.00</span>`;
        statCallout.style.background = 'rgba(255, 219, 121, 0.15)';
      }
    }
  }

  p1Input?.addEventListener('input', update1401);
  p2Input?.addEventListener('input', update1401);

  // 3. Simulador Alarma 23:55
  const btnFireAlarm = document.getElementById('btn-fire-alarm');
  const alarmToast = document.getElementById('alarm-live-toast');
  const clockVal = document.getElementById('clock-display-val');

  btnFireAlarm?.addEventListener('click', () => {
    if (alarmToast) {
      alarmToast.style.display = 'block';
    }
    if (clockVal) {
      clockVal.textContent = '23:55:00 🚨';
      clockVal.style.color = '#FF3D5E';
    }
  });

  // 4. Simulador Compresor PDF
  const btnCompress = document.getElementById('btn-run-compress');
  const track = document.getElementById('compress-track');
  const fill = document.getElementById('compress-fill');
  const successBanner = document.getElementById('compress-success-banner');
  const origSizeBadge = document.getElementById('compress-file-orig');

  btnCompress?.addEventListener('click', () => {
    if (!track || !fill || !successBanner) return;
    track.style.display = 'block';
    fill.style.width = '0%';
    successBanner.style.display = 'none';

    let progress = 0;
    const interval = setInterval(() => {
      progress += 25;
      fill.style.width = `${progress}%`;
      if (progress >= 100) {
        clearInterval(interval);
        setTimeout(() => {
          track.style.display = 'none';
          successBanner.style.display = 'block';
          if (origSizeBadge) {
            origSizeBadge.textContent = '1.84 MB ✅';
            origSizeBadge.style.background = '#00FF87';
            origSizeBadge.style.color = '#000000';
          }
        }, 300);
      }
    }, 100);
  });

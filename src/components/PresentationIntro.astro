---
interface Props {
  V: any;
  M: any;
}

const { V, M } = Astro.props;
---

<div id="intro" role="dialog" aria-modal="true" aria-label="Presentación de Pilas!" data-m={JSON.stringify(M)} data-v={JSON.stringify(V)}>
  <div class="beam" aria-hidden="true"></div>
  <div class="film" aria-hidden="true">
    <i class="scr" style="left:23%"></i>
    <i class="scr" style="left:71%;animation-delay:-1.1s"></i>
  </div>

  <div class="intro-theater-wrap">
    <!-- Barra Superior -->
    <header class="intro-top-bar">
      <div class="intro-brand">
        <div class="intro-brand-logo-pill" title="Pilas! App Estudiantil">
          <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="intro-logo-img" width="130" height="44" />
        </div>
        <span class="badge b-info hide-xs">
          <svg class="ico"><use href="#i-info"/></svg>
          v{V.version} · Build {V.build}
        </span>
      </div>
      <div class="intro-actions">
        <a class="btn btn-p btn-sm" id="idl" href="#acceso">
          <svg class="ico"><use href="#i-play"/></svg><span class="hide-xs">Pedir </span>Acceso
        </a>
        <button class="btn btn-s btn-sm" id="iskip" type="button">
          Saltar<span class="hide-xs"> al Hub</span> ➔
        </button>
      </div>
    </header>

    <!-- Pantalla de Proyección Widescreen 16:9 Centrada -->
    <main class="intro-canvas-wrap">
      <div class="screen" id="sl" aria-live="off"></div>
      <div class="sr" id="sr" aria-live="polite"></div>
    </main>

    <!-- Escenario: Mascota Animada + Diálogo / Subtítulo Retro -->
    <section class="intro-stage" aria-label="Comentarios del presentador">
      <div class="mascot-frame">
        <img id="mas" class="mas" src={M.scared} alt="Pilo, mascota de Pilas!" width="110" height="110" />
        <span class="mascot-nameplate">PILO</span>
      </div>
      <div class="speech-container" aria-live="off">
        <div class="sub" id="sub" aria-hidden="true">
          <div class="sub-top-line">
            <span class="sub-speaker-tag">🎙️ PRESENTADOR EN VIVO</span>
            <small id="cue" class="sub-cue"></small>
          </div>
          <span class="sub-text-line" id="subt"></span>
        </div>
        <p class="bubble" id="say" aria-hidden="true"></p>
      </div>
    </section>

    <!-- Barra de Controles Inferior -->
    <footer class="intro-bottom-bar">
      <div class="bat-wrap" aria-label="Progreso de la exposición">
        <span class="bat-label hide-xs">DIAPOSITIVA</span>
        <div class="bat" aria-hidden="true"><div class="bat-body" id="imeter"></div></div>
        <span class="cnt num" id="icount">1 de 6</span>
      </div>
      <div class="intro-ctls-right">
        <button class="btn btn-s btn-sm" id="icc" type="button" aria-pressed="true" title="Cambiar modo retro">
          <span id="icc-ico">🎞️</span> <span id="icc-txt" class="hide-xs">Modo retro: Activo</span>
        </button>
        <button class="btn btn-s btn-sm" id="iprev" type="button" aria-label="Diapositiva anterior" hidden>
          ⬅ <span class="hide-xs">Anterior</span>
        </button>
        <button class="btn btn-p btn-sm" id="inext" type="button">
          <span>Siguiente</span> ➔
        </button>
        <div id="ichoice" class="intro-choice-group" hidden>
          <button class="btn btn-ghost btn-sm" id="iswitch" type="button" title="Cambiar universidad"></button>
          <button class="btn btn-p btn-sm" id="ifinish" type="button">⚡ Entrar a Pilas ESPE ➔</button>
        </div>
      </div>
    </footer>
  </div>
</div>

<style is:global>
  @import '../styles/intro.css';
</style>

<script>
  import { initIntroPresentation } from '../scripts/intro-timeline';
  initIntroPresentation();
</script>

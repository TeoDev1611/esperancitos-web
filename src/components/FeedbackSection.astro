---
// FeedbackSection.astro - Reporte de bugs, sugerencias de funciones y contacto
import { FEEDBACK_CONFIG, enabledChannels, TALLY_CONFIG } from '../config/feedback';
import { SITE } from '../config/site';

const channels = enabledChannels();
const { responseTime } = FEEDBACK_CONFIG;
const supportEmail = SITE.social.email;

const iconPaths: Record<string, string> = {
  bug: '<circle cx="12" cy="12" r="8"></circle><path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M6.3 6.3 4.9 4.9M19.1 19.1l-1.4-1.4M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path><path d="M9 10h.01M15 10h.01M9.5 15a3.5 3.5 0 0 0 5 0"></path>',
  sparkles: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path><path d="M18.5 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"></path>',
  star: '<polygon points="12 2 15.1 8.6 22 9.5 17 14.3 18.2 21.2 12 17.9 5.8 21.2 7 14.3 2 9.5 8.9 8.6 12 2"></polygon>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m2 7 10 6 10-6"></path>',
};
---

<section class="feedback-section scroll-reveal" id="comentarios">
  <div class="container">
    <div class="section-header reveal-init">
      <div class="sticker-pill" style="background: #FFE500; margin-bottom: 12px;">💬 COMUNIDAD & FEEDBACK</div>
      <h2>¿Algo no funciona o se te ocurre una idea?</h2>
      <p>
        Esta app se mejora con lo que reportan los estudiantes. Si algo falla o si se te ocurre una función útil, escríbeme: leo y respondo todos los mensajes.
      </p>
    </div>

    <!-- Tarjeta Brutalista de Contacto Directo y Formulario Tally -->
    <div class="direct-contact-banner card-app reveal-init">
      <div class="direct-contact-info">
        <span class="sticker-pill fuchsia" style="margin-bottom: 8px;">SOPORTE DIRECTO</span>
        <h3>Formulario oficial o contacto directo</h3>
        <p>Abre el formulario interactivo en un toque o escribe directamente al correo:</p>
        <span class="direct-email-code">{supportEmail}</span>
      </div>
      <div class="direct-contact-cta">
        <button
          type="button"
          class="btn-pilas-primary direct-btn"
          data-tally-open={TALLY_CONFIG.formId}
          data-tally-overlay={TALLY_CONFIG.overlay}
          data-tally-emoji-text={TALLY_CONFIG.emojiText}
          data-tally-emoji-animation={TALLY_CONFIG.emojiAnimation}
          data-tally-auto-close={TALLY_CONFIG.autoClose}
          aria-label="Abrir formulario web de reporte y sugerencias en ventana emergente"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Abrir Formulario de Soporte</span>
        </button>
        <a
          href={`mailto:${supportEmail}?subject=Feedback%20Pilas!%20Web/App`}
          class="direct-mail-fallback-link"
          aria-label={`O enviar correo directo a ${supportEmail}`}
        >
          O escribe a <code>{supportEmail}</code>
        </a>
      </div>
    </div>

    <div class="feedback-grid">
      {channels.map((channel) => {
        const hasUrl = channel.url.trim().length > 0;
        const tallyId = channel.tallyId || TALLY_CONFIG.formId;
        const tallyHash = `#tally-open=${tallyId}&tally-overlay=${TALLY_CONFIG.overlay}&tally-emoji-text=${TALLY_CONFIG.emojiText}&tally-emoji-animation=${TALLY_CONFIG.emojiAnimation}&tally-auto-close=${TALLY_CONFIG.autoClose}`;
        return (
          <article class:list={['feedback-card', 'card-app', `accent-${channel.accent}`, 'reveal-init']}>
            <div class="feedback-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[channel.icon]} />
            </div>

            <h3>{channel.description}</h3>
            <p class="feedback-hint">{channel.hint}</p>

            {hasUrl ? (
              <a
                href={tallyHash}
                class="btn-app feedback-btn"
                data-tally-open={tallyId}
                data-tally-overlay={TALLY_CONFIG.overlay}
                data-tally-emoji-text={TALLY_CONFIG.emojiText}
                data-tally-emoji-animation={TALLY_CONFIG.emojiAnimation}
                data-tally-auto-close={TALLY_CONFIG.autoClose}
                aria-label={`${channel.label} (abre el formulario emergente de Tally)`}
              >
                <span>{channel.label}</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            ) : (
              <span class="btn-app feedback-btn is-pending" aria-disabled="true" title="Formulario aún no publicado">
                <span>{channel.label}</span>
                <span class="pending-tag">Próximamente</span>
              </span>
            )}
          </article>
        );
      })}
    </div>

    <div class="feedback-footer reveal-init">
      <p class="feedback-meta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{responseTime}</span>
      </p>

      {supportEmail && (
        <p class="feedback-meta">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m2 7 10 6 10-6"></path>
          </svg>
          <span>
            Correo oficial: <a href="mailto:teo.hurtado.16@gmail.com?subject=Feedback%20Pilas!%20Web/App">teo.hurtado.16@gmail.com</a>
          </span>
        </p>
      )}

      <p class="feedback-meta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>
          Canal oficial: <a href="https://whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g" target="_blank" rel="noopener noreferrer" style="color: #25D366; font-weight: 700;">WhatsApp Pilas! (Noticias y Avisos)</a>
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .feedback-section {
    padding: 80px 0 100px 0;
    position: relative;
    border-top: 2px solid var(--border-app);
    background: rgba(16, 26, 35, 0.2);
  }

  .direct-contact-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background: #1A1F2C;
    border: 2px solid var(--color-primary);
    border-radius: 16px;
    padding: 28px 36px;
    box-shadow: 4px 4px 0px #4A0026;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .direct-contact-info h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin: 6px 0;
  }

  .direct-contact-info p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .direct-email-code {
    display: inline-block;
    background: #000000;
    color: var(--color-success);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .direct-contact-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .direct-btn {
    white-space: nowrap;
  }

  .direct-subject-hint {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .direct-subject-hint code {
    color: var(--color-primary);
  }

  .direct-mail-fallback-link {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 180ms ease;
    margin-top: 4px;
  }

  .direct-mail-fallback-link:hover {
    color: #FF3FA4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .direct-mail-fallback-link code {
    color: #FF3FA4;
    font-family: 'JetBrains Mono', monospace;
  }

  @media (max-width: 768px) {
    .feedback-section {
      padding: 60px 0 70px 0;
    }

    .direct-contact-banner {
      flex-direction: column;
      text-align: center;
      padding: 22px 16px;
      gap: 20px;
    }

    .direct-contact-cta {
      width: 100%;
    }

    .direct-btn {
      width: 100%;
      max-width: 320px;
      white-space: normal;
      text-align: center;
      padding: 11px 16px;
      font-size: 0.92rem;
    }

    .direct-email-code {
      font-size: clamp(0.72rem, 3.6vw, 0.88rem);
      overflow-wrap: anywhere;
      word-break: break-all;
      max-width: 100%;
    }
  }

  .feedback-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  /* Con solo 2 canales configurados, dos columnas quedan mejor que tres vacías */
  .feedback-grid:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(2, 1fr);
    max-width: 820px;
    margin: 0 auto;
  }

  .feedback-grid:has(> :only-child) {
    grid-template-columns: 1fr;
    max-width: 480px;
    margin: 0 auto;
  }

  .feedback-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px;
    background: var(--bg-surface);
    transition: transform 260ms var(--ease-spring),
                box-shadow 260ms var(--ease-apple),
                border-color 260ms ease;
  }

  .feedback-card:hover {
    transform: translateY(-4px);
    box-shadow: 6px 6px 0px #000000, 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .feedback-card.accent-critical {
    border-color: rgba(255, 180, 171, 0.4);
  }

  .feedback-card.accent-critical .feedback-icon {
    background: rgba(255, 180, 171, 0.14);
    color: var(--accent-critical);
    border-color: rgba(255, 180, 171, 0.45);
  }

  .feedback-card.accent-green .feedback-icon {
    background: rgba(255, 63, 164, 0.14);
    color: var(--accent-primary);
    border-color: rgba(255, 63, 164, 0.45);
  }

  .feedback-card.accent-amber .feedback-icon {
    background: rgba(255, 219, 121, 0.14);
    color: var(--accent-amber);
    border-color: rgba(255, 219, 121, 0.45);
  }

  .feedback-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-md);
    border: 2px solid #000;
    box-shadow: 2px 2px 0px #000;
    flex-shrink: 0;
    transition: transform 220ms var(--ease-spring);
  }

  .feedback-card:hover .feedback-icon {
    transform: scale(1.12);
  }

  .feedback-card h3 {
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .feedback-hint {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    flex-grow: 1;
  }

  .feedback-btn {
    width: 100%;
    margin-top: 4px;
    padding: 12px 18px;
    font-size: 0.88rem;
    gap: 8px;
  }

  .feedback-btn svg {
    transition: transform 200ms var(--ease-spring);
  }

  .feedback-btn:hover svg {
    transform: translateX(3px) translateY(-3px);
  }

  .feedback-card.accent-green .feedback-btn {
    background: var(--accent-primary);
    color: var(--on-primary);
    border-color: #000;
  }

  .feedback-card.accent-amber .feedback-btn {
    background: var(--accent-amber);
    color: var(--on-amber);
    border-color: #000;
  }

  .feedback-card.accent-critical .feedback-btn {
    background: var(--bg-surface-elevated);
    color: var(--text-primary);
    border-color: var(--border-app);
  }

  .feedback-card.accent-critical .feedback-btn:hover {
    border-color: var(--accent-critical);
    color: var(--accent-critical);
  }

  /* Botón deshabilitado mientras el formulario no está publicado */
  .feedback-btn.is-pending {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface-elevated);
    color: var(--text-muted);
    border-color: var(--border-app);
    box-shadow: var(--shadow-hard-sm);
    cursor: not-allowed;
    opacity: 0.7;
    text-transform: none;
  }

  .feedback-btn.is-pending:hover {
    transform: none;
    box-shadow: var(--shadow-hard-sm);
    border-color: var(--border-app);
    color: var(--text-muted);
  }

  .pending-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--bg-surface);
    border: 1px solid var(--border-app);
    border-radius: 4px;
    padding: 2px 6px;
  }

  .feedback-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 28px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1.5px solid var(--border-app);
  }

  .feedback-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .feedback-meta svg {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .feedback-meta a {
    color: var(--accent-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .feedback-meta a:hover {
    color: #34D399;
  }

  @media (max-width: 900px) {
    .feedback-grid,
    .feedback-grid:has(> :nth-child(2):last-child) {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin: 0 auto;
    }

    .feedback-card {
      padding: 24px;
    }
  }
</style>

---
/**
 * SocialProofSection.astro
 * Sección de prueba social honesta:
 * 1. Espacio para capturas reales de la app móvil.
 * 2. Componente de testimonios que se oculta automáticamente si no hay datos verificados.
 */
import testimonialsData from '../data/testimonials.json';

interface Testimonial {
  author: string;
  university: string;
  career: string;
  quote: string;
  verified: boolean;
}

const testimonials: Testimonial[] = (testimonialsData.items as Testimonial[]).filter(t => t.verified);
const hasTestimonials = testimonials.length > 0;
---

<section id="comunidad" class="hub-social-proof">
  <div class="container">
    <div class="proof-header">
      <span class="sticker-pill green font-mono">CAPTURAS REALES</span>
      <h2 class="hub-section-title">Así se ve Pilas! por dentro</h2>
      <p class="proof-subtitle">
        Hecha escuchando los problemas de todos los días en pasillos, laboratorios y buses. Esto es lo que ves al abrirla, en Android y en iPhone.
      </p>
    </div>

    <!-- Espacio para capturas reales de la app -->
    <div class="screenshots-showcase-box">

      <div class="screenshots-grid screenshots-real">
        <figure class="real-shot">
          <img src="/images/mockup-horario.webp" alt="Captura real de Pilas!: Mi horario del viernes con Estadística en el aula B-112 y Dibujo en la G-201" width="640" height="1459" loading="lazy" />
          <figcaption><b>Tu día de un vistazo</b><span>Clases con hora, aula y bloque</span></figcaption>
        </figure>
        <figure class="real-shot">
          <img src="/images/mockup-malla.webp" alt="Captura real de Pilas!: malla curricular de Mecánica con créditos, materias y niveles" width="640" height="1459" loading="lazy" />
          <figcaption><b>Tu malla, offline</b><span>Créditos, niveles y prerrequisitos</span></figcaption>
        </figure>
      </div>
      
    </div>

    <!-- Componente de testimonios: se oculta automáticamente si no hay datos verificados -->
    {hasTestimonials ? (
      <div class="testimonials-block">
        <h3 class="testimonials-heading">Lo que dice la comunidad estudiantil</h3>
        <div class="testimonials-grid">
          {testimonials.map((t) => (
            <article class="testimonial-card">
              <p class="testimonial-quote">“{t.quote}”</p>
              <footer class="testimonial-author">
                <b>{t.author}</b>
                <span class="testimonial-meta">{t.career} · {t.university}</span>
              </footer>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <div class="testimonials-empty-callout">
        <div class="empty-callout-inner">
          <span class="callout-icon">💬</span>
          <div class="callout-text">
            <b>¿Estás usando Pilas! en tu facultad?</b>
            <p>
              Queremos escuchar tu experiencia real. Escríbenos por Instagram o correo para que tu opinión aparezca aquí.
            </p>
          </div>
          <a href="https://www.instagram.com/pilas_ec.app/" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-p">
            <span>Enviar testimonio</span>
            <span class="btn-arrow">➔</span>
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hub-social-proof {
    padding: 60px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .proof-header {
    margin-bottom: 32px;
  }
  .proof-subtitle {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 650px;
    margin-top: 8px;
    line-height: 1.5;
  }
  .screenshots-showcase-box {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    margin-bottom: 32px;
  }
  .showcase-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 768px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
    }
  }
  .mockup-slot {
    background: rgba(11, 16, 26, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.4);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .mockup-slot:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }
  .mockup-header {
    background: rgba(255, 255, 255, 0.03);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    border: none;
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.06);
  }
  .mockup-header .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
    opacity: 0.5;
  }
  .mockup-title {
    font-size: 0.76rem;
    color: var(--body);
    margin-left: 6px;
  }
  .mockup-body {
    padding: 34px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
  }
  .mockup-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }
  .mockup-icon { font-size: 2.2rem; }
  .mockup-placeholder b { font-size: 1rem; color: var(--title); }
  .mockup-placeholder small { color: var(--muted); font-size: 0.82rem; }
  .owner-notice-box {
    margin-top: 20px;
    padding: 12px 16px;
    background: rgba(255, 190, 59, 0.06);
    border: 1px solid rgba(255, 190, 59, 0.25);
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
  }
  .owner-notice-box p { color: var(--body); margin: 0; }

  /* Testimonials Callout */
  .testimonials-empty-callout {
    background: rgba(17, 23, 35, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    border-radius: 18px;
    padding: 22px 26px;
  }
  .empty-callout-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .callout-icon { font-size: 1.8rem; }
  .callout-text { flex: 1; min-width: min(100%, 260px); }
  .callout-text b { font-size: 1.05rem; color: var(--title); display: block; margin-bottom: 4px; }
  .callout-text p { font-size: 0.9rem; color: var(--muted); margin: 0; line-height: 1.45; }

  /* Testimonials Grid (cuando haya datos) */
  .testimonials-block {
    margin-top: 36px;
  }
  .testimonials-heading {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 20px;
    color: var(--title);
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .testimonial-card {
    background: rgba(17, 23, 35, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    padding: 22px;
    border-radius: 16px;
  }
  .testimonial-quote {
    font-style: italic;
    color: var(--body);
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .testimonial-author b {
    display: block;
    color: var(--primary);
  }
  .testimonial-meta {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .screenshots-real { grid-template-columns: repeat(2, minmax(0, 260px)); justify-content: center; gap: 28px; }
  .real-shot { margin: 0; display: grid; gap: 12px; }
  .real-shot img {
    display: block; width: 100%; height: auto; aspect-ratio: 640 / 1300; object-fit: cover; object-position: top;
    border-radius: 26px; border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 50px -18px rgba(0, 0, 0, 0.8), 0 0 0 6px rgba(13, 18, 28, 0.9);
  }
  .real-shot figcaption { display: grid; gap: 2px; text-align: center; }
  .real-shot figcaption b { font-family: var(--f-d); color: #fff; }
  .real-shot figcaption span { font-size: 0.86rem; color: var(--muted); }
  @media (max-width: 560px) { .screenshots-real { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } .real-shot img { border-radius: 18px; } }
</style>

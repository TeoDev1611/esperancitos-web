<script>
  // Tabs interactivas con crossfade
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.seg-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.screen-panel');

  type RevealHelper = (root: ParentNode, stagger?: number) => void;
  const revealWithin = (window as unknown as { esperancitosRevealWithin?: RevealHelper })
    .esperancitosRevealWithin;

  const activatePanel = (panel: HTMLElement) => {
    panels.forEach(p => p.classList.remove('active'));
    panel.classList.add('active');

    // El MutationObserver global también escucha este cambio, pero se invoca
    // aquí directamente para no depender de que esté registrado.
    revealWithin?.(panel, 70);
  };

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tabButtons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const targetId = btn.getAttribute('data-tab');
      const targetPanel = targetId ? document.getElementById(targetId) : null;
      if (targetPanel) activatePanel(targetPanel);
    });

    // Navegación por teclado dentro del tablist (flechas / Home / End)
    btn.addEventListener('keydown', (event: KeyboardEvent) => {
      const keys = ['ArrowRight', 'ArrowLeft', 'Home', 'End'];
      if (!keys.includes(event.key)) return;
      event.preventDefault();

      const list = Array.from(tabButtons);
      const current = list.indexOf(btn);
      let next = current;

      if (event.key === 'ArrowRight') next = (current + 1) % list.length;
      if (event.key === 'ArrowLeft') next = (current - 1 + list.length) % list.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = list.length - 1;

      list[next].focus();
      list[next].click();
    });
  });

  // Animación al entrar en vista: materias que pasan de gris a verde en cascada.
  // Se ejecuta UNA sola vez: antes se rearmaba cada vez que el bloque volvía a
  // entrar en el viewport, así que la demostración se reiniciaba sin parar.
  const cascadeNode3 = document.getElementById('cascade-node-3');
  const stateNode3 = document.getElementById('state-node-3');
  const cascadeBox = document.getElementById('malla-cascade-box');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (cascadeBox && cascadeNode3 && stateNode3) {
    const openCascadeNode = () => {
      cascadeNode3.classList.remove('pending');
      cascadeNode3.classList.add('unlocked');
      stateNode3.textContent = '✓ Desbloqueada';
    };

    if (prefersReducedMotion.matches) {
      // Sin animación: el resultado final se muestra de inmediato
      openCascadeNode();
    } else {
      let cascadePlayed = false;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !cascadePlayed) {
            cascadePlayed = true;
            window.setTimeout(openCascadeNode, 800);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.4 });

      observer.observe(cascadeBox);
    }
  }
</script>

---
// negocios.astro - Directorio comunitario de servicios y negocios estudiantiles
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildApiPayloads } from '../lib/community-payloads.ts';
import { NEGOCIO_CATEGORIES, type PublicNegocioItem } from '../lib/community-contract.ts';
import { NEGOCIOS_FORM_URL, COMUNIDAD_REPORTE_EMAIL } from '../config/community.ts';

// Cargar negocios vigentes desde el generador determinista
const includeExamples =
  import.meta.env.DEV ||
  process.env.INCLUDE_EXAMPLES === 'true' ||
  process.env.PUBLIC_API_INCLUDE_EXAMPLES === 'true';

const payloads = buildApiPayloads({ includeExamples });
const negocios: PublicNegocioItem[] = payloads.parsed.negocios.items;

const categoryLabels: Record<string, { label: string; icon: string }> = {
  todas: { label: 'Todas', icon: '✨' },
  comida: { label: 'Comida', icon: '🍲' },
  copias: { label: 'Copias e Impresión', icon: '🖨️' },
  papeleria: { label: 'Papelería', icon: '📐' },
  transporte: { label: 'Transporte', icon: '🚌' },
  vivienda: { label: 'Vivienda', icon: '🏠' },
  salud: { label: 'Salud', icon: '🩺' },
  servicios: { label: 'Servicios', icon: '⚡' },
  otros: { label: 'Otros', icon: '📦' },
};

const hasFormUrl = NEGOCIOS_FORM_URL.trim().length > 0;
---

<BaseLayout
  title="Directorio de Negocios y Servicios"
  description="Directorio gratuito de negocios, fotocopias, comida y servicios locales para estudiantes de la ESPE."
  keywords="negocios ESPE, copias sangolqui, comida cerca ESPE, papeleria espe, servicios estudiantes"
  includeAppSchema={false}
>
  <section class="community-page">
    <div class="container community-container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Negocios</span>
      </nav>

      <header class="page-header reveal-init">
        <div class="header-split">
          <div>
            <span class="section-kicker">Comunidad Pilas!</span>
            <h1>Directorio de Negocios y Servicios</h1>
            <p class="page-lead">
              Servicios locales, copias, papelerías, alimentación y hospedaje recomendados por y para estudiantes.
            </p>
          </div>

          {hasFormUrl && (
            <div class="postular-cta-wrap">
              <a
                href={NEGOCIOS_FORM_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-app btn-app-primary btn-postular"
              >
                <span>¿Tienes un negocio? Postula</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </a>
            </div>
          )}
        </div>

        <!-- AVISO LEGAL OBLIGATORIO SEGÚN CONTRATO -->
        <div class="notice-disclaimer-box card-app">
          <div class="disclaimer-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <strong>Pilas! no respalda ni garantiza los negocios listados. Los listados son gratuitos y no hay pagos por posición.</strong>
          </div>
          <p class="disclaimer-text">
            Este directorio es una iniciativa colaborativa para facilitar la vida universitaria. No cobramos comisiones ni tarifas a ningún negocio. Si encuentras datos erróneos o eres propietario y deseas actualizar o dar de baja un listado, escribe directamente a
            <a href={`mailto:${COMUNIDAD_REPORTE_EMAIL}`} class="report-link">{COMUNIDAD_REPORTE_EMAIL}</a>.
          </p>
        </div>

        <!-- BARRA DE BÚSQUEDA Y FILTROS -->
        <div class="controls-wrapper card-app">
          <div class="search-box">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="negocios-search"
              placeholder="Buscar por nombre, zona o descripción..."
              aria-label="Buscar negocios"
              autocomplete="off"
            />
            <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Limpiar búsqueda" style="display: none;">
              ✕
            </button>
          </div>

          <div class="categories-filter" role="tablist" aria-label="Filtrar por categoría">
            <button
              type="button"
              class="cat-chip active"
              data-cat="todas"
              role="tab"
              aria-selected="true"
            >
              <span>{categoryLabels.todas.icon}</span>
              <span>{categoryLabels.todas.label}</span>
            </button>
            {NEGOCIO_CATEGORIES.map((cat) => {
              const conf = categoryLabels[cat] || { label: cat, icon: '🏷️' };
              return (
                <button
                  type="button"
                  class="cat-chip"
                  data-cat={cat}
                  role="tab"
                  aria-selected="false"
                >
                  <span>{conf.icon}</span>
                  <span>{conf.label}</span>
                </button>
              );
            })}
          </div>
        </div>
      </header>

      <!-- Contador dinámico de resultados -->
      <div class="results-meta" id="results-counter" aria-live="polite">
        Mostrando <strong id="visible-count">{negocios.length}</strong> de <strong>{negocios.length}</strong> negocios registrados
      </div>

      <!-- LISTADO DE NEGOCIOS -->
      {negocios.length === 0 ? (
        <div class="empty-state card-app reveal-init">
          <div class="empty-icon-wrap" aria-hidden="true">
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <h3>Aún no hay negocios listados en el directorio</h3>
          <p>
            Los listados son 100% gratuitos y abiertos a la comunidad politécnica.
            Si eres dueño o conoces un negocio cercano a la ESPE, postúlalo para que aparezca aquí y en la app.
          </p>
          {hasFormUrl && (
            <a href={NEGOCIOS_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn-app btn-app-primary">
              <span>Postular un negocio</span>
            </a>
          )}
        </div>
      ) : (
        <div class="negocios-grid" id="negocios-list">
          {negocios.map((negocio) => {
            const catInfo = categoryLabels[negocio.category] || { label: negocio.category, icon: '🏷️' };
            const cleanWhatsapp = negocio.contact?.whatsapp?.replace(/[^0-9+]/g, '');
            const waLink = cleanWhatsapp
              ? `https://wa.me/${cleanWhatsapp.replace(/^\+/, '')}`
              : null;

            return (
              <article
                class="card-app negocio-card"
                id={negocio.id}
                data-category={negocio.category}
                data-search={`${negocio.name} ${negocio.description} ${negocio.zone} ${negocio.address}`.toLowerCase()}
              >
                <div class="card-head">
                  {negocio.logo ? (
                    <img
                      src={negocio.logo}
                      alt={`Logo de ${negocio.name}`}
                      width="54"
                      height="54"
                      class="negocio-logo"
                      loading="lazy"
                    />
                  ) : (
                    <div class="negocio-logo-placeholder" aria-hidden="true">
                      <span>{catInfo.icon}</span>
                    </div>
                  )}

                  <div class="card-title-group">
                    <div class="badges-row">
                      <span class="badge-cat">
                        <span>{catInfo.icon}</span>
                        <span>{catInfo.label}</span>
                      </span>

                      {negocio.verifiedAt && (
                        <span class="badge-verified" title="Negocio verificado por moderación">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <span>Verificado</span>
                        </span>
                      )}
                    </div>
                    <h2 class="negocio-name">{negocio.name}</h2>
                  </div>
                </div>

                <p class="negocio-desc">{negocio.description}</p>

                <div class="negocio-info-rows">
                  <div class="info-row">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>
                      <strong>{negocio.zone}:</strong> {negocio.address}
                    </span>
                  </div>

                  {negocio.hours && (
                    <div class="info-row">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span>{negocio.hours}</span>
                    </div>
                  )}
                </div>

                {negocio.contact && Object.keys(negocio.contact).length > 0 && (
                  <div class="contact-actions">
                    {waLink && (
                      <a
                        href={waLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn contact-wa"
                        aria-label={`Escribir por WhatsApp a ${negocio.name}`}
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                        <span>WhatsApp</span>
                      </a>
                    )}

                    {negocio.contact.phone && (
                      <a href={`tel:${negocio.contact.phone}`} class="contact-btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>Llamar</span>
                      </a>
                    )}

                    {negocio.contact.instagram && (
                      <a
                        href={negocio.contact.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn"
                        aria-label={`Ver Instagram de ${negocio.name}`}
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                        <span>Instagram</span>
                      </a>
                    )}

                    {negocio.contact.web && (
                      <a
                        href={negocio.contact.web}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn"
                        aria-label={`Visitar sitio web de ${negocio.name}`}
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="2" y1="12" x2="22" y2="12"></line>
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                        <span>Sitio Web</span>
                      </a>
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      )}

      <!-- Estado vacío para búsquedas sin resultados -->
      <div id="no-search-results" class="empty-state card-app" style="display: none;">
        <h3>No se encontraron negocios</h3>
        <p>No hay resultados que coincidan con los filtros seleccionados. Prueba otra búsqueda o categoría.</p>
        <button type="button" id="reset-filters-btn" class="btn-app btn-app-surface">
          <span>Restablecer filtros</span>
        </button>
      </div>

      <div class="community-page-footer reveal-init">
        <a href="/" class="btn-app btn-app-surface">
          <span>← Volver al inicio</span>
        </a>
        <a href="/avisos" class="btn-app btn-app-primary">
          <span>Ver Avisos de la Comunidad →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Filtrado instantáneo y ligero de negocios por texto y categoría (Vanilla JS)
  const searchInput = document.getElementById('negocios-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-search-btn');
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-chip');
  const cards = document.querySelectorAll<HTMLElement>('.negocio-card');
  const counterEl = document.getElementById('visible-count');
  const noResultsEl = document.getElementById('no-search-results');
  const resetBtn = document.getElementById('reset-filters-btn');

  let activeCategory = 'todas';
  let searchTerm = '';

  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      const cardCat = card.getAttribute('data-category') || '';
      const cardSearch = card.getAttribute('data-search') || '';

      const matchesCat = activeCategory === 'todas' || cardCat === activeCategory;
      const matchesSearch = !searchTerm || cardSearch.includes(searchTerm);

      if (matchesCat && matchesSearch) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (counterEl) counterEl.textContent = String(visible);

    if (noResultsEl) {
      noResultsEl.style.display = visible === 0 && cards.length > 0 ? 'block' : 'none';
    }

    if (clearBtn && searchInput) {
      clearBtn.style.display = searchInput.value ? 'inline-block' : 'none';
    }
  }

  // Evento de búsqueda
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchTerm = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  if (clearBtn && searchInput) {
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      applyFilters();
      searchInput.focus();
    });
  }

  // Eventos de botones de categoría
  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      activeCategory = btn.getAttribute('data-cat') || 'todas';
      applyFilters();
    });
  });

  if (resetBtn && searchInput) {
    resetBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      activeCategory = 'todas';
      catButtons.forEach((b) => {
        const isAll = b.getAttribute('data-cat') === 'todas';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-selected', String(isAll));
      });
      applyFilters();
    });
  }
</script>

<style>
  .community-page {
    padding: 50px 0 90px 0;
    border-top: 2px solid var(--border-app);
  }

  .community-container {
    max-width: 1040px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .page-header {
    margin-bottom: 30px;
  }

  .header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 12px;
  }

  .page-lead {
    font-size: 1.08rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 720px;
  }

  .btn-postular {
    padding: 10px 18px;
    font-size: 0.86rem;
    white-space: nowrap;
  }

  /* Aviso de no responsabilidad */
  .notice-disclaimer-box {
    background: rgba(255, 219, 121, 0.08);
    border-color: var(--accent-amber);
    padding: 16px 20px;
    margin-bottom: 24px;
  }

  .disclaimer-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-amber);
    font-size: 0.95rem;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .disclaimer-badge svg {
    flex-shrink: 0;
  }

  .disclaimer-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .report-link {
    color: var(--accent-primary);
    font-weight: 700;
    text-decoration: underline;
  }

  /* Controles de búsqueda y filtros */
  .controls-wrapper {
    background: var(--bg-surface-elevated);
    padding: 20px 24px;
    margin-bottom: 24px;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 16px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    padding: 12px 40px 12px 42px;
    background: var(--bg-primary);
    border: 2px solid var(--border-app);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.96rem;
    outline: none;
    transition: border-color var(--duration-hover) ease;
  }

  .search-box input:focus {
    border-color: var(--accent-primary);
  }

  .clear-btn {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    padding: 4px;
  }

  .clear-btn:hover {
    color: var(--text-primary);
  }

  .categories-filter {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--bg-primary);
    border: 1.5px solid var(--border-app);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--duration-hover) var(--ease-apple);
  }

  .cat-chip:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
    transform: translateY(-2px);
  }

  .cat-chip.active {
    background: var(--accent-primary);
    color: var(--on-primary);
    border-color: #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .results-meta {
    font-size: 0.86rem;
    color: var(--text-muted);
    margin-bottom: 22px;
    padding-left: 4px;
  }

  /* Grid de tarjetas de negocios */
  .negocios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 22px;
    margin-bottom: 44px;
  }

  .negocio-card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    transition: transform var(--duration-hover) var(--ease-spring),
                box-shadow var(--duration-hover) var(--ease-apple),
                border-color var(--duration-hover) ease;
  }

  .negocio-card:hover {
    transform: translateY(-4px);
    box-shadow: 6px 6px 0px #000000, 0 8px 24px rgba(0, 0, 0, 0.35);
    border-color: rgba(0, 255, 135, 0.4);
  }

  .card-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 12px;
  }

  .negocio-logo {
    width: 52px;

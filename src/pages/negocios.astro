---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import { buildApiPayloads } from '../lib/community-payloads.ts';
import { NEGOCIO_CATEGORIES, type PublicNegocioItem } from '../lib/community-contract.ts';
import { NEGOCIOS_FORM_URL, COMUNIDAD_REPORTE_EMAIL } from '../config/community.ts';

const includeExamples =
  import.meta.env.DEV ||
  process.env.INCLUDE_EXAMPLES === 'true' ||
  process.env.PUBLIC_API_INCLUDE_EXAMPLES === 'true';

const payloads = buildApiPayloads({ includeExamples });
const negocios: PublicNegocioItem[] = payloads.parsed.negocios.items;

const categoryLabels: Record<string, string> = {
  todas: 'Todas',
  comida: 'Comida',
  copias: 'Copias e Impresión',
  papeleria: 'Papelería',
  transporte: 'Transporte',
  vivienda: 'Vivienda',
  salud: 'Salud',
  servicios: 'Servicios',
  otros: 'Otros',
};

const hasFormUrl = NEGOCIOS_FORM_URL.trim().length > 0;
const mailtoSubject = encodeURIComponent('Postulación de Negocio - Directorio Pilas!');
const mailtoBody = encodeURIComponent(
  '¡Hola equipo de Pilas!:\n\nQuisiera registrar mi local o emprendimiento en el directorio gratuito de Pilas!:\n\n• Nombre del negocio: \n• Categoría: \n• Descripción breve: \n• Dirección y Zona: \n• Horarios de atención: \n• Teléfono / WhatsApp: \n• Red social o web: \n\n¡Gracias!'
);
const postularUrl = hasFormUrl
  ? NEGOCIOS_FORM_URL
  : `mailto:${COMUNIDAD_REPORTE_EMAIL}?subject=${mailtoSubject}&body=${mailtoBody}`;

const IG = 'https://www.instagram.com/pilas_ec.app/';
const WA = 'https://whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g';
---
<!doctype html>
<html lang="es-EC" data-mode="espe">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Directorio de Negocios y Servicios | Pilas!</title>
<meta name="description" content="Directorio gratuito de fotocopias, comida, papelería y servicios locales para estudiantes universitarios.">
<meta name="theme-color" content="#101319">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<script is:inline>
try {
  var m = localStorage.pilasMode;
  if (m === 'multi' || m === 'espe') document.documentElement.dataset.mode = m;
} catch (e) {}
</script>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"/></symbol>
</svg>

<header class="top">
  <div class="wrap">
    <a class="nav-brand-logo-pill" href="/" aria-label="Pilas!, volver al inicio">
      <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="nav-brand-logo" width="128" height="42" />
    </a>
    <a class="btn btn-s btn-sm" href="/"><svg class="ico"><use href="#i-back"/></svg>Volver<span class="hide-xs"> al inicio</span></a>
    <a class="btn btn-p btn-sm" href="/#descargar"><svg class="ico"><use href="#i-down"/></svg>Descargar</a>
  </div>
</header>

<main class="page-body">
  <div class="wrap">
    <div class="header-split">
      <div class="page-head">
        <span class="badge b-info"><svg class="ico"><use href="#i-info"/></svg>Directorio Comunitario</span>
        <h1>Negocios y Servicios</h1>
        <p class="lead">Comida, fotocopias, papelerías, residencias y servicios recomendados para el campus.</p>
      </div>
      <a class="btn btn-p" href={postularUrl} target={hasFormUrl ? '_blank' : undefined} rel={hasFormUrl ? 'noopener noreferrer' : undefined}>
        Postular mi negocio gratis
      </a>
    </div>

    <!-- Aviso Legal Obligatorio -->
    <div class="card notice-box" style="margin-top:24px">
      <b>Iniciativa colaborativa estudiantil. No cobramos comisiones ni tarifas a los locales.</b>
      <p style="margin-top:4px">Pilas! no intermedia transacciones financieras ni garantiza los servicios listados. Si eres propietario y deseas actualizar datos o dar de baja tu local, escribe a <a href={`mailto:${COMUNIDAD_REPORTE_EMAIL}`}>{COMUNIDAD_REPORTE_EMAIL}</a>.</p>
    </div>

    <!-- Buscador y Filtros -->
    <div class="search-wrap">
      <div class="search-box">
        <svg class="ico"><use href="#i-search"/></svg>
        <input
          type="search"
          id="negocio-search"
          placeholder="Buscar por nombre, zona o producto (ej. copias, menú, Rumiñahui)..."
          aria-label="Buscar en el directorio de negocios"
        />
        <button type="button" id="negocio-clear" class="btn-clear" aria-label="Limpiar búsqueda" hidden>×</button>
      </div>
    </div>

    <div class="cat-bar" role="tablist" aria-label="Categorías de negocios">
      <button type="button" class="cat-btn active" data-cat-id="todas" role="tab" aria-selected="true">Todas</button>
      {NEGOCIO_CATEGORIES.map((cat) => (
        <button type="button" class="cat-btn" data-cat-id={cat} role="tab" aria-selected="false">
          {categoryLabels[cat] || cat}
        </button>
      ))}
    </div>

    <p class="count-line" id="negocio-count" aria-live="polite">Mostrando <b class="num">{negocios.length}</b> negocios</p>

    <!-- Lista de Negocios -->
    <div class="negocios-grid" id="negocios-list" style="margin-top:20px">
      {negocios.map((n) => (
        <article class="card negocio-card" data-category={n.category} data-negocio-text={`${n.name} ${n.description} ${n.address || ''} ${n.zone || ''} ${categoryLabels[n.category] || ''}`}>
          <div class="negocio-top">
            <span class="badge b-info">{categoryLabels[n.category] || n.category}</span>
            {n.zone && <span class="badge b-warn">{n.zone}</span>}
          </div>
          <h2 class="negocio-name">{n.name}</h2>
          <p class="negocio-desc">{n.description}</p>
          <dl class="negocio-details">
            {n.address && <div><dt>Ubicación</dt><dd>{n.address}</dd></div>}
            {n.hours && <div><dt>Horario</dt><dd>{n.hours}</dd></div>}
          </dl>
          <div class="negocio-actions">
            {n.contact?.whatsapp && (
              <a class="btn btn-p btn-sm" href={`https://wa.me/${n.contact.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer">
                WhatsApp
              </a>
            )}
            {n.contact?.instagram && (
              <a class="btn btn-s btn-sm" href={n.contact.instagram.startsWith('http') ? n.contact.instagram : `https://instagram.com/${n.contact.instagram.replace('@', '')}`} target="_blank" rel="noopener noreferrer">
                Instagram
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Estado Vacío -->
    <div class="empty card" id="negocio-empty" hidden>
      <img src="/logos/mascota_negacion.svg" alt="Pilo, la mascota de Pilas!, indicando con el pulgar abajo que no se encontraron negocios" width="120" height="120">
      <h3>No encontramos negocios para ese filtro</h3>
      <p>Prueba con otra palabra o revisa en la categoría "Todas".</p>
      <button type="button" class="btn btn-p btn-sm" id="btn-reset-negocios">Ver todos los negocios</button>
    </div>
  </div>
</main>

<footer class="hub-footer">
  <div class="wrap footer-wrap">
    <div class="footer-brand-row">
      <a class="footer-brand-logo-pill" href="/" aria-label="Pilas!, volver arriba">
        <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="footer-lettering-img" width="132" height="42" />
      </a>
      <div class="footer-pill-edition">
        <span class="sticker-pill" data-for="espe">⚡ COMUNIDAD UNIVERSITARIA ESPE</span>
        <span class="sticker-pill coral" data-for="multi">⭐ RED MULTI-UNIVERSIDAD ECUADOR</span>
      </div>
    </div>
    <nav aria-label="Enlaces del sitio" class="footer-nav">
      <a href="/faq">Preguntas frecuentes</a>
      <a href="/avisos">Avisos</a>
      <a href="/negocios">Negocios</a>
      <a href="/privacidad">Privacidad</a>
      <a href={IG} target="_blank" rel="noopener noreferrer">Instagram (@pilas_ec.app)</a>
      <a href={WA} target="_blank" rel="noopener noreferrer">Canal de WhatsApp</a>
    </nav>
    <div class="footer-legal">
      <p>Pilas! es un proyecto estudiantil independiente. No está respaldado ni afiliado oficialmente a la Universidad de las Fuerzas Armadas ESPE, Ellucian, Banner ni Moodle. Las credenciales y datos viven únicamente en tu teléfono.</p>
      <p>Los nombres, siglas y logotipos de universidades pertenecen con exclusividad a sus respectivos titulares y se usan únicamente para fines de contextualización estudiantil y compatibilidad técnica.</p>
      <p class="footer-copy">© 2026 Pilas! · Hecho con orgullo estudiantil para el Ecuador.</p>
    </div>
  </div>
</footer>

<style is:global>
:root{
  color-scheme:dark;
  --primary:#ff3fa4;--primary-hover:#e5147d;--primary-extrude:#7a0a45;--primary-shadow:#4a0026;--primary-coral:#ff3d5e;
  --success:#00ff87;--success-shadow:#059669;--warning:#ffdb60;--critical:#ef4444;--info:#38bdf8;
  --bg-base:#101319;--bg-subtle:#191d28;--bg-surface:#161a23;--bg-elevated:#1e2230;--bg-container:#242938;
  --border:#2a3142;--border-control:#6b7894;--title:#faf7f7;--body:#e1e2eb;--muted:#8f9cae;
  --f-d:"Outfit Variable",system-ui,sans-serif;--f-b:"Inter Variable",system-ui,sans-serif;
  --accent:var(--primary);--bg:var(--bg-base);
}
html[data-mode=multi]{--accent:var(--primary-coral);--bg:var(--bg-subtle)}
html{scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background-color:var(--bg);color:var(--body);font:400 1.0625rem/1.6 var(--f-b);padding-bottom:env(safe-area-inset-bottom,0px)}
html[data-mode=espe] body{background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px}
html[data-mode=multi] body{background-image:radial-gradient(rgba(255,255,255,.09) 1.5px,transparent 1.5px);background-size:22px 22px}
h1,h2,h3{font-family:var(--f-d);font-weight:800;color:var(--title);line-height:1.1;letter-spacing:-.02em;margin:0}
p{margin:0}a{color:var(--info)}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding-inline:clamp(16px,4vw,32px)}
.num{font-variant-numeric:tabular-nums}
.ico{width:1.1em;height:1.1em;fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border:2px solid;border-radius:12px;font:800 1rem var(--f-d);text-decoration:none;cursor:pointer;transition:transform 100ms,box-shadow 100ms,background 150ms}
.btn:active{transform:translate(2px,2px);box-shadow:none!important}
.btn-p{background:var(--primary);color:#000;border-color:#000;box-shadow:3px 3px 0 #000}
.btn-p:hover,.btn-p:active{background:var(--primary-hover)}
.btn-s{background:var(--bg-elevated);color:var(--title);border:2px solid var(--border-control);box-shadow:3px 3px 0 #000}
.btn-sm{padding:0 16px;font-size:.95rem}
.card{background:var(--bg-surface);border:2px solid var(--border);border-radius:14px;box-shadow:2px 2px 0 var(--border);padding:24px}
.badge{display:inline-flex;align-items:center;gap:6px;border:1.5px solid currentColor;border-radius:999px;padding:4px 12px 4px 8px;background:var(--bg-base);font:600 .875rem/1.3 var(--f-b)}
.b-warn{color:var(--warning)}.b-info{color:var(--info)}

/* top con logo pill y glow */
.top{position:sticky;top:0;z-index:20;background:rgba(16,19,25,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:2px solid #000;padding:10px 0}
.top .wrap{display:flex;align-items:center;gap:12px;min-height:50px}

.nav-brand-logo-pill,
.footer-brand-logo-pill {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:transparent!important;
  border:none!important;
  box-shadow:none!important;
  text-decoration:none;
  margin-right:auto;
}

.nav-brand-logo,
.footer-lettering-img {
  display:block;
  height:36px;
  width:auto;
  filter:drop-shadow(0 0 10px rgba(255,63,164,0.9))
         drop-shadow(0 0 22px rgba(255,20,117,0.7))
         drop-shadow(2px 3px 0 #000000)!important;
  transition:filter 220ms ease, transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  animation:logoPinkGlowPulse 4s ease-in-out infinite;
}
.nav-brand-logo:hover,
.footer-lettering-img:hover {
  filter:drop-shadow(0 0 14px rgba(255,63,164,1))
         drop-shadow(0 0 30px rgba(255,20,117,0.95))
         drop-shadow(2px 3px 0 #000000)!important;
  transform:translateY(-2px) scale(1.03);
}

@keyframes logoPinkGlowPulse {
  0%, 100% {
    filter: drop-shadow(0 0 8px rgba(255, 63, 164, 0.9))
            drop-shadow(0 0 20px rgba(255, 20, 117, 0.7))
            drop-shadow(2px 3px 0 #000000);
  }
  50% {
    filter: drop-shadow(0 0 13px rgba(255, 63, 164, 1))
            drop-shadow(0 0 28px rgba(255, 20, 117, 0.88))
            drop-shadow(2px 3px 0 #000000);
  }
}

.sticker-pill {
  display: inline-block;
  padding: 4px 12px;
  border: 1.5px solid #000;
  border-radius: 9999px;
  background: var(--primary);
  color: #000;
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  box-shadow: 2px 2px 0 #000;
}
.sticker-pill.coral { background: var(--primary-coral); }

/* Footer Neo-Brutalista Oficial */
.hub-footer {
  padding: 48px 0 56px;
  border-top: 2px solid #000;
  background: #090b10;
}
.footer-wrap {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.footer-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.footer-pill-edition {
  display: flex;
  gap: 8px;
}
.footer-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 14px 24px;
}
.footer-nav a {
  color: var(--body);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;
  transition: color 150ms;
}
.footer-nav a:hover {
  color: var(--primary);
}
.footer-legal {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.82rem;
  color: var(--muted);
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  padding-top: 16px;
}
.footer-copy {
  color: var(--title);
  font-weight: 700;
}

/* page content */
.page-body{padding:clamp(36px,6vw,72px) 0 clamp(48px,7vw,96px)}
.header-split{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
.page-head{display:grid;gap:12px;max-width:44em}
.page-head h1{font-size:clamp(2.2rem,5vw,3.6rem);margin-top:6px}
.lead{font-size:1.15rem;color:var(--body)}

.notice-box{border-color:var(--border-control);background:var(--bg-elevated)}
.notice-box b{color:var(--title);display:block}

/* search */
.search-wrap{margin-top:28px}
.search-box{display:flex;align-items:center;gap:12px;min-height:56px;padding:0 16px;border:2px solid var(--border-control);border-radius:12px;background:var(--bg-elevated)}
.search-box:focus-within{border-color:var(--primary);outline:2px solid var(--primary);outline-offset:2px}
.search-box input{flex:1;background:transparent;border:none;color:var(--title);font:500 1.05rem var(--f-b);outline:none}
.search-box input::placeholder{color:var(--muted)}
.btn-clear{background:none;border:none;color:var(--muted);font-size:1.4rem;cursor:pointer;padding:4px 8px}

/* categories */
.cat-bar{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
.cat-btn{min-height:48px;padding:0 18px;border:2px solid var(--border-control);border-radius:12px;background:var(--bg-elevated);color:var(--title);font:700 .95rem var(--f-d);cursor:pointer;transition:background 120ms,color 120ms}
.cat-btn.active{background:var(--primary);color:#000;border-color:#000;box-shadow:3px 3px 0 #000}
.cat-btn:active{transform:translate(2px,2px);box-shadow:none}

.count-line{margin-top:24px;color:var(--muted);font-size:.95rem}

/* negocios grid */
.negocios-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:20px}
.negocio-card{display:flex;flex-direction:column;gap:12px;border:2px solid var(--border-control);background:var(--bg-surface)}
.negocio-top{display:flex;gap:8px;flex-wrap:wrap}
.negocio-name{font-size:1.35rem;color:var(--title)}
.negocio-desc{color:var(--body);line-height:1.55;flex:1}
.negocio-details{margin:0;display:grid;gap:6px;border-top:1px solid var(--border);padding-top:10px;font-size:.9rem}
.negocio-details dt{color:var(--muted);font-weight:600}
.negocio-details dd{margin:0;color:var(--title);font-weight:500}
.negocio-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:4px}

.empty{text-align:center;display:grid;place-items:center;gap:12px;padding:48px 24px;margin-top:32px}

footer{padding:40px 0 56px;border-top:2px solid #000;background:var(--bg);font-size:.95rem}
footer .wrap{display:grid;gap:16px}footer nav{display:flex;flex-wrap:wrap;gap:0 22px}footer nav a{display:inline-flex;align-items:center;min-height:48px}footer p{color:var(--muted);max-width:60em}

@media(max-width:540px){
  .hide-xs{display:none!important}
  .top .wrap{gap:8px}
  .nav-brand-logo{height:28px}
}
</style>

<script>
const input = document.getElementById('negocio-search') as HTMLInputElement;
const clearBtn = document.getElementById('negocio-clear') as HTMLButtonElement;
const catBtns = document.querySelectorAll('.cat-btn') as NodeListOf<HTMLButtonElement>;
const cards = document.querySelectorAll('.negocio-card') as NodeListOf<HTMLElement>;
const countEl = document.getElementById('negocio-count') as HTMLElement;
const emptyBox = document.getElementById('negocio-empty') as HTMLElement;
const resetBtn = document.getElementById('btn-reset-negocios') as HTMLButtonElement;

let currentCat = 'todas';
let currentQuery = '';

/**
 * Normaliza texto eliminando acentos, diacríticos (incluyendo tilde de ñ para búsqueda insensible),
 * signos de puntuación y espacios extras.
 */
function normalizeText(str: string): string {
  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

// Pre-indexar el texto normalizado de cada tarjeta para búsquedas instantáneas
const cardData = Array.from(cards).map((card) => {
  const cat = card.dataset.category || '';
  const rawText = card.dataset.negocioText || card.textContent || '';
  return {
    el: card,
    category: cat,
    normText: normalizeText(rawText),
  };
});

function matchToken(token: string, text: string): boolean {
  if (text.includes(token)) return true;
  if (token.length > 3 && token.endsWith('s')) {
    if (text.includes(token.slice(0, -1))) return true;
    if (token.length > 4 && token.endsWith('es')) {
      if (text.includes(token.slice(0, -2))) return true;
    }
  }
  return false;
}

function filter() {
  let visible = 0;
  const normQ = normalizeText(currentQuery);
  const tokens = normQ.split(' ').filter(Boolean);

  cardData.forEach(({ el, category, normText }) => {
    const matchCat = currentCat === 'todas' || category === currentCat;
    // Búsqueda multi-término (AND): cada token ingresado debe encontrarse en los datos del local
    const matchQuery = tokens.length === 0 || tokens.every((token) => matchToken(token, normText));

    const show = matchCat && matchQuery;
    el.hidden = !show;
    if (show) visible++;
  });

  if (countEl) {
    countEl.innerHTML = `Mostrando <b class="num">${visible}</b> ${visible === 1 ? 'negocio' : 'negocios'}`;
  }
  if (emptyBox) {
    emptyBox.hidden = visible > 0;
  }
}

function setCategory(catId: string) {
  currentCat = catId;
  catBtns.forEach((btn) => {
    const isSelected = (btn.dataset.catId || 'todas') === catId;
    btn.classList.toggle('active', isSelected);
    btn.setAttribute('aria-selected', String(isSelected));
  });
  filter();
}

input?.addEventListener('input', () => {
  currentQuery = input.value;
  clearBtn.hidden = !currentQuery.trim();
  filter();
});

input?.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    e.preventDefault();
    input.value = '';
    currentQuery = '';
    clearBtn.hidden = true;
    filter();
  }
});

clearBtn?.addEventListener('click', () => {
  input.value = '';
  currentQuery = '';
  clearBtn.hidden = true;
  filter();
  input.focus();
});

catBtns.forEach((btn, idx) => {
  btn.addEventListener('click', () => {
    setCategory(btn.dataset.catId || 'todas');
  });

  // Navegación accesible por teclado entre pestañas (W3C WAI-ARIA)
  btn.addEventListener('keydown', (e) => {
    let nextIdx = -1;
    if (e.key === 'ArrowRight') nextIdx = (idx + 1) % catBtns.length;
    else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + catBtns.length) % catBtns.length;
    else if (e.key === 'Home') nextIdx = 0;
    else if (e.key === 'End') nextIdx = catBtns.length - 1;

    if (nextIdx >= 0) {
      e.preventDefault();
      const target = catBtns[nextIdx];
      target.focus();
      target.click();
    }
  });
});

resetBtn?.addEventListener('click', () => {
  input.value = '';
  currentQuery = '';
  clearBtn.hidden = true;
  setCategory('todas');
  input.focus();
});

// Soporte de enlace profundo por URL (ej. /negocios?q=copias o /negocios#comida)
try {
  const urlParams = new URLSearchParams(window.location.search);
  const qParam = urlParams.get('q');
  const catHash = window.location.hash.replace('#', '');

  if (qParam && input) {
    input.value = qParam;
    currentQuery = qParam;
    clearBtn.hidden = false;
  }
  if (catHash && Array.from(catBtns).some((b) => b.dataset.catId === catHash)) {
    setCategory(catHash);
  } else {
    filter();
  }
} catch {}
</script>
</body>
</html>

---
// negocios.astro - Directorio comunitario de servicios y negocios estudiantiles
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildApiPayloads } from '../lib/community-payloads.ts';
import { NEGOCIO_CATEGORIES, type PublicNegocioItem } from '../lib/community-contract.ts';
import { NEGOCIOS_FORM_URL, COMUNIDAD_REPORTE_EMAIL } from '../config/community.ts';

// Cargar negocios vigentes desde el generador determinista
const includeExamples =
  import.meta.env.DEV ||
  process.env.INCLUDE_EXAMPLES === 'true' ||
  process.env.PUBLIC_API_INCLUDE_EXAMPLES === 'true';

const payloads = buildApiPayloads({ includeExamples });
const negocios: PublicNegocioItem[] = payloads.parsed.negocios.items;

const categoryLabels: Record<string, { label: string; icon: string }> = {
  todas: { label: 'Todas', icon: '✨' },
  comida: { label: 'Comida', icon: '🍲' },
  copias: { label: 'Copias e Impresión', icon: '🖨️' },
  papeleria: { label: 'Papelería', icon: '📐' },
  transporte: { label: 'Transporte', icon: '🚌' },
  vivienda: { label: 'Vivienda', icon: '🏠' },
  salud: { label: 'Salud', icon: '🩺' },
  servicios: { label: 'Servicios', icon: '⚡' },
  otros: { label: 'Otros', icon: '📦' },
};

const hasFormUrl = NEGOCIOS_FORM_URL.trim().length > 0;
const mailtoSubject = encodeURIComponent('Postulación de Negocio - Directorio Pilas!');
const mailtoBody = encodeURIComponent(
  '¡Hola equipo de Pilas!:\n\nQuisiera registrar mi local o emprendimiento en el directorio gratuito de Pilas!:\n\n• Nombre del negocio: \n• Categoría (comida, copias, papeleria, transporte, vivienda, salud, servicios, otros): \n• Descripción breve (qué ofreces): \n• Dirección y Zona (ej. Frente a Puerta 1 ESPE, Av. Gral. Rumiñahui): \n• Horarios de atención: \n• Teléfono / WhatsApp de contacto: \n• Instagram o enlace web (opcional): \n\n¡Gracias!'
);
const postularUrl = hasFormUrl
  ? NEGOCIOS_FORM_URL
  : `mailto:${COMUNIDAD_REPORTE_EMAIL}?subject=${mailtoSubject}&body=${mailtoBody}`;
---

<BaseLayout
  title="Directorio de Negocios y Servicios"
  description="Directorio gratuito de negocios, fotocopias, comida y servicios locales para estudiantes de la ESPE."
  keywords="negocios ESPE, copias sangolqui, comida cerca ESPE, papeleria espe, servicios estudiantes"
  includeAppSchema={false}
>
  <section class="community-page">
    <div class="container community-container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Negocios</span>
      </nav>

      <header class="page-header reveal-init">
        <div class="header-split">
          <div>
            <div class="header-kicker-row">
              <span class="section-kicker">Comunidad Pilas!</span>
              <span class="badge-app green">✨ 100% Gratuito</span>
            </div>
            <h1>Directorio de Negocios y Servicios</h1>
            <p class="page-lead">
              Fotocopias, comida, papelerías, transporte y residencias estudiantiles recomendadas para toda la comunidad de la ESPE.
            </p>
          </div>

          <div class="postular-cta-wrap">
            <a
              href={postularUrl}
              target={hasFormUrl ? '_blank' : undefined}
              rel={hasFormUrl ? 'noopener noreferrer' : undefined}
              class="btn-app btn-app-primary btn-postular"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>¿Tienes un negocio? Postula Gratis</span>
            </a>
          </div>
        </div>

        <!-- AVISO LEGAL OBLIGATORIO SEGÚN CONTRATO -->
        <div class="notice-disclaimer-box card-app">
          <div class="disclaimer-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <strong>Pilas! no respalda ni garantiza los negocios listados. Los listados son gratuitos y no hay pagos por posición.</strong>
          </div>
          <p class="disclaimer-text">
            Este directorio es una iniciativa colaborativa para facilitar la vida universitaria. No cobramos comisiones ni tarifas a ningún negocio. Si encuentras datos erróneos o eres propietario y deseas actualizar o dar de baja un listado, escribe directamente a
            <a href={`mailto:${COMUNIDAD_REPORTE_EMAIL}`} class="report-link">{COMUNIDAD_REPORTE_EMAIL}</a>.
          </p>
        </div>

        {negocios.length > 0 && (
          <div class="controls-wrapper card-app">
            <div class="search-box">
              <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="search"
                id="negocios-search"
                placeholder="Buscar por nombre, zona o descripción..."
                aria-label="Buscar negocios"
                autocomplete="off"
              />
              <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Limpiar búsqueda" style="display: none;">
                ✕
              </button>
            </div>

            <div class="categories-filter" role="tablist" aria-label="Filtrar por categoría">
              <button
                type="button"
                class="cat-chip active"
                data-cat="todas"
                role="tab"
                aria-selected="true"
              >
                <span>{categoryLabels.todas.icon}</span>
                <span>{categoryLabels.todas.label}</span>
              </button>
              {NEGOCIO_CATEGORIES.map((cat) => {
                const conf = categoryLabels[cat] || { label: cat, icon: '🏷️' };
                return (
                  <button
                    type="button"
                    class="cat-chip"
                    data-cat={cat}
                    role="tab"
                    aria-selected="false"
                  >
                    <span>{conf.icon}</span>
                    <span>{conf.label}</span>
                  </button>
                );
              })}
            </div>
          </div>
        )}
      </header>

      <!-- LISTADO DE NEGOCIOS O ESTADO VACÍO RICO -->
      {negocios.length === 0 ? (
        <div class="empty-state-hub card-app reveal-init">
          <div class="empty-hero-section">
            <div class="empty-icon-pill-wrap" aria-hidden="true">
              <div class="empty-icon-circle">
                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                  <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
                  <path d="M2 7h20"></path>
                </svg>
              </div>
            </div>

            <div class="empty-hero-content">
              <div class="sticker-pill empty-sticker">🚀 ¡SÉ EL PRIMERO EN APARECER!</div>
              <h2 class="empty-hub-title">¡Ups! Aún no hay negocios registrados en el directorio</h2>
              <p class="empty-hub-lead">
                Estamos estrenando la <strong>versión oficial final v1.0.0</strong> de Pilas! y abrimos este directorio limpio para que los mejores locales de los alrededores de la ESPE y los emprendimientos politécnicos se den a conocer. <strong>¡El registro es y siempre será 100% gratuito!</strong>
              </p>
            </div>
          </div>

          <!-- VENTAJAS / POR QUÉ REGISTRARTE -->
          <div class="hub-reasons-title-row">
            <span class="hub-kicker">¿POR QUÉ FORMAR PARTE DEL DIRECTORIO PILAS?</span>
            <h3>Ventajas exclusivas para tu negocio o emprendimiento</h3>
          </div>

          <div class="hub-benefits-grid">
            <div class="hub-benefit-card">
              <div class="hub-benefit-icon green">💸</div>
              <div class="hub-benefit-body">
                <h4>100% Gratuito de por vida</h4>
                <p>Cero costos de inscripción y cero comisiones sobre lo que vendas. Una plataforma colaborativa para dinamizar la economía de la comunidad.</p>
              </div>
            </div>

            <div class="hub-benefit-card">
              <div class="hub-benefit-icon fuchsia">📱</div>
              <div class="hub-benefit-body">
                <h4>Visible en la App y en la Web</h4>
                <p>Llega a miles de politécnicos en sus teléfonos (Android e iOS) cuando busquen dónde imprimir, almorzar o comprar materiales cerca del campus.</p>
              </div>
            </div>

            <div class="hub-benefit-card">
              <div class="hub-benefit-icon amber">⚡</div>
              <div class="hub-benefit-body">
                <h4>Contacto Directo sin Intermediarios</h4>
                <p>Los estudiantes te contactarán directamente a tu WhatsApp, te llamarán o te seguirán en Instagram con un solo toque.</p>
              </div>
            </div>

            <div class="hub-benefit-card">
              <div class="hub-benefit-icon cyan">📍</div>
              <div class="hub-benefit-body">
                <h4>Ubicación Exacta por Zonas ESPE</h4>
                <p>Frente a Puerta 1, Puerta 2, Santa Clara o sedes. Los estudiantes sabrán exactamente cómo llegar a tu local y tus horarios de atención.</p>
              </div>
            </div>
          </div>

          <!-- CATEGORÍAS ABIERTAS -->
          <div class="hub-categories-box">
            <div class="hub-cat-header">
              <span class="cat-box-icon">🎯</span>
              <strong>Buscamos todo tipo de negocios y servicios cerca de la ESPE:</strong>
            </div>
            <div class="hub-tags-cloud">
              <span class="hub-tag">🖨️ Fotocopiadoras, Ploteo y Anillados</span>
              <span class="hub-tag">🍲 Restaurantes, Almuerzos y Cafeterías</span>
              <span class="hub-tag">📐 Papelerías y Artículos de Dibujo</span>
              <span class="hub-tag">🚌 Rutas de Transporte Universitario</span>
              <span class="hub-tag">🏠 Alquiler de Cuartos y Residencias</span>
              <span class="hub-tag">🩺 Consultorios Médicos, Dentales y Ópticas</span>
              <span class="hub-tag">⚡ Asesorías Académicas y Clases Particulares</span>
              <span class="hub-tag">📦 Emprendimientos Estudiantiles</span>
            </div>
          </div>

          <!-- PASOS PARA POSTULAR -->
          <div class="hub-steps-container">
            <span class="steps-title">¿Cómo postular? Solo 3 pasos rápidos:</span>
            <div class="steps-row">
              <div class="step-card">
                <div class="step-badge">1</div>
                <strong>Envía la Información</strong>
                <p>Nombre del local, categoría, dirección o zona, horario y datos de contacto de tu negocio.</p>
              </div>
              <div class="step-card">
                <div class="step-badge">2</div>
                <strong>Revisión Comunitaria</strong>
                <p>Validamos que los datos sean auténticos para proteger y guiar a los estudiantes de la ESPE.</p>
              </div>
              <div class="step-card">
                <div class="step-badge">3</div>
                <strong>¡Aparece en Pilas!</strong>
                <p>Se publica en este directorio web y se sincroniza en la app de toda la comunidad politécnica.</p>
              </div>
            </div>
          </div>

          <!-- BOTONES DE ACCIÓN PRINCIPALES -->
          <div class="hub-actions-bar">
            <a
              href={postularUrl}
              target={hasFormUrl ? '_blank' : undefined}
              rel={hasFormUrl ? 'noopener noreferrer' : undefined}
              class="btn-app btn-app-primary btn-hub-cta"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Postular mi Negocio o Emprendimiento Gratis</span>
            </a>

            <a
              href={`mailto:${COMUNIDAD_REPORTE_EMAIL}?subject=${mailtoSubject}&body=${mailtoBody}`}
              class="btn-app btn-app-surface btn-hub-email"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>Enviar datos por Correo ({COMUNIDAD_REPORTE_EMAIL})</span>
            </a>
          </div>

          <div class="hub-student-tip">
            <span class="tip-spark">💡</span>
            <span>
              <strong>¿Eres estudiante politécnico y tienes un emprendimiento?</strong> Si vendes postres, dulces, haces impresiones en tu depa o das clases de cálculo o física, ¡este directorio también es para ti!
            </span>
          </div>
        </div>
      ) : (
        <>
          <div class="results-meta" id="results-counter" aria-live="polite">
            Mostrando <strong id="visible-count">{negocios.length}</strong> de <strong>{negocios.length}</strong> negocios registrados
          </div>

          <div class="negocios-grid" id="negocios-list">
          {negocios.map((negocio) => {
            const catInfo = categoryLabels[negocio.category] || { label: negocio.category, icon: '🏷️' };
            const cleanWhatsapp = negocio.contact?.whatsapp?.replace(/[^0-9+]/g, '');
            const waLink = cleanWhatsapp
              ? `https://wa.me/${cleanWhatsapp.replace(/^\+/, '')}`
              : null;

            return (
              <article
                class="card-app negocio-card"
                id={negocio.id}
                data-category={negocio.category}
                data-search={`${negocio.name} ${negocio.description} ${negocio.zone} ${negocio.address}`.toLowerCase()}
              >
                <div class="card-head">
                  {negocio.logo ? (
                    <img
                      src={negocio.logo}
                      alt={`Logo de ${negocio.name}`}
                      width="54"
                      height="54"
                      class="negocio-logo"
                      loading="lazy"
                    />
                  ) : (
                    <div class="negocio-logo-placeholder" aria-hidden="true">
                      <span>{catInfo.icon}</span>
                    </div>
                  )}

                  <div class="card-title-group">
                    <div class="badges-row">
                      <span class="badge-cat">
                        <span>{catInfo.icon}</span>
                        <span>{catInfo.label}</span>
                      </span>

                      {negocio.verifiedAt && (
                        <span class="badge-verified" title="Negocio verificado por moderación">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <span>Verificado</span>
                        </span>
                      )}
                    </div>
                    <h2 class="negocio-name">{negocio.name}</h2>
                  </div>
                </div>

                <p class="negocio-desc">{negocio.description}</p>

                <div class="negocio-info-rows">
                  <div class="info-row">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>
                      <strong>{negocio.zone}:</strong> {negocio.address}
                    </span>
                  </div>

                  {negocio.hours && (
                    <div class="info-row">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span>{negocio.hours}</span>
                    </div>
                  )}
                </div>

                {negocio.contact && Object.keys(negocio.contact).length > 0 && (
                  <div class="contact-actions">
                    {waLink && (
                      <a
                        href={waLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn contact-wa"
                        aria-label={`Escribir por WhatsApp a ${negocio.name}`}
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                        <span>WhatsApp</span>
                      </a>
                    )}

                    {negocio.contact.phone && (
                      <a href={`tel:${negocio.contact.phone}`} class="contact-btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>Llamar</span>
                      </a>
                    )}

                    {negocio.contact.instagram && (
                      <a
                        href={negocio.contact.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn"
                        aria-label={`Ver Instagram de ${negocio.name}`}
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                        <span>Instagram</span>
                      </a>
                    )}

                    {negocio.contact.web && (
                      <a
                        href={negocio.contact.web}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn"
                        aria-label={`Visitar sitio web de ${negocio.name}`}
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="2" y1="12" x2="22" y2="12"></line>
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                        <span>Sitio Web</span>
                      </a>
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </>
    )}

      <!-- Estado vacío para búsquedas sin resultados -->
      <div id="no-search-results" class="empty-state card-app" style="display: none;">
        <h3>No se encontraron negocios</h3>
        <p>No hay resultados que coincidan con los filtros seleccionados. Prueba otra búsqueda o categoría.</p>
        <button type="button" id="reset-filters-btn" class="btn-app btn-app-surface">
          <span>Restablecer filtros</span>
        </button>
      </div>

      <div class="community-page-footer reveal-init">
        <a href="/" class="btn-app btn-app-surface">
          <span>← Volver al inicio</span>
        </a>
        <a href="/avisos" class="btn-app btn-app-primary">
          <span>Ver Avisos de la Comunidad →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Filtrado instantáneo y ligero de negocios por texto y categoría (Vanilla JS)
  const searchInput = document.getElementById('negocios-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-search-btn');
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-chip');
  const cards = document.querySelectorAll<HTMLElement>('.negocio-card');
  const counterEl = document.getElementById('visible-count');
  const noResultsEl = document.getElementById('no-search-results');
  const resetBtn = document.getElementById('reset-filters-btn');

  let activeCategory = 'todas';
  let searchTerm = '';

  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      const cardCat = card.getAttribute('data-category') || '';
      const cardSearch = card.getAttribute('data-search') || '';

      const matchesCat = activeCategory === 'todas' || cardCat === activeCategory;
      const matchesSearch = !searchTerm || cardSearch.includes(searchTerm);

      if (matchesCat && matchesSearch) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (counterEl) counterEl.textContent = String(visible);

    if (noResultsEl) {
      noResultsEl.style.display = visible === 0 && cards.length > 0 ? 'block' : 'none';
    }

    if (clearBtn && searchInput) {
      clearBtn.style.display = searchInput.value ? 'inline-block' : 'none';
    }
  }

  // Evento de búsqueda
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchTerm = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  if (clearBtn && searchInput) {
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      applyFilters();
      searchInput.focus();
    });
  }

  // Eventos de botones de categoría
  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      activeCategory = btn.getAttribute('data-cat') || 'todas';
      applyFilters();
    });
  });

  if (resetBtn && searchInput) {
    resetBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      activeCategory = 'todas';
      catButtons.forEach((b) => {
        const isAll = b.getAttribute('data-cat') === 'todas';
        b.classList.toggle('active', isAll);
        b.setAttribute('aria-selected', String(isAll));
      });
      applyFilters();
    });
  }
</script>


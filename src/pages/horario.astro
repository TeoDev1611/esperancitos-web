  .breadcrumb-sep {
    color: var(--color-border);
  }

  .breadcrumb-current {
    color: var(--color-text-title);
    font-weight: 500;
  }

  /* HERO HEADER */
  .converter-hero-header {
    margin-bottom: 3rem;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .converter-main-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text-title);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .title-highlight {
    background: linear-gradient(135deg, var(--color-primary) 0%, #ff85c0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .converter-hero-desc {
    font-size: 1.125rem;

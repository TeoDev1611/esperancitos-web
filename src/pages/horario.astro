    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brutalist);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .export-badge-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background: rgba(255, 63, 164, 0.15);
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .export-badge-tag.qr-tag {
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
  }

  .export-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin: 0 0 0.5rem 0;
  }

  .export-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem 0;
  }

  .export-tips {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding: 0.8rem 1rem;
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .tip-check {
    color: var(--color-success);
    font-weight: bold;
  }

  .export-tips p {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-body);
    margin: 0;
  }

  /* QR CODE STYLES */
  .qr-render-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .qr-canvas-wrapper {
    background: #ffffff;
    padding: 0.75rem;
    border-radius: 12px;
    border: 3px solid #000;
    box-shadow: 4px 4px 0px #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-canvas-wrapper canvas {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .qr-action-buttons {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    justify-content: center;
  }

  .btn-mini-brutalist {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.5rem 0.9rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-title);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-hover);
  }

  .btn-mini-brutalist:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  /* BARRA DE CONTROLES & TABS */
  /* ==========================================================================
     BARRA DE CONTROLES DE VISTA & TABS (NEO-BRUTALISMO ESTUDIANTIL)
     ========================================================================== */
  .preview-controls-bar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .view-tabs-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .view-tabs {
    display: inline-flex;
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    padding: 0.35rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-brutalist-sm);
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-hover) var(--ease-spring);
  }

  .tab-btn:hover {
    color: var(--color-text-title);
    background: rgba(255, 255, 255, 0.05);
  }

  .tab-btn.is-active {
    background: var(--color-primary);
    color: #000;
    box-shadow: 2px 2px 0px #000;
  }

  .btn-print-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    color: var(--color-text-title);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    box-shadow: var(--shadow-brutalist-sm);
    transition: all var(--duration-hover) var(--ease-spring);
  }

  .btn-print-action:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-brutalist);
  }

  /* SELECTOR DE DÍAS (PILLS HORIZONTALES) */
  .day-filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .day-pill {
    background: var(--color-bg-surface);
    border: 1.5px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.825rem;
    font-weight: 700;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--duration-hover);
  }

  .day-pill:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .day-pill.is-active {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: #000;
    font-weight: 800;
    box-shadow: 2px 2px 0 #000;
  }

  /* ==========================================================================
     1. HORARIO SEMANAL: TABLERO MULTI-COLUMNA DE DÍAS
     ========================================================================== */
  .weekly-board-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(250px, 1fr));
    gap: 1.25rem;
    overflow-x: auto;
    padding-bottom: 1.5rem;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    margin-bottom: 2.5rem;
  }

  .day-column {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-brutalist-sm);
    display: flex;
    flex-direction: column;
    min-width: 250px;
    scroll-snap-align: start;
    transition: all var(--duration-hover);
    overflow: hidden;
  }

  .day-column.has-classes {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .day-column.is-free-day {
    opacity: 0.85;
    border-style: dashed;
  }

  .day-column-header {
    padding: 0.85rem 1rem;
    background: var(--color-bg-elevated);
    border-bottom: 2px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .day-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .day-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .day-dot.active {
    background: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary);
  }

  .day-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--color-text-title);
    text-transform: uppercase;
  }

  .day-stats-pill {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .day-stats-pill.active {
    border-color: rgba(0, 240, 255, 0.35);
    color: var(--accent-cyan);
  }

  .day-stats-pill.free {
    border-color: rgba(0, 255, 135, 0.35);
    color: var(--color-success);
  }

  .day-column-body {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  .day-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    border: 2px dashed rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-sm);
    margin: auto 0;
    background: rgba(255, 255, 255, 0.015);
  }

  .day-empty-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .day-empty-title {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin-bottom: 0.25rem;
  }

  .day-empty-desc {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    max-width: 180px;
  }

  /* HUECO / TIEMPO LIBRE ENTRE CLASES */
  .schedule-gap-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.025);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    padding: 0.45rem 0.65rem;
    border-radius: 6px;
    text-align: center;
    transition: all var(--duration-hover);
  }

  .schedule-gap-pill:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .schedule-gap-pill .gap-icon {
    font-size: 0.85rem;
  }

  /* TARJETA DE CLASE EN EL TABLERO */
  .schedule-class-card {
    background: var(--color-bg-base);
    border: 2px solid var(--card-border, var(--color-border));
    border-radius: var(--radius-sm);
    box-shadow: 2px 2px 0px #000;
    padding: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .schedule-class-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--card-accent, var(--color-primary));
  }

  .schedule-class-card:hover,
  .schedule-class-card:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px #000;
    border-color: var(--card-accent, var(--color-primary));
    outline: none;
  }

  .card-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2px;
  }

  .card-time-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 800;
    color: var(--color-text-title);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .card-duration-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    box-shadow: 1px 1px 0 #000;
  }

  .card-subject-title {
    font-size: 0.985rem;
    font-weight: 900;
    line-height: 1.3;
    color: var(--color-text-title);
    margin: 0;
    word-break: break-word;
  }

  .card-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .meta-code-pill,
  .meta-nrc-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .meta-nrc-pill {
    border-color: rgba(255, 183, 3, 0.4);
    color: var(--color-warning);
  }

  .card-info-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0.55rem;
    font-size: 0.8rem;
  }

  .card-info-item {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    color: var(--color-text-body);
    line-height: 1.35;
  }

  .card-info-item.room-warning {
    color: var(--color-warning);
    font-weight: 700;
  }

  .card-info-item.room-virtual {
    color: var(--accent-cyan);
    font-weight: 700;
  }

  .card-info-item .icon {
    flex-shrink: 0;
    font-size: 0.85rem;
  }

  .card-info-item .text strong {
    color: var(--color-text-muted);
  }

  /* ==========================================================================
     2. MATRIZ HORARIA (GRID SEMANAL COMPLETO DE 07:00 A 21:00)
     ========================================================================== */
  .matrix-card-wrap {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-brutalist);
    padding: 1.25rem;
    margin-bottom: 2.5rem;
    overflow: hidden;
  }

  .matrix-legend-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }

  .matrix-legend-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-text-title);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 10px var(--color-primary);
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .matrix-legend-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .matrix-scroll-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-base);
  }

  .matrix-grid-container {
    display: grid;
    /* 1 Columna de tiempo (75px) + 6 Columnas de Días */
    grid-template-columns: 75px repeat(6, minmax(135px, 1fr));
    /* 1 Fila Cabecera (42px) + 14 Filas de Horas (07:00 a 21:00, 64px c/u) */
    grid-template-rows: 42px repeat(14, 64px);
    position: relative;
    min-width: 890px;
  }

  .matrix-cell {
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .matrix-corner-cell {
    grid-column: 1;
    grid-row: 1;
    background: var(--color-bg-elevated);
    border-right: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
    color: var(--color-text-muted);
    position: sticky;
    top: 0;
    left: 0;
    z-index: 5;
  }

  .matrix-header-cell {
    background: var(--color-bg-elevated);
    border-bottom: 2px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: sticky;
    top: 0;
    z-index: 4;
  }

  .matrix-header-cell.is-highlighted {
    background: rgba(0, 240, 255, 0.15);
    border-color: var(--accent-cyan);
  }

  .matrix-header-abbr {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 900;
    color: var(--color-text-title);
  }

  .matrix-header-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 900;
    color: var(--color-text-title);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .matrix-time-cell {
    background: var(--color-bg-elevated);
    border-right: 2px solid var(--color-border);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-text-muted);
    position: sticky;
    left: 0;
    z-index: 3;
  }

  .matrix-slot-bg {
    background: transparent;
    pointer-events: none;
  }

  .matrix-slot-bg:nth-child(even) {
    background: rgba(255, 255, 255, 0.008);
  }

  .matrix-class-block {
    margin: 3px 4px;
    border-radius: 6px;
    border: 2px solid var(--card-border, var(--color-primary));
    background: var(--card-bg, rgba(255, 63, 164, 0.15));
    padding: 0.45rem 0.55rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    cursor: pointer;
    z-index: 3;
    box-shadow: 2px 2px 0px #000;
    transition: all 0.16s ease;
  }

  .matrix-class-block:hover,
  .matrix-class-block:focus-visible {
    transform: scale(1.02);
    z-index: 8;
    box-shadow: 4px 4px 0px #000;
    border-color: #fff;
    outline: none;
  }

  .matrix-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .matrix-block-time {
    color: var(--color-text-title);
    white-space: nowrap;
  }

  .matrix-block-nrc {
    font-size: 0.62rem;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-weight: 800;
    box-shadow: 1px 1px 0 #000;
  }

  .matrix-block-title {
    font-size: 0.8rem;
    font-weight: 900;
    line-height: 1.25;
    color: #fff;
    margin: 0.2rem 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }

  .matrix-block-footer {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-text-body);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .matrix-block-room.warn {
    color: var(--color-warning);
  }

  /* ==========================================================================
     3. AGENDA DIARIA (TIMELINE DETALLADO)
     ========================================================================== */
  .agenda-timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .agenda-day-section {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-brutalist-sm);
    padding: 1.5rem;
  }

  .agenda-day-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-border);
  }

  .agenda-day-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .agenda-accent-bar {
    width: 6px;
    height: 22px;
    border-radius: 3px;
    background: var(--color-primary);
  }

  .agenda-day-title h3 {
    font-size: 1.25rem;
    font-weight: 900;
    margin: 0;
    color: var(--color-text-title);
  }

  .agenda-day-badge {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    color: var(--accent-cyan);
  }

  .agenda-timeline-rail {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
  }

  .agenda-timeline-rail::before {
    content: '';
    position: absolute;
    left: 80px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--color-border);
    z-index: 1;
  }

  .agenda-item-node {
    display: flex;
    gap: 1.5rem;
    position: relative;
    z-index: 2;
    cursor: pointer;
  }

  .agenda-time-column {
    width: 80px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
  }

  .agenda-time-start {
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--color-text-title);
  }

  .agenda-time-divider {
    width: 10px;
    height: 1px;
    background: var(--color-border);
    margin: 2px 0;
  }

  .agenda-time-end {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .agenda-time-dur {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin-top: 0.2rem;

---
// horario.astro - Convertidor Oficial de Horarios de Banner 9 a Pilas! ESPE
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Convertidor de Horarios Banner 9 ESPE a .pilas | Pilas! para iPhone y Android"
  description="Convierte tu horario en PDF descargado de Banner 9 ESPE al formato .pilas o sincronízalo mediante código QR a tu PWA Pilas! en iPhone y Android. Procesamiento 100% privado en tu navegador."
  keywords="convertidor horario ESPE, horario banner espe pdf, horario pilas iphone, importar horario banner 9 espe, horario espe qr, app horario espe"
  includeAppSchema={false}
>
  <main class="converter-page">
    <div class="container">
      <!-- Breadcrumb / Volver -->
      <nav class="converter-breadcrumb" aria-label="Navegación secundaria">
        <a href="/" class="btn-back-home">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Volver al inicio</span>
        </a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Convertidor de Horarios Banner</span>
      </nav>

      <!-- Encabezado de la herramienta -->
      <header class="converter-hero-header">
        <div class="badge-row">
          <span class="badge-app fuchsia">BANNER 9 ESPE · ZERO-BACKEND</span>
          <span class="badge-app cyan">COMPATIBLE CON IPHONE & ANDROID</span>
        </div>
        <h1 class="converter-main-title">
          Pasa tu Horario de Banner <br class="hidden-mobile" />
          <span class="title-highlight">Directo a tu Teléfono</span>
        </h1>
        <p class="converter-hero-desc">
          Convierte el PDF oficial impreso de Banner 9 al formato <code class="code-pill">.pilas</code> para la PWA en iOS o escanéalo al instante con la cámara de tu aplicación. 
          <strong>Tus datos nunca salen de tu dispositivo:</strong> todo el procesamiento se ejecuta 100% en tu navegador de forma privada.
        </p>

        <!-- Píldoras de Seguridad & Privacidad -->
        <div class="privacy-badges-grid">
          <div class="privacy-item">
            <span class="privacy-icon" aria-hidden="true">🔒</span>
            <div>
              <strong>100% en el cliente</strong>
              <p>El PDF se lee en tu memoria RAM local</p>
            </div>
          </div>
          <div class="privacy-item">
            <span class="privacy-icon" aria-hidden="true">🚫</span>
            <div>
              <strong>Cero servidores</strong>
              <p>Sin APIs externas ni almacenamiento remoto</p>
            </div>
          </div>
          <div class="privacy-item">
            <span class="privacy-icon" aria-hidden="true">⚡</span>
            <div>
              <strong>Instantáneo</strong>
              <p>Genera el archivo .pilas y QR al instante</p>
            </div>
          </div>
        </div>
      </header>

      <!-- Instrucciones Paso a Paso con Enlace Directo y Captura Oficial -->
      <section class="banner-steps-guide" aria-label="Tutorial para descargar tu horario desde Banner 9">
        <div class="guide-header">
          <div class="guide-header-badges">
            <span class="guide-num-badge">💡 TUTORIAL RÁPIDO</span>
            <span class="badge-app green-subtle">PASO A PASO PARA MÓVIL Y PC</span>
          </div>
          <h2 class="guide-title">¿Cómo sacar tu Horario Oficial desde Banner 9 ESPE?</h2>
          <p class="guide-subtitle">
            Sigue estos 3 sencillos pasos para obtener tu horario listo para convertir:
          </p>
        </div>

        <div class="steps-cards-grid">
          <!-- PASO 1: ENLACE DIRECTO -->
          <div class="step-card step-card-featured">
            <div class="step-header-row">
              <div class="step-number">1</div>
              <span class="step-tag">ACCESO DIRECTO</span>
            </div>
            <div class="step-body">
              <h3>Entra directo a tu Horario</h3>
              <p>
                Haz clic en el siguiente enlace oficial de la ESPE. Si no has iniciado sesión hoy, ingresa con tu correo y contraseña institucional:
              </p>
              
              <a
                href="https://registrop.espe.edu.ec/StudentRegistrationSsb/ssb/registrationHistory/registrationHistory"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-banner-direct"
                id="btn-direct-banner"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                <span>Abrir mi Horario en Banner 9 ↗</span>
              </a>
              <span class="direct-link-note">Se abre en una pestaña nueva oficial de la ESPE</span>
            </div>
          </div>

          <!-- PASO 2: BOTÓN IMPRESORA CON CAPTURA VISUAL -->
          <div class="step-card step-card-visual">
            <div class="step-header-row">
              <div class="step-number">2</div>
              <span class="step-tag pulse-tag">PUNTO CLAVE</span>
            </div>
            <div class="step-body">
              <h3>Toca el icono de la Impresora 🖨️</h3>
              <p>
                En la esquina superior derecha del cuadro de tus materias, <strong>haz clic en el icono de la impresora</strong> como se muestra en la captura:
              </p>

              <!-- Captura ilustrativa del botón de impresora -->
              <div class="tutorial-image-container">
                <div class="image-spotlight-badge">
                  <span class="spotlight-arrow">👉</span>
                  <span>Clic en este botón de impresora</span>
                </div>
                <div class="tutorial-img-frame">
                  <img
                    src="/images/banner-print-btn.png"
                    alt="Botón de impresora en la esquina superior derecha de Banner 9 ESPE"
                    class="tutorial-img"
                    width="180"
                    height="140"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- PASO 3: GUARDAR PDF O COPIAR TEXTO -->
          <div class="step-card">
            <div class="step-header-row">
              <div class="step-number">3</div>
              <span class="step-tag">GUARDAR O COPIAR</span>
            </div>
            <div class="step-body">
              <h3>Guarda el PDF (o copia el texto)</h3>
              <p>
                En la ventana que se abre:
              </p>
              <ul class="step-tips-list">
                <li>
                  <strong>Si estás en iPhone / Teléfono:</strong> Puedes seleccionar todo el texto de la pantalla y copiarlo directamente (¡no necesitas descargar nada!).
                </li>
                <li>
                  <strong>Si prefieres el PDF:</strong> En el cuadro de impresión selecciona <em>"Guardar como PDF"</em> y guárdalo en tus archivos.
                </li>
              </ul>
              <p class="step-final-note">
                Luego regresa aquí abajo y <strong>arrastra el PDF o pega el texto</strong>. ¡Listo!
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Zona de Carga e Interacción Principal -->
      <section class="converter-box-section" id="converter-box">
        <!-- DROPZONE -->
        <div class="dropzone-card" id="dropzone">
          <input type="file" id="file-input" accept="application/pdf" class="sr-only" aria-label="Seleccionar archivo PDF de Banner" />
          
          <div class="dropzone-content">
            <div class="dropzone-icon-wrap" id="dropzone-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <path d="M12 18v-6"></path>
                <path d="M9 15l3-3 3 3"></path>
              </svg>
            </div>
            
            <h2 class="dropzone-title" id="dropzone-text">Arrastra y suelta tu horario en PDF aquí</h2>
            <p class="dropzone-subtitle">o haz clic en el botón para buscarlo en tu dispositivo</p>
            
            <div class="dropzone-actions">
              <button type="button" class="btn-brutalist btn-primary" id="btn-browse">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <span>Seleccionar archivo PDF</span>
              </button>

              <button type="button" class="btn-brutalist btn-secondary" id="btn-demo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Cargar ejemplo de prueba</span>
              </button>
            </div>

            <p class="dropzone-hint">
              <span class="hint-bullet">•</span> Compatible con PDFs generados por Banner 9 ESPE (vista de impresión oficial).
            </p>
          </div>

          <!-- Spinner / Estado de procesamiento -->
          <div class="dropzone-loader" id="dropzone-loader" hidden>
            <div class="spinner-neon"></div>
            <p class="loader-title">Procesando horario en tu navegador...</p>
            <p class="loader-desc">Analizando materias, horarios, aulas y docentes...</p>
          </div>
        </div>

        <!-- MODO ALTERNATIVO: PEGAR TEXTO DIRECTAMENTE -->
        <div class="text-paste-container">
          <button type="button" class="btn-toggle-paste" id="btn-toggle-paste" aria-expanded="false" aria-controls="paste-panel">
            <span class="toggle-icon" id="toggle-chevron">▼</span>
            <span>¿Prefieres pegar el texto copiado de Banner? (Haz clic aquí)</span>
          </button>

          <div class="paste-panel" id="paste-panel" hidden>
            <div class="paste-panel-inner">
              <label for="raw-text-input" class="paste-label">
                Pega el texto seleccionado de la página de impresión de Banner ESPE:
              </label>
              <textarea
                id="raw-text-input"
                class="paste-textarea"
                rows="6"
                placeholder="Ejemplo:
INGENIERIA DE SOFTWARE SOFT A0101 101 6.0 12345 20-Oct-2026 - 20-Feb-2027
Lunes, Miércoles
07:00 - 08:59
CAMPUS CENTRAL ESPE, BLOQUE X FICTICIO, AULA-X101
DOCENTE EJEMPLO, CARLOS ALBERTO"
              ></textarea>
              <div class="paste-actions">
                <button type="button" class="btn-brutalist btn-cyan" id="btn-parse-text">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Procesar texto pegado</span>
                </button>
                <button type="button" class="btn-brutalist btn-subtle" id="btn-clear-text">
                  <span>Limpiar</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Alertas de estado y error -->
        <div class="alert-box alert-error" id="error-alert" hidden role="alert">
          <div class="alert-icon">⚠️</div>
          <div class="alert-content">
            <strong id="error-title">No se pudieron detectar materias</strong>
            <p id="error-desc">Asegúrate de haber subido el PDF oficial de la vista de impresión de Banner 9 ESPE.</p>
          </div>
          <button type="button" class="alert-close" id="btn-close-alert" aria-label="Cerrar alerta">✕</button>
        </div>
      </section>

      <!-- RESULTADOS & PREVISUALIZACIÓN (SE MUESTRA TRAS EL PARSEO) -->
      <section class="schedule-preview-section" id="schedule-preview" hidden aria-label="Previsualización del horario detectado">
        <!-- Metadatos de la cabecera del horario -->
        <div class="preview-meta-card">
          <div class="meta-top">
            <div class="meta-badge-group">
              <span class="badge-app success" id="badge-total-materias">0 MATERIAS DETECTADAS</span>
              <span class="badge-app amber" id="badge-total-clases">0 BLOQUES HORARIOS</span>
              <span class="badge-app cyan" id="badge-periodo">PERIODO: 202651</span>
            </div>
            <button type="button" class="btn-reset-parse" id="btn-reset">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="1 4 1 10 7 10"></polyline>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
              </svg>
              <span>Subir otro horario</span>
            </button>
          </div>

          <div class="meta-fields-grid">
            <div class="field-item">
              <label for="input-estudiante" class="field-label">Estudiante:</label>
              <input type="text" id="input-estudiante" class="field-input" value="Estudiante ESPE" />
            </div>
            <div class="field-item">
              <label for="input-periodo" class="field-label">Periodo Académico:</label>
              <input type="text" id="input-periodo" class="field-input" value="202651" />
            </div>
          </div>
        </div>

        <!-- ACCIONES DE EXPORTACIÓN (DESCARGA .PILAS Y CÓDIGO QR) -->
        <div class="export-actions-grid">
          <!-- TARJETA 1: DESCARGA .PILAS -->
          <div class="export-card download-card">
            <div class="export-card-header">
              <div class="export-badge-tag">RECOMENDADO PARA PWA</div>
              <h2 class="export-title">Descargar archivo .pilas</h2>
              <p class="export-desc">
                Genera tu archivo <code class="code-pill">horario_espe.pilas</code> con la estructura exacta compatible con el almacenamiento Drift SQLite de Pilas!.
              </p>
            </div>

            <div class="export-body">
              <button type="button" class="btn-brutalist btn-fuchsia btn-large" id="btn-download-pilas">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Descargar horario_espe.pilas</span>
              </button>

              <div class="export-tips">
                <span class="tip-check">✓</span>
                <p>En tu iPhone o Android, abre Pilas! → <strong>Ajustes / Horario</strong> → <strong>Importar archivo .pilas</strong>.</p>
              </div>
            </div>
          </div>

          <!-- TARJETA 2: CÓDIGO QR PWA (P2P ESP://FRIEND) -->
          <div class="export-card qr-card">
            <div class="export-card-header">
              <div class="export-badge-tag qr-tag">SIN DESCARGAS · SCAN & GO</div>
              <h2 class="export-title">Escanea con tu PWA Pilas!</h2>
              <p class="export-desc">
                Comprimido en Gzip y codificado en Base64Url con el protocolo <code class="code-pill">esp://friend</code>. Apunta la cámara de tu app al monitor.
              </p>
            </div>

            <div class="qr-render-container">
              <div class="qr-canvas-wrapper" id="qr-wrapper">
                <canvas id="qr-canvas" width="220" height="220" aria-label="Código QR con tu horario comprimido"></canvas>
              </div>

              <div class="qr-action-buttons">
                <a href="#" class="btn-mini-brutalist btn-open-pwa" id="btn-open-protocol" title="Abrir directamente con la app Pilas en tu teléfono">
                  <span>📱 Abrir en Pilas! App</span>
                </a>
                <button type="button" class="btn-mini-brutalist" id="btn-copy-protocol">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="btn-copy-protocol-text">Copiar URI</span>
                </button>
                <button type="button" class="btn-mini-brutalist" id="btn-download-qr">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Guardar QR</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- FILTROS Y VISTAS INTERACTIVAS -->
        <div class="preview-controls-bar">
          <div class="view-tabs" role="tablist" aria-label="Modo de visualización">
            <button type="button" class="tab-btn is-active" id="tab-day-view" role="tab" aria-selected="true" aria-controls="view-by-days">
              Vista por Días de Semana
            </button>
            <button type="button" class="tab-btn" id="tab-subject-view" role="tab" aria-selected="false" aria-controls="view-by-subjects">
              Vista por Materias
            </button>
          </div>

          <!-- Selector de día rápido -->
          <div class="day-filter-pills" id="day-filter-container">
            <button type="button" class="day-pill is-active" data-day="ALL">Todos</button>
            <button type="button" class="day-pill" data-day="LUN">Lunes</button>
            <button type="button" class="day-pill" data-day="MAR">Martes</button>
            <button type="button" class="day-pill" data-day="MIE">Miércoles</button>
            <button type="button" class="day-pill" data-day="JUE">Jueves</button>
            <button type="button" class="day-pill" data-day="VIE">Viernes</button>
            <button type="button" class="day-pill" data-day="SAB">Sábado</button>
          </div>
        </div>

        <!-- CONTENEDOR 1: VISTA POR DÍAS (CRONOGRAMA) -->
        <div class="schedule-view-panel" id="view-by-days">
          <div class="schedule-grid" id="classes-grid">
            <!-- Rellenado dinámicamente con JavaScript -->
          </div>
        </div>

        <!-- CONTENEDOR 2: VISTA POR MATERIAS (ACORDEÓN / TARJETAS) -->
        <div class="schedule-view-panel" id="view-by-subjects" hidden>
          <div class="subjects-grid" id="subjects-grid">
            <!-- Rellenado dinámicamente con JavaScript -->
          </div>
        </div>

        <!-- PREVIEW JSON RAW (COLAPSABLE) -->
        <div class="json-preview-container">
          <button type="button" class="btn-toggle-json" id="btn-toggle-json" aria-expanded="false" aria-controls="json-preview-box">
            <span id="json-chevron">▼</span>
            <span>Ver JSON crudo generado para el archivo .pilas</span>
          </button>
          <div class="json-preview-box" id="json-preview-box" hidden>
            <pre><code id="json-preview-code"></code></pre>
          </div>
        </div>
      </section>

      <!-- SECCIÓN FAQ / RESOLUCIÓN DE PROBLEMAS -->
      <section class="converter-faq-section" aria-label="Preguntas frecuentes sobre horarios">
        <h2 class="faq-section-title">Preguntas Frecuentes del Horario Banner</h2>
        <div class="faq-grid">
          <div class="faq-card">
            <h3>¿Por qué los iPhone necesitan este convertidor?</h3>
            <p>
              En iOS / Safari existen restricciones de seguridad en las descargas directas de PDFs institucionales con cookies protegidas. Con este convertidor web, extraes tu horario en un formato ligero y lo sincronizas a tu PWA en 1 segundo con la cámara.
            </p>
          </div>
          <div class="faq-card">
            <h3>¿Mis contraseñas o datos se comparten con Pilas!?</h3>
            <p>
              <strong>Jamás.</strong> Este convertidor no pide tus contraseñas ni tiene base de datos en la nube. El archivo PDF se abre en la memoria de tu navegador y nada se transmite a internet.
            </p>
          </div>
          <div class="faq-card">
            <h3>¿Qué pasa si mi clase termina en :59 minutos?</h3>
            <p>
              Banner 9 registra las clases con minutos como <code>08:59</code> o <code>14:59</code> para evitar traslapes del sistema. Nuestro algoritmo inteligente las redondea automáticamente a <code>09:00</code> y <code>15:00</code> respectivamente.
            </p>
          </div>
          <div class="faq-card">
            <h3>¿Cómo se resuelven las aulas del campus?</h3>
            <p>
              El analizador descompone cadenas como <code>ESPE MATRIZ SANGOLQUI, BLOQUE B SANGOLQUI, B415</code> para extraer el aula limpia y el bloque de forma que la app Pilas! te ubique sin confusiones.
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { extractTextFromPdf } from '../lib/pdf-extractor';
  import {
    parseBannerSchedule,
    generateQrPayload,
    generateFriendQrProtocol,
    downloadPilasFile,
    type PilasSchedule,
    type MateriaItem,
    type ClaseItem,
  } from '../lib/banner-parser';
  import QRCode from 'qrcode';

  // Demo schedule text con datos y bloques ficticios de mentira
  const DEMO_BANNER_TEXT = `Universidad de las Fuerzas Armadas ESPE
Detalle del Horario del Estudiante
Estudiante: ESTUDIANTE EJEMPLO, ALEX JAVIER
Periodo: 202651 - Pregrado Octubre 2026 - Febrero 2027

INGENIERIA DE SOFTWARE SOFT A0101 101 6.0 12345 20-Oct-2026 - 20-Feb-2027
Lunes, Miércoles
07:00 - 08:59
CAMPUS CENTRAL ESPE, BLOQUE X FICTICIO, AULA-X101
DOCENTE EJEMPLO, CARLOS ALBERTO

CALCULO VECTORIAL MATG 1002 102 4.0 23456 20-Oct-2026 - 20-Feb-2027
Martes, Jueves
09:00 - 10:59
CAMPUS CENTRAL ESPE, EDIFICIO OMEGA, AULA-OM02
PROFESORA DEMO, MARIA FERNANDA (P)

PROGRAMACION ORIENTADA A OBJETOS CS 2002 103 3.0 34567 15-Oct-2026 - 25-Feb-2027
Lunes, Miércoles, Viernes
11:00 - 12:59
CAMPUS CENTRAL ESPE, LABORATORIO VIRTUAL, LAB-DEMO-03
INSTRUCTOR FICTICIO, ROBERTO DANIEL

FISICA CONCEPTUAL FISI A0102 104 4.0 45678 20-Oct-2026 - 20-Feb-2027
Martes
11:00 - 12:59
CAMPUS CENTRAL ESPE, BLOQUE Z KRYPTON, AULA-Z204
DOCENTE PRUEBA, ANDREA SOFIA
Jueves
11:00 - 11:59
CAMPUS CENTRAL ESPE, LABORATORIOS EXPERIMENTALES, LAB-EXP-02
DOCENTE PRUEBA, ANDREA SOFIA`;

  // Estado global en memoria
  let currentSchedule: PilasSchedule | null = null;
  let currentDayFilter = 'ALL';
  let currentViewMode: 'days' | 'subjects' = 'days';

  // Elementos DOM
  const dropzone = document.getElementById('dropzone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const btnBrowse = document.getElementById('btn-browse') as HTMLButtonElement;
  const btnDemo = document.getElementById('btn-demo') as HTMLButtonElement;
  const dropzoneLoader = document.getElementById('dropzone-loader') as HTMLElement;
  const errorAlert = document.getElementById('error-alert') as HTMLElement;
  const errorTitle = document.getElementById('error-title') as HTMLElement;
  const errorDesc = document.getElementById('error-desc') as HTMLElement;
  const btnCloseAlert = document.getElementById('btn-close-alert') as HTMLButtonElement;

  // Textarea panel
  const btnTogglePaste = document.getElementById('btn-toggle-paste') as HTMLButtonElement;
  const pastePanel = document.getElementById('paste-panel') as HTMLElement;
  const toggleChevron = document.getElementById('toggle-chevron') as HTMLElement;
  const rawTextInput = document.getElementById('raw-text-input') as HTMLTextAreaElement;
  const btnParseText = document.getElementById('btn-parse-text') as HTMLButtonElement;
  const btnClearText = document.getElementById('btn-clear-text') as HTMLButtonElement;

  // Preview Section
  const schedulePreview = document.getElementById('schedule-preview') as HTMLElement;
  const badgeTotalMaterias = document.getElementById('badge-total-materias') as HTMLElement;
  const badgeTotalClases = document.getElementById('badge-total-clases') as HTMLElement;
  const badgePeriodo = document.getElementById('badge-periodo') as HTMLElement;
  const inputEstudiante = document.getElementById('input-estudiante') as HTMLInputElement;
  const inputPeriodo = document.getElementById('input-periodo') as HTMLInputElement;
  const btnReset = document.getElementById('btn-reset') as HTMLButtonElement;

  // Export buttons
  const btnDownloadPilas = document.getElementById('btn-download-pilas') as HTMLButtonElement;
  const qrCanvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
  const btnCopyProtocol = document.getElementById('btn-copy-protocol') as HTMLButtonElement;
  const btnCopyProtocolText = document.getElementById('btn-copy-protocol-text') as HTMLElement;
  const btnDownloadQr = document.getElementById('btn-download-qr') as HTMLButtonElement;

  // Tabs & Views
  const tabDayView = document.getElementById('tab-day-view') as HTMLButtonElement;
  const tabSubjectView = document.getElementById('tab-subject-view') as HTMLButtonElement;
  const viewByDays = document.getElementById('view-by-days') as HTMLElement;
  const viewBySubjects = document.getElementById('view-by-subjects') as HTMLElement;
  const classesGrid = document.getElementById('classes-grid') as HTMLElement;
  const subjectsGrid = document.getElementById('subjects-grid') as HTMLElement;
  const dayPills = document.querySelectorAll<HTMLButtonElement>('.day-pill');

  // JSON Preview
  const btnToggleJson = document.getElementById('btn-toggle-json') as HTMLButtonElement;
  const jsonPreviewBox = document.getElementById('json-preview-box') as HTMLElement;
  const jsonPreviewCode = document.getElementById('json-preview-code') as HTMLElement;
  const jsonChevron = document.getElementById('json-chevron') as HTMLElement;

  // ---------------------------------------------------------------------------
  // MANEJADORES DE DROPZONE & ARCHIVOS
  // ---------------------------------------------------------------------------
  if (btnBrowse && fileInput) {
    btnBrowse.addEventListener('click', () => {
      fileInput.click();
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', async (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) {
        await handleFile(files[0]);
      }
      fileInput.value = '';
    });
  }

  if (dropzone) {
    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('is-dragover');
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('is-dragover');
      });
    });

    dropzone.addEventListener('drop', async (e) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files[0]) {
        await handleFile(dt.files[0]);
      }
    });
  }

  async function handleFile(file: File) {
    if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
      showError('Formato no compatible', 'Por favor selecciona un archivo PDF descargado de Banner 9.');
      return;
    }

    hideError();
    setLoader(true);

    try {
      const extractedText = await extractTextFromPdf(file);
      if (!extractedText || extractedText.trim().length === 0) {
        throw new Error('El PDF no contiene texto legible (posiblemente esté protegido o escaneado como imagen).');
      }

      processTextAndRender(extractedText);
    } catch (err: any) {
      console.error('Error al procesar PDF:', err);
      showError(
        'Error al procesar el PDF',
        err.message || 'No se pudo extraer el texto del archivo. Puedes copiar y pegar el texto manualmente usando la casilla inferior.'
      );
    } finally {
      setLoader(false);
    }
  }

  // Demo Button
  if (btnDemo) {
    btnDemo.addEventListener('click', () => {
      hideError();
      processTextAndRender(DEMO_BANNER_TEXT);
    });
  }

  // Toggle Paste Panel
  if (btnTogglePaste && pastePanel && toggleChevron) {
    btnTogglePaste.addEventListener('click', () => {
      const isHidden = pastePanel.hidden;
      pastePanel.hidden = !isHidden;
      btnTogglePaste.setAttribute('aria-expanded', String(isHidden));
      toggleChevron.textContent = isHidden ? '▲' : '▼';
    });
  }

  // Parse Text Button
  if (btnParseText && rawTextInput) {
    btnParseText.addEventListener('click', () => {
      const text = rawTextInput.value.trim();
      if (!text) {
        showError('Texto vacío', 'Pega el texto del horario copiado desde Banner 9 en el cuadro de texto.');
        return;
      }
      hideError();
      processTextAndRender(text);
    });
  }

  if (btnClearText && rawTextInput) {
    btnClearText.addEventListener('click', () => {
      rawTextInput.value = '';
    });
  }

  if (btnCloseAlert && errorAlert) {
    btnCloseAlert.addEventListener('click', () => {
      hideError();
    });
  }

  function showError(title: string, desc: string) {
    if (errorTitle) errorTitle.textContent = title;
    if (errorDesc) errorDesc.textContent = desc;
    if (errorAlert) errorAlert.hidden = false;
  }

  function hideError() {
    if (errorAlert) errorAlert.hidden = true;
  }

  function setLoader(isLoading: boolean) {
    if (dropzoneLoader) {
      dropzoneLoader.hidden = !isLoading;
      if (isLoading) {
        dropzoneLoader.classList.add('is-loading');
      } else {
        dropzoneLoader.classList.remove('is-loading');
      }
    }
  }

  // ---------------------------------------------------------------------------
  // PARSEO Y ACTUALIZACIÓN DE INTERFAZ
  // ---------------------------------------------------------------------------
  function processTextAndRender(rawText: string) {
    try {
      const schedule = parseBannerSchedule(rawText);

      if (!schedule.materias || schedule.materias.length === 0) {
        showError(
          'No se encontraron materias en el archivo',
          'El documento no contiene el formato típico de impresión de Banner 9 ESPE. Revisa que incluya código de materia (ej. EMEC A0202) y NRC de 5 dígitos.'
        );
        return;
      }

      currentSchedule = schedule;

      // Actualizar campos
      if (inputEstudiante) inputEstudiante.value = schedule.estudiante;
      if (inputPeriodo) inputPeriodo.value = schedule.periodo;

      updateStatsAndViews();

      // Mostrar previsualización
      if (schedulePreview) {
        schedulePreview.hidden = false;
        schedulePreview.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Generar código QR y preview JSON
      renderQrCode();
      updateJsonPreview();
    } catch (err: any) {
      console.error('Error durante el parseo:', err);
      showError('Error de análisis', err.message || 'Ocurrió un error inesperado al analizar el horario.');
    }
  }

  // Sincronizar cambios manuales de estudiante o periodo
  if (inputEstudiante) {
    inputEstudiante.addEventListener('input', () => {
      if (currentSchedule) {
        currentSchedule.estudiante = inputEstudiante.value.trim() || 'Estudiante ESPE';
        renderQrCode();
        updateJsonPreview();
      }
    });
  }

  if (inputPeriodo) {
    inputPeriodo.addEventListener('input', () => {
      if (currentSchedule) {
        currentSchedule.periodo = inputPeriodo.value.trim() || '202651';
        if (badgePeriodo) badgePeriodo.textContent = `PERIODO: ${currentSchedule.periodo}`;
        updateJsonPreview();
      }
    });
  }

  if (btnReset) {
    btnReset.addEventListener('click', () => {
      currentSchedule = null;
      if (schedulePreview) schedulePreview.hidden = true;
      if (dropzone) dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }

  function updateStatsAndViews() {
    if (!currentSchedule) return;

    const totalMaterias = currentSchedule.materias.length;
    let totalClases = 0;
    for (const m of currentSchedule.materias) {
      totalClases += m.clases.length;
    }

    if (badgeTotalMaterias) {
      badgeTotalMaterias.textContent = `${totalMaterias} ${totalMaterias === 1 ? 'MATERIA DETECTADA' : 'MATERIAS DETECTADAS'}`;
    }
    if (badgeTotalClases) {
      badgeTotalClases.textContent = `${totalClases} ${totalClases === 1 ? 'BLOQUE HORARIO' : 'BLOQUES HORARIOS'}`;
    }
    if (badgePeriodo) {
      badgePeriodo.textContent = `PERIODO: ${currentSchedule.periodo}`;
    }

    renderDaysView();
    renderSubjectsView();
  }

  // ---------------------------------------------------------------------------
  // VISTA POR DÍAS (CRONOGRAMA SEMANAL)
  // ---------------------------------------------------------------------------
  interface FlattenedClass {
    dia: ClaseItem['dia'];
    inicio: string;
    fin: string;
    aula: string;
    materia: string;
    codigo: string;
    nrc: string;
    docente: string;
  }

  const DAY_ORDER: Record<string, number> = {
    LUN: 1, MAR: 2, MIE: 3, JUE: 4, VIE: 5, SAB: 6, DOM: 7,
  };

  const DAY_FULL_NAMES: Record<string, string> = {
    LUN: 'Lunes',
    MAR: 'Martes',
    MIE: 'Miércoles',
    JUE: 'Jueves',
    VIE: 'Viernes',
    SAB: 'Sábado',
    DOM: 'Domingo',
  };

  function renderDaysView() {
    if (!currentSchedule || !classesGrid) return;

    // Aplanar todas las clases con sus metadatos de materia
    const allClases: FlattenedClass[] = [];
    for (const m of currentSchedule.materias) {
      for (const c of m.clases) {
        allClases.push({
          dia: c.dia,
          inicio: c.inicio,
          fin: c.fin,
          aula: c.aula,
          materia: m.materia,
          codigo: m.codigo,
          nrc: m.nrc,
          docente: m.docente,
        });
      }
    }

    // Filtrar por día si no es ALL
    const filtered = currentDayFilter === 'ALL'
      ? allClases
      : allClases.filter(c => c.dia === currentDayFilter);

    // Ordenar cronológicamente por día y luego por hora de inicio
    filtered.sort((a, b) => {
      const dayDiff = (DAY_ORDER[a.dia] || 0) - (DAY_ORDER[b.dia] || 0);
      if (dayDiff !== 0) return dayDiff;
      return a.inicio.localeCompare(b.inicio);
    });

    if (filtered.length === 0) {
      classesGrid.innerHTML = `
        <div class="empty-state-card">
          <span class="empty-icon">☕</span>
          <h3>Sin clases registradas para este día</h3>
          <p>No se encontraron bloques de clase para ${DAY_FULL_NAMES[currentDayFilter] || currentDayFilter}.</p>
        </div>
      `;
      return;
    }

    let html = '';
    for (const item of filtered) {
      const dayClass = `day-tag-${item.dia.toLowerCase()}`;
      html += `
        <article class="class-card ${dayClass}">
          <div class="class-card-header">
            <span class="day-badge ${dayClass}">${DAY_FULL_NAMES[item.dia] || item.dia}</span>
            <span class="time-range-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              ${item.inicio} - ${item.fin}
            </span>
          </div>

          <h3 class="class-title">${escapeHtml(item.materia)}</h3>

          <div class="class-meta-pills">
            <span class="pill-code">${escapeHtml(item.codigo)}</span>
            <span class="pill-nrc">NRC: ${escapeHtml(item.nrc)}</span>
          </div>

          <div class="class-details">
            <div class="detail-row">
              <span class="detail-icon" aria-hidden="true">📍</span>
              <span class="detail-text aula-text"><strong>Aula:</strong> ${escapeHtml(item.aula)}</span>
            </div>
            <div class="detail-row">
              <span class="detail-icon" aria-hidden="true">👨‍🏫</span>
              <span class="detail-text docente-text"><strong>Docente:</strong> ${escapeHtml(item.docente)}</span>
            </div>
          </div>
        </article>
      `;
    }

    classesGrid.innerHTML = html;
  }

  // ---------------------------------------------------------------------------
  // VISTA POR MATERIAS
  // ---------------------------------------------------------------------------
  function renderSubjectsView() {
    if (!currentSchedule || !subjectsGrid) return;

    let html = '';
    for (const m of currentSchedule.materias) {
      html += `
        <article class="subject-card">
          <div class="subject-header">
            <div class="subject-tags">
              <span class="badge-app fuchsia">${escapeHtml(m.codigo)}</span>
              <span class="badge-app amber">NRC ${escapeHtml(m.nrc)}</span>
            </div>
            <h3 class="subject-title">${escapeHtml(m.materia)}</h3>
            <p class="subject-docente">
              <span class="icon-inline" aria-hidden="true">👨‍🏫</span>
              ${escapeHtml(m.docente)}
            </p>
          </div>

          <div class="subject-sessions-list">
            <h4 class="sessions-heading">Horarios de clase asignados:</h4>
            ${m.clases.length === 0 ? '<p class="no-sessions">Sin sesiones detectadas.</p>' : ''}
            <div class="sessions-chips">
              ${m.clases.map(c => `
                <div class="session-chip day-tag-${c.dia.toLowerCase()}">
                  <span class="chip-day">${DAY_FULL_NAMES[c.dia] || c.dia}</span>
                  <span class="chip-time">${c.inicio} - ${c.fin}</span>
                  <span class="chip-aula">📍 ${escapeHtml(c.aula)}</span>
                </div>
              `).join('')}
            </div>
          </div>
        </article>
      `;
    }

    subjectsGrid.innerHTML = html;
  }

  // ---------------------------------------------------------------------------
  // FILTRADO POR DÍAS & TABS
  // ---------------------------------------------------------------------------
  dayPills.forEach(pill => {
    pill.addEventListener('click', () => {
      dayPills.forEach(p => p.classList.remove('is-active'));
      pill.classList.add('is-active');
      currentDayFilter = pill.getAttribute('data-day') || 'ALL';
      renderDaysView();
    });
  });

  if (tabDayView && tabSubjectView && viewByDays && viewBySubjects) {
    tabDayView.addEventListener('click', () => {
      tabDayView.classList.add('is-active');
      tabDayView.setAttribute('aria-selected', 'true');
      tabSubjectView.classList.remove('is-active');
      tabSubjectView.setAttribute('aria-selected', 'false');

      viewByDays.hidden = false;
      viewBySubjects.hidden = true;
      currentViewMode = 'days';
    });

    tabSubjectView.addEventListener('click', () => {
      tabSubjectView.classList.add('is-active');
      tabSubjectView.setAttribute('aria-selected', 'true');
      tabDayView.classList.remove('is-active');
      tabDayView.setAttribute('aria-selected', 'false');

      viewByDays.hidden = true;
      viewBySubjects.hidden = false;
      currentViewMode = 'subjects';
    });
  }

  // ---------------------------------------------------------------------------
  // DESCARGA DEL ARCHIVO .PILAS
  // ---------------------------------------------------------------------------
  if (btnDownloadPilas) {
    btnDownloadPilas.addEventListener('click', () => {
      if (!currentSchedule) {
        showError('Sin datos', 'Carga un horario antes de descargar.');
        return;
      }
      downloadPilasFile(currentSchedule, 'horario_espe.pilas');
    });
  }

  // ---------------------------------------------------------------------------
  // GENERACIÓN DE CÓDIGO QR (P2P esp://friend?d=...)
  // ---------------------------------------------------------------------------
  let currentQrUri = '';

  async function renderQrCode() {
    if (!currentSchedule || !qrCanvas) return;

    try {
      const qrPayload = generateQrPayload(currentSchedule);
      const uri = generateFriendQrProtocol(qrPayload);
      currentQrUri = uri;

      const btnOpenProtocol = document.getElementById('btn-open-protocol') as HTMLAnchorElement;
      if (btnOpenProtocol) {
        btnOpenProtocol.href = uri;
      }

      await QRCode.toCanvas(qrCanvas, uri, {
        width: 220,
        margin: 2,
        color: {
          dark: '#101319',
          light: '#ffffff',
        },
        errorCorrectionLevel: 'M',
      });
    } catch (err) {
      console.error('Error al generar código QR:', err);
    }
  }

  if (btnCopyProtocol && btnCopyProtocolText) {
    btnCopyProtocol.addEventListener('click', async () => {
      if (!currentQrUri) return;
      try {
        await navigator.clipboard.writeText(currentQrUri);
        const originalText = btnCopyProtocolText.textContent;
        btnCopyProtocolText.textContent = '¡Copiado!';
        setTimeout(() => {
          btnCopyProtocolText.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Error al copiar al portapapeles:', err);
      }
    });
  }

  if (btnDownloadQr && qrCanvas) {
    btnDownloadQr.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = 'horario_pilas_qr.png';
      link.href = qrCanvas.toDataURL('image/png');
      link.click();
    });
  }

  // ---------------------------------------------------------------------------
  // PREVISUALIZACIÓN DE JSON
  // ---------------------------------------------------------------------------
  function updateJsonPreview() {
    if (!currentSchedule || !jsonPreviewCode) return;
    jsonPreviewCode.textContent = JSON.stringify(currentSchedule, null, 2);
  }

  if (btnToggleJson && jsonPreviewBox && jsonChevron) {
    btnToggleJson.addEventListener('click', () => {
      const isHidden = jsonPreviewBox.hidden;
      jsonPreviewBox.hidden = !isHidden;
      btnToggleJson.setAttribute('aria-expanded', String(isHidden));
      jsonChevron.textContent = isHidden ? '▲' : '▼';
    });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>


  // ---------------------------------------------------------------------------
  // MANEJADORES DE DROPZONE & ARCHIVOS
  // ---------------------------------------------------------------------------
  if (btnBrowse && fileInput) {
    btnBrowse.addEventListener('click', () => {
      fileInput.click();
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', async (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) {
        await handleFile(files[0]);
      }
      fileInput.value = '';
    });
  }

  if (dropzone) {
    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('is-dragover');
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('is-dragover');
      });
    });

    dropzone.addEventListener('drop', async (e) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files[0]) {
        await handleFile(dt.files[0]);
      }
    });
  }

  async function handleFile(file: File) {
    if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
      showError('Formato no compatible', 'Por favor selecciona un archivo PDF descargado de Banner 9.');
      return;
    }

    hideError();
    setLoader(true);

    try {
      const extractedText = await extractTextFromPdf(file);
      if (!extractedText || extractedText.trim().length === 0) {
        throw new Error('El PDF no contiene texto legible (posiblemente esté protegido o escaneado como imagen).');
      }

      processTextAndRender(extractedText);
    } catch (err: any) {
      console.error('Error al procesar PDF:', err);
      showError(
        'Error al procesar el PDF',
        err.message || 'No se pudo extraer el texto del archivo. Puedes copiar y pegar el texto manualmente usando la casilla inferior.'
      );
    } finally {
      setLoader(false);
    }
  }

  // Demo Button
  if (btnDemo) {
    btnDemo.addEventListener('click', () => {
      hideError();
      processTextAndRender(DEMO_BANNER_TEXT);
    });
  }

  // Toggle Paste Panel
  if (btnTogglePaste && pastePanel && toggleChevron) {
    btnTogglePaste.addEventListener('click', () => {
      const isHidden = pastePanel.hidden;
      pastePanel.hidden = !isHidden;
      btnTogglePaste.setAttribute('aria-expanded', String(isHidden));
      toggleChevron.textContent = isHidden ? '▲' : '▼';
    });
  }

  // Parse Text Button
  if (btnParseText && rawTextInput) {
    btnParseText.addEventListener('click', () => {
      const text = rawTextInput.value.trim();
      if (!text) {
        showError('Texto vacío', 'Pega el texto del horario copiado desde Banner 9 en el cuadro de texto.');
        return;
      }
      hideError();
      processTextAndRender(text);
    });
  }

  if (btnClearText && rawTextInput) {
    btnClearText.addEventListener('click', () => {
      rawTextInput.value = '';
    });
  }

  if (btnCloseAlert && errorAlert) {
    btnCloseAlert.addEventListener('click', () => {
      hideError();
    });
  }

  function showError(title: string, desc: string) {
    if (errorTitle) errorTitle.textContent = title;
    if (errorDesc) errorDesc.textContent = desc;
    if (errorAlert) errorAlert.hidden = false;
  }

  function hideError() {
    if (errorAlert) errorAlert.hidden = true;
  }

  function setLoader(isLoading: boolean) {
    if (dropzoneLoader) {
      dropzoneLoader.hidden = !isLoading;
      if (isLoading) {
        dropzoneLoader.classList.add('is-loading');
      } else {
        dropzoneLoader.classList.remove('is-loading');
      }
    }
  }

  // ---------------------------------------------------------------------------
  // PARSEO Y ACTUALIZACIÓN DE INTERFAZ
  // ---------------------------------------------------------------------------
  function processTextAndRender(rawText: string) {
    try {
      const schedule = parseBannerSchedule(rawText);

      if (!schedule.materias || schedule.materias.length === 0) {
        showError(
          'No se encontraron materias en el archivo',
          'El documento no contiene el formato típico de impresión de Banner 9 ESPE. Revisa que incluya código de materia (ej. EMEC A0202) y NRC de 5 dígitos.'
        );
        return;
      }

      currentSchedule = schedule;

      // Actualizar campos
      if (inputEstudiante) inputEstudiante.value = schedule.estudiante;
      if (inputPeriodo) inputPeriodo.value = schedule.periodo;

      updateStatsAndViews();

      // Mostrar previsualización
      if (schedulePreview) {
        schedulePreview.hidden = false;
        schedulePreview.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Generar código QR y preview JSON
      renderQrCode();
      updateJsonPreview();
    } catch (err: any) {
      console.error('Error durante el parseo:', err);
      showError('Error de análisis', err.message || 'Ocurrió un error inesperado al analizar el horario.');
    }
  }

  // Sincronizar cambios manuales de estudiante o periodo
  if (inputEstudiante) {
    inputEstudiante.addEventListener('input', () => {
      if (currentSchedule) {
        currentSchedule.estudiante = inputEstudiante.value.trim() || 'Estudiante ESPE';
        renderQrCode();
        updateJsonPreview();
      }
    });
  }

  if (inputPeriodo) {
    inputPeriodo.addEventListener('input', () => {
      if (currentSchedule) {
        currentSchedule.periodo = inputPeriodo.value.trim() || '202651';
        if (badgePeriodo) badgePeriodo.textContent = `PERIODO: ${currentSchedule.periodo}`;
        updateJsonPreview();
      }
    });
  }

  if (btnReset) {
    btnReset.addEventListener('click', () => {
      currentSchedule = null;
      if (schedulePreview) schedulePreview.hidden = true;
      if (dropzone) dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }

  // ===========================================================================
  // PALETAS DE COLOR DINÁMICAS POR MATERIA (ESTUDIANTE PRO NEO-BRUTALISM)
  // ===========================================================================
  interface SubjectPalette {
    id: string;
    border: string;
    bg: string;
    accent: string;
    tagBg: string;
    tagColor: string;
    glow: string;
  }

  const SUBJECT_PALETTES: SubjectPalette[] = [
    {
      id: 'fuchsia',
      border: '#ff3fa4',
      bg: 'rgba(255, 63, 164, 0.12)',
      accent: '#ff3fa4',
      tagBg: '#ff3fa4',
      tagColor: '#000000',
      glow: 'rgba(255, 63, 164, 0.35)',
    },
    {
      id: 'cyan',
      border: '#00f0ff',
      bg: 'rgba(0, 240, 255, 0.12)',
      accent: '#00f0ff',
      tagBg: '#00f0ff',
      tagColor: '#000000',
      glow: 'rgba(0, 240, 255, 0.35)',
    },
    {
      id: 'emerald',
      border: '#00ff87',
      bg: 'rgba(0, 255, 135, 0.12)',
      accent: '#00ff87',
      tagBg: '#00ff87',
      tagColor: '#00210c',
      glow: 'rgba(0, 255, 135, 0.35)',
    },
    {
      id: 'amber',
      border: '#ffb703',
      bg: 'rgba(255, 183, 3, 0.12)',
      accent: '#ffb703',
      tagBg: '#ffb703',
      tagColor: '#2b1700',
      glow: 'rgba(255, 183, 3, 0.35)',
    },
    {
      id: 'violet',
      border: '#c084fc',
      bg: 'rgba(192, 132, 252, 0.12)',
      accent: '#c084fc',
      tagBg: '#c084fc',
      tagColor: '#210036',
      glow: 'rgba(192, 132, 252, 0.35)',
    },
    {
      id: 'rose',
      border: '#fb7185',
      bg: 'rgba(251, 113, 133, 0.12)',
      accent: '#fb7185',
      tagBg: '#fb7185',
      tagColor: '#38000d',
      glow: 'rgba(251, 113, 133, 0.35)',
    },
    {
      id: 'teal',
      border: '#2dd4bf',
      bg: 'rgba(45, 212, 191, 0.12)',
      accent: '#2dd4bf',
      tagBg: '#2dd4bf',
      tagColor: '#002620',
      glow: 'rgba(45, 212, 191, 0.35)',
    },
    {
      id: 'indigo',
      border: '#818cf8',
      bg: 'rgba(129, 140, 248, 0.12)',
      accent: '#818cf8',
      tagBg: '#818cf8',
      tagColor: '#0c003b',
      glow: 'rgba(129, 140, 248, 0.35)',
    },
  ];

  const coursePaletteMap = new Map<string, SubjectPalette>();

  function setupCoursePalettes() {
    coursePaletteMap.clear();
    if (!currentSchedule) return;
    currentSchedule.materias.forEach((m, idx) => {
      const p = SUBJECT_PALETTES[idx % SUBJECT_PALETTES.length];
      const key = (m.nrc || m.materia).trim();
      coursePaletteMap.set(key, p);
    });
  }

  function getSubjectPalette(materia: string, nrc?: string): SubjectPalette {
    if (nrc && coursePaletteMap.has(nrc.trim())) {
      return coursePaletteMap.get(nrc.trim())!;
    }
    if (coursePaletteMap.has(materia.trim())) {
      return coursePaletteMap.get(materia.trim())!;
    }
    // Fallback hash
    const str = nrc || materia;
    let sum = 0;
    for (let i = 0; i < str.length; i++) sum += str.charCodeAt(i);
    return SUBJECT_PALETTES[sum % SUBJECT_PALETTES.length];
  }

  // ===========================================================================
  // UTILIDADES DE HORAS Y AULAS
  // ===========================================================================
  interface FlattenedClass {
    dia: ClaseItem['dia'];
    inicio: string;
    fin: string;
    aula: string;
    materia: string;
    codigo: string;
    nrc: string;
    docente: string;
  }

  const DAY_ORDER: Record<string, number> = {
    LUN: 1, MAR: 2, MIE: 3, JUE: 4, VIE: 5, SAB: 6, DOM: 7,
  };

  const DAY_FULL_NAMES: Record<string, string> = {
    LUN: 'Lunes',
    MAR: 'Martes',
    MIE: 'Miércoles',
    JUE: 'Jueves',
    VIE: 'Viernes',
    SAB: 'Sábado',
    DOM: 'Domingo',
  };

  const WEEK_DAYS: Array<{ code: ClaseItem['dia']; label: string; full: string }> = [
    { code: 'LUN', label: 'LUN', full: 'Lunes' },
    { code: 'MAR', label: 'MAR', full: 'Martes' },
    { code: 'MIE', label: 'MIÉ', full: 'Miércoles' },
    { code: 'JUE', label: 'JUE', full: 'Jueves' },
    { code: 'VIE', label: 'VIE', full: 'Viernes' },
    { code: 'SAB', label: 'SÁB', full: 'Sábado' },
  ];

  function parseTimeToMinutes(t: string): number {
    if (!t) return 0;
    const parts = t.trim().split(':');
    const h = parseInt(parts[0], 10) || 0;
    const m = parseInt(parts[1], 10) || 0;
    return h * 60 + m;
  }

  function formatMinutesDuration(totalMinutes: number): string {
    const h = Math.floor(totalMinutes / 60);
    const m = totalMinutes % 60;
    if (h > 0 && m > 0) return `${h}h ${m}m`;
    if (h > 0) return `${h}h`;
    return `${m}m`;
  }

  function cleanAulaInfo(raw: string): { display: string; short: string; isWarning: boolean; isVirtual: boolean } {
    const trimmed = (raw || '').trim();
    const upper = trimmed.toUpperCase();
    if (!trimmed || upper.includes('POR ASIGNAR') || upper.includes('POR CONFIRMAR') || upper.includes('SIN AULA')) {
      return { display: 'Aula: Por Asignar', short: 'Por Asignar', isWarning: true, isVirtual: false };
    }
    if (upper.includes('VIRTUAL') || upper.includes('LINEA') || upper.includes('TEAMS') || upper.includes('ZOOM')) {
      return { display: 'Aula Virtual · En línea', short: 'Virtual', isWarning: false, isVirtual: true };
    }
    const parts = trimmed.split(',').map(p => p.trim()).filter(Boolean);
    if (parts.length >= 2) {
      const bldg = parts[parts.length - 2].replace(/ESPE|MATRIZ|CAMPUS|SANGOLQUI/gi, '').trim();
      const room = parts[parts.length - 1];
      const display = bldg ? `${bldg} · ${room}` : room;
      return { display, short: room, isWarning: false, isVirtual: false };
    }
    return { display: trimmed, short: trimmed, isWarning: false, isVirtual: false };
  }

  function getAllFlattenedClasses(): FlattenedClass[] {
    if (!currentSchedule) return [];
    const list: FlattenedClass[] = [];
    for (const m of currentSchedule.materias) {
      for (const c of m.clases) {
        list.push({
          dia: c.dia,
          inicio: c.inicio,
          fin: c.fin,
          aula: c.aula,
          materia: m.materia,
          codigo: m.codigo,
          nrc: m.nrc,
          docente: m.docente,
        });
      }
    }
    return list;
  }

  function updateStatsAndViews() {
    if (!currentSchedule) return;

    setupCoursePalettes();

    const totalMaterias = currentSchedule.materias.length;
    let totalClases = 0;
    let totalMinutes = 0;

    for (const m of currentSchedule.materias) {
      totalClases += m.clases.length;
      for (const c of m.clases) {
        const diff = parseTimeToMinutes(c.fin) - parseTimeToMinutes(c.inicio);
        if (diff > 0) totalMinutes += diff;
      }
    }

    const totalHoursStr = formatMinutesDuration(totalMinutes);

    if (badgeTotalMaterias) {
      badgeTotalMaterias.textContent = `${totalMaterias} ${totalMaterias === 1 ? 'MATERIA DETECTADA' : 'MATERIAS DETECTADAS'}`;
    }
    if (badgeTotalClases) {
      badgeTotalClases.textContent = `${totalClases} ${totalClases === 1 ? 'BLOQUE' : 'BLOQUES'} (${totalHoursStr})`;
    }
    if (badgePeriodo) {
      badgePeriodo.textContent = `PERIODO: ${currentSchedule.periodo}`;
    }

    renderCurrentView();
  }

  function renderCurrentView() {
    renderWeeklyBoard();
    renderMatrixView();
    renderAgendaView();
    renderSubjectsView();
  }

  // ===========================================================================
  // 1. HORARIO SEMANAL: TABLERO MULTI-COLUMNA DE DÍAS (LUNES A SÁBADO)
  // ===========================================================================
  function renderWeeklyBoard() {
    if (!currentSchedule || !weeklyBoardContainer) return;

    const allClasses = getAllFlattenedClasses();
    const daysToShow = currentDayFilter === 'ALL'
      ? WEEK_DAYS
      : WEEK_DAYS.filter(d => d.code === currentDayFilter);

    if (daysToShow.length === 0) {
      weeklyBoardContainer.innerHTML = `
        <div class="empty-state-card">
          <span class="empty-icon">☕</span>
          <h3>Sin clases registradas</h3>
          <p>No se encontraron bloques para el filtro seleccionado.</p>
        </div>
      `;
      return;
    }

    let boardHtml = '';

    for (const day of daysToShow) {
      const dayClasses = allClasses
        .filter(c => c.dia === day.code)
        .sort((a, b) => a.inicio.localeCompare(b.inicio));

      let totalDayMinutes = 0;
      dayClasses.forEach(c => {
        const diff = parseTimeToMinutes(c.fin) - parseTimeToMinutes(c.inicio);
        if (diff > 0) totalDayMinutes += diff;
      });

      const hasClasses = dayClasses.length > 0;
      const countLabel = hasClasses
        ? `${dayClasses.length} ${dayClasses.length === 1 ? 'clase' : 'clases'} · ${formatMinutesDuration(totalDayMinutes)}`
        : 'Libre 🌴';

      boardHtml += `
        <div class="day-column ${hasClasses ? 'has-classes' : 'is-free-day'}" data-day="${day.code}">
          <div class="day-column-header">
            <div class="day-title-wrap">
              <span class="day-dot ${hasClasses ? 'active' : ''}"></span>
              <span class="day-name">${day.full}</span>
            </div>
            <span class="day-stats-pill ${hasClasses ? 'active' : 'free'}">${countLabel}</span>
          </div>

          <div class="day-column-body">
      `;

      if (!hasClasses) {
        boardHtml += `
          <div class="day-empty-state">
            <span class="day-empty-icon" aria-hidden="true">🌴</span>
            <div class="day-empty-title">Día sin clases</div>
            <div class="day-empty-desc">Aprovecha para repasar, proyectos o descansar</div>
          </div>
        `;
      } else {
        for (let i = 0; i < dayClasses.length; i++) {
          const item = dayClasses[i];
          const palette = getSubjectPalette(item.materia, item.nrc);
          const duration = getDurationBetween(item.inicio, item.fin);
          const aula = cleanAulaInfo(item.aula);

          // Verificar si hay hueco libre antes de esta clase
          if (i > 0) {
            const prev = dayClasses[i - 1];
            const gap = parseTimeToMinutes(item.inicio) - parseTimeToMinutes(prev.fin);
            if (gap >= 30) {
              boardHtml += `
                <div class="schedule-gap-pill" title="Hueco libre de ${formatMinutesDuration(gap)}">
                  <span class="gap-icon">⏳</span>
                  <span class="gap-text"><strong>${formatMinutesDuration(gap)} libres</strong> (${prev.fin} - ${item.inicio})</span>
                </div>
              `;
            }
          }

          boardHtml += `
            <article class="schedule-class-card" 
                     style="--card-accent: ${palette.accent}; --card-border: ${palette.border}; --card-bg: ${palette.bg}; --card-glow: ${palette.glow};"
                     data-card-click="true"
                     data-materia="${escapeHtml(item.materia)}"
                     data-nrc="${escapeHtml(item.nrc)}"
                     data-codigo="${escapeHtml(item.codigo)}"
                     data-dia="${day.full}"
                     data-horas="${item.inicio} - ${item.fin}"
                     data-duracion="${duration}"
                     data-aula="${escapeHtml(aula.display)}"
                     data-docente="${escapeHtml(item.docente)}"
                     tabindex="0"
                     role="button"
                     aria-label="${escapeHtml(item.materia)}, de ${item.inicio} a ${item.fin}">
              <div class="card-top-bar">
                <span class="card-time-badge">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  ${item.inicio} - ${item.fin}
                </span>
                <span class="card-duration-badge" style="background: ${palette.tagBg}; color: ${palette.tagColor};">${duration}</span>
              </div>

              <h4 class="card-subject-title">${escapeHtml(item.materia)}</h4>

              <div class="card-meta-row">
                <span class="meta-code-pill">${escapeHtml(item.codigo)}</span>
                <span class="meta-nrc-pill">NRC ${escapeHtml(item.nrc)}</span>
              </div>

              <div class="card-info-list">
                <div class="card-info-item ${aula.isWarning ? 'room-warning' : (aula.isVirtual ? 'room-virtual' : '')}">
                  <span class="icon" aria-hidden="true">${aula.isWarning ? '⚠️' : (aula.isVirtual ? '💻' : '📍')}</span>
                  <span class="text"><strong>Aula:</strong> ${escapeHtml(aula.display)}</span>
                </div>
                <div class="card-info-item">
                  <span class="icon" aria-hidden="true">👨‍🏫</span>
                  <span class="text"><strong>Docente:</strong> ${escapeHtml(item.docente)}</span>
                </div>
              </div>
            </article>
          `;
        }
      }

      boardHtml += `
          </div>
        </div>
      `;
    }

    weeklyBoardContainer.innerHTML = boardHtml;
    attachCardModalListeners(weeklyBoardContainer);
  }

  // ===========================================================================
  // 2. MATRIZ HORARIA: GRID SEMANAL DE 07:00 A 21:00
  // ===========================================================================
  function renderMatrixView() {
    if (!currentSchedule || !matrixGridContainer) return;

    const allClasses = getAllFlattenedClasses();
    const START_HOUR = 7;
    const END_HOUR = 21;
    const TOTAL_HOURS = END_HOUR - START_HOUR;

    let matrixHtml = '';

    // Esquina superior izquierda
    matrixHtml += `<div class="matrix-cell matrix-corner-cell">HORA</div>`;

    // Cabeceras de días
    WEEK_DAYS.forEach((d, idx) => {
      const isFiltered = currentDayFilter !== 'ALL' && currentDayFilter === d.code;
      matrixHtml += `
        <div class="matrix-cell matrix-header-cell ${isFiltered ? 'is-highlighted' : ''}" style="grid-column: ${idx + 2}; grid-row: 1;">
          <span class="matrix-header-abbr">${d.label}</span>
          <span class="matrix-header-name">${d.full}</span>
        </div>
      `;
    });

    // Celdas de horas (Eje Y) y líneas de cuadrícula
    for (let h = START_HOUR; h < END_HOUR; h++) {
      const rowIdx = (h - START_HOUR) + 2;
      const timeStr = `${h.toString().padStart(2, '0')}:00`;

      matrixHtml += `
        <div class="matrix-cell matrix-time-cell" style="grid-column: 1; grid-row: ${rowIdx};">
          <span>${timeStr}</span>
        </div>
      `;

      // Celdas vacías de fondo
      for (let d = 0; d < 6; d++) {
        matrixHtml += `
          <div class="matrix-cell matrix-slot-bg" style="grid-column: ${d + 2}; grid-row: ${rowIdx};"></div>
        `;
      }
    }

    // Bloques de clase posicionados en la cuadrícula
    for (const item of allClasses) {
      const dayIdx = WEEK_DAYS.findIndex(d => d.code === item.dia);
      if (dayIdx === -1) continue;

      const col = dayIdx + 2;
      const startMin = parseTimeToMinutes(item.inicio);
      const endMin = parseTimeToMinutes(item.fin);

      const startHourFloat = startMin / 60;
      const endHourFloat = endMin / 60;

      // Calcular fila de inicio y span de filas
      const clampedStartHour = Math.max(START_HOUR, Math.min(END_HOUR - 1, Math.floor(startHourFloat)));
      const rowStart = (clampedStartHour - START_HOUR) + 2;
      const span = Math.max(1, Math.round(endHourFloat - startHourFloat));

      const palette = getSubjectPalette(item.materia, item.nrc);
      const aula = cleanAulaInfo(item.aula);
      const duration = getDurationBetween(item.inicio, item.fin);

      matrixHtml += `
        <div class="matrix-class-block" 
             style="grid-column: ${col}; grid-row: ${rowStart} / span ${span}; --card-accent: ${palette.accent}; --card-border: ${palette.border}; --card-bg: ${palette.bg}; --card-glow: ${palette.glow};"
             data-card-click="true"
             data-materia="${escapeHtml(item.materia)}"
             data-nrc="${escapeHtml(item.nrc)}"
             data-codigo="${escapeHtml(item.codigo)}"
             data-dia="${DAY_FULL_NAMES[item.dia] || item.dia}"
             data-horas="${item.inicio} - ${item.fin}"
             data-duracion="${duration}"
             data-aula="${escapeHtml(aula.display)}"
             data-docente="${escapeHtml(item.docente)}"
             tabindex="0"
             role="button"
             title="${escapeHtml(item.materia)} (${item.inicio} - ${item.fin})">
          <div class="matrix-block-header">
            <span class="matrix-block-time">${item.inicio} - ${item.fin}</span>
            <span class="matrix-block-nrc" style="background: ${palette.tagBg}; color: ${palette.tagColor};">${escapeHtml(item.nrc)}</span>
          </div>
          <div class="matrix-block-title">${escapeHtml(item.materia)}</div>
          <div class="matrix-block-footer">
            <span class="matrix-block-room ${aula.isWarning ? 'warn' : ''}">
              ${aula.isWarning ? '⚠️' : (aula.isVirtual ? '💻' : '📍')} ${escapeHtml(aula.short)}
            </span>
          </div>
        </div>
      `;
    }

    matrixGridContainer.innerHTML = matrixHtml;
    attachCardModalListeners(matrixGridContainer);
  }

  // ===========================================================================
  // 3. AGENDA DIARIA: TIMELINE CRONOLÓGICO
  // ===========================================================================
  function renderAgendaView() {
    if (!currentSchedule || !agendaTimelineContainer) return;

    const allClasses = getAllFlattenedClasses();
    const daysToShow = currentDayFilter === 'ALL'
      ? WEEK_DAYS
      : WEEK_DAYS.filter(d => d.code === currentDayFilter);

    let html = '';

    for (const day of daysToShow) {
      const dayClasses = allClasses
        .filter(c => c.dia === day.code)
        .sort((a, b) => a.inicio.localeCompare(b.inicio));

      if (dayClasses.length === 0 && currentDayFilter !== 'ALL') {
        html += `
          <div class="empty-state-card">
            <span class="empty-icon">☕</span>
            <h3>Sin clases programadas para el ${day.full}</h3>
            <p>No tienes asignaturas registradas este día.</p>
          </div>
        `;
        continue;
      }

      if (dayClasses.length === 0) continue;

      let totalDayMinutes = 0;
      dayClasses.forEach(c => {
        const diff = parseTimeToMinutes(c.fin) - parseTimeToMinutes(c.inicio);
        if (diff > 0) totalDayMinutes += diff;
      });

      html += `
        <div class="agenda-day-section">
          <div class="agenda-day-header">
            <div class="agenda-day-title">
              <span class="agenda-accent-bar"></span>
              <h3>${day.full}</h3>
            </div>
            <span class="agenda-day-badge">${dayClasses.length} ${dayClasses.length === 1 ? 'bloque' : 'bloques'} · ${formatMinutesDuration(totalDayMinutes)}</span>
          </div>

          <div class="agenda-timeline-rail">
      `;

      for (let i = 0; i < dayClasses.length; i++) {
        const item = dayClasses[i];
        const palette = getSubjectPalette(item.materia, item.nrc);
        const aula = cleanAulaInfo(item.aula);
        const duration = getDurationBetween(item.inicio, item.fin);

        // Hueco libre
        if (i > 0) {
          const prev = dayClasses[i - 1];
          const gap = parseTimeToMinutes(item.inicio) - parseTimeToMinutes(prev.fin);
          if (gap >= 30) {
            html += `
              <div class="agenda-gap-node">
                <div class="agenda-node-icon">⏳</div>
                <div class="agenda-gap-card">
                  <strong>${formatMinutesDuration(gap)} de tiempo libre</strong> entre ${prev.fin} y ${item.inicio}
                </div>
              </div>
            `;
          }
        }

        html += `
          <div class="agenda-item-node" 
               style="--card-accent: ${palette.accent}; --card-border: ${palette.border}; --card-bg: ${palette.bg}; --card-glow: ${palette.glow};"
               data-card-click="true"
               data-materia="${escapeHtml(item.materia)}"
               data-nrc="${escapeHtml(item.nrc)}"
               data-codigo="${escapeHtml(item.codigo)}"
               data-dia="${day.full}"
               data-horas="${item.inicio} - ${item.fin}"
               data-duracion="${duration}"
               data-aula="${escapeHtml(aula.display)}"
               data-docente="${escapeHtml(item.docente)}">
            <div class="agenda-time-column">
              <span class="agenda-time-start">${item.inicio}</span>
              <span class="agenda-time-divider"></span>
              <span class="agenda-time-end">${item.fin}</span>
              <span class="agenda-time-dur">${duration}</span>
            </div>

            <div class="agenda-card-bubble">
              <div class="agenda-card-top">
                <span class="meta-nrc-pill" style="background: ${palette.tagBg}; color: ${palette.tagColor};">NRC ${escapeHtml(item.nrc)}</span>
                <span class="meta-code-pill">${escapeHtml(item.codigo)}</span>
              </div>
              <h4 class="agenda-card-title">${escapeHtml(item.materia)}</h4>
              <div class="agenda-card-details">
                <div class="agenda-detail-row ${aula.isWarning ? 'room-warning' : (aula.isVirtual ? 'room-virtual' : '')}">
                  <span class="icon">${aula.isWarning ? '⚠️' : (aula.isVirtual ? '💻' : '📍')}</span>
                  <span><strong>Aula:</strong> ${escapeHtml(aula.display)}</span>
                </div>
                <div class="agenda-detail-row">
                  <span class="icon">👨‍🏫</span>
                  <span><strong>Docente:</strong> ${escapeHtml(item.docente)}</span>
                </div>
              </div>
            </div>
          </div>
        `;
      }

      html += `
          </div>
        </div>
      `;
    }

    if (!html.trim()) {
      html = `
        <div class="empty-state-card">
          <span class="empty-icon">☕</span>
          <h3>Semana sin asignaturas</h3>
          <p>No se encontraron bloques de clase cargados.</p>
        </div>
      `;
    }

    agendaTimelineContainer.innerHTML = html;
    attachCardModalListeners(agendaTimelineContainer);
  }

  // ===========================================================================
  // 4. VISTA POR MATERIAS
  // ===========================================================================
  function renderSubjectsView() {
    if (!currentSchedule || !subjectsGrid) return;

    let html = '';
    for (const m of currentSchedule.materias) {
      const palette = getSubjectPalette(m.materia, m.nrc);
      let totalCourseMinutes = 0;
      m.clases.forEach(c => {
        const diff = parseTimeToMinutes(c.fin) - parseTimeToMinutes(c.inicio);
        if (diff > 0) totalCourseMinutes += diff;
      });

      html += `
        <article class="subject-card" style="--card-border: ${palette.border}; --card-glow: ${palette.glow};">
          <div class="subject-header">
            <div class="subject-tags">
              <span class="badge-app fuchsia">${escapeHtml(m.codigo)}</span>
              <span class="badge-app amber">NRC ${escapeHtml(m.nrc)}</span>
              <span class="badge-app cyan">${m.clases.length} ${m.clases.length === 1 ? 'sesión' : 'sesiones'} (${formatMinutesDuration(totalCourseMinutes)})</span>
            </div>
            <h3 class="subject-title">${escapeHtml(m.materia)}</h3>
            <p class="subject-docente">
              <span class="icon-inline" aria-hidden="true">👨‍🏫</span>
              <strong>Docente:</strong> ${escapeHtml(m.docente)}
            </p>
          </div>

          <div class="subject-sessions-list">
            <h4 class="sessions-heading">Horarios semanales asignados:</h4>
            ${m.clases.length === 0 ? '<p class="no-sessions">Sin sesiones detectadas.</p>' : ''}
            <div class="sessions-chips">
              ${m.clases.map(c => {
                const aula = cleanAulaInfo(c.aula);
                return `
                  <div class="session-chip" style="border-left: 3px solid ${palette.accent};">
                    <span class="chip-day">${DAY_FULL_NAMES[c.dia] || c.dia}</span>
                    <span class="chip-time">${c.inicio} - ${c.fin}</span>
                    <span class="chip-aula ${aula.isWarning ? 'warn' : ''}">
                      ${aula.isWarning ? '⚠️' : (aula.isVirtual ? '💻' : '📍')} ${escapeHtml(aula.short)}
                    </span>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        </article>
      `;
    }

    subjectsGrid.innerHTML = html;
  }

  // ===========================================================================
  // MODAL INTERACTIVO DE DETALLE DE CLASE
  // ===========================================================================
  function attachCardModalListeners(parent: HTMLElement) {
    const clickableCards = parent.querySelectorAll<HTMLElement>('[data-card-click="true"]');
    clickableCards.forEach(card => {
      card.addEventListener('click', () => {
        openClassDetailModal(card);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openClassDetailModal(card);
        }
      });
    });
  }

  function openClassDetailModal(card: HTMLElement) {
    if (!classDetailModal || !classModalContent) return;

    const materia = card.getAttribute('data-materia') || '';
    const nrc = card.getAttribute('data-nrc') || '';
    const codigo = card.getAttribute('data-codigo') || '';
    const dia = card.getAttribute('data-dia') || '';
    const horas = card.getAttribute('data-horas') || '';
    const duracion = card.getAttribute('data-duracion') || '';
    const aula = card.getAttribute('data-aula') || '';
    const docente = card.getAttribute('data-docente') || '';
    const palette = getSubjectPalette(materia, nrc);

    classModalContent.innerHTML = `
      <div class="modal-card-inner" style="--modal-accent: ${palette.accent}; --modal-glow: ${palette.glow};">
        <div class="modal-header">
          <div class="modal-badges">
            <span class="badge-app fuchsia">${escapeHtml(codigo)}</span>
            <span class="badge-app amber">NRC ${escapeHtml(nrc)}</span>
            <span class="badge-app cyan">${escapeHtml(dia)}</span>
          </div>
          <button type="button" class="btn-modal-close" id="btn-close-modal" aria-label="Cerrar ventana">✕</button>
        </div>

        <h3 class="modal-title">${escapeHtml(materia)}</h3>

        <div class="modal-details-grid">
          <div class="modal-detail-item">
            <span class="modal-detail-icon">🕒</span>
            <div>
              <div class="modal-detail-label">Horario de clase:</div>
              <div class="modal-detail-val"><strong>${escapeHtml(horas)}</strong> (${escapeHtml(duracion)})</div>
            </div>
          </div>

          <div class="modal-detail-item">
            <span class="modal-detail-icon">📍</span>
            <div>
              <div class="modal-detail-label">Ubicación / Aula:</div>
              <div class="modal-detail-val">${escapeHtml(aula)}</div>
            </div>
          </div>

          <div class="modal-detail-item">
            <span class="modal-detail-icon">👨‍🏫</span>
            <div>
              <div class="modal-detail-label">Docente Asignado:</div>
              <div class="modal-detail-val">${escapeHtml(docente)}</div>
            </div>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-brutalist btn-secondary btn-copy-nrc" id="btn-modal-copy-nrc">
            📋 Copiar NRC (${escapeHtml(nrc)})
          </button>
          <button type="button" class="btn-brutalist btn-primary btn-modal-done" id="btn-modal-done">
            Entendido
          </button>
        </div>
      </div>
    `;

    try {
      classDetailModal.showModal();
    } catch (_) {
      classDetailModal.setAttribute('open', 'true');
    }

    const btnClose = document.getElementById('btn-close-modal');
    const btnDone = document.getElementById('btn-modal-done');
    const btnCopyNrc = document.getElementById('btn-modal-copy-nrc');

    const closeModal = () => {
      try {
        classDetailModal.close();
      } catch (_) {
        classDetailModal.removeAttribute('open');
      }
    };

    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (btnDone) btnDone.addEventListener('click', closeModal);
    if (btnCopyNrc) {
      btnCopyNrc.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(nrc);
          btnCopyNrc.textContent = '¡NRC Copiado!';
          setTimeout(() => {
            btnCopyNrc.textContent = `📋 Copiar NRC (${nrc})`;
          }, 2000);
        } catch (_) {}
      });
    }

    classDetailModal.addEventListener('click', (e) => {
      if (e.target === classDetailModal) closeModal();
    }, { once: true });
  }

  // ===========================================================================
  // TABS & FILTROS DE DÍA
  // ===========================================================================
  function switchViewTab(mode: 'weekly' | 'matrix' | 'agenda' | 'subjects') {
    currentViewMode = mode;

    [tabWeeklyBoard, tabMatrixView, tabAgendaView, tabSubjectView].forEach(btn => {
      if (btn) {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-selected', 'false');
      }
    });

    if (viewWeeklyBoard) viewWeeklyBoard.hidden = mode !== 'weekly';
    if (viewMatrix) viewMatrix.hidden = mode !== 'matrix';
    if (viewAgenda) viewAgenda.hidden = mode !== 'agenda';
    if (viewBySubjects) viewBySubjects.hidden = mode !== 'subjects';

    if (mode === 'weekly' && tabWeeklyBoard) {
      tabWeeklyBoard.classList.add('is-active');
      tabWeeklyBoard.setAttribute('aria-selected', 'true');
      renderWeeklyBoard();
    } else if (mode === 'matrix' && tabMatrixView) {
      tabMatrixView.classList.add('is-active');
      tabMatrixView.setAttribute('aria-selected', 'true');
      renderMatrixView();
    } else if (mode === 'agenda' && tabAgendaView) {
      tabAgendaView.classList.add('is-active');
      tabAgendaView.setAttribute('aria-selected', 'true');
      renderAgendaView();
    } else if (mode === 'subjects' && tabSubjectView) {
      tabSubjectView.classList.add('is-active');
      tabSubjectView.setAttribute('aria-selected', 'true');
      renderSubjectsView();
    }
  }

  if (tabWeeklyBoard) tabWeeklyBoard.addEventListener('click', () => switchViewTab('weekly'));
  if (tabMatrixView) tabMatrixView.addEventListener('click', () => switchViewTab('matrix'));
  if (tabAgendaView) tabAgendaView.addEventListener('click', () => switchViewTab('agenda'));
  if (tabSubjectView) tabSubjectView.addEventListener('click', () => switchViewTab('subjects'));

  if (btnPrintSchedule) {
    btnPrintSchedule.addEventListener('click', () => {
      window.print();
    });
  }

  dayPills.forEach(pill => {
    pill.addEventListener('click', () => {
      dayPills.forEach(p => p.classList.remove('is-active'));
      pill.classList.add('is-active');
      currentDayFilter = pill.getAttribute('data-day') || 'ALL';
      renderCurrentView();

      // Si el usuario elige un día específico en el tablero semanal, hacer scroll suave hacia él
      if (currentDayFilter !== 'ALL' && weeklyBoardContainer) {
        const targetCol = weeklyBoardContainer.querySelector(`[data-day="${currentDayFilter}"]`);
        if (targetCol) {
          targetCol.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        }
      }
    });
  });

  // ---------------------------------------------------------------------------
  // DESCARGA DEL ARCHIVO .PILAS
  // ---------------------------------------------------------------------------
  if (btnDownloadPilas) {
    btnDownloadPilas.addEventListener('click', () => {
      if (!currentSchedule) {
        showError('Sin datos', 'Carga un horario antes de descargar.');
        return;
      }
      downloadPilasFile(currentSchedule, 'horario_espe.pilas');
    });
  }

  // ---------------------------------------------------------------------------
  // GENERACIÓN DE CÓDIGO QR (P2P esp://friend?d=...)
  // ---------------------------------------------------------------------------
  let currentQrUri = '';

  async function renderQrCode() {
    if (!currentSchedule || !qrCanvas) return;

    try {
      const qrPayload = generateQrPayload(currentSchedule);
      const uri = generateFriendQrProtocol(qrPayload);
      currentQrUri = uri;

      const btnOpenProtocol = document.getElementById('btn-open-protocol') as HTMLAnchorElement;
      if (btnOpenProtocol) {
        btnOpenProtocol.href = uri;
      }

      await QRCode.toCanvas(qrCanvas, uri, {
        width: 220,
        margin: 2,
        color: {
          dark: '#101319',
          light: '#ffffff',
        },
        errorCorrectionLevel: 'M',
      });
    } catch (err) {
      console.error('Error al generar código QR:', err);
    }
  }

  if (btnCopyProtocol && btnCopyProtocolText) {
    btnCopyProtocol.addEventListener('click', async () => {
      if (!currentQrUri) return;
      try {
        await navigator.clipboard.writeText(currentQrUri);
        const originalText = btnCopyProtocolText.textContent;
        btnCopyProtocolText.textContent = '¡Copiado!';
        setTimeout(() => {
          btnCopyProtocolText.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Error al copiar al portapapeles:', err);
      }
    });
  }

  if (btnDownloadQr && qrCanvas) {
    btnDownloadQr.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = 'horario_pilas_qr.png';
      link.href = qrCanvas.toDataURL('image/png');
      link.click();
    });
  }

  // ---------------------------------------------------------------------------
  // PREVISUALIZACIÓN DE JSON
  // ---------------------------------------------------------------------------
  function updateJsonPreview() {
    if (!currentSchedule || !jsonPreviewCode) return;
    jsonPreviewCode.textContent = JSON.stringify(currentSchedule, null, 2);
  }

  if (btnToggleJson && jsonPreviewBox && jsonChevron) {
    btnToggleJson.addEventListener('click', () => {
      const isHidden = jsonPreviewBox.hidden;
      jsonPreviewBox.hidden = !isHidden;
      btnToggleJson.setAttribute('aria-expanded', String(isHidden));
      jsonChevron.textContent = isHidden ? '▲' : '▼';
    });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>


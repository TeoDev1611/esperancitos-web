  }

  /* PÍLDORAS PRIVACIDAD */
  .privacy-badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    max-width: 900px;
  }

  .privacy-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-brutalist-sm);
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-md);
  }

  .privacy-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .privacy-item strong {
    display: block;
    color: var(--color-text-title);
    font-size: 0.95rem;
  }

  .privacy-item p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* GUÍA DE PASOS */
  .banner-steps-guide {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brutalist);
    padding: 1.75rem 2rem;
    margin-bottom: 2.5rem;
  }

  .guide-header {
    margin-bottom: 1.25rem;
  }

  .guide-num-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-warning);
    background: rgba(255, 219, 121, 0.12);
    border: 1px solid var(--color-warning);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .guide-header-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .badge-app.green-subtle {
    background: rgba(0, 255, 135, 0.12);
    color: var(--color-success);
    border: 1px solid var(--color-success);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .guide-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin: 0 0 0.35rem 0;
  }

  .guide-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem 0;
  }

  .steps-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .step-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-base);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    box-shadow: var(--shadow-brutalist-sm);
    transition: transform var(--duration-hover) var(--ease-spring);
  }

  .step-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
  }

  .step-card-featured {
    border-color: rgba(255, 63, 164, 0.4);
    background: linear-gradient(180deg, rgba(255, 63, 164, 0.04) 0%, var(--color-bg-base) 100%);
  }

  .step-card-visual {
    border-color: rgba(56, 189, 248, 0.4);
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.04) 0%, var(--color-bg-base) 100%);
  }

  .step-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--color-primary);
    color: #000;
    font-weight: 800;
    font-family: var(--font-mono);
    border-radius: 8px;
    flex-shrink: 0;
    box-shadow: 2px 2px 0 #000;
  }

  .step-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background: var(--color-bg-elevated);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .step-tag.pulse-tag {
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
  }

  .step-body h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin: 0 0 0.5rem 0;
  }

  .step-body p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-body);
    margin: 0 0 0.75rem 0;
  }

  /* BOTÓN ENLACE DIRECTO BANNER */
  .btn-banner-direct {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--color-primary);
    color: #000;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-md);
    border: 2px solid #000;
    box-shadow: 3px 3px 0 #000;
    text-decoration: none;
    margin-top: 0.75rem;
    margin-bottom: 0.4rem;
    transition: all var(--duration-hover) var(--ease-spring);
    text-align: center;
  }

  .btn-banner-direct:hover {
    background: var(--color-primary-hover);
    color: #fff;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 #000;
  }

  .btn-banner-direct:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #000;
  }

  .direct-link-note {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  /* CAPTURA TUTORIAL DE LA IMPRESORA */
  .tutorial-image-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .image-spotlight-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid var(--accent-cyan);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .spotlight-arrow {
    font-size: 0.9rem;
    animation: bounce-horizontal 1.2s infinite ease-in-out;
  }

  @keyframes bounce-horizontal {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(3px); }
  }

  .tutorial-img-frame {
    background: #000;
    border: 2px solid var(--color-border);
    border-radius: 10px;
    padding: 4px;
    box-shadow: 3px 3px 0 #000;
    display: flex;
    justify-content: center;
    max-width: 100%;
  }

  .tutorial-img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    object-fit: contain;
  }

  .step-tips-list {
    margin: 0 0 0.75rem 1.15rem;
    padding: 0;
    font-size: 0.85rem;
    color: var(--color-text-body);
    line-height: 1.5;
  }

  .step-tips-list li {
    margin-bottom: 0.4rem;
  }

  .step-final-note {
    font-size: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  /* BOTÓN ABRIR APP PWA */
  .btn-open-pwa {
    background: var(--color-primary);
    color: #000;
    border-color: #000;
    font-weight: 800;
  }

  .btn-open-pwa:hover {
    background: var(--color-primary-hover);
    color: #fff;
  }

  /* DROPZONE CARD */
  .converter-box-section {
    margin-bottom: 3rem;
  }

  .dropzone-card {
    position: relative;
    background: var(--color-bg-surface);
    border: 3px dashed var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brutalist);
    padding: 3rem 2rem;
    text-align: center;
    transition: all var(--duration-hover) var(--ease-spring);
    cursor: pointer;
  }

  .dropzone-card:hover {
    border-color: var(--color-primary);
    background: #171c26;
  }

  .dropzone-card.is-dragover {
    border-color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.05);
    box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.2), var(--shadow-brutalist-lg);
    transform: scale(1.01);
  }

  .dropzone-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    color: var(--color-primary);
    border-radius: 20px;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-brutalist-sm);
    transition: transform var(--duration-hover) var(--ease-spring);
  }

  .dropzone-card:hover .dropzone-icon-wrap {
    transform: translateY(-4px);
    color: #fff;
    background: var(--color-primary);
    border-color: #000;
  }

  .dropzone-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin: 0 0 0.5rem 0;
  }

  .dropzone-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0 0 1.75rem 0;
  }

  .dropzone-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .dropzone-hint {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .hint-bullet {
    color: var(--color-success);
    font-weight: bold;
  }

  /* BOTONES BRUTALISTAS */
  .btn-brutalist {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-md);
    border: 2px solid #000;
    box-shadow: var(--shadow-brutalist);
    cursor: pointer;
    transition: all var(--duration-hover) var(--ease-spring);
    text-decoration: none;
  }

  .btn-brutalist:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-brutalist-lg);
  }

  .btn-brutalist:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #000;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #000;
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
    color: #fff;
  }

  .btn-secondary {
    background: var(--color-bg-elevated);
    color: var(--color-text-title);
    border-color: var(--color-border);
  }

  .btn-secondary:hover {
    border-color: #000;
    background: var(--color-bg-container);
  }

  .btn-fuchsia {
    background: var(--color-primary);
    color: #000;
  }

  .btn-fuchsia:hover {
    background: #ff1f8f;
    color: #fff;
  }

  .btn-cyan {
    background: var(--accent-cyan);
    color: #000;
  }

  .btn-cyan:hover {
    background: #0284c7;
    color: #fff;
  }

  .btn-subtle {
    background: transparent;
    color: var(--color-text-muted);
    border-color: var(--color-border);
    box-shadow: none;
  }

  .btn-subtle:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text-title);
  }

  .btn-large {
    font-size: 1.1rem;
    padding: 1.1rem 1.8rem;
    width: 100%;
  }

  /* LOADER (Oculto por defecto; se muestra solo al procesar un archivo) */
  .dropzone-loader {
    position: absolute;
    inset: 0;
    background: rgba(16, 19, 25, 0.95);
    border-radius: var(--radius-lg);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .dropzone-loader.is-loading,
  .dropzone-loader:not([hidden]) {
    display: flex;
  }

  .dropzone-loader[hidden] {
    display: none !important;
  }

  [hidden] {
    display: none !important;
  }

  .spinner-neon {
    width: 48px;
    height: 48px;
    border: 4px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-right-color: var(--accent-cyan);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 1rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loader-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-title);
    margin: 0 0 0.3rem 0;
  }

  .loader-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* TEXTAREA COLLAPSIBLE */
  .text-paste-container {
    margin-top: 1.25rem;
  }

  .btn-toggle-paste {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all var(--duration-hover) var(--ease-spring);
  }

  .btn-toggle-paste:hover {
    color: var(--color-text-title);
    border-color: var(--color-primary);
  }

  .toggle-icon {
    font-size: 0.75rem;
    transition: transform 0.2s;
  }

  .paste-panel {
    margin-top: 0.75rem;
  }

  .paste-panel-inner {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-brutalist-sm);
    padding: 1.25rem;
  }

  .paste-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-title);
    margin-bottom: 0.6rem;
  }

  .paste-textarea {
    width: 100%;
    background: var(--color-bg-base);
    color: var(--color-text-title);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.5;
    resize: vertical;
    margin-bottom: 1rem;
  }

  .paste-textarea:focus {
    outline: none;
    border-color: var(--accent-cyan);
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
  }

  .paste-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* ALERT BOX */
  .alert-box {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 2px solid #000;
    box-shadow: var(--shadow-brutalist);
    margin-top: 1.5rem;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.15);
    border-color: var(--color-critical);
  }

  .alert-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .alert-content strong {
    display: block;
    color: #fca5a5;
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
  }

  .alert-content p {
    font-size: 0.85rem;
    color: #e1e2eb;
    margin: 0;
  }

  .alert-close {
    margin-left: auto;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    cursor: pointer;
  }

  /* PREVISUALIZACIÓN */
  .schedule-preview-section {
    margin-top: 3rem;
  }

  .preview-meta-card {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brutalist);
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
  }

  .meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .meta-badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .btn-reset-parse {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-body);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-hover);
  }

  .btn-reset-parse:hover {
    border-color: var(--color-critical);
    color: var(--color-critical);
  }

  .meta-fields-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .field-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .field-input {
    background: var(--color-bg-base);
    color: var(--color-text-title);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .field-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  /* EXPORT ACTIONS GRID */
  .export-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  .export-card {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brutalist);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .export-badge-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background: rgba(255, 63, 164, 0.15);
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .export-badge-tag.qr-tag {
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
  }

  .export-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin: 0 0 0.5rem 0;
  }

  .export-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem 0;
  }

  .export-tips {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding: 0.8rem 1rem;
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .tip-check {
    color: var(--color-success);
    font-weight: bold;
  }

  .export-tips p {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-body);
    margin: 0;
  }

  /* QR CODE STYLES */
  .qr-render-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .qr-canvas-wrapper {
    background: #ffffff;
    padding: 0.75rem;
    border-radius: 12px;
    border: 3px solid #000;
    box-shadow: 4px 4px 0px #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-canvas-wrapper canvas {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .qr-action-buttons {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    justify-content: center;
  }

  .btn-mini-brutalist {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.5rem 0.9rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-title);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-hover);
  }

  .btn-mini-brutalist:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  /* BARRA DE CONTROLES & TABS */
  .preview-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .view-tabs {
    display: flex;
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    padding: 0.3rem;
    border-radius: var(--radius-md);
  }

  .tab-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-hover);
  }

  .tab-btn.is-active {
    background: var(--color-primary);
    color: #000;
  }

  .day-filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .day-pill {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--duration-hover);
  }

  .day-pill:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .day-pill.is-active {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: #000;
    font-weight: 700;
  }

  /* CLASES GRID (VISTA POR DÍAS) */
  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .class-card {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-brutalist-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: all var(--duration-hover) var(--ease-spring);
  }

  .class-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-brutalist);
  }

  .class-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .day-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid #000;
    box-shadow: 2px 2px 0 #000;
  }

  /* Colores por día */

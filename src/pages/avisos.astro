---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import { buildApiPayloads } from '../lib/community-payloads.ts';
import type { PublicAvisoItem } from '../lib/community-contract.ts';

const includeExamples =
  import.meta.env.DEV ||
  process.env.INCLUDE_EXAMPLES === 'true' ||
  process.env.PUBLIC_API_INCLUDE_EXAMPLES === 'true';

const payloads = buildApiPayloads({ includeExamples });
const avisos: PublicAvisoItem[] = payloads.parsed.avisos.items;

const typeConfig: Record<string, { label: string; badgeClass: string }> = {
  info: { label: 'Información', badgeClass: 'b-info' },
  evento: { label: 'Evento', badgeClass: 'b-warn' },
  mantenimiento: { label: 'Mantenimiento', badgeClass: 'b-warn' },
  importante: { label: 'Importante', badgeClass: 'b-crit' },
};

function formatDate(isoString: string): string {
  try {
    const d = new Date(isoString);
    return new Intl.DateTimeFormat('es-EC', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'America/Guayaquil',
    }).format(d);
  } catch {
    return isoString;
  }
}

const IG = 'https://www.instagram.com/pilas_ec.app/';
const WA = 'https://whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g';
---
<!doctype html>
<html lang="es-EC" data-mode="espe">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Avisos de la Comunidad | Pilas!</title>
<meta name="description" content="Novedades, eventos y avisos de interés compartidos por y para estudiantes de la comunidad universitaria.">
<meta name="theme-color" content="#101319">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<script is:inline>
try {
  var m = localStorage.pilasMode;
  if (m === 'multi' || m === 'espe') document.documentElement.dataset.mode = m;
} catch (e) {}
</script>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"/></symbol>
</svg>

<header class="top">
  <div class="wrap">
    <a class="nav-brand-logo-pill" href="/" aria-label="Pilas!, volver al inicio">
      <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="nav-brand-logo" width="128" height="42" />
    </a>
    <a class="btn btn-s btn-sm" href="/"><svg class="ico"><use href="#i-back"/></svg>Volver<span class="hide-xs"> al inicio</span></a>
    <a class="btn btn-p btn-sm" href="/#acceso"><svg class="ico"><use href="#i-down"/></svg><span class="hide-xs">Pedir </span>Acceso</a>
  </div>
</header>

<main class="page-body">
  <div class="wrap">
    <div class="page-head">
      <span class="badge b-info"><svg class="ico"><use href="#i-info"/></svg>Tablón de avisos</span>
      <h1>Avisos de la Comunidad</h1>
      <p class="lead">Novedades, eventos y avisos importantes gestionados por y para estudiantes.</p>
    </div>

    <!-- Aviso Legal -->
    <div class="card notice-box" style="margin-top:24px">
      <b>Aviso de la comunidad estudiantil. No es un comunicado oficial de la universidad.</b>
      <p style="margin-top:4px">Para trámites administrativos y resoluciones institucionales oficiales, consulta siempre los portales oficiales de tu universidad.</p>
    </div>

    <!-- Canal WhatsApp CTA -->
    <div class="card wa-box" style="margin-top:20px">
      <div>
        <b>¿Quieres enterarte al instante de nuevas versiones y alertas?</b>
        <p style="margin-top:4px">Súmate a nuestro canal de WhatsApp para avisos de mantenimiento y lanzamientos de APK.</p>
      </div>
      <a class="btn btn-p btn-sm" href={WA} target="_blank" rel="noopener noreferrer">Unirme al canal</a>
    </div>

    <!-- Lista de Avisos -->
    <div class="avisos-list" style="margin-top:32px">
      {avisos.length === 0 ? (
        <div class="card empty">
          <img src="/logos/mascota_dormido.svg" alt="Pilo, la mascota de Pilas!, durmiendo plácidamente con gorro de noche porque no hay avisos pendientes" width="120" height="120">
          <h3>No hay avisos pendientes en este momento</h3>
          <p>Todo está tranquilo en el campus. ¡Estás al día!</p>
        </div>
      ) : (
        <div class="rules one">
          {avisos.map((aviso) => {
            const cfg = typeConfig[aviso.type] || { label: aviso.type, badgeClass: 'b-info' };
            return (
              <div class="aviso-row">
                <div class="aviso-meta">
                  <span class={`badge ${cfg.badgeClass}`}>{cfg.label}</span>
                  <span class="aviso-date num">{formatDate(aviso.publishedAt)}</span>
                </div>
                <dt class="aviso-title">{aviso.title}</dt>
                <dd class="aviso-content">
                  {aviso.body && <p>{aviso.body}</p>}
                  {aviso.link && (
                    <p style="margin-top:8px">
                      <a href={aviso.link.url} target="_blank" rel="noopener noreferrer">{aviso.link.label || 'Ver más información ➔'}</a>
                    </p>
                  )}
                </dd>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</main>

<footer class="hub-footer">
  <div class="wrap footer-wrap">
    <div class="footer-brand-row">
      <a class="footer-brand-logo-pill" href="/" aria-label="Pilas!, volver arriba">
        <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="footer-lettering-img" width="132" height="42" />
      </a>
      <div class="footer-pill-edition">
        <span class="sticker-pill" data-for="espe">⚡ COMUNIDAD UNIVERSITARIA ESPE</span>
        <span class="sticker-pill coral" data-for="multi">⭐ RED MULTI-UNIVERSIDAD ECUADOR</span>
      </div>
    </div>
    <nav aria-label="Enlaces del sitio" class="footer-nav">
      <a href="/faq">Preguntas frecuentes</a>
      <a href="/avisos">Avisos</a>
      <a href="/negocios">Negocios</a>
      <a href="/privacidad">Privacidad</a>
      <a href={IG} target="_blank" rel="noopener noreferrer">Instagram (@pilas_ec.app)</a>
      <a href={WA} target="_blank" rel="noopener noreferrer">Canal de WhatsApp</a>
    </nav>
    <div class="footer-legal">
      <p>Pilas! es un proyecto estudiantil independiente. No está respaldado ni afiliado oficialmente a la Universidad de las Fuerzas Armadas ESPE, Ellucian, Banner ni Moodle. Las credenciales y datos viven únicamente en tu teléfono.</p>
      <p>Los nombres, siglas y logotipos de universidades pertenecen con exclusividad a sus respectivos titulares y se usan únicamente para fines de contextualización estudiantil y compatibilidad técnica.</p>
      <p class="footer-copy">© 2026 Pilas! · Hecho con orgullo estudiantil para el Ecuador.</p>
    </div>
  </div>
</footer>

<style is:global>
:root{
  color-scheme:dark;
  --primary:#ff3fa4;--primary-hover:#e5147d;--primary-extrude:#7a0a45;--primary-shadow:#4a0026;--primary-coral:#ff3d5e;
  --success:#00ff87;--success-shadow:#059669;--warning:#ffdb60;--critical:#ef4444;--info:#38bdf8;
  --bg-base:#101319;--bg-subtle:#191d28;--bg-surface:#161a23;--bg-elevated:#1e2230;--bg-container:#242938;
  --border:#2a3142;--border-control:#6b7894;--title:#faf7f7;--body:#e1e2eb;--muted:#8f9cae;
  --f-d:"Outfit Variable",system-ui,sans-serif;--f-b:"Inter Variable",system-ui,sans-serif;
  --accent:var(--primary);--bg:var(--bg-base);
}
html[data-mode=multi]{--accent:var(--primary-coral);--bg:var(--bg-subtle)}
html{scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background-color:var(--bg);color:var(--body);font:400 1.0625rem/1.6 var(--f-b);padding-bottom:env(safe-area-inset-bottom,0px)}
html[data-mode=espe] body{background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px}
html[data-mode=multi] body{background-image:radial-gradient(rgba(255,255,255,.09) 1.5px,transparent 1.5px);background-size:22px 22px}
h1,h2,h3{font-family:var(--f-d);font-weight:800;color:var(--title);line-height:1.1;letter-spacing:-.02em;margin:0}
p{margin:0}a{color:var(--info)}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding-inline:clamp(16px,4vw,32px)}
.num{font-variant-numeric:tabular-nums}
.ico{width:1.1em;height:1.1em;fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border:2px solid;border-radius:12px;font:800 1rem var(--f-d);text-decoration:none;cursor:pointer;transition:transform 100ms,box-shadow 100ms,background 150ms}
.btn:active{transform:translate(2px,2px);box-shadow:none!important}
.btn-p{background:var(--primary);color:#000;border-color:#000;box-shadow:3px 3px 0 #000}
.btn-p:hover,.btn-p:active{background:var(--primary-hover)}
.btn-s{background:var(--bg-elevated);color:var(--title);border:2px solid var(--border-control);box-shadow:3px 3px 0 #000}
.btn-sm{padding:0 16px;font-size:.95rem}
.card{background:var(--bg-surface);border:2px solid var(--border);border-radius:14px;box-shadow:2px 2px 0 var(--border);padding:20px}
.badge{display:inline-flex;align-items:center;gap:6px;border:1.5px solid currentColor;border-radius:999px;padding:4px 12px 4px 8px;background:var(--bg-base);font:600 .875rem/1.3 var(--f-b)}
.b-warn{color:var(--warning)}.b-crit{color:var(--critical)}.b-info{color:var(--info)}

/* top con logo pill y glow */
.top{position:sticky;top:0;z-index:20;background:rgba(16,19,25,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:2px solid #000;padding:10px 0}
.top .wrap{display:flex;align-items:center;gap:12px;min-height:50px}

.nav-brand-logo-pill,
.footer-brand-logo-pill {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:transparent!important;
  border:none!important;
  box-shadow:none!important;
  text-decoration:none;
  margin-right:auto;
}

.nav-brand-logo,
.footer-lettering-img {
  display:block;
  height:36px;
  width:auto;
  filter:drop-shadow(0 0 10px rgba(255,63,164,0.9))
         drop-shadow(0 0 22px rgba(255,20,117,0.7))
         drop-shadow(2px 3px 0 #000000)!important;
  transition:filter 220ms ease, transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  animation:logoPinkGlowPulse 4s ease-in-out infinite;
}
.nav-brand-logo:hover,
.footer-lettering-img:hover {
  filter:drop-shadow(0 0 14px rgba(255,63,164,1))
         drop-shadow(0 0 30px rgba(255,20,117,0.95))
         drop-shadow(2px 3px 0 #000000)!important;
  transform:translateY(-2px) scale(1.03);
}

@keyframes logoPinkGlowPulse {
  0%, 100% {
    filter: drop-shadow(0 0 8px rgba(255, 63, 164, 0.9))
            drop-shadow(0 0 20px rgba(255, 20, 117, 0.7))
            drop-shadow(2px 3px 0 #000000);
  }
  50% {
    filter: drop-shadow(0 0 13px rgba(255, 63, 164, 1))
            drop-shadow(0 0 28px rgba(255, 20, 117, 0.88))
            drop-shadow(2px 3px 0 #000000);
  }
}

.sticker-pill {
  display: inline-block;
  padding: 4px 12px;
  border: 1.5px solid #000;
  border-radius: 9999px;
  background: var(--primary);
  color: #000;
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  box-shadow: 2px 2px 0 #000;
}
.sticker-pill.coral { background: var(--primary-coral); }

/* Footer Neo-Brutalista Oficial */
.hub-footer {
  padding: 48px 0 56px;
  border-top: 2px solid #000;
  background: #090b10;
}
.footer-wrap {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.footer-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.footer-pill-edition {
  display: flex;
  gap: 8px;
}
.footer-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 14px 24px;
}
.footer-nav a {
  color: var(--body);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;
  transition: color 150ms;
}
.footer-nav a:hover {
  color: var(--primary);
}
.footer-legal {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.82rem;
  color: var(--muted);
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  padding-top: 16px;
}
.footer-copy {
  color: var(--title);
  font-weight: 700;
}

/* page content */
.page-body{padding:clamp(36px,6vw,72px) 0 clamp(48px,7vw,96px)}
.page-head{display:grid;gap:12px;max-width:44em}
.page-head h1{font-size:clamp(2.2rem,5vw,3.6rem);margin-top:6px}
.lead{font-size:1.15rem;color:var(--body)}

.notice-box{border-color:var(--border-control);background:var(--bg-elevated)}
.notice-box b{color:var(--title);display:block}
.wa-box{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;background:var(--bg-container);border-color:var(--border-control)}
.wa-box b{color:var(--title)}

/* list */
.rules.one>div{padding:20px 0;border-top:1px solid var(--border)}
.rules.one>div:first-of-type{border-top:none;padding-top:0}
.aviso-row{display:grid;gap:8px}
.aviso-meta{display:flex;align-items:center;gap:12px}
.aviso-date{color:var(--muted);font-size:.9rem}
.aviso-title{font:800 1.25rem var(--f-d);color:var(--title)}
.aviso-content{margin:0;color:var(--body);line-height:1.6}

.empty{text-align:center;display:grid;place-items:center;gap:12px;padding:48px 24px}

footer{padding:40px 0 56px;border-top:2px solid #000;background:var(--bg);font-size:.95rem}
footer .wrap{display:grid;gap:16px}footer nav{display:flex;flex-wrap:wrap;gap:0 22px}footer nav a{display:inline-flex;align-items:center;min-height:48px}footer p{color:var(--muted);max-width:60em}

@media(max-width:540px){
  .hide-xs{display:none!important}
  .top .wrap{gap:8px}
  .nav-brand-logo{height:28px}
}
</style>
</body>
</html>

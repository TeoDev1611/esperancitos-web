---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import { SITE } from '../config/site';
import { FAQ_ENTRIES, FAQ_CATEGORIES } from '../config/faq';

const categoryMap: Record<string, string> = {
  instalacion: 'Instalación & APK',
  seguridad: 'Seguridad & Cuentas',
  moodle: 'Moodle & Tareas',
  horarios: 'Horario, Aulas & Notas',
  malla: 'Malla & Modo Offline',
  general: 'General, Sedes & iPhone',
};

const V = {
  version: SITE.version,
  apk: SITE.primaryApkPath,
};
const IG = 'https://www.instagram.com/pilas_ec.app/';
const WA = 'https://whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g';
---
<!doctype html>
<html lang="es-EC" data-mode="espe">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Preguntas Frecuentes | Pilas! para Android</title>
<meta name="description" content="Respuestas sobre la app Pilas!: instalación de APK, seguridad y privacidad de contraseñas, Moodle por QR, horarios sin internet y cálculo de notas.">
<meta name="theme-color" content="#101319">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<script is:inline>
try {
  var m = localStorage.pilasMode;
  if (m === 'multi' || m === 'espe') document.documentElement.dataset.mode = m;
} catch (e) {}
</script>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></symbol>
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></symbol>
</svg>

<header class="top">
  <div class="wrap">
    <a class="nav-brand-logo-pill" href="/" aria-label="Pilas!, volver al inicio">
      <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="nav-brand-logo" width="128" height="42" />
    </a>
    <a class="btn btn-s btn-sm" href="/"><svg class="ico"><use href="#i-back"/></svg>Volver<span class="hide-xs"> al inicio</span></a>
    <a class="btn btn-p btn-sm" href={V.apk}><svg class="ico"><use href="#i-down"/></svg><span class="hide-xs">Descargar </span>APK</a>
  </div>
</header>

<main class="page-body">
  <div class="wrap">
    <div class="page-head">
      <span class="badge b-info"><svg class="ico"><use href="#i-info"/></svg>Centro de ayuda</span>
      <h1>Preguntas Frecuentes</h1>
      <p class="lead">Todo lo que necesitas saber sobre instalación, cuentas, seguridad, horarios y Moodle.</p>
    </div>

    <!-- Buscador -->
    <div class="search-wrap">
      <div class="search-box">
        <svg class="ico"><use href="#i-search"/></svg>
        <input
          type="search"
          id="faq-search"
          placeholder="Buscar por palabra clave (ej. contraseña, APK, Play Protect, QR)..."
          aria-label="Buscar preguntas frecuentes"
        />
        <button type="button" id="faq-clear" class="btn-clear" aria-label="Limpiar búsqueda" hidden>×</button>
      </div>
    </div>

    <!-- Filtros de categoría -->
    <div class="cat-bar" role="tablist" aria-label="Categorías de preguntas">
      {FAQ_CATEGORIES.map((cat, idx) => (
        <button
          type="button"
          class={`cat-btn ${idx === 0 ? 'active' : ''}`}
          data-cat-id={cat.id}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          <span>{cat.name}</span>
        </button>
      ))}
    </div>

    <p class="count-line" id="faq-count" aria-live="polite">Mostrando <b class="num">{FAQ_ENTRIES.length}</b> preguntas</p>

    <!-- Lista de acordeones -->
    <div class="faq-list" id="faq-list">
      {FAQ_ENTRIES.map((entry) => (
        <details class="faq-item" data-category={entry.category} data-faq-id={entry.id}>
          <summary>
            <span class="badge b-info">{categoryMap[entry.category] || entry.category}</span>
            <span class="faq-q">{entry.question}</span>
          </summary>
          <div class="faq-ans">
            <p><Fragment set:html={entry.answer} /></p>
            {entry.bullets && entry.bullets.length > 0 && (
              <ul class="faq-bullets">
                {entry.bullets.map((b) => (
                  <li><Fragment set:html={b} /></li>
                ))}
              </ul>
            )}
          </div>
        </details>
      ))}
    </div>

    <!-- Estado vacío -->
    <div class="empty card" id="faq-empty" hidden>
      <img src="/logos/mascota_negacion.svg" alt="Pilo con ceño fruncido indicando que no se encontraron respuestas" width="120" height="120">
      <h3>No encontramos respuestas para esa búsqueda</h3>
      <p>Prueba con términos más generales como <em>Moodle</em>, <em>contraseña</em>, <em>APK</em> o <em>horario</em>.</p>
      <button type="button" class="btn btn-p btn-sm" id="btn-reset">Ver todas las preguntas</button>
    </div>

    <!-- Tarjeta de contacto -->
    <div class="card support-card">
      <div>
        <h3>¿Tienes otra duda o encontraste un problema?</h3>
        <p style="margin-top:6px">Escríbenos directamente a través de nuestros canales comunitarios oficiales.</p>
      </div>
      <div class="support-btns">
        <a class="btn btn-p" href={WA} target="_blank" rel="noopener noreferrer">Canal de WhatsApp</a>
        <a class="btn btn-s" href={`mailto:${SITE.social.email}`}>Enviar correo</a>
      </div>
    </div>
  </div>
</main>

<footer class="hub-footer">
  <div class="wrap footer-wrap">
    <div class="footer-brand-row">
      <a class="footer-brand-logo-pill" href="/" aria-label="Pilas!, volver arriba">
        <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="footer-lettering-img" width="132" height="42" />
      </a>
      <div class="footer-pill-edition">
        <span class="sticker-pill" data-for="espe">⚡ COMUNIDAD UNIVERSITARIA ESPE</span>
        <span class="sticker-pill coral" data-for="multi">⭐ RED MULTI-UNIVERSIDAD ECUADOR</span>
      </div>
    </div>
    <nav aria-label="Enlaces del sitio" class="footer-nav">
      <a href="/faq">Preguntas frecuentes</a>
      <a href="/avisos">Avisos</a>
      <a href="/negocios">Negocios</a>
      <a href="/privacidad">Privacidad</a>
      <a href={IG} target="_blank" rel="noopener noreferrer">Instagram (@pilas_ec.app)</a>
      <a href={WA} target="_blank" rel="noopener noreferrer">Canal de WhatsApp</a>
    </nav>
    <div class="footer-legal">
      <p>Pilas! es un proyecto estudiantil independiente. No está respaldado ni afiliado oficialmente a la Universidad de las Fuerzas Armadas ESPE, Ellucian, Banner ni Moodle. Las credenciales y datos viven únicamente en tu teléfono.</p>
      <p class="footer-copy">© 2026 Pilas! · Hecho con orgullo estudiantil para el Ecuador.</p>
    </div>
  </div>
</footer>

<style is:global>
:root{
  color-scheme:dark;
  --primary:#ff3fa4;--primary-hover:#e5147d;--primary-extrude:#7a0a45;--primary-shadow:#4a0026;--primary-coral:#ff3d5e;
  --success:#00ff87;--success-shadow:#059669;--warning:#ffdb60;--critical:#ef4444;--info:#38bdf8;
  --bg-base:#101319;--bg-subtle:#191d28;--bg-surface:#161a23;--bg-elevated:#1e2230;--bg-container:#242938;
  --border:#2a3142;--border-control:#6b7894;--title:#faf7f7;--body:#e1e2eb;--muted:#8f9cae;
  --f-d:"Outfit Variable",system-ui,sans-serif;--f-b:"Inter Variable",system-ui,sans-serif;
  --accent:var(--primary);--bg:var(--bg-base);
}
html[data-mode=multi]{--accent:var(--primary-coral);--bg:var(--bg-subtle)}
html{scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background-color:var(--bg);color:var(--body);font:400 1.0625rem/1.6 var(--f-b);padding-bottom:env(safe-area-inset-bottom,0px)}
html[data-mode=espe] body{background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px}
html[data-mode=multi] body{background-image:radial-gradient(rgba(255,255,255,.09) 1.5px,transparent 1.5px);background-size:22px 22px}
h1,h2,h3{font-family:var(--f-d);font-weight:800;color:var(--title);line-height:1.1;letter-spacing:-.02em;margin:0}
p{margin:0}a{color:var(--info)}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding-inline:clamp(16px,4vw,32px)}
.num{font-variant-numeric:tabular-nums}
.ico{width:1.1em;height:1.1em;fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border:2px solid;border-radius:12px;font:800 1rem var(--f-d);text-decoration:none;cursor:pointer;transition:transform 100ms,box-shadow 100ms,background 150ms}
.btn:active{transform:translate(2px,2px);box-shadow:none!important}
.btn-p{background:var(--primary);color:#000;border-color:#000;box-shadow:3px 3px 0 #000}
.btn-p:hover,.btn-p:active{background:var(--primary-hover)}
.btn-s{background:var(--bg-elevated);color:var(--title);border:2px solid var(--border-control);box-shadow:3px 3px 0 #000}
.btn-sm{padding:0 16px;font-size:.95rem}
.card{background:var(--bg-surface);border:2px solid var(--border);border-radius:14px;box-shadow:2px 2px 0 var(--border);padding:24px}
.badge{display:inline-flex;align-items:center;gap:6px;border:1.5px solid currentColor;border-radius:999px;padding:4px 12px 4px 8px;background:var(--bg-base);font:600 .875rem/1.3 var(--f-b)}
.b-ok{color:var(--success)}.b-warn{color:var(--warning)}.b-crit{color:var(--critical)}.b-info{color:var(--info)}

/* top con logo pill y glow */
.top{position:sticky;top:0;z-index:20;background:rgba(16,19,25,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:2px solid #000;padding:10px 0}
.top .wrap{display:flex;align-items:center;gap:12px;min-height:50px}

.nav-brand-logo-pill,
.footer-brand-logo-pill {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:transparent!important;
  border:none!important;
  box-shadow:none!important;
  text-decoration:none;
  margin-right:auto;
}

.nav-brand-logo,
.footer-lettering-img {
  display:block;
  height:36px;
  width:auto;
  filter:drop-shadow(0 0 10px rgba(255,63,164,0.9))
         drop-shadow(0 0 22px rgba(255,20,117,0.7))
         drop-shadow(2px 3px 0 #000000)!important;
  transition:filter 220ms ease, transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  animation:logoPinkGlowPulse 4s ease-in-out infinite;
}
.nav-brand-logo:hover,
.footer-lettering-img:hover {
  filter:drop-shadow(0 0 14px rgba(255,63,164,1))
         drop-shadow(0 0 30px rgba(255,20,117,0.95))
         drop-shadow(2px 3px 0 #000000)!important;
  transform:translateY(-2px) scale(1.03);
}

@keyframes logoPinkGlowPulse {
  0%, 100% {
    filter: drop-shadow(0 0 8px rgba(255, 63, 164, 0.9))
            drop-shadow(0 0 20px rgba(255, 20, 117, 0.7))
            drop-shadow(2px 3px 0 #000000);
  }
  50% {
    filter: drop-shadow(0 0 13px rgba(255, 63, 164, 1))
            drop-shadow(0 0 28px rgba(255, 20, 117, 0.88))
            drop-shadow(2px 3px 0 #000000);
  }
}

.sticker-pill {
  display: inline-block;
  padding: 4px 12px;
  border: 1.5px solid #000;
  border-radius: 9999px;
  background: var(--primary);
  color: #000;
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  box-shadow: 2px 2px 0 #000;
}
.sticker-pill.coral { background: var(--primary-coral); }

/* Footer Neo-Brutalista Oficial */
.hub-footer {
  padding: 48px 0 56px;
  border-top: 2px solid #000;
  background: #090b10;
}
.footer-wrap {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.footer-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.footer-pill-edition {
  display: flex;
  gap: 8px;
}
.footer-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 14px 24px;
}
.footer-nav a {
  color: var(--body);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;
  transition: color 150ms;
}
.footer-nav a:hover {
  color: var(--primary);
}
.footer-legal {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.82rem;
  color: var(--muted);
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  padding-top: 16px;
}
.footer-copy {
  color: var(--title);
  font-weight: 700;
}

/* page content */
.page-body{padding:clamp(36px,6vw,72px) 0 clamp(48px,7vw,96px)}
.page-head{display:grid;gap:12px;max-width:44em}
.page-head h1{font-size:clamp(2.2rem,5vw,3.6rem);margin-top:6px}
.lead{font-size:1.15rem;color:var(--body)}

/* search */
.search-wrap{margin-top:32px}
.search-box{display:flex;align-items:center;gap:12px;min-height:56px;padding:0 16px;border:2px solid var(--border-control);border-radius:12px;background:var(--bg-elevated)}
.search-box:focus-within{border-color:var(--primary);outline:2px solid var(--primary);outline-offset:2px}
.search-box input{flex:1;background:transparent;border:none;color:var(--title);font:500 1.05rem var(--f-b);outline:none}
.search-box input::placeholder{color:var(--muted)}
.btn-clear{background:none;border:none;color:var(--muted);font-size:1.4rem;cursor:pointer;padding:4px 8px}

/* categories */
.cat-bar{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.cat-btn{min-height:48px;padding:0 18px;border:2px solid var(--border-control);border-radius:12px;background:var(--bg-elevated);color:var(--title);font:700 .95rem var(--f-d);cursor:pointer;transition:background 120ms,color 120ms}
.cat-btn.active{background:var(--primary);color:#000;border-color:#000;box-shadow:3px 3px 0 #000}
.cat-btn:active{transform:translate(2px,2px);box-shadow:none}

.count-line{margin-top:24px;color:var(--muted);font-size:.95rem}

/* faq list */
.faq-list{display:grid;gap:14px;margin-top:16px}
.faq-item{border:2px solid var(--border-control);border-radius:12px;background:var(--bg-surface);padding:4px 18px}
.faq-item summary{font:800 1.08rem var(--f-d);color:var(--title);cursor:pointer;min-height:54px;display:flex;align-items:center;gap:12px;list-style:none}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:"+";margin-left:auto;font-size:1.5rem;color:var(--muted);flex:none;transition:transform .15s}
.faq-item[open] summary::after{content:"−"}
.faq-item[open]{padding-bottom:18px;background:var(--bg-elevated)}
.faq-q{flex:1}
.faq-ans{margin-top:12px;padding-top:12px;border-top:1px solid var(--border);color:var(--body);line-height:1.65}
.faq-bullets{margin:10px 0 0;padding-left:20px}
.faq-bullets li{margin-top:6px}

/* empty state */
.empty{margin-top:32px;text-align:center;display:grid;place-items:center;gap:12px}
.empty img{margin-bottom:6px}

/* support card */
.support-card{margin-top:48px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;background:var(--bg-container);border-color:var(--border-control)}
.support-btns{display:flex;gap:12px;flex-wrap:wrap}

footer{padding:40px 0 56px;border-top:2px solid #000;background:var(--bg);font-size:.95rem}
footer .wrap{display:grid;gap:16px}footer nav{display:flex;flex-wrap:wrap;gap:0 22px}footer nav a{display:inline-flex;align-items:center;min-height:48px}footer p{color:var(--muted);max-width:60em}

@media(max-width:720px){
  .faq-item summary{align-items:flex-start;padding-top:12px}
  .faq-item summary::after{margin-top:-4px}
  .support-card{flex-direction:column;align-items:stretch}
}
@media(max-width:540px){
  .hide-xs{display:none!important}
  .top .wrap{gap:8px}
  .nav-brand-logo{height:28px}
}
</style>

<script>
const input = document.getElementById('faq-search') as HTMLInputElement;
const clearBtn = document.getElementById('faq-clear') as HTMLButtonElement;
const catBtns = document.querySelectorAll('.cat-btn') as NodeListOf<HTMLButtonElement>;
const items = document.querySelectorAll('.faq-item') as NodeListOf<HTMLDetailsElement>;
const countEl = document.getElementById('faq-count') as HTMLElement;
const emptyBox = document.getElementById('faq-empty') as HTMLElement;
const resetBtn = document.getElementById('btn-reset') as HTMLButtonElement;

let currentCat = 'todos';
let currentQuery = '';

/**
 * Normaliza texto eliminando acentos, diacríticos (incluyendo tilde de ñ para búsqueda insensible),
 * signos de puntuación y espacios extras.
 */
function normalizeText(str: string): string {
  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

// Pre-indexar el texto normalizado de cada pregunta para una búsqueda instantánea
const itemData = Array.from(items).map((item) => {
  const cat = item.dataset.category || '';
  const rawText = item.textContent || '';
  return {
    el: item,
    category: cat,
    normText: normalizeText(rawText),
  };
});

function matchToken(token: string, text: string): boolean {
  if (text.includes(token)) return true;
  if (token.length > 3 && token.endsWith('s')) {
    if (text.includes(token.slice(0, -1))) return true;
    if (token.length > 4 && token.endsWith('es')) {
      if (text.includes(token.slice(0, -2))) return true;
    }
  }
  return false;
}

function filter() {
  let visible = 0;
  const normQ = normalizeText(currentQuery);
  const tokens = normQ.split(' ').filter(Boolean);

  itemData.forEach(({ el, category, normText }) => {
    const matchCat = currentCat === 'todos' || category === currentCat;
    // Búsqueda multi-término (AND): cada palabra ingresada debe existir en la pregunta/respuesta
    const matchQuery = tokens.length === 0 || tokens.every((token) => matchToken(token, normText));

    const show = matchCat && matchQuery;
    el.hidden = !show;

    if (show) {
      visible++;
      // Si el usuario está buscando términos activamente, auto-expandir el acordeón para mostrar la respuesta
      if (tokens.length > 0) {
        el.open = true;
      }
    } else {
      el.open = false;
    }
  });

  // Si la búsqueda se limpió por completo, volver a colapsar los acordeones para navegación limpia
  if (tokens.length === 0) {
    items.forEach((item) => {
      item.open = false;
    });
  }

  if (countEl) {
    countEl.innerHTML = `Mostrando <b class="num">${visible}</b> ${visible === 1 ? 'pregunta' : 'preguntas'}`;
  }
  if (emptyBox) {
    emptyBox.hidden = visible > 0;
  }
}

function setCategory(catId: string) {
  currentCat = catId;
  catBtns.forEach((btn) => {
    const isSelected = (btn.dataset.catId || 'todos') === catId;
    btn.classList.toggle('active', isSelected);
    btn.setAttribute('aria-selected', String(isSelected));
  });
  filter();
}

input?.addEventListener('input', () => {
  currentQuery = input.value;
  clearBtn.hidden = !currentQuery.trim();
  filter();
});

input?.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    e.preventDefault();
    input.value = '';
    currentQuery = '';
    clearBtn.hidden = true;
    filter();
  }
});

clearBtn?.addEventListener('click', () => {
  input.value = '';
  currentQuery = '';
  clearBtn.hidden = true;
  filter();
  input.focus();
});

catBtns.forEach((btn, idx) => {
  btn.addEventListener('click', () => {
    setCategory(btn.dataset.catId || 'todos');
  });

  // Navegación accesible por teclado entre pestañas (W3C WAI-ARIA)
  btn.addEventListener('keydown', (e) => {
    let nextIdx = -1;
    if (e.key === 'ArrowRight') nextIdx = (idx + 1) % catBtns.length;
    else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + catBtns.length) % catBtns.length;
    else if (e.key === 'Home') nextIdx = 0;
    else if (e.key === 'End') nextIdx = catBtns.length - 1;

    if (nextIdx >= 0) {
      e.preventDefault();
      const target = catBtns[nextIdx];
      target.focus();
      target.click();
    }
  });
});

resetBtn?.addEventListener('click', () => {
  input.value = '';
  currentQuery = '';
  clearBtn.hidden = true;
  setCategory('todos');
  input.focus();
});

// Soporte de enlace profundo por URL (ej. /faq?q=contrasena o /faq#moodle)
try {
  const urlParams = new URLSearchParams(window.location.search);
  const qParam = urlParams.get('q');
  const catHash = window.location.hash.replace('#', '');

  if (qParam && input) {
    input.value = qParam;
    currentQuery = qParam;
    clearBtn.hidden = false;
  }
  if (catHash && Array.from(catBtns).some((b) => b.dataset.catId === catHash)) {
    setCategory(catHash);
  } else {
    filter();
  }
} catch {}
</script>
</body>
</html>

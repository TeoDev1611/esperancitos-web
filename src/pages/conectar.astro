---
// conectar.astro - Herramienta para conectar Moodle en iPhone / iOS escaneando la pantalla de la PC (Estilo WhatsApp Web)
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const CAMPUSES = [
  { id: 'presencial', name: 'Presencial', host: 'micampus.espe.edu.ec', default: true },
  { id: 'enlinea', name: 'En Línea', host: 'micampusvirtual.espe.edu.ec' },
  { id: 'postgrado', name: 'Postgrado', host: 'micampus2.espe.edu.ec' },
  { id: 'nivelacion', name: 'Nivelación', host: 'micampus1.espe.edu.ec' },
];
---

<BaseLayout
  title="Vincular Moodle en iPhone | Pilas! para la ESPE"
  description="Sincroniza tus cursos, notas y tareas de Moodle en tu iPhone escaneando el código QR generado en tu computadora con tu sesión institucional."
  keywords="moodle espe iphone, vincular moodle pilas, conectar moodle qr, moodle sso espe"
>
  <main class="conectar-main">
    <div class="container">
      <!-- HEADER PRINCIPAL -->
      <header class="conectar-header">
        <div class="conectar-badge">
          <span class="badge-dot"></span>
          <span>CONEXIÓN RÁPIDA ESTILO WHATSAPP WEB</span>
        </div>
        <h1 class="conectar-title">
          Vincular Moodle a <span class="text-fuchsia">Pilas!</span> en tu iPhone
        </h1>
        <p class="conectar-subtitle">
          Inicia sesión en Moodle desde tu computadora y genera tu código de vinculación para escanearlo con la cámara de tu iPhone en 5 segundos.
        </p>
      </header>

      <!-- SELECTOR DE CAMPUS INSTITUCIONAL -->
      <section class="campus-selector-section" aria-label="Seleccionar campus universitario">
        <div class="campus-bar-label">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 2 2 7h20L12 2z"></path>
          </svg>
          <span>Selecciona tu campus:</span>
        </div>
        <div class="campus-tabs-row" id="campus-tabs" role="tablist">
          {CAMPUSES.map((c) => (
            <button
              type="button"
              class:list={['btn-campus-tab', { active: c.default }]}
              data-campus-id={c.id}
              data-campus-host={c.host}
              data-campus-name={c.name}
              role="tab"
              aria-selected={c.default ? 'true' : 'false'}
            >
              <span class="campus-tab-name">{c.name}</span>
              <span class="campus-tab-host">{c.host}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- GRID DE CONEXIÓN: PASOS (IZQ) Y CÓDIGO QR EN VIVO (DER) -->
      <div class="conectar-grid">
        <!-- COLUMNA IZQUIERDA: PASO 1 Y PASO 2 -->
        <div class="steps-column">
          <!-- TARJETA PASO 1 -->
          <div class="step-card">
            <div class="step-card-header">
              <div class="step-badge">PASO 1</div>
              <h2 class="step-title">Abrir sesión institucional de Moodle</h2>
            </div>
            <p class="step-description">
              Haz clic en el botón abajo. Si ya tienes tu sesión de estudiante abierta con tu correo <strong>@espe.edu.ec</strong> en esta computadora, Moodle se abrirá inmediatamente.
            </p>
            <div class="step-action-box">
              <a
                href="https://micampus.espe.edu.ec/admin/tool/mobile/launch.php?service=moodle_mobile_app&passport=1&urlscheme=moodlemobile"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-brutalist btn-primary btn-large btn-full"
                id="btn-open-moodle-sso"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                <span id="btn-open-text">1. Abrir Sesión en Moodle Presencial ↗</span>
              </a>
            </div>
            <div class="step-hint">
              <span class="hint-icon">💡</span>
              <p>Se abrirá una nueva pestaña de Moodle con el mensaje institucional de la aplicación móvil.</p>
            </div>
          </div>

          <!-- TARJETA PASO 2 -->
          <div class="step-card">
            <div class="step-card-header">
              <div class="step-badge">PASO 2</div>
              <h2 class="step-title">Copiar y pegar el enlace de sesión</h2>
            </div>
            <div class="instruction-quote">
              <p class="quote-header">En la pestaña que se abrió en tu navegador verás:</p>
              <div class="quote-box">
                <span class="quote-tag">Aula Virtual:</span>
                <span class="quote-link-text">«Haga clic aquí si la aplicación no se abre automáticamente.»</span>
              </div>
              <p class="quote-tip">
                👉 Haz <strong>clic derecho</strong> sobre ese texto y selecciona <strong>«Copiar dirección del enlace»</strong> (o copia el enlace <code>moodlemobile://token=...</code>).
              </p>
            </div>

            <div class="paste-input-container">
              <label for="token-input" class="input-label">Pega aquí el enlace o clave copiada:</label>
              <div class="input-action-wrapper">
                <textarea
                  id="token-input"
                  rows="3"
                  class="token-textarea"
                  placeholder="Pega aquí moodlemobile://token=... o tu clave de 32 caracteres"
                  spellcheck="false"
                ></textarea>
                <button type="button" class="btn-paste-quick" id="btn-paste" title="Pegar del portapapeles">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                  </svg>
                  <span>Pegar</span>
                </button>
              </div>

              <!-- MENSAJE DE ESTADO / VALIDACIÓN -->
              <div class="validation-message" id="validation-msg" style="display: none;"></div>
            </div>
          </div>
        </div>

        <!-- COLUMNA DERECHA: PASO 3 (CÓDIGO QR EN VIVO) -->
        <div class="qr-column">
          <div class="qr-main-card" id="qr-card">
            <!-- ESTADO VACÍO (ESPERANDO ENLACE) -->
            <div class="qr-idle-state" id="qr-idle">
              <div class="qr-idle-icon-wrap">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                  <path d="M10 3v4"></path>
                  <path d="M14 7h.01"></path>
                  <path d="M7 10v.01"></path>
                  <path d="M7 14v.01"></path>
                  <path d="M10 14v3"></path>
                  <path d="M10 21v-1"></path>
                  <path d="M17 14v.01"></path>
                  <path d="M20 17v.01"></path>
                  <path d="M17 20v1"></path>
                </svg>
              </div>
              <h3 class="qr-idle-title">Esperando enlace de sesión</h3>
              <p class="qr-idle-desc">
                Completa los Pasos 1 y 2 a la izquierda. Tu código QR aparecerá aquí listo para ser escaneado con tu iPhone.
              </p>
            </div>

            <!-- ESTADO ACTIVO (CÓDIGO QR GENERADO) -->
            <div class="qr-active-state" id="qr-active" style="display: none;">
              <div class="qr-ready-badge">
                <span class="ready-dot"></span>
                <span>¡LISTO PARA ESCANEAR EN IPHONE!</span>
              </div>
              <div class="qr-canvas-box">
                <canvas id="qr-canvas" width="280" height="280" aria-label="Código QR para vincular Moodle con Pilas!"></canvas>
              </div>

              <!-- METADATOS Y ACCIONES -->
              <div class="qr-details-box">
                <div class="detail-row">
                  <span class="detail-label">Campus:</span>
                  <span class="detail-value text-fuchsia" id="qr-campus-label">Presencial</span>
                </div>
                <div class="detail-row">
                  <span class="detail-label">Token:</span>
                  <span class="detail-value font-mono" id="qr-token-masked">••••••••••••••••</span>
                </div>
              </div>

              <!-- INSTRUCCIONES IPHONE -->
              <div class="phone-instructions-box">
                <h4 class="phone-ins-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                  </svg>
                  <span>En tu iPhone:</span>
                </h4>
                <ol class="phone-steps-list">
                  <li>Abre la app <strong>Pilas!</strong>.</li>
                  <li>Ve a <strong>Moodle</strong> &gt; pulsa <strong>«Escanear QR de mi Computadora»</strong> (o usa el botón de cámara).</li>
                  <li>Apunta tu cámara a este código QR. <strong>¡Se conectará al instante!</strong></li>
                </ol>
              </div>

              <!-- BOTONES AUXILIARES -->
              <div class="qr-action-row">
                <button type="button" class="btn-brutalist btn-secondary btn-small" id="btn-copy-token">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="btn-copy-token-text">Copiar Token Directo</span>
                </button>
                <button type="button" class="btn-brutalist btn-secondary btn-small" id="btn-clear-session">
                  <span>Limpiar</span>
                </button>
              </div>
            </div>
          </div>

          <!-- TARJETA DE SEGURIDAD PRIVACIDAD (ZERO-BACKEND) -->
          <div class="security-card">
            <div class="sec-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div class="sec-text">
              <strong>100% Seguro & Zero-Backend:</strong> El código QR se genera localmente en tu navegador. Tu token jamás toca ningún servidor externo ni intermediario.
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import QRCode from 'qrcode';

  // Configuración de campus institucionales de la ESPE
  const CAMPUS_DATA = {
    presencial: { name: 'Presencial', host: 'micampus.espe.edu.ec' },
    enlinea: { name: 'En Línea', host: 'micampusvirtual.espe.edu.ec' },
    postgrado: { name: 'Postgrado', host: 'micampus2.espe.edu.ec' },
    nivelacion: { name: 'Nivelación', host: 'micampus1.espe.edu.ec' },
  };

  let activeCampusId = 'presencial';
  let activeToken = '';

  const campusTabs = document.querySelectorAll('.btn-campus-tab');
  const btnOpenMoodleSso = document.getElementById('btn-open-moodle-sso');
  const btnOpenText = document.getElementById('btn-open-text');
  const tokenInput = document.getElementById('token-input');
  const btnPaste = document.getElementById('btn-paste');
  const validationMsg = document.getElementById('validation-msg');
  const qrIdle = document.getElementById('qr-idle');
  const qrActive = document.getElementById('qr-active');
  const qrCanvas = document.getElementById('qr-canvas');
  const qrCampusLabel = document.getElementById('qr-campus-label');
  const qrTokenMasked = document.getElementById('qr-token-masked');
  const btnCopyToken = document.getElementById('btn-copy-token');
  const btnCopyTokenText = document.getElementById('btn-copy-token-text');
  const btnClearSession = document.getElementById('btn-clear-session');

  function updateMoodleLaunchUrl() {
    const campus = CAMPUS_DATA[activeCampusId] || CAMPUS_DATA.presencial;
    const url = 'https://' + campus.host + '/admin/tool/mobile/launch.php?service=moodle_mobile_app&passport=1&urlscheme=moodlemobile';
    if (btnOpenMoodleSso) {
      btnOpenMoodleSso.href = url;
    }
    if (btnOpenText) {
      btnOpenText.textContent = '1. Abrir Sesión en Moodle ' + campus.name + ' ↗';
    }
    if (activeToken) {
      generateQr(activeToken);
    }
  }

  // Selección de campus
  campusTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      campusTabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      activeCampusId = tab.dataset.campusId || 'presencial';
      updateMoodleLaunchUrl();
    });
  });

  // Extractor de token compatible con MoodleLaunchUrlParser de Pilas!
  function extractMoodleToken(rawInput) {
    if (!rawInput) return null;
    const trimmed = rawInput.trim();

    // 1. Si es un token directo de 32 hex
    if (/^[a-fA-F0-9]{32}$/.test(trimmed)) {
      return trimmed;
    }

    // 2. Si pegó una URL web completa (https://...)
    if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
      return { isWebUrl: true, url: trimmed };
    }

    // 3. Si contiene token=<base64>
    const match = trimmed.match(/token=([^&#\s]+)/i);
    let base64Payload = null;
    if (match) {
      base64Payload = match[1];
    } else if (trimmed.startsWith('moodlemobile://')) {
      base64Payload = trimmed.replace(/^moodlemobile:\/\//i, '').replace(/^[?&]/, '');
    } else {
      // Probar si el string completo es base64
      base64Payload = trimmed;
    }

    if (base64Payload) {
      try {
        let normalized = decodeURIComponent(base64Payload).trim();
        while (normalized.length % 4 !== 0) {
          normalized += '=';
        }
        const decoded = atob(normalized);
        const parts = decoded.split(':::');
        if (parts.length >= 2) {
          const candidate = parts[1].trim();
          if (/^[a-fA-F0-9]{32}$/.test(candidate)) {
            return candidate;
          }
        }
      } catch (_) {}
    }

    return null;
  }

  async function generateQr(token) {
    if (!token || !qrCanvas) return;
    try {
      const payload = 'pilas://moodle-auth?token=' + encodeURIComponent(token) + '&campus=' + encodeURIComponent(activeCampusId);
      await QRCode.toCanvas(qrCanvas, payload, {
        width: 280,
        margin: 2,
        color: {
          dark: '#101319',
          light: '#ffffff',
        },
        errorCorrectionLevel: 'M',
      });

      if (qrCampusLabel) {
        qrCampusLabel.textContent = CAMPUS_DATA[activeCampusId]?.name || 'Presencial';
      }
      if (qrTokenMasked) {
        qrTokenMasked.textContent = token.substring(0, 4) + '••••••••••••••••' + token.substring(28);
      }

      if (qrIdle) qrIdle.style.display = 'none';
      if (qrActive) qrActive.style.display = 'block';
    } catch (err) {
      console.error('Error al generar código QR:', err);
    }
  }

  function handleInputChanged() {
    if (!tokenInput) return;
    const val = tokenInput.value.trim();
    if (!val) {
      activeToken = '';
      if (validationMsg) validationMsg.style.display = 'none';
      if (qrIdle) qrIdle.style.display = 'block';
      if (qrActive) qrActive.style.display = 'none';
      return;
    }

    const res = extractMoodleToken(val);

    if (res && typeof res === 'object' && res.isWebUrl) {
      activeToken = '';
      if (validationMsg) {
        validationMsg.className = 'validation-message error';
        validationMsg.innerHTML = '⚠️ <strong>Has pegado la dirección de la página web (' + (res.url.length > 35 ? res.url.substring(0, 35) + '...' : res.url) + ').</strong><br>En la pantalla de Moodle, haz clic derecho sobre el texto <em>«Haga clic aquí si la aplicación no se abre automáticamente»</em> y selecciona <strong>«Copiar dirección del enlace»</strong>.';
        validationMsg.style.display = 'block';
      }
      if (qrIdle) qrIdle.style.display = 'block';
      if (qrActive) qrActive.style.display = 'none';
      return;
    }

    if (res && typeof res === 'string') {
      activeToken = res;
      if (validationMsg) {
        validationMsg.className = 'validation-message success';
        validationMsg.innerHTML = '✅ <strong>¡Enlace de sesión válido detectado!</strong> Código QR listo para escanear en tu iPhone.';
        validationMsg.style.display = 'block';
      }
      generateQr(res);
      return;
    }

    // No se pudo extraer
    activeToken = '';
    if (validationMsg) {
      validationMsg.className = 'validation-message error';
      validationMsg.innerHTML = '⚠️ No se reconoció un enlace de sesión ni token válido.<br>Asegúrate de copiar el enlace de la pantalla de Moodle (comienza con <code>moodlemobile://token=...</code>).';
      validationMsg.style.display = 'block';
    }
    if (qrIdle) qrIdle.style.display = 'block';
    if (qrActive) qrActive.style.display = 'none';
  }

  if (tokenInput) {
    tokenInput.addEventListener('input', handleInputChanged);
    tokenInput.addEventListener('paste', () => {
      setTimeout(handleInputChanged, 50);
    });
  }

  if (btnPaste && tokenInput) {
    btnPaste.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          tokenInput.value = text.trim();
          handleInputChanged();
        }
      } catch (err) {
        tokenInput.focus();
      }
    });
  }

  if (btnCopyToken && btnCopyTokenText) {
    btnCopyToken.addEventListener('click', async () => {
      if (!activeToken) return;
      try {
        await navigator.clipboard.writeText(activeToken);
        const prev = btnCopyTokenText.textContent;
        btnCopyTokenText.textContent = '¡Copiado!';
        setTimeout(() => {
          btnCopyTokenText.textContent = prev;
        }, 2000);
      } catch (err) {
        console.error('Error al copiar token:', err);
      }
    });
  }

  if (btnClearSession) {
    btnClearSession.addEventListener('click', () => {
      if (tokenInput) tokenInput.value = '';
      activeToken = '';
      if (validationMsg) validationMsg.style.display = 'none';
      if (qrIdle) qrIdle.style.display = 'block';
      if (qrActive) qrActive.style.display = 'none';
    });
  }
</script>

<style>
  .conectar-main {
    min-height: 85vh;
    padding: 3rem 0 5rem;
    background: var(--color-bg-base);
  }

  .conectar-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }

  .conectar-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(255, 63, 164, 0.12);
    border: 1.5px solid var(--color-primary);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-primary);
  }

  .conectar-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--color-text-title);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .text-fuchsia {
    color: var(--color-primary);
  }

  .conectar-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 auto;
  }

  /* BARRA SELECTOR DE CAMPUS */
  .campus-selector-section {
    max-width: 960px;
    margin: 0 auto 2rem;
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-brutalist);
  }

  .campus-bar-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-text-title);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .campus-tabs-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.65rem;
  }

  .btn-campus-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.75rem 1rem;
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: left;
  }

  .btn-campus-tab:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .btn-campus-tab.active {
    background: rgba(255, 63, 164, 0.15);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-brutalist-sm);
  }

  .campus-tab-name {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-text-title);
  }

  .btn-campus-tab.active .campus-tab-name {
    color: var(--color-primary);
  }

  .campus-tab-host {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-family: monospace;
    margin-top: 0.2rem;
  }

  /* GRID PRINCIPAL */
  .conectar-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 2rem;
    max-width: 1040px;
    margin: 0 auto;
    align-items: start;
  }

  .steps-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* TARJETAS DE PASOS */
  .step-card {
    background: var(--color-bg-surface);
    border: 2px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow-brutalist);
  }


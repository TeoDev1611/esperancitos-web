---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import { SITE } from '../config/site';

const lastUpdate = '2 de octubre de 2026';
const contactEmail = SITE.social.email;

const V = {
  version: SITE.version,
  apk: SITE.primaryApkPath,
};
const M = {
  guard: '/logos/mascota_policia.svg',
};
const IG = 'https://www.instagram.com/pilas_ec.app/';
const WA = 'https://whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g';
---
<!doctype html>
<html lang="es-EC" data-mode="espe">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Política de Privacidad | Pilas! para Android</title>
<meta name="description" content="Política de privacidad de Pilas!: arquitectura Zero-Backend, cifrado AES de 256 bits en Android Keystore y cero servidores intermedios.">
<meta name="theme-color" content="#101319">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<script is:inline>
try {
  var m = localStorage.pilasMode;
  if (m === 'multi' || m === 'espe') document.documentElement.dataset.mode = m;
} catch (e) {}
</script>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"/></symbol>
</svg>

<header class="top">
  <div class="wrap">
    <a class="nav-brand-logo-pill" href="/" aria-label="Pilas!, volver al inicio">
      <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="nav-brand-logo" width="128" height="42" />
    </a>
    <a class="btn btn-s btn-sm" href="/"><svg class="ico"><use href="#i-back"/></svg>Volver<span class="hide-xs"> al inicio</span></a>
    <a class="btn btn-p btn-sm" href={V.apk}><svg class="ico"><use href="#i-down"/></svg><span class="hide-xs">Descargar </span>APK</a>
  </div>
</header>

<main class="page-body">
  <div class="wrap">
    <div class="priv-hero">
      <div>
        <span class="badge b-info"><svg class="ico"><use href="#i-shield"/></svg>Zero-Backend · Privacidad Radical</span>
        <h1>Política de Privacidad</h1>
        <p class="lead">Pilas! no tiene servidores que guarden tus datos. Tu sesión, tus materias y tus notas viven únicamente en tu celular.</p>
        <p class="fine" style="margin-top:8px">Última actualización: {lastUpdate}</p>
      </div>
      <img class="guard-hero" src={M.guard} alt="Pilo con gorra y lentes oscuros, vigilando la privacidad" width="160" height="160">
    </div>

    <div class="priv-sections">
      <!-- 1. En una frase -->
      <section class="card">
        <h2>En una frase: Arquitectura Zero-Backend real</h2>
        <p style="margin-top:10px">La <strong>aplicación móvil Pilas!</strong> se comunica directa y exclusivamente entre tu dispositivo y los portales institucionales oficiales de tu universidad (Banner y Moodle). Pilas! <strong>no cuenta con servidores intermedios</strong> que intercepten, guarden ni procesen tus contraseñas, notas, cédula ni horarios.</p>
      </section>

      <!-- 2. Aviso Legal e Independencia -->
      <section class="card">
        <h2>Aviso legal e independencia institucional</h2>
        <p style="margin-top:10px">Pilas! es un proyecto estudiantil independiente de código privado y propietario, desarrollado de forma gratuita por y para estudiantes. <strong>Pilas! no está afiliada, asociada, patrocinada, respaldada ni conectada oficialmente con la Universidad de las Fuerzas Armadas ESPE, ninguna otra universidad del país, Ellucian Company L.P. (Banner), ni Moodle Pty Ltd.</strong></p>
        <p style="margin-top:10px">Los nombres, siglas, marcas y logotipos de universidades (ESPE, UCE, EPN, PUCE, ESPOL, UNACH, UTA u otras) pertenecen con exclusividad a sus respectivos titulares y se mencionan únicamente con fines de compatibilidad técnica, contextualización académica e identificación de facultades por parte de la comunidad estudiantil.</p>
      </section>

      <!-- 3. Tabla: Qué datos pasan por dónde -->
      <section class="card">
        <h2>¿Qué datos pasan por dónde?</h2>
        <p style="margin-top:8px;color:var(--muted)">Transparencia total sobre los 5 canales y superficies que componen el ecosistema de Pilas!:</p>
        
        <div class="priv-table-wrap" style="margin-top:16px">
          <table class="priv-table">
            <thead>
              <tr>
                <th>Superficie / Canal</th>
                <th>Datos involucrados</th>
                <th>Destino y almacenamiento</th>
                <th>¿Pasan por servidores de Pilas!?</th>
                <th>Retención y eliminación</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>(a) App Móvil (Android)</strong></td>
                <td>Token QR de Moodle (wstoken), cookies de Banner, horario, materias, aulas, notas y firmas visuales.</td>
                <td>Almacenamiento privado local de tu celular (SQLite Drift + Android Keystore con AES-256). Conexión directa HTTPS a tu universidad.</td>
                <td><span class="badge b-ok">NO</span> Cero intermediación. Jamás tocan servidores nuestros.</td>
                <td>Permanecen en el teléfono hasta cerrar sesión desde la app o desinstalarla.</td>
              </tr>
              <tr>
                <td><strong>(b) Este Sitio Web (pilas-ec.vercel.app)</strong></td>
                <td>Preferencias de visualización local (modo ESPE / Multi-U, modo retro, vista de intro).</td>
                <td>Tu navegador web local (<code>localStorage</code>) y CDN estático de Vercel (archivos HTML/CSS/JS).</td>
                <td><span class="badge b-ok">NO</span> No hay base de datos de usuarios ni cuentas web.</td>
                <td>Hasta que limpies el historial/almacenamiento local de tu navegador.</td>
              </tr>
              <tr>
                <td><strong>(c) Tablón de avisos y API comunitaria (/api/v1/)</strong></td>
                <td>Avisos comunitarios, enlaces académicos públicos y directorio de comercios aprobados.</td>
                <td>Archivos JSON estáticos públicos servidos en red de distribución de contenido (CDN). Solo lectura.</td>
                <td>Son datos públicos del proyecto; la app los consulta en modo solo lectura sin enviar datos personales.</td>
                <td>Permanente mientras el aviso o negocio figure en el repositorio público.</td>
              </tr>
              <tr>
                <td><strong>(d) Formulario de postulación de negocios</strong></td>
                <td>Nombre de contacto/propietario, nombre comercial, categoría, dirección/zona, teléfono/WhatsApp y redes sociales.</td>
                <td>Buzón de correo electrónico y repositorio administrativo para revisión comunitaria.</td>
                <td><span class="badge b-warn">SÍ</span> Se reciben para evaluar y publicar el local en el directorio gratuito.</td>
                <td>Conservados mientras el local desee figurar. Se eliminan o rectifican en &lt;48h enviando un correo a <code>teo.hurtado.16@gmail.com</code>.</td>
              </tr>
              <tr>
                <td><strong>(e) Medición y analítica de descargas</strong></td>
                <td>Eventos numéricos anónimos agregados (visita a la web, clic de descarga de APK por arquitectura). Cero cookies.</td>
                <td>Capa de analítica ligera y respetuosa con la privacidad sin almacenar direcciones IP ni huella digital.</td>
                <td>Solo métricas agregadas globales (conteos numéricos de clics).</td>
                <td>Cifras estadísticas agregadas sin identificación de usuarios.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 4. Sección: Tus credenciales institucionales -->
      <section class="card">
        <h2>Tus credenciales institucionales: Seguridad y verificación</h2>
        <dl class="rules one" style="margin-top:16px">
          <div>
            <dt>¿Qué se guarda en tu teléfono?</dt>
            <dd>Solo el token de sesión de Moodle Mobile (<code>wstoken</code>) generado al escanear el código QR institucional y las cookies de sesión temporal de Banner/miESPE si consultas notas u horarios. La contraseña nunca se almacena en texto plano.</dd>
          </div>
          <div>
            <dt>¿Dónde y cómo se protegen?</dt>
            <dd>Credenciales cifradas con <strong>AES-256 mediante Android Keystore</strong> en el enclave seguro de hardware del dispositivo. La base de datos de horarios y notas vive en SQLite privado dentro del sandbox aislado del sistema operativo Android.</dd>
          </div>
          <div>
            <dt>¿Cómo borrar tus datos definitivamente?</dt>
            <dd>Dentro de la app, ve a <strong>Ajustes ➔ Cerrar sesión</strong>: esto vacía de forma atómica la base de datos local SQLite, destruye las llaves del Keystore y cancela alarmas. También puedes desinstalar la app desde los Ajustes de Android para eliminar cualquier residuo.</dd>
          </div>
          <div>
            <dt>¿Cómo verificar técnicamente que no hay servidores ocultos?</dt>
            <dd>Cualquier estudiante o desarrollador puede conectar su celular a un proxy de depuración de red (como <em>HTTP Toolkit</em> o <em>mitmproxy</em> en Android) y auditar el tráfico: comprobarás que el 100% de las solicitudes con tus datos académicos viajan únicamente hacia <code>*.espe.edu.ec</code> o tu servidor Moodle institucional directo.</dd>
          </div>
          <div>
            <dt>Transparencia y código fuente</dt>
            <dd>
              Actualmente el código de la app móvil es propietario y privado para salvaguardar la estabilidad de los conectores contra bloqueos institucionales. 
              <!-- TODO(owner): Indicar si se publicarán conectores o se habilitará un programa de auditoría independiente de código para estudiantes. -->
              <em>(Nota de transparencia: el equipo mantiene los conectores protegidos; TODO(owner): evaluar proceso de auditoría externa).</em>
            </dd>
          </div>
        </dl>
      </section>

      <!-- 5. Permisos del dispositivo -->
      <section class="card">
        <h2>Permisos del dispositivo</h2>
        <dl class="rules one" style="margin-top:16px">
          <div>
            <dt>Cámara</dt>
            <dd>Únicamente activa durante los segundos que escaneas el QR de Moodle o el QR de un compañero. No graba, no toma fotos ni transmite datos.</dd>
          </div>
          <div>
            <dt>Notificaciones y alarmas exactas</dt>
            <dd>Para alertarte antes del inicio de tus clases y recordarte tareas próximas a vencer. Puedes desactivarlas en cualquier momento desde los ajustes.</dd>
          </div>
        </dl>
        <p class="fine" style="margin-top:20px">Para consultas sobre tratamiento de datos, bajas de negocios o soporte: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>
      </section>
    </div>
  </div>
</main>

<footer class="hub-footer">
  <div class="wrap footer-wrap">
    <div class="footer-brand-row">
      <a class="footer-brand-logo-pill" href="/" aria-label="Pilas!, volver arriba">
        <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="footer-lettering-img" width="132" height="42" />
      </a>
      <div class="footer-pill-edition">
        <span class="sticker-pill" data-for="espe">⚡ COMUNIDAD UNIVERSITARIA ESPE</span>
        <span class="sticker-pill coral" data-for="multi">⭐ RED MULTI-UNIVERSIDAD ECUADOR</span>
      </div>
    </div>
    <nav aria-label="Enlaces del sitio" class="footer-nav">
      <a href="/faq">Preguntas frecuentes</a>
      <a href="/avisos">Avisos</a>
      <a href="/negocios">Negocios</a>
      <a href="/privacidad">Privacidad</a>
      <a href={IG} target="_blank" rel="noopener noreferrer">Instagram (@pilas_ec.app)</a>
      <a href={WA} target="_blank" rel="noopener noreferrer">Canal de WhatsApp</a>
    </nav>
    <div class="footer-legal">
      <p>Pilas! es un proyecto estudiantil independiente. No está respaldado ni afiliado oficialmente a la Universidad de las Fuerzas Armadas ESPE, Ellucian, Banner ni Moodle. Las credenciales y datos viven únicamente en tu teléfono.</p>
      <p>Los nombres, siglas y logotipos de universidades pertenecen con exclusividad a sus respectivos titulares y se usan únicamente para fines de contextualización estudiantil y compatibilidad técnica.</p>
      <p class="footer-copy">© 2026 Pilas! · Hecho con orgullo estudiantil para el Ecuador.</p>
    </div>
  </div>
</footer>

<style is:global>
:root{
  color-scheme:dark;
  --primary:#ff3fa4;--primary-hover:#e5147d;--primary-extrude:#7a0a45;--primary-shadow:#4a0026;--primary-coral:#ff3d5e;
  --success:#00ff87;--success-shadow:#059669;--warning:#ffdb60;--critical:#ef4444;--info:#38bdf8;
  --bg-base:#101319;--bg-subtle:#191d28;--bg-surface:#161a23;--bg-elevated:#1e2230;--bg-container:#242938;
  --border:#2a3142;--border-control:#6b7894;--title:#faf7f7;--body:#e1e2eb;--muted:#8f9cae;
  --f-d:"Outfit Variable",system-ui,sans-serif;--f-b:"Inter Variable",system-ui,sans-serif;
  --accent:var(--primary);--bg:var(--bg-base);
}
html[data-mode=multi]{--accent:var(--primary-coral);--bg:var(--bg-subtle)}
html{scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background-color:var(--bg);color:var(--body);font:400 1.0625rem/1.6 var(--f-b);padding-bottom:env(safe-area-inset-bottom,0px)}
html[data-mode=espe] body{background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px}
html[data-mode=multi] body{background-image:radial-gradient(rgba(255,255,255,.09) 1.5px,transparent 1.5px);background-size:22px 22px}
h1,h2,h3{font-family:var(--f-d);font-weight:800;color:var(--title);line-height:1.1;letter-spacing:-.02em;margin:0}
p{margin:0}a{color:var(--info)}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding-inline:clamp(16px,4vw,32px)}
.num{font-variant-numeric:tabular-nums}
.ico{width:1.1em;height:1.1em;fill:none;stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border:2px solid;border-radius:12px;font:800 1rem var(--f-d);text-decoration:none;cursor:pointer;transition:transform 100ms,box-shadow 100ms,background 150ms}
.btn:active{transform:translate(2px,2px);box-shadow:none!important}
.btn-p{background:var(--primary);color:#000;border-color:#000;box-shadow:3px 3px 0 #000}
.btn-p:hover,.btn-p:active{background:var(--primary-hover)}
.btn-s{background:var(--bg-elevated);color:var(--title);border:2px solid var(--border-control);box-shadow:3px 3px 0 #000}
.btn-sm{padding:0 16px;font-size:.95rem}
.card{background:var(--bg-surface);border:2px solid var(--border);border-radius:14px;box-shadow:2px 2px 0 var(--border);padding:24px}
.badge{display:inline-flex;align-items:center;gap:6px;border:1.5px solid currentColor;border-radius:999px;padding:4px 12px 4px 8px;background:var(--bg-base);font:600 .875rem/1.3 var(--f-b)}
.b-info{color:var(--info)}

/* top con logo pill y glow */
.top{position:sticky;top:0;z-index:20;background:rgba(16,19,25,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:2px solid #000;padding:10px 0}
.top .wrap{display:flex;align-items:center;gap:12px;min-height:50px}

.nav-brand-logo-pill,
.footer-brand-logo-pill {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:transparent!important;
  border:none!important;
  box-shadow:none!important;
  text-decoration:none;
  margin-right:auto;
}

.nav-brand-logo,
.footer-lettering-img {
  display:block;
  height:36px;
  width:auto;
  filter:drop-shadow(0 0 10px rgba(255,63,164,0.9))
         drop-shadow(0 0 22px rgba(255,20,117,0.7))
         drop-shadow(2px 3px 0 #000000)!important;
  transition:filter 220ms ease, transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  animation:logoPinkGlowPulse 4s ease-in-out infinite;
}
.nav-brand-logo:hover,
.footer-lettering-img:hover {
  filter:drop-shadow(0 0 14px rgba(255,63,164,1))
         drop-shadow(0 0 30px rgba(255,20,117,0.95))
         drop-shadow(2px 3px 0 #000000)!important;
  transform:translateY(-2px) scale(1.03);
}

@keyframes logoPinkGlowPulse {
  0%, 100% {
    filter: drop-shadow(0 0 8px rgba(255, 63, 164, 0.9))
            drop-shadow(0 0 20px rgba(255, 20, 117, 0.7))
            drop-shadow(2px 3px 0 #000000);
  }
  50% {
    filter: drop-shadow(0 0 13px rgba(255, 63, 164, 1))
            drop-shadow(0 0 28px rgba(255, 20, 117, 0.88))
            drop-shadow(2px 3px 0 #000000);
  }
}

.sticker-pill {
  display: inline-block;
  padding: 4px 12px;
  border: 1.5px solid #000;
  border-radius: 9999px;
  background: var(--primary);
  color: #000;
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  box-shadow: 2px 2px 0 #000;
}
.sticker-pill.coral { background: var(--primary-coral); }

/* Footer Neo-Brutalista Oficial */
.hub-footer {
  padding: 48px 0 56px;
  border-top: 2px solid #000;
  background: #090b10;
}
.footer-wrap {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.footer-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.footer-pill-edition {
  display: flex;
  gap: 8px;
}
.footer-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 14px 24px;
}
.footer-nav a {
  color: var(--body);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;
  transition: color 150ms;
}
.footer-nav a:hover {
  color: var(--primary);
}
.footer-legal {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.82rem;
  color: var(--muted);
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  padding-top: 16px;
}
.footer-copy {
  color: var(--title);
  font-weight: 700;
}

/* priv hero */
.page-body{padding:clamp(36px,6vw,72px) 0 clamp(48px,7vw,96px)}
.priv-hero{display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap}
.priv-hero>div{max-width:38em;display:grid;gap:12px}
.priv-hero h1{font-size:clamp(2.2rem,5vw,3.6rem);margin-top:6px}
.lead{font-size:1.15rem;color:var(--body)}
.fine{color:var(--muted);font-size:.95rem}
.guard-hero{width:160px;height:160px;object-fit:contain}

/* sections */
.priv-sections{display:grid;gap:20px;margin-top:36px}
.priv-sections h2{font-size:1.5rem}

.priv-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 2px solid #000;
  box-shadow: 4px 4px 0 #000;
  background: var(--bg-surface);
}
.priv-table {
  width: 100%;
  min-width: 680px;
  border-collapse: collapse;
  font-size: 0.92rem;
  text-align: left;
}
.priv-table th, .priv-table td {
  padding: 12px 14px;
  border: 1px solid var(--border);
  vertical-align: top;
  line-height: 1.5;
}
.priv-table th {
  background: var(--bg-elevated);
  color: var(--title);
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.88rem;
}
.priv-table tbody tr:hover {
  background: rgba(255, 63, 164, 0.04);
}

.rules{display:grid;gap:0}
.rules.one>div{padding:14px 0;border-top:1px solid var(--border)}
.rules.one>div:first-of-type{border-top:none;padding-top:0}
.rules dt{font:800 1.1rem var(--f-d);color:var(--title)}
.rules dd{margin:4px 0 0;color:var(--body);line-height:1.6}

footer{padding:40px 0 56px;border-top:2px solid #000;background:var(--bg);font-size:.95rem}
footer .wrap{display:grid;gap:16px}footer nav{display:flex;flex-wrap:wrap;gap:0 22px}footer nav a{display:inline-flex;align-items:center;min-height:48px}footer p{color:var(--muted);max-width:60em}

@media(max-width:540px){
  .hide-xs{display:none!important}
  .top .wrap{gap:8px}
  .nav-brand-logo{height:28px}
  .priv-hero{flex-direction:column;align-items:flex-start;gap:16px}
  .guard-hero{width:110px;height:110px}
}
</style>
</body>
</html>

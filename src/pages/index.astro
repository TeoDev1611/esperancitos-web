---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PainPointsSection from '../components/PainPointsSection.astro';
import Features from '../components/Features.astro';
import AppScreensShowcase from '../components/AppScreensShowcase.astro';
import ZeroBackendSection from '../components/ZeroBackendSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import CollaborationSection from '../components/CollaborationSection.astro';
import SupportSection from '../components/SupportSection.astro';
import DocsSection from '../components/DocsSection.astro';
import { SITE } from '../config/site';
import { SHOW_DONATIONS } from '../config/donation';
---

<Layout
  title={`Pilas! ${SITE.versionTag} • Todo tu semestre bajo control. Rápido, privado y sin internet.`}
  description="La aplicación académica definitiva para estudiantes de la Universidad de las Fuerzas Armadas ESPE. Horario de clases de Banner, tareas y chat de Moodle con alarmas, calculadora de parciales ESPE, malla curricular interactiva, carnet digital y widgets de pantalla de inicio: tus credenciales nunca salen de tu teléfono. Disponible 100% gratis para todos los estudiantes."
  keywords="Pilas!, app Pilas, ponte pilas, pilas ñañ@s, pilas ñaño, pilas ñaña, mijin, app ESPE gratis, malla curricular sin internet, horario con aulas ESPE, carnet digital garita ESPE, widgets horario Android, tareas Moodle con alarmas"
>
  <!-- 1. Hero Principal con Mascota Variación 1 y Mockup Cinético -->
  <Hero />

  <!-- 2. Sección de Dolores: ¿Cansado de MiESPE caído? (Mascota Variación 2) -->
  <PainPointsSection />

  <!-- 3. Todas las Funciones Detalladas & Simulador de Promedios (Mascota Variación 3) -->
  <Features />

  <!-- 4. Vistas de la App & Capturas de Pantalla -->
  <AppScreensShowcase />

  <!-- 5. Seguridad & Privacidad Radical: Arquitectura Zero-Backend -->
  <ZeroBackendSection />

  <!-- 6. Centro Oficial de Descargas (APK Android Directo) -->
  <DownloadSection />

  <!-- 7. Tablón de avisos: colaboradores para versión de iPhone -->
  <CollaborationSection />

  <!-- 10. Apoyo para publicar en Google Play (Oculto si las donaciones salen luego) -->
  {SHOW_DONATIONS && <SupportSection />}

  <!-- 11. Documentación, Guías de Login & FAQ -->
  <DocsSection />
</Layout>

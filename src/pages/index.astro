/* Diapositiva 3: Caos y Dolor */
.sl-pain-wrap { display: flex; flex-direction: column; gap: 10px; width: 100%; flex: 1; justify-content: center; }
.sl-alert-banner { display: flex; align-items: center; gap: 12px; padding: 8px 14px; border: 2px solid var(--critical); border-radius: 10px; background: rgba(239, 68, 68, 0.12); color: #ff8585; font-size: 0.92rem; font-weight: 700; }
.pulse-dot-red { width: 10px; height: 10px; border-radius: 50%; background: var(--critical); box-shadow: 0 0 10px var(--critical); animation: pulseDot 1s infinite alternate; flex-shrink: 0; }
@keyframes pulseDot { from { opacity: 0.4; } to { opacity: 1; } }

.sl-chaos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
.chaos-card {
  background: #171a25;
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  padding: 9px 13px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.chaos-card.crit { border-color: var(--critical); background: rgba(239, 68, 68, 0.08); }
.chaos-icon { font-size: 1.35rem; line-height: 1; flex-shrink: 0; }
.chaos-info b { display: block; font-size: 0.92rem; color: var(--title); font-family: var(--f-d); }
.chaos-info p { color: var(--muted); font-size: 0.82rem; line-height: 1.3; margin-top: 3px; }

/* Diapositiva 4: Solución de Horario / Moodle */
.sl-solution-full {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
  justify-content: center;
}
.sl-trans-hero {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #171a25;
  border: 2px solid var(--border-control);
  border-radius: 14px;
  padding: 12px 16px;
  box-shadow: 3px 3px 0 #000;
}
.sl-solution-full.espe .sl-trans-hero { border-color: var(--primary); box-shadow: 3px 3px 0 var(--primary-shadow); }
.sl-solution-full.multi .sl-trans-hero { border-color: var(--primary-coral); box-shadow: 3px 3px 0 #4a0010; }
.sl-trans-from, .sl-trans-to { flex: 1; }
.sl-trans-lbl {
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.78rem;
  color: var(--muted);
  display: block;
  margin-bottom: 3px;
  letter-spacing: 0.04em;
}
.sl-code-box {
  font-family: monospace;
  font-size: 1rem;
  background: #0f121a;
  padding: 6px 12px;
  border-radius: 8px;
  border: 1px dashed var(--border-control);
  color: var(--title);
}
.sl-trans-arrow {
  font-size: 1.4rem;
  color: var(--muted);
  flex-shrink: 0;
}
.sl-room-badge {
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 1rem;
  background: rgba(255, 63, 164, 0.15);
  border: 1.5px solid var(--primary);
  color: #ffffff;
  padding: 6px 12px;
  border-radius: 8px;
}
.sl-room-badge.coral {
  background: rgba(255, 61, 94, 0.15);
  border-color: var(--primary-coral);
}
.sl-offline-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.sl-offline-card {
  background: #171a25;
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  padding: 10px 14px;
}
.sl-offline-card b {
  display: block;
  font-family: var(--f-d);
  font-size: 0.92rem;
  color: var(--title);
}
.sl-offline-card p {
  font-size: 0.82rem;
  color: var(--muted);
  margin-top: 3px;
  line-height: 1.3;
}

/* Diapositiva 5: Control Académico */
.sl-malla-kpis { display: flex; gap: 10px; }
.sl-kpi { flex: 1; background: #171a25; border: 1.5px solid var(--border-control); border-radius: 12px; padding: 10px 14px; }
.sl-kpi-lbl { font-family: var(--f-d); font-weight: 700; font-size: 0.76rem; color: var(--muted); display: block; }
.sl-kpi-val { font-family: var(--f-d); font-weight: 800; font-size: 1.25rem; color: var(--title); display: flex; align-items: baseline; gap: 8px; }
.sl-bar { height: 8px; border-radius: 999px; background: #000; margin-top: 4px; overflow: hidden; border: 1px solid var(--border); }
.sl-bar-fill { height: 100%; background: var(--primary); border-radius: 999px; }
.sl-chain-flow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.88rem; background: #11131b; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border); }
.chain-node { padding: 3px 8px; border-radius: 6px; font-weight: 700; }
.chain-node.ok { background: rgba(0, 255, 135, 0.15); color: var(--success); }
.chain-node.warn { background: rgba(255, 219, 96, 0.15); color: var(--warning); }
.chain-node.lock { background: rgba(255, 255, 255, 0.1); color: var(--muted); }
.chain-arrow { color: var(--muted); }
.sl-common-free { font-size: 0.88rem; color: var(--title); background: rgba(56, 189, 248, 0.12); border: 1px solid var(--info); border-radius: 10px; padding: 8px 12px; }

/* Diapositiva 6: Pase Garita / Carnet y 13 Herramientas */
.sl-tools-grid-6 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  width: 100%;
}
.sl-pass-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #171a25;
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  padding: 8px 14px;
}
.sl-pass-hero.espe { border-color: var(--primary); }
.sl-pass-hero.multi { border-color: var(--primary-coral); }
.sl-pass-info b { font-family: var(--f-d); font-size: 0.92rem; color: var(--title); display: block; }
.sl-pass-info p { font-size: 0.78rem; color: var(--muted); margin: 0; }
.sl-pass-badge { font-family: monospace; font-size: 0.92rem; padding: 4px 10px; background: #000; border-radius: 6px; letter-spacing: 0.08em; color: var(--success); }
.tool-card {
  background: #171a25;
  border: 1.5px solid var(--border-control);
  border-radius: 10px;
  padding: 7px 10px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  box-shadow: 2px 2px 0 #000;
  text-align: left;
}
.tool-ico { font-size: 1.2rem; }
.tool-card b { font-family: var(--f-d); font-size: 0.84rem; color: var(--title); }
.tool-card small { font-size: 0.72rem; color: var(--muted); line-height: 1.25; }
.sl-cta-box {
  display: flex;
  justify-content: center;
  margin-top: 4px;
}

/* ============================================================== */
/* 2. ESTILOS DEL HUB ESTUDIANTIL (LINKTREE BRUTALISTA)          */
/* ============================================================== */
.top {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(16, 19, 25, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 2px solid #000;
  padding-top: env(safe-area-inset-top, 0px);
}
html[data-mode="multi"] .top {
  background: rgba(25, 29, 40, 0.94);
}
.top-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 64px;
}
.nav-brand {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}
.nav-brand-logo {
  height: 38px;
  width: auto;
  object-fit: contain;
}
.nav-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: var(--bg-surface);
  border: 1.5px solid var(--border-control);
  border-radius: 9999px;
  font: 800 0.8rem var(--f-d);
  letter-spacing: 0.02em;
  color: var(--title);
  box-shadow: 2px 2px 0 #000;
}
.live-pulse {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 8px var(--success);
  display: inline-block;
  flex-shrink: 0;
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hub-main {
  padding: 36px 0 80px;
}
.hub-wrap {
  display: flex;
  flex-direction: column;
  gap: 48px;
}

/* Hub Hero */
.hub-hero {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(24px, 4vw, 56px);
  align-items: center;
}
.hero-brand-marquee {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}
.hero-brand-top {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.hero-lettering-img {
  height: clamp(54px, 5.8vw, 70px);
  width: auto;
  object-fit: contain;
}
.hero-meta-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.hub-title {
  font-size: clamp(1.85rem, 4.5vw, 3.4rem);
  line-height: 1.1;
  letter-spacing: -0.03em;
  margin: 10px 0 16px;
  overflow-wrap: break-word;
  word-break: break-word;
}
.hub-desc {
  font-size: 1.08rem;
  color: var(--body);
  max-width: 36em;
  line-height: 1.5;
  margin-bottom: 20px;
}

/* Tarjeta de Diálogo de Pilas */
.hero-dialogue-card {
  display: flex;
  align-items: center;
  gap: 14px;
  background: var(--bg-surface);
  border: 2px solid var(--border-control);
  border-radius: 14px;
  padding: 12px 16px;
  box-shadow: 3px 3px 0 #000;
  margin-bottom: 24px;
  position: relative;
}
.dialogue-mascot-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  background: #0b0e14;
  padding: 6px;
  border-radius: 10px;
  border: 1.5px solid var(--border);
}
.dialogue-mascot-img {
  width: 52px;
  height: 52px;
  object-fit: contain;
}
.dialogue-mascot-name {
  font-size: 0.68rem;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: 0.08em;
}
html[data-mode="multi"] .dialogue-mascot-name {
  color: var(--primary-coral);
}
.dialogue-bubble {
  flex: 1;
  min-width: 0;
}
.dialogue-quote {
  display: block;
  font-family: var(--f-d);
  font-size: 0.94rem;
  color: var(--title);
  line-height: 1.35;
  font-weight: 700;
}
.dialogue-sub {
  display: block;
  font-size: 0.76rem;
  color: var(--muted);
  margin-top: 4px;
}

/* Selector de Modo */
.mode-switch-wrapper {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.mode-switch-legend {
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.08em;
  font-weight: 700;
}
.mode-switch-group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  max-width: 520px;
}
.mode-switch-group button {
  text-align: left;
  min-height: 64px;
  padding: 10px 14px;
  border: 2px solid var(--border-control);
  border-radius: 12px;
  background: var(--bg-elevated);
  color: var(--title);
  font: inherit;
  cursor: pointer;
  transition: transform 100ms, box-shadow 100ms, border-color 150ms;
  box-shadow: 2px 2px 0 #000;
}
.mode-btn-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.mode-icon {
  font-size: 1.15rem;
  line-height: 1;
}
.mode-btn-row b {
  font: 800 1.05rem var(--f-d);
  color: inherit;
}
.mode-switch-group small {
  display: block;
  color: var(--muted);
  line-height: 1.3;
  margin-top: 3px;
  font-size: 0.8rem;
}
.mode-switch-group button:hover {
  border-color: var(--accent);
}
.mode-switch-group button[aria-pressed="true"] {
  background: var(--accent);
  color: #000;
  border-color: #000;
  box-shadow: 4px 4px 0 #000;
}
.mode-switch-group button[aria-pressed="true"] b {
  color: #000;
}
.mode-switch-group button[aria-pressed="true"] small {
  color: #000;
  font-weight: 600;
}
.mode-switch-group button:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}

/* Carnet 3D */
.pass-container {
  display: flex;
  justify-content: center;
}
.pass {
  perspective: 1200px;
  width: min(100%, 370px);
  aspect-ratio: 3 / 4.4;
  cursor: pointer;
  touch-action: pan-y;
}
.pass-in {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}
html[data-mode="multi"] .pass-in {
  transform: rotateY(180deg);
}
.face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
  border: 2px solid #000;
  border-radius: 16px;
  box-shadow: 6px 6px 0 #000;
  overflow: hidden;
  background: var(--bg-surface);
  display: flex;
  flex-direction: column;
}
.face.back {
  transform: rotateY(180deg) translate3d(0, 0, 0);
  -webkit-transform: rotateY(180deg) translate3d(0, 0, 0);
}
.pass-hdr-espe {
  background: var(--primary);
  color: #000;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font: 800 1.05rem var(--f-d);
  border-bottom: 2px solid #000;
}
.pass-hdr-multi {
  background: var(--primary-coral);
  color: #000;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font: 800 1.05rem var(--f-d);
  border-bottom: 2px solid #000;
}
.crest-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
}
.crest-stars {
  font-size: 0.75rem;
  letter-spacing: 2px;
}
.crest-sub {
  font: 800 0.68rem var(--f-d);
  letter-spacing: 0.06em;
}
.pass-title {
  font-weight: 800;
}
.fb {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}
.pass-student-row {
  display: flex;
  gap: 12px;
  align-items: center;
}
.pass-avatar-wrap {
  width: 66px;
  height: 66px;
  border-radius: 10px;
  background: #0b0e14;
  border: 2px solid var(--primary);
  padding: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  box-shadow: 2px 2px 0 #000;
}
.pass-avatar-wrap.back-wrap {
  border-color: var(--primary-coral);
}
.pass-avatar-img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}
.pass-avatar-tag {
  position: absolute;
  bottom: -6px;
  background: var(--primary);
  color: #000;
  font: 800 0.55rem var(--f-d);
  padding: 1px 4px;
  border-radius: 4px;
  letter-spacing: 0.05em;
}
.pass-avatar-tag.back-tag {
  background: var(--primary-coral);
}
.pass-student-info {
  flex: 1;
  min-width: 0;
}
.pass-student-info h2 {
  font-size: 1.05rem;
  line-height: 1.15;
}
.campus-sub {
  font: 800 0.68rem var(--f-d);
  color: var(--muted);
  letter-spacing: 0.05em;
  display: block;
  margin-top: 2px;
}
.pass-badge-active {
  display: inline-block;
  font: 800 0.65rem var(--f-d);
  color: var(--primary);
  background: rgba(255, 63, 164, 0.14);
  padding: 2px 6px;
  border-radius: 4px;
  margin-top: 4px;
  border: 1px solid var(--primary);
}
.pass-badge-active.back-active {
  color: var(--primary-coral);
  background: rgba(255, 61, 94, 0.14);
  border-color: var(--primary-coral);
}
.pass-data-grid {
  margin: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 10px;
  background: #11141c;
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
}
.pass-data-grid dt {
  color: var(--muted);
  font-size: 0.76rem;
}
.pass-data-grid dd {
  margin: 0;
  color: var(--title);
  font-weight: 700;
  font-size: 0.85rem;
  line-height: 1.2;
}

/* Holograma */
.hologram-strip {
  display: flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(90deg, #131a26, #1c2638, #131a26);
  border: 1.5px solid #36445c;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 0.68rem;
  color: #93c5fd;
  box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.08);
}
.hologram-strip.back-holo {
  border-color: #55333f;
  color: #fda4af;
}
.holo-symbol {
  font-size: 0.85rem;
  line-height: 1;
}
.barcode-box {
  background: #000;
  border: 1.5px solid var(--border-control);
  border-radius: 8px;
  padding: 6px 8px;
  text-align: center;
}
.barcode-lines {
  height: 24px;
  background: repeating-linear-gradient(90deg, #fff, #fff 2px, #000 2px, #000 5px, #fff 5px, #fff 8px, #000 8px, #000 10px, #fff 10px, #fff 14px);
}
.barcode-num {
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.1em;
  display: block;
  margin-top: 3px;
}
.qr-pass-box {
  background: #11141c;
  border: 1.5px solid var(--border-control);
  border-radius: 8px;
  padding: 8px;
  text-align: center;
}
.qr-pill-tag {
  font: 800 0.72rem var(--f-d);
  color: var(--primary-coral);
  display: block;
}
.qr-sub {
  font-size: 0.72rem;
  color: var(--muted);
}
.pass-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

/* Sección Modo */
.hub-campus-features {
  padding: 8px 0;
}
.campus-sec-header {
  margin-bottom: 20px;
}
.campus-sec-sub {
  color: var(--muted);
  font-size: 1rem;
  margin-top: 6px;
  max-width: 48em;
}
.rules-neo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.rule-card {
  background: var(--bg-surface);
  border: 2px solid var(--border-control);
  border-radius: 14px;
  padding: 18px 16px;
  box-shadow: 3px 3px 0 #000;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: transform 100ms, border-color 150ms, box-shadow 100ms;
}
.rule-card:hover {
  transform: translateY(-2px);
  border-color: var(--primary);
  box-shadow: 5px 5px 0 #000;
}
.rule-card.coral:hover {
  border-color: var(--primary-coral);
}
.rule-badge-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: var(--bg-elevated);
  border: 1.5px solid var(--primary);
  color: var(--primary);
  font-size: 0.95rem;
  font-weight: 800;
}
.rule-card.coral .rule-badge-num {
  border-color: var(--primary-coral);
  color: var(--primary-coral);
}
.rule-body h3 {
  font-size: 1.05rem;
  margin-bottom: 6px;
  color: var(--title);
}
.rule-body p {
  font-size: 0.88rem;
  color: var(--body);
  line-height: 1.4;
  margin: 0;
}

/* Sección Seguridad Zero-Backend */
.hub-security-showcase {
  background: var(--bg-elevated);
  border: 2px solid var(--border);
  border-radius: 16px;
  padding: clamp(20px, 3.5vw, 36px);
  box-shadow: 4px 4px 0 #000;
}
.security-layout {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: clamp(16px, 3.5vw, 36px);
  align-items: center;
}
.security-avatar-frame {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  background: #0a0d14;
  border: 2px solid var(--border-control);
  border-radius: 16px;
  padding: 14px 10px;
  text-align: center;
  box-shadow: 3px 3px 0 #000;
}
.security-mascot-img {
  width: 96px;
  height: 96px;
  object-fit: contain;
}
.security-badge-tag {
  font-size: 0.65rem;
  font-weight: 800;
  color: var(--warning);
  letter-spacing: 0.06em;
}
.security-title {
  font-size: clamp(1.4rem, 2.6vw, 2rem);
  margin: 6px 0 8px;
}
.security-lead {
  color: var(--body);
  font-size: 1.02rem;
  margin-bottom: 18px;
}
.security-guarantees-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.guarantee-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: var(--bg-surface);
  border: 1.5px solid var(--border-control);
  border-radius: 10px;
  padding: 10px 12px;
}
.guarantee-icon {
  font-size: 1.3rem;
  line-height: 1.2;
  flex-shrink: 0;
}
.guarantee-info b {
  display: block;
  font-family: var(--f-d);
  font-size: 0.92rem;
  color: var(--title);
}
.guarantee-info p {
  font-size: 0.82rem;
  color: var(--muted);
  line-height: 1.3;
  margin-top: 2px;
}

/* Tarjeta de Descarga */
.hub-download-card {
  background: var(--bg-elevated);
  border: 2px solid var(--border);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding: clamp(20px, 3.5vw, 36px);
  box-shadow: 4px 4px 0 #000;
}
.dl-header-row {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 24px;
  align-items: center;
}
.dl-info-col {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.dl-title {
  font-size: clamp(1.7rem, 3.2vw, 2.5rem);
  margin: 6px 0;
}
.dl-subtitle {
  color: var(--body);
  font-size: 1.05rem;
  line-height: 1.45;
}
.dl-cta-row {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 10px;
}
.dl-badge-col {
  display: flex;
  justify-content: center;
  align-items: center;
}
.dl-mascot-stamp {
  display: flex;
  align-items: center;
  gap: 14px;
  background: var(--bg-surface);
  border: 2px dashed var(--success);
  border-radius: 14px;
  padding: 14px 18px;
  box-shadow: 3px 3px 0 #000;
}
.dl-mascot-img {
  width: 74px;
  height: 74px;
  object-fit: contain;
}
.dl-stamp-text b {
  display: block;
  font-size: 0.88rem;
  color: var(--success);
}
.dl-stamp-text small {
  color: var(--muted);
  font-size: 0.78rem;
}
.pack-badge-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.hub-steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}
.step-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: var(--bg-surface);
  padding: 12px 16px;
  border-radius: 12px;
  border: 1.5px solid var(--border-control);
}
.step-num {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--primary);
  color: #000;
  font: 800 1rem var(--f-d);
  flex-shrink: 0;
}
html[data-mode="multi"] .step-num {
  background: var(--primary-coral);
}
.step-text b {
  display: block;
  color: var(--title);
  font-size: 0.95rem;
}
.step-text small {
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.25;
  margin-top: 2px;
  display: block;
}

details.more-downloads {
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  background: var(--bg-surface);
  padding: 6px 16px;
}
details summary {
  font: 800 0.95rem var(--f-d);
  color: var(--title);
  cursor: pointer;
  min-height: 44px;
  display: flex;
  align-items: center;
  list-style: none;
}
details summary::-webkit-details-marker { display: none; }
details summary::after { content: "+"; margin-left: auto; font-size: 1.3rem; color: var(--muted); }
details[open] summary::after { content: "−"; }
details[open] { padding-bottom: 16px; }
.dl-alt-list { display: grid; gap: 12px; margin-top: 10px; font-size: 0.9rem; }
.dl-alt-list > div { display: grid; gap: 4px; padding: 8px 0; border-top: 1px solid var(--border); }
.dl-alt-list > div:first-of-type { border-top: none; }
.dl-alt-list a { font-weight: 700; }
.dl-alt-list small { color: var(--muted); font-size: 0.8rem; word-break: break-all; }

/* Deslinde de Carnet Independiente */
.pass-disclaimer {
  margin-top: 14px;
  text-align: center;
  font-size: 0.8rem;
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* Verificación Criptográfica de APK */
.apk-verify-box {
  background: var(--bg-surface);
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  padding: 18px 20px;
  margin-top: 20px;
}
.terminal-snippets-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 12px;
  margin-top: 12px;
}
.terminal-snippet {
  background: #090b10;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  box-shadow: 2px 2px 0 #000;
}
.terminal-os {
  font-size: 0.78rem;
  font-weight: 800;
  color: var(--title);
  letter-spacing: 0.03em;
}
.terminal-snippet code {
  font-family: monospace;
  font-size: 0.82rem;
  color: #00ff87;
  word-break: break-all;
  user-select: all;
  background: transparent;
  padding: 0;
}

/* Linktree de Enlaces */
.hub-links-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.hub-section-title {
  font-size: clamp(1.5rem, 3vw, 2rem);
}
.linktree-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.link-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  background: var(--bg-surface);
  border: 2px solid var(--border);
  border-radius: 16px;
  text-decoration: none;
  box-shadow: 3px 3px 0 #000;
  transition: transform 100ms, border-color 150ms, box-shadow 100ms;
}
.link-card:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
  box-shadow: 5px 5px 0 #000;
}
.link-card:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}
.link-icon {
  font-size: 2rem;
  flex-shrink: 0;
}
.link-content {
  flex: 1;
  min-width: 0;
}
.link-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
}
.link-head-row b {
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 1.1rem;
  color: var(--title);
}
.link-content p {
  color: var(--muted);
  font-size: 0.88rem;
  line-height: 1.35;
}
.link-arrow {
  color: var(--muted);
  width: 1.2em;
  height: 1.2em;
  flex-shrink: 0;
  transition: transform 150ms;
}
.link-card:hover .link-arrow {
  color: var(--primary);
  transform: translateX(3px);
}

/* Demos Interactivas */
.hub-demos-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.demo-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.demo-card-hdr {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.demo-card h3 {
  font-size: 1.35rem;
}
.fine {
  color: var(--muted);
  font-size: 0.88rem;
}
.mockup-calc {
  background: #11141e;
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 6px;
}
.calc-sliders-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.slider-box {
  background: #191d29;
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid var(--border);
}
.slider-lbl {
  display: flex;
  justify-content: space-between;
  font: 800 0.8rem var(--f-d);
  margin-bottom: 4px;
}
.range-input {
  width: 100%;
  accent-color: var(--primary);
  cursor: pointer;
  height: 6px;
}
.calc-result-banner {
  background: rgba(255, 219, 96, 0.12);
  border: 1px solid var(--warning);
  padding: 8px 12px;
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.95rem;
}
.calc-target { font-size: 1.2rem; font-weight: 800; }

.gauge-card {
  background: #11141e;
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 6px;
}
.gauge-hdr { display: flex; justify-content: space-between; align-items: center; }
.gauge {
  position: relative;
  height: 16px;
  border: 2px solid var(--border-control);
  border-radius: 9999px;
  background: var(--bg-base);
  overflow: hidden;
}
.gauge i { display: block; height: 100%; width: 100%; background: var(--critical); }
.lim { position: absolute; top: -2px; bottom: -2px; left: 16.67%; width: 3px; background: #fff; }

.calc-mascot-reaction,
.gauge-mascot-reaction {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--bg-surface);
  border: 1.5px solid var(--border-control);
  border-radius: 12px;
  padding: 10px 14px;
  margin-top: 10px;
}
.calc-mascot-img,
.gauge-mascot-img {
  width: 48px;
  height: 48px;
  object-fit: contain;
  flex-shrink: 0;
  filter: drop-shadow(2px 2px 0 #000);
}
.calc-mascot-balloon,
.gauge-mascot-balloon {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.calc-mascot-status,
.gauge-mascot-status {
  font-family: var(--f-d);
  font-size: 0.92rem;
  font-weight: 800;
  color: var(--title);
}
.calc-mascot-quote,
.gauge-mascot-quote {
  font-size: 0.84rem;
  color: var(--muted);
  line-height: 1.3;
}

/* Footer */
.hub-footer {
  padding: 48px 0 60px;
  border-top: 2px solid #000;
  background: var(--bg);
  font-size: 0.95rem;
}
.footer-wrap {
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.footer-brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.footer-logo {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}
.footer-lettering-img {
  height: 38px;
  width: auto;
  object-fit: contain;
}
.footer-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 24px;
}
.footer-nav a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  color: var(--title);
  font-weight: 700;
  text-decoration: none;
}
.footer-nav a:hover {
  color: var(--primary);
  text-decoration: underline;
}
.footer-legal {
  display: flex;
  flex-direction: column;
  gap: 8px;
  border-top: 1px solid var(--border);
  padding-top: 18px;
}
.footer-legal p {
  color: var(--muted);
  max-width: 65em;
  font-size: 0.86rem;
  line-height: 1.45;
  margin: 0;
}
.footer-copy {
  font-weight: 700;
  color: var(--title);
}

/* Responsive */
@media (max-width: 860px) {
  .intro-theater-wrap {
    width: 100%;
    margin: 0 auto;
    padding-bottom: 24px;
  }
  .sl-intro-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .sl-intro-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .hub-hero {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .dl-header-row,
  .hub-steps-grid,
  .linktree-grid,
  .hub-demos-grid,
  .rules-neo-grid,
  .security-layout,
  .security-guarantees-grid {
    grid-template-columns: 1fr;
  }
  .sl-dual-cards,
  .sl-diagram {
    grid-template-columns: 1fr;
  }
  .sl-tools-grid-6 {
    grid-template-columns: repeat(2, 1fr);
  }
  .hide-s { display: none !important; }
}

@media (max-width: 680px) {
  .mode-switch-group {
    grid-template-columns: 1fr;
  }
  .sl-pick-cards {
    grid-template-columns: 1fr;
  }
  .sl-trans-hero {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  .sl-trans-arrow {
    text-align: center;
    transform: rotate(90deg);
    margin: -2px 0;
  }
  .calc-sliders-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }
}

@media (max-width: 640px) {
  .nav-status-badge { display: none !important; }
  .top-wrap { gap: 8px; }
  .nav-brand-logo { height: 32px; }
  .nav-actions { gap: 6px; }
  .nav-dl-btn { padding: 0 14px; min-height: 40px; }
  .hub-title {
    font-size: clamp(1.75rem, 5.5vw, 2.4rem);
  }
  .screen {
    padding: 10px 12px;
  }
  .intro-bottom-bar {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  .bat-wrap {
    width: 100%;
    justify-content: space-between;
  }
  .intro-ctls-right {
    width: 100%;
    justify-content: space-between;
    margin-left: 0;
    flex-wrap: wrap;
    gap: 8px;
  }
  #ichoice {
    width: 100%;
    flex-direction: column;
    gap: 8px;
  }
  #ichoice button {
    width: 100%;
  }
  .gauge-hdr b {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 62%;
  }
}

@media (max-width: 540px) {
  .sl-intro-cards {
    grid-template-columns: 1fr;
  }
  .sl-chaos-grid {
    grid-template-columns: 1fr;
  }
  .sl-solution-tabs {
    grid-template-columns: 1fr;
  }
  .sl-tools-grid-6 {
    grid-template-columns: 1fr;
  }
  .hide-xs { display: none !important; }
  .intro-brand img { height: 26px; }
  .bat { width: 100px; }

  text-transform: uppercase;
}

/* Diapositiva 1: Portada rica */
.sl-intro-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(14px, 2.2vw, 24px);
  align-items: center;
  flex: 1;
}
.sl-intro-main {
  display: flex;
  flex-direction: column;
  gap: 8px;
  text-align: left;
}
.sl-intro-brand-row {

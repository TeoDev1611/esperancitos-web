<!-- ESTILOS GLOBALES: NEO-BRUTALISMO ALAJITA, OSCURO & RADIANTE    -->
<!-- ============================================================== -->
<style is:global>
:root {
  color-scheme: dark;
  --primary: #ff3fa4;
  --primary-hover: #e5147d;
  --primary-extrude: #7a0a45;
  --primary-shadow: #4a0026;
  --primary-coral: #ff3d5e;
  --success: #00ff87;
  --warning: #ffdb60;
  --critical: #ef4444;
  --info: #38bdf8;
  --bg-base: #101319;
  --bg-subtle: #191d28;
  --bg-surface: #161a23;
  --bg-elevated: #1e2230;
  --bg-container: #242938;
  --border: #2a3142;
  --border-control: #6b7894;
  --title: #faf7f7;
  --body: #e1e2eb;
  --muted: #8f9cae;
  --f-d: "Outfit Variable", system-ui, sans-serif;
  --f-b: "Inter Variable", system-ui, sans-serif;
  --accent: var(--primary);
  --bg: var(--bg-base);
}

html[data-mode="multi"] {
  --accent: var(--primary-coral);
  --bg: var(--bg-subtle);
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px;
}
*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background-color: var(--bg);
  color: var(--body);
  font: 400 1.0625rem/1.6 var(--f-b);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

html[data-mode="espe"] body {
  background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  background-size: 32px 32px;
}
html[data-mode="multi"] body {
  background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1.5px, transparent 1.5px);
  background-size: 22px 22px;
}

html[data-mode="espe"] [data-for="multi"],
html[data-mode="multi"] [data-for="espe"] {
  display: none !important;
}

h1, h2, h3 {
  font-family: var(--f-d);
  font-weight: 800;
  color: var(--title);
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin: 0;
}
p { margin: 0; }
a { color: var(--info); }

.wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding-inline: clamp(16px, 4vw, 32px);
}
.num { font-variant-numeric: tabular-nums; }
.font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

/* Screen Reader Oculto */
.sr {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* Iconos SVG */
.ico {
  width: 1.15em;
  height: 1.15em;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex-shrink: 0;
  display: inline-block;
  vertical-align: middle;
}

/* Botones Neo-Brutalistas */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 20px;
  border: 2px solid #000000;
  border-radius: 12px;
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.95rem;
  text-decoration: none;
  cursor: pointer;
  box-sizing: border-box;
  user-select: none;
  transition: transform 100ms, box-shadow 100ms, background 150ms;
}
.btn:active {
  transform: translate(2px, 2px);
  box-shadow: none !important;
}
.btn-p {
  background: var(--primary);
  color: #000000;
  border-color: #000000;
  box-shadow: 3px 3px 0 #000000;
}
.btn-p:hover { background: var(--primary-hover); }
.btn-coral {
  background: var(--primary-coral);
  color: #000000;
  border-color: #000000;
  box-shadow: 3px 3px 0 #000000;
}
.btn-coral:hover { background: #e02446; }
.btn-s {
  background: var(--bg-elevated);
  color: var(--title);
  border: 2px solid var(--border-control);
  box-shadow: 3px 3px 0 #000000;
}
.btn-s:hover {
  background: var(--bg-container);
  border-color: #ffffff;
}
.btn-sm {
  min-height: 38px;
  padding: 0 14px;
  font-size: 0.88rem;
}
.btn-lg {
  min-height: 52px;
  padding: 0 26px;
  font-size: 1.05rem;
}

/* Badges Neo-Brutalistas */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1.5px solid currentColor;
  border-radius: 9999px;
  padding: 4px 12px;
  background: #101319;
  font-family: var(--f-d);
  font-weight: 700;
  font-size: 0.82rem;
  line-height: 1.2;
}
.b-ok {
  color: var(--success);
  background: rgba(0, 255, 135, 0.1);
  border-color: rgba(0, 255, 135, 0.5);
}
.b-warn {
  color: var(--warning);
  background: rgba(255, 219, 96, 0.1);
  border-color: rgba(255, 219, 96, 0.5);
}
.b-crit {
  color: var(--critical);
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.5);
}
.b-info {
  color: var(--info);
  background: rgba(56, 189, 248, 0.1);
  border-color: rgba(56, 189, 248, 0.5);
}

.sticker-pill {
  display: inline-block;
  padding: 6px 14px;
  border: 2px solid #000000;
  border-radius: 9999px;
  background: var(--primary);
  color: #000000;
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.82rem;
  letter-spacing: 0.04em;
  box-shadow: 2px 2px 0 #000000;
  margin-bottom: 12px;
}
.sticker-pill.coral { background: var(--primary-coral); }
.sticker-pill.green { background: var(--success); }
.sticker-pill.cyan { background: var(--info); }

.card {
  background: var(--bg-surface);
  border: 2px solid var(--border);
  border-radius: 16px;
  box-shadow: 4px 4px 0 #000000;
  padding: 24px;
}

/* ============================================================== */
/* 1. ESTILOS DE LA EXPOSICIÓN VINTAGE                            */
/* ============================================================== */
#intro {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #090b11;
  color: var(--title);
  height: 100vh;

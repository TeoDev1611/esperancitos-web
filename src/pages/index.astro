  font-size: clamp(1.35rem, 2.4vw, 1.85rem);
  color: var(--title);
  margin: 0;
  font-weight: 800;
  line-height: 1.25;
}
.sl-pick-desc {
  font-size: clamp(0.92rem, 1.3vw, 1.05rem);
  color: var(--muted);
  margin: 0 0 2px;
  line-height: 1.35;
}
.sl-pick-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(10px, 1.6vw, 16px);
  width: 100%;
}
.sl-pick-card {
  background: #171a25;
  border: 2px solid var(--border-control);
  border-radius: 14px;
  padding: clamp(10px, 1.4vw, 14px) clamp(12px, 1.6vw, 16px);
  display: flex;
  flex-direction: column;
  gap: 6px;
  text-align: left;
  cursor: pointer;
  box-shadow: 4px 4px 0 #000;
  transition: transform 120ms, box-shadow 120ms, background 150ms;
  font-family: inherit;
  color: inherit;
}
.sl-pick-card:hover {
  transform: translateY(-2px);
  background: #1d2130;
}
.sl-pick-card.espe {
  border-color: var(--primary);
  box-shadow: 4px 4px 0 var(--primary-shadow);
}
.sl-pick-card.espe:hover {
  box-shadow: 6px 6px 0 var(--primary);
}
.sl-pick-card.multi {
  border-color: var(--primary-coral);
  box-shadow: 4px 4px 0 #4a0010;
}
.sl-pick-card.multi:hover {
  box-shadow: 6px 6px 0 var(--primary-coral);
}
.sl-pick-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sl-pick-badge {
  font-family: var(--f-d);
  font-weight: 800;
  font-size: 0.82rem;
  padding: 4px 10px;
  border-radius: 999px;
  color: #000;
  letter-spacing: 0.04em;
}
.sl-pick-badge.espe { background: var(--primary); }
.sl-pick-badge.multi { background: var(--primary-coral); }
.sl-pick-tag {
  font-size: 0.82rem;
  color: var(--muted);
  font-weight: 700;
}
.sl-pick-name {
  font-family: var(--f-d);
  font-size: clamp(1.15rem, 1.8vw, 1.38rem);
  font-weight: 800;
  color: var(--title);
  margin: 0;
  line-height: 1.25;
}
.sl-pick-campuses {
  font-size: clamp(0.82rem, 1.1vw, 0.92rem);
  color: var(--muted);
  margin: 0;
  line-height: 1.3;
}
.sl-pick-features {
  list-style: none;
  margin: 2px 0 0;
  padding: 0;
  font-size: clamp(0.84rem, 1.2vw, 0.95rem);
  display: grid;
  gap: 6px;
  color: var(--body);
  line-height: 1.35;
}
.sl-pick-features li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}


  position: relative;
  box-sizing: border-box;
  transition: background 250ms, border-color 250ms;
}

/* Modo Retro Auténtico: Pantalla de Proyección Vintage Blanco y Negro / Grises */
.retro-on .screen {
  border: 4px double #ffffff;
  background: radial-gradient(ellipse at 50% 35%, #181b22 0%, #0e1015 68%, #050608 100%);
  box-shadow: 0 0 55px rgba(255, 255, 255, 0.12), 6px 6px 0 #000;
  animation: projJitter 4.5s steps(60) infinite alternate;
}
@keyframes projJitter {
  0% { transform: translate(0, 0); }
  20% { transform: translate(0.3px, -0.3px); }
  40% { transform: translate(-0.3px, 0.2px); }
  60% { transform: translate(0.2px, 0.3px); }
  80% { transform: translate(-0.2px, -0.2px); }
  100% { transform: translate(0.1px, -0.1px); }
}


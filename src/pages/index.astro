/* ---------- simulador interactivo de notas ESPE (Hub) ---------- */
const p1Slider = $('#site-p1-slider');
const p2Slider = $('#site-p2-slider');
const p1Val = $('#site-p1-val');
const p2Val = $('#site-p2-val');
const p3Req = $('#site-p3-req');
const calcVerdict = $('#site-calc-verdict');

function updateSiteCalc() {
  if (!p1Slider || !p2Slider) return;
  const p1 = parseFloat(p1Slider.value);
  const p2 = parseFloat(p2Slider.value);
  p1Val.textContent = p1.toFixed(2) + ' / 20';
  p2Val.textContent = p2.toFixed(2) + ' / 20';

  const needed = Math.max(0, 42 - (p1 + p2));
  const simP3 = Math.min(20, needed);
  const total = p1 + p2 + simP3;

  p3Req.textContent = needed > 20 ? 'No alcanza (> 20 pts)' : needed.toFixed(2) + ' / 20';

  const mascotImg = $('#calc-mascot-img') as HTMLImageElement;
  const mascotStatus = $('#calc-mascot-status');
  const mascotQuote = $('#calc-mascot-quote');

  if (needed <= 12) {
    calcVerdict.className = 'badge b-ok';
    calcVerdict.textContent = `✓ APROBADO (${(total / 3).toFixed(2)})`;
    if (mascotImg) {
      mascotImg.src = M.success;
      mascotImg.alt = 'Pilo celebrando con el pulgar arriba que apruebas la materia con comodidad';
    }
    if (mascotStatus) mascotStatus.textContent = '¡Tranqui, vas sobrado!';
    if (mascotQuote) mascotQuote.textContent = `Con ${needed.toFixed(2)} pts en el Parcial 3 pasas directo el semestre.`;
    if (!reduce) {
      calcVerdict.animate([
        { transform: 'scale(1.12)' },
        { transform: 'scale(1)' }
      ], { duration: 250, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' });
    }
  } else if (needed <= 20) {
    calcVerdict.className = 'badge b-warn';
    calcVerdict.textContent = `⚠️ A SALVAR EL PARCIAL (${(total / 3).toFixed(2)})`;
    if (mascotImg) {
      mascotImg.src = M.scared;
      mascotImg.alt = 'Pilo asustado con gota de sudor, atento a la nota del parcial';
    }
    if (mascotStatus) mascotStatus.textContent = '¡Ponte pilas con el Parcial 3!';
    if (mascotQuote) mascotQuote.textContent = `Necesitas sacar mínimo ${needed.toFixed(2)} / 20 para evitar el supletorio.`;
  } else {
    calcVerdict.className = 'badge b-crit';
    calcVerdict.textContent = '⚠️ SUPLETORIO';
    if (mascotImg) {
      mascotImg.src = M.error;
      mascotImg.alt = 'Pilo con pulgar abajo porque la suma de parciales no alcanza los 42 puntos';
    }
    if (mascotStatus) mascotStatus.textContent = '¡Chuta! No alcanza a 42';
    if (mascotQuote) mascotQuote.textContent = 'La suma de los tres parciales no llega a 42. Toca preparar el supletorio.';
    if (!reduce) {
      calcVerdict.animate([
        { transform: 'translateX(-3px)' },
        { transform: 'translateX(3px)' },
        { transform: 'translateX(0)' }
      ], { duration: 180, iterations: 2 });
    }
  }
}
if (p1Slider && p2Slider) {
  p1Slider.addEventListener('input', updateSiteCalc);
  p2Slider.addEventListener('input', updateSiteCalc);
  updateSiteCalc();
}

/* ---------- compresor interactivo (Hub) ---------- */
const LIM = 5, MAX = 30;
const gb = $('#gb'), gf = $('#gfill'), gn = $('#gnow'), gbtn = $('#gbtn');
function gauge(mb: number) {
  if (!gf || !gn || !gb) return;
  gf.style.width = Math.max(2, (mb / MAX) * 100) + '%';
  gn.textContent = mb.toFixed(1) + ' MB';
  const isOver = mb > LIM;
  const k = isOver ? ['b-crit', 'Supera el límite de Moodle (5 MB)'] : ['b-ok', `Reducido a ${mb.toFixed(1)} MB · Listo para entregar`];
  gf.style.background = isOver ? 'var(--critical)' : 'var(--success)';
  gb.className = 'badge ' + k[0];
  gb.textContent = k[1];

  const gMascot = $('#gauge-mascot-img') as HTMLImageElement;
  const gStatus = $('#gauge-mascot-status');
  const gQuote = $('#gauge-mascot-quote');
  if (gMascot && gStatus && gQuote) {
    if (isOver) {
      gMascot.src = M.scared;
      gMascot.alt = 'Pilo preocupado porque el PDF excede el límite de subida de Moodle';
      gStatus.textContent = '¡Cuidado con la entrega!';
      gQuote.textContent = 'Moodle rebotará tu tarea si pesa más de 5 MB. Comprímelo en un toque.';
    } else {
      gMascot.src = M.success;
      gMascot.alt = 'Pilo feliz con pulgar arriba porque el PDF entra en el límite de Moodle';
      gStatus.textContent = '¡De una! Archivo listo';
      gQuote.textContent = `Comprimido a ${mb.toFixed(1)} MB sin perder nitidez legible.`;
    }
  }
}
let comp = false;
let gaugeAnimId = 0;
gauge(24.8);

function animateGauge(from: number, to: number, duration: number = 750) {
  if (gaugeAnimId) cancelAnimationFrame(gaugeAnimId);
  const t0 = performance.now();
  function step(now: number) {
    const p = Math.min(1, (now - t0) / duration);
    const ease = 1 - Math.pow(1 - p, 3);
    const cur = from + (to - from) * ease;
    gauge(cur);
    if (p < 1) {
      gaugeAnimId = requestAnimationFrame(step);
    }
  }
  gaugeAnimId = requestAnimationFrame(step);
}

if (gbtn) {
  gbtn.addEventListener('click', () => {
    const from = comp ? 2.1 : 24.8;
    const to = comp ? 24.8 : 2.1;
    comp = !comp;
    gbtn.textContent = comp ? 'Probar de nuevo' : 'Probar compresión';
    if (reduce) return gauge(to);
    animateGauge(from, to, 750);
  });
}
</script>

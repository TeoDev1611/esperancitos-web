---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PainPointsSection from '../components/PainPointsSection.astro';
import Features from '../components/Features.astro';
import AppScreensShowcase from '../components/AppScreensShowcase.astro';
import ZeroBackendSection from '../components/ZeroBackendSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import DeepLinksSection from '../components/DeepLinksSection.astro';
import FeedbackSection from '../components/FeedbackSection.astro';
import CollaborationSection from '../components/CollaborationSection.astro';
import SupportSection from '../components/SupportSection.astro';
import DocsSection from '../components/DocsSection.astro';
---

<Layout
  title="Pilas! • Tu vida universitaria al día. Sin rodeos."
  description="Cliente móvil y ecosistema estudiantil independiente para la comunidad de la ESPE. Horarios con aulas exactas, tareas de Moodle sincronizadas, simulación de notas y 100% offline."
  keywords="Pilas!, app Pilas, ponte pilas, pilas ñañ@s, pilas ñaño, pilas ñaña, mijin, app ESPE gratis, malla curricular sin internet, horario con aulas ESPE, entrar a Moodle con QR, calculadora de notas universitarias Ecuador"
>
  <!-- 1. Hero Principal con Mascota Variación 1 y Mockup Cinético -->
  <Hero />

  <!-- 2. Sección de Dolores: ¿Cansado de MiESPE caído? (Mascota Variación 2) -->
  <PainPointsSection />

  <!-- 3. Todas las Funciones Detalladas & Simulador de Promedios (Mascota Variación 3) -->
  <Features />

  <!-- 4. Vistas de la App & Capturas de Pantalla -->
  <AppScreensShowcase />

  <!-- 5. Seguridad & Privacidad Radical: Arquitectura Zero-Backend -->
  <ZeroBackendSection />

  <!-- 6. Centro Oficial de Descargas (APK Android Directo) -->
  <DownloadSection />

  <!-- 7. Integración con la App Móvil: Protocolo de Deep Links pilas:// -->
  <DeepLinksSection />

  <!-- 8. Reportes de errores, sugerencias de funciones & Contacto Directo -->
  <FeedbackSection />

  <!-- 9. Tablón de avisos: colaboradores para versión de iPhone -->
  <CollaborationSection />

  <!-- 10. Apoyo para publicar en Google Play (Deuna & QR) -->
  <SupportSection />

  <!-- 11. Documentación, Guías de Login & FAQ -->
  <DocsSection />
</Layout>

---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import '@fontsource/special-elite';

import {
  RELEASE,
  PRIMARY_ARCH,
  PRIMARY_APK_SIZE,
  ARCHITECTURES_LIST,
  DOWNLOAD_STATS,
  PLAY_STORE_BETA,
} from '../lib/release';
import { SITE } from '../config/site';

// Datos centrales del proyecto (única fuente de verdad)
const V = {
  version: RELEASE.version,
  build: RELEASE.build,
  apkVersion: RELEASE.apkVersion,
  size: PRIMARY_APK_SIZE,
  apk: PRIMARY_ARCH.url,
  note: RELEASE.versionDiscrepancyNote,
  downloads: DOWNLOAD_STATS,
};

// Rutas de mascotas oficiales
const M = {
  neutral: '/logos/mascota_neutro.svg',
  error: '/logos/mascota_negacion.svg',
  success: '/logos/mascota_aprobacion.svg',
  scared: '/logos/mascota_asustado.svg',
  sleeping: '/logos/mascota_dormido.svg',
  guard: '/logos/mascota_policia.svg',
};

// Enlaces oficiales
const PLAY = 'https://forms.gle/svzBYKL2ZhWrS7M78';
const IG = 'https://www.instagram.com/pilas_ec.app/';
const WA = 'https://whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g';
---
<!doctype html>
<html lang="es-EC" data-mode="espe" class="intro-on retro-on">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pilas! La app estudiantil para la ESPE y otras universidades del Ecuador</title>
<meta name="description" content="Horario con aulas exactas, Moodle por QR, carnet digital y 13 herramientas offline. Gratis, sin anuncios y sin servidores intermedios.">
<meta name="theme-color" content="#101319">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<script is:inline>
try {
  var p = new URLSearchParams(location.search);
  var modeParam = p.get('mode');
  var m = (modeParam === 'espe' || modeParam === 'multi') ? modeParam : localStorage.pilasMode;
  if (m === 'multi' || m === 'espe') document.documentElement.dataset.mode = m;
  if (modeParam) localStorage.pilasMode = m;

  var hasSeenIntro = false;
  try {
    hasSeenIntro = localStorage.getItem('pilasIntroSeen') === '1';
  } catch (e) {}

  var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  var isSlowConn = conn && (conn.saveData || conn.effectiveType === '2g' || conn.effectiveType === '3g' || conn.effectiveType === 'slow-2g');
  var prefersReduced = false;
  try {
    prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  } catch (e) {}

  if (hasSeenIntro || p.get('skip') === '1' || prefersReduced || isSlowConn) {
    document.documentElement.classList.remove('intro-on');
  }
  if (localStorage.pilasRetro === '0') {
    document.documentElement.classList.remove('retro-on');
  }
} catch (e) {}
</script>
<noscript><style>#intro{display:none!important}.intro-on body{overflow:auto!important}</style></noscript>
</head>
<body>

<!-- ============================================================== -->
<!-- SÍMBOLOS SVG COMUNES                                           -->
<!-- ============================================================== -->
<svg width="0" height="0" style="position:absolute;display:none" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12l4 4 10-10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3l10 18H2z" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12 10v5M12 18v.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></symbol>
  <symbol id="i-off" viewBox="0 0 24 24"><path d="M3 3l18 18M5 12a10 10 0 014-2M2 8.8a15 15 0 014-2.8M8.5 16a5 5 0 014-1.5M12 20v.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 5 5-5M4 21h16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12 11v5M12 8v.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
  <symbol id="i-play" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<!-- ============================================================== -->
<!-- 1. LA EXPOSICIÓN VINTAGE: TODA LA INFO EN EL PROYECTOR         -->
<!-- ============================================================== -->
<div id="intro" role="dialog" aria-modal="true" aria-label="Presentación de Pilas!" data-m={JSON.stringify(M)} data-v={JSON.stringify(V)}>
  <div class="beam" aria-hidden="true"></div>
  <div class="film" aria-hidden="true">
    <i class="scr" style="left:23%"></i>
    <i class="scr" style="left:71%;animation-delay:-1.1s"></i>
  </div>

  <div class="intro-theater-wrap">
    <!-- Barra Superior -->
    <header class="intro-top-bar">
      <div class="intro-brand">
        <div class="intro-brand-logo-pill" title="Pilas! App Estudiantil">
          <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="intro-logo-img" width="130" height="44" />
        </div>
        <span class="badge b-info hide-xs">
          <svg class="ico"><use href="#i-info"/></svg>
          v{V.version} · Build {V.build}
        </span>
      </div>
      <div class="intro-actions">
        <a class="btn btn-p btn-sm" id="idl" href={V.apk}>
          <svg class="ico"><use href="#i-down"/></svg><span class="hide-xs">Descargar </span>APK
        </a>
        <button class="btn btn-s btn-sm" id="iskip" type="button">
          Saltar<span class="hide-xs"> al Hub</span> ➔
        </button>
      </div>
    </header>

    <!-- Pantalla de Proyección Widescreen 16:9 Centrada -->
    <main class="intro-canvas-wrap">
      <div class="screen" id="sl" aria-live="off"></div>
      <div class="sr" id="sr" aria-live="polite"></div>
    </main>

    <!-- Escenario: Mascota Animada + Diálogo / Subtítulo Retro -->
    <section class="intro-stage" aria-label="Comentarios del presentador">
      <div class="mascot-frame">
        <img id="mas" class="mas" src={M.scared} alt="Pilo, mascota de Pilas!" width="110" height="110" />
        <span class="mascot-nameplate">PILO</span>
      </div>
      <div class="speech-container" aria-live="off">
        <div class="sub" id="sub" aria-hidden="true">
          <div class="sub-top-line">
            <span class="sub-speaker-tag">🎙️ PRESENTADOR EN VIVO</span>
            <small id="cue" class="sub-cue"></small>
          </div>
          <span class="sub-text-line" id="subt"></span>
        </div>
        <p class="bubble" id="say" aria-hidden="true"></p>
      </div>
    </section>

    <!-- Barra de Controles Inferior -->
    <footer class="intro-bottom-bar">
      <div class="bat-wrap" aria-label="Progreso de la exposición">
        <span class="bat-label hide-xs">DIAPOSITIVA</span>
        <div class="bat" aria-hidden="true"><div class="bat-body" id="imeter"></div></div>
        <span class="cnt num" id="icount">1 de 6</span>
      </div>
      <div class="intro-ctls-right">
        <button class="btn btn-s btn-sm" id="icc" type="button" aria-pressed="true" title="Cambiar modo retro">
          <span id="icc-ico">🎞️</span> <span id="icc-txt">Modo retro: Activo</span>
        </button>
        <button class="btn btn-p btn-sm" id="inext" type="button">Siguiente ➔</button>
        <div id="ichoice" class="intro-choice-group" hidden>
          <button class="btn btn-ghost btn-sm" id="iswitch" type="button" title="Cambiar universidad"></button>
          <button class="btn btn-p btn-sm" id="ifinish" type="button">⚡ Entrar a Pilas ESPE ➔</button>
        </div>
      </div>
    </footer>
  </div>
</div>

<!-- ============================================================== -->
<!-- 2. EL HUB ESTUDIANTIL (LINKTREE BRUTALISTA)                    -->
<!-- ============================================================== -->
<div id="site">
  <header class="top">
    <div class="wrap top-wrap">
      <a class="nav-brand nav-brand-logo-pill" href="#" aria-label="Pilas!, volver al inicio">
        <img src="/logos/letras_estilo_transparente.svg" alt="Pilas!" class="nav-brand-logo" width="128" height="42" />
      </a>
      <div class="nav-status-badge">
        <span class="live-pulse"></span>
        <span class="nav-mode-txt" data-for="espe">ESPE Sangolquí</span>
        <span class="nav-mode-txt" data-for="multi">Multi-Universidad</span>
      </div>
      <div class="nav-actions">
        <button class="btn btn-s btn-sm" id="replay" type="button" title="Ver exposición de Pilas">
          <svg class="ico"><use href="#i-play"/></svg>
          <span class="hide-s">Ver exposición</span>
        </button>
        <a class="btn btn-p btn-sm nav-dl-btn" href="#descargar">
          <svg class="ico"><use href="#i-down"/></svg>
          <span>Descargar</span>
        </a>
      </div>
    </div>
  </header>

  <main class="hub-main">
    <div class="wrap hub-wrap">
      
      <!-- HERO HUB: IDENTIDAD DE MARCA, MENSAJE DE PILAS & CARNET 3D -->
      <section class="hub-hero">
        <div class="hub-hero-header">
          <!-- Marquee / Brand Lockup con Logo de Letras Oficial -->
          <div class="hero-brand-marquee">
            <div class="hero-brand-top">
              <div class="hero-brand-logo-pill" title="Pilas! Software Estudiantil">
                <img src="/logos/letras_estilo_transparente.svg" alt="Pilas! Software Estudiantil" class="hero-lettering-img" width="220" height="74" />
              </div>
              <div class="hero-meta-badges">
                <span class="sticker-pill" data-for="espe">⚡ EDICIÓN ESPE</span>
                <span class="sticker-pill coral" data-for="multi">⭐ EDICIÓN MULTI-UNIVERSIDAD</span>
                <span class="badge b-ok num">v{V.version}</span>
              </div>
            </div>
          </div>

          <h1 class="hub-title">
            <span data-for="espe">Tu semestre bajo control, aunque MiESPE esté caído</span>
            <span data-for="multi">Tu Moodle y tus notas, desde cualquier campus del país</span>
          </h1>

          <p class="hub-desc">
            <span data-for="espe">Aulas decodificadas a pisos reales, 23 mallas con prerrequisitos interactivos, simulador de 42 puntos y carnet garita. 100% offline y en tu bolsillo.</span>
            <span data-for="multi">Vinculación por QR de Moodle Mobile en 1 segundo, notas en cualquier escala (10, 20 o 100) y carnet estudiantil universal. Sin intermediarios.</span>
          </p>

          <!-- Tarjeta de Diálogo de Pilo (Voz y Personalidad de la Mascota) -->
          <div class="hero-dialogue-card">
            <div class="dialogue-mascot-box">
              <img src={M.neutral} alt="Pilo, mascota de Pilas!" class="dialogue-mascot-img" width="56" height="56" />
              <span class="dialogue-mascot-name font-mono">PILO</span>
            </div>
            <div class="dialogue-bubble">
              <b class="dialogue-quote" data-for="espe">“¡Qué fue! Ya no le ruegues a MiESPE a las 11:59 ni te pierdas buscando el bloque G. Aquí tienes tus herramientas listas.”</b>
              <b class="dialogue-quote" data-for="multi">“¡Pilas con ese semestre! Escanea el QR de tu Moodle en la compu y olvídate de claves. Tus notas y carnet van directo a tu celular.”</b>
              <span class="dialogue-sub fine">Software estudiantil independiente · Desarrollado en Ecuador</span>
            </div>
          </div>

          <!-- Selector de Modo Neo-Brutalista -->
          <div class="mode-switch-wrapper">
            <span class="mode-switch-legend font-mono">SELECCIONA TU CAMPUS:</span>
            <div class="mode-switch-group" role="group" aria-label="Elige tu universidad">
              <button type="button" data-mode-btn="espe" aria-pressed="true">
                <div class="mode-btn-row">
                  <span class="mode-icon">⚡</span>
                  <b>Modo ESPE</b>
                </div>
                <small>Sangolquí, Latacunga y Santo Domingo</small>
              </button>
              <button type="button" data-mode-btn="multi" aria-pressed="false">
                <div class="mode-btn-row">
                  <span class="mode-icon">⭐</span>
                  <b>Multi-Universidad</b>
                </div>
                <small>UCE, EPN, PUCE, ESPOL, UNACH y más</small>
              </button>
            </div>
          </div>
        </div>

        <!-- Carnet 3D con Foto de Pilo, Holograma y Código de Barras -->
        <div class="pass-container">
          <div class="pass" id="hub-carnet" title="Toca para voltear">
            <div class="pass-in">
              <!-- Cara Frontal ESPE -->
              <div class="face front">
                <header class="pass-hdr-espe">
                  <div class="crest-row">
                    <span class="crest-stars">★ ★ ★</span>
                    <span class="crest-sub">ESPE DIGITAL</span>
                  </div>
                  <span class="pass-title">Pase Estudiantil</span>
                </header>
                <div class="fb">
                  <div class="pass-student-row">
                    <div class="pass-avatar-wrap">
                      <img src={M.neutral} alt="Pilo, estudiante de la ESPE" class="pass-avatar-img" width="68" height="68" />
                      <span class="pass-avatar-tag">PILAS!</span>
                    </div>
                    <div class="pass-student-info">
                      <h2>Universidad de las Fuerzas Armadas ESPE</h2>
                      <span class="campus-sub">SEDE MATRIZ SANGOLQUÍ · PREGRADO</span>
                      <span class="pass-badge-active">ESTUDIANTE REGULAR</span>
                    </div>
                  </div>

                  <dl class="pass-data-grid">
                    <div><dt>Aulas</dt><dd>Bloques A al H</dd></div>
                    <div><dt>Mallas</dt><dd class="num">23 carreras</dd></div>
                    <div><dt>Regla</dt><dd class="num">42 / 60 pts</dd></div>
                    <div><dt>Cifrado</dt><dd>AES-256 local</dd></div>
                  </dl>

                  <!-- Holograma de Seguridad -->
                  <div class="hologram-strip">
                    <span class="holo-symbol">⬡</span>
                    <span class="holo-text font-mono">CHIP GARITA · OFFLINE VERIFIED</span>
                  </div>

                  <div class="barcode-box">
                    <div class="barcode-lines"></div>
                    <span class="barcode-num font-mono">ID BANNER · L00412890</span>
                  </div>

                  <div class="pass-footer">
                    <span class="badge b-info"><svg class="ico"><use href="#i-off"/></svg>100% Offline</span>
                    <span class="badge b-ok">✓ Modo local</span>
                  </div>
                </div>
              </div>

              <!-- Cara Posterior Multi-U -->
              <div class="face back">
                <header class="pass-hdr-multi">
                  <div class="crest-row">
                    <span class="crest-stars">★ ★ ★</span>
                    <span class="crest-sub">RED ECUADOR</span>
                  </div>
                  <span class="pass-title">Pasaporte Estudiantil</span>
                </header>
                <div class="fb">
                  <div class="pass-student-row">
                    <div class="pass-avatar-wrap back-wrap">
                      <img src={M.success} alt="Pilas Pasaporte Multi-U" class="pass-avatar-img" width="68" height="68" />
                      <span class="pass-avatar-tag back-tag">UNIVERSAL</span>
                    </div>
                    <div class="pass-student-info">
                      <h2>Multi-Universidad Ecuador</h2>
                      <span class="campus-sub">CAMPUS NACIONAL MOODLE</span>
                      <span class="pass-badge-active back-active">CONECTADO</span>
                    </div>
                  </div>

                  <dl class="pass-data-grid">
                    <div><dt>Entrada</dt><dd>QR en 1 segundo</dd></div>
                    <div><dt>Moodle</dt><dd>Cualquier sede</dd></div>
                    <div><dt>Escala</dt><dd class="num">10, 20 o 100 pts</dd></div>
                    <div><dt>Carátulas</dt><dd>Con tu escudo</dd></div>
                  </dl>

                  <!-- Holograma Multi-U -->
                  <div class="hologram-strip back-holo">
                    <span class="holo-symbol">⬡</span>
                    <span class="holo-text font-mono">PROTOCOLO MOODLE MOBILE DIRECTO</span>
                  </div>

                  <div class="qr-pass-box">
                    <span class="qr-pill-tag">ACCESO ESTUDIANTIL UNIVERSAL</span>
                    <span class="qr-sub">Moodle Mobile Protocol · Cifrado AES-256</span>
                  </div>

                  <div class="pass-footer">
                    <span class="badge b-info"><svg class="ico"><use href="#i-off"/></svg>100% Offline</span>
                    <span class="badge b-ok">✓ Compatible</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="pass-disclaimer font-mono">
            <span class="badge b-info" style="font-size:0.75rem">PROYECTO INDEPENDIENTE</span>
            <span>No afiliado a la ESPE. Desarrollado por estudiantes para la comunidad.</span>
          </div>
        </div>
      </section>

      <!-- SECCIÓN MODO: 4 REGLAS ESPECÍFICAS POR UNIVERSIDAD -->
      <section id="modo" class="hub-campus-features">
        <!-- Modo ESPE -->
        <div data-for="espe" class="campus-feature-block">
          <div class="campus-sec-header">
            <span class="sticker-pill">⚡ EXCLUSIVO PARA LA VIDA ESTUDIANTIL ESPE</span>
            <h2 class="hub-section-title">Lo que Pilas! resuelve en la ESPE</h2>
            <p class="campus-sec-sub">Sedes Sangolquí, Latacunga, Santo Domingo y San Roque · Diseñado para la rutina universitaria real.</p>
          </div>
          <div class="rules-neo-grid">
            <div class="rule-card">
              <span class="rule-badge-num font-mono">01</span>
              <div class="rule-body">
                <h3>Traductor de aulas Banner</h3>
                <p>Convierte códigos crípticos como “B-302” o “H-Auditorio” en bloque, piso y referencia visual para no perderte.</p>
              </div>
            </div>
            <div class="rule-card">
              <span class="rule-badge-num font-mono">02</span>
              <div class="rule-body">
                <h3>23 mallas curriculares</h3>
                <p>Mallas oficiales actualizadas con materias aprobadas, créditos acumulados y prerrequisitos en cadena interactiva.</p>
              </div>
            </div>
            <div class="rule-card">
              <span class="rule-badge-num font-mono">03</span>
              <div class="rule-body">
                <h3>Regla de 42/60 puntos</h3>
                <p>Calcula automáticamente cuánto puntaje necesitas en el Parcial 3 sobre 20 sin sorpresas de supletorio.</p>
              </div>
            </div>
            <div class="rule-card">
              <span class="rule-badge-num font-mono">04</span>
              <div class="rule-body">
                <h3>Pase de garita offline</h3>
                <p>Muestra tu carnet estudiantil con código de barras de tu ID Banner listo para garita militar sin internet.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Modo Multi-Universidad -->
        <div data-for="multi" class="campus-feature-block">
          <div class="campus-sec-header">
            <span class="sticker-pill coral">⭐ INTEGRACIÓN UNIVERSITARIA NACIONAL</span>
            <h2 class="hub-section-title">Lo que Pilas! resuelve en tu universidad</h2>
            <p class="campus-sec-sub">UCE, EPN, PUCE, ESPOL, UNACH, UTA, UTPL y cualquier campus con Moodle en Ecuador.</p>
          </div>
          <div class="rules-neo-grid">
            <div class="rule-card coral">
              <span class="rule-badge-num font-mono">01</span>
              <div class="rule-body">
                <h3>Conexión por código QR</h3>
                <p>Abre Moodle en tu computadora, escanea el QR de la app móvil y sincroniza tu semestre sin ingresar contraseñas.</p>
              </div>
            </div>
            <div class="rule-card coral">
              <span class="rule-badge-num font-mono">02</span>
              <div class="rule-body">
                <h3>Calificador multi-escala</h3>
                <p>Configura materias sobre 10, 20 o 100 puntos según el reglamento de tu facultad con redondeo académico exacto.</p>
              </div>
            </div>
            <div class="rule-card coral">
              <span class="rule-badge-num font-mono">03</span>
              <div class="rule-body">
                <h3>Detector de tareas y entregas</h3>
                <p>Ordena tus deberes pendientes por fecha de entrega y te avisa antes de que la plataforma se cierre a las 23:59.</p>
              </div>
            </div>
            <div class="rule-card coral">
              <span class="rule-badge-num font-mono">04</span>
              <div class="rule-body">
                <h3>Carátulas con tu escudo oficial</h3>
                <p>Genera carátulas listas en formato PDF con la tipografía, logotipo y datos oficiales de tu universidad.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN SEGURIDAD Y PRIVACIDAD CON PILAS POLICÍA -->
      <section class="hub-security-showcase card">
        <div class="security-layout">
          <div class="security-mascot-col">
            <div class="security-avatar-frame">
              <img src={M.guard} alt="Pilas guardia de seguridad" class="security-mascot-img" width="104" height="104" />
              <span class="security-badge-tag font-mono">SEGURIDAD PILAS!</span>
            </div>
          </div>
          <div class="security-content-col">
            <div class="security-header">
              <span class="sticker-pill cyan">🛡️ PRIVACIDAD RADICAL</span>
              <h2 class="security-title">Arquitectura Zero-Backend: tus claves son solo tuyas</h2>
              <p class="security-lead">La app móvil se comunica directamente con Banner y Moodle sin servidores intermediarios de Pilas!. Lo que consultas en tu teléfono, se queda en tu teléfono.</p>
            </div>
            <div class="security-guarantees-grid">
              <div class="guarantee-item">
                <span class="guarantee-icon">🔐</span>
                <div class="guarantee-info">
                  <b>Credenciales cifradas con AES-256</b>
                  <p>Tus contraseñas y tokens se guardan exclusivamente en Android Keystore por hardware en tu propio celular.</p>
                </div>
              </div>
              <div class="guarantee-item">
                <span class="guarantee-icon">🚫</span>
                <div class="guarantee-info">
                  <b>Cero servidores intermedios</b>
                  <p>La app se comunica directamente de tu teléfono a tu Moodle o Banner. Jamás pasa por computadoras nuestras.</p>
                </div>
              </div>
              <div class="guarantee-item">

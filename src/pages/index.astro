---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import '@fontsource/special-elite';

import {
  RELEASE,
  PRIMARY_ARCH,
  PRIMARY_APK_SIZE,
  ARCHITECTURES_LIST,
  DOWNLOAD_STATS,
  PLAY_STORE_BETA,
} from '../lib/release';
import { SITE } from '../config/site';
import PresentationIntro from '../components/PresentationIntro.astro';
import HubHeader from '../components/HubHeader.astro';
import HubHero from '../components/HubHero.astro';
import CampusRules from '../components/CampusRules.astro';
import ZeroBackendVault from '../components/ZeroBackendVault.astro';
import DownloadCenter from '../components/DownloadCenter.astro';
import LinkHub from '../components/LinkHub.astro';
import GradeCalculatorDemo from '../components/GradeCalculatorDemo.astro';
import PdfCompressorDemo from '../components/PdfCompressorDemo.astro';
import SocialProofSection from '../components/SocialProofSection.astro';
import HubFooter from '../components/HubFooter.astro';

// Datos centrales del producto (única fuente de verdad)
const V = {
  version: RELEASE.version,
  build: RELEASE.build,
  apkVersion: RELEASE.apkVersion,
  size: PRIMARY_APK_SIZE,
  apk: PRIMARY_ARCH.url,
  note: RELEASE.versionDiscrepancyNote,
  downloads: DOWNLOAD_STATS,
};

// Rutas de mascotas oficiales
const M = {
  neutral: '/logos/mascota_neutro.svg',
  error: '/logos/mascota_negacion.svg',
  success: '/logos/mascota_aprobacion.svg',
  scared: '/logos/mascota_asustado.svg',
  sleeping: '/logos/mascota_dormido.svg',
  guard: '/logos/mascota_policia.svg',
};

// Enlaces oficiales
const PLAY = 'https://forms.gle/svzBYKL2ZhWrS7M78';
const IG = 'https://www.instagram.com/pilas_ec.app/';
const WA = 'https://whatsapp.com/channel/0029VbDorHS4SpkCdv49bM3g';
---
<!doctype html>
<html lang="es-EC" data-mode="espe" class="intro-on retro-on">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pilas! La app estudiantil para la ESPE y otras universidades del Ecuador</title>
<meta name="description" content={SITE.description}>
<meta name="theme-color" content="#101319">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<script is:inline>
try {
  var p = new URLSearchParams(location.search);
  var modeParam = p.get('mode');
  var m = (modeParam === 'espe' || modeParam === 'multi') ? modeParam : localStorage.pilasMode;
  if (m === 'multi' || m === 'espe') document.documentElement.dataset.mode = m;
  if (modeParam) localStorage.pilasMode = m;

  var hasSeenIntro = false;
  try {
    hasSeenIntro = localStorage.getItem('pilasIntroSeen') === '1';
  } catch (e) {}

  var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  var isSlowConn = conn && (conn.saveData || conn.effectiveType === '2g' || conn.effectiveType === '3g' || conn.effectiveType === 'slow-2g');
  var prefersReduced = false;
  try {
    prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  } catch (e) {}

  if (hasSeenIntro || p.get('skip') === '1' || prefersReduced || isSlowConn) {
    document.documentElement.classList.remove('intro-on');
  }
  if (localStorage.pilasRetro === '0') {
    document.documentElement.classList.remove('retro-on');
  }
} catch (e) {}
</script>
<noscript><style>#intro{display:none!important}.intro-on body{overflow:auto!important}</style></noscript>
</head>
<body>

<!-- Símbolos SVG compartidos -->
<svg width="0" height="0" style="position:absolute;display:none" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12l4 4 10-10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3l10 18H2z" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12 10v5M12 18v.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></symbol>
  <symbol id="i-off" viewBox="0 0 24 24"><path d="M3 3l18 18M5 12a10 10 0 014-2M2 8.8a15 15 0 014-2.8M8.5 16a5 5 0 014-1.5M12 20v.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 5 5-5M4 21h16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M12 11v5M12 8v.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
  <symbol id="i-play" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<!-- 1. Exposición Vintage en Proyector -->
<PresentationIntro V={V} M={M} />

<!-- 2. Hub Estudiantil Neo-Brutalista -->
<div id="site">
  <HubHeader />

  <main class="hub-main">
    <div class="wrap hub-wrap">
      <HubHero V={V} M={M} />
      <CampusRules />
      <ZeroBackendVault M={M} />
      <DownloadCenter
        V={V}
        M={M}
        PLAY={PLAY}
        PLAY_STORE_BETA={PLAY_STORE_BETA}
        PRIMARY_ARCH={PRIMARY_ARCH}
        ARCHITECTURES_LIST={ARCHITECTURES_LIST}
      />
      <LinkHub IG={IG} WA={WA} />
      
      <section class="hub-demos-grid">
        <GradeCalculatorDemo M={M} />
        <PdfCompressorDemo M={M} />
      </section>

      <SocialProofSection />
    </div>
  </main>

  <HubFooter IG={IG} WA={WA} />
</div>

<style is:global>
  @import '../styles/hub.css';
</style>

<script>
  import { initCampusMode } from '../scripts/campus-mode';
  initCampusMode();
</script>
</body>
</html>

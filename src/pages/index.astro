/* ---------- modo conmutador ---------- */
function paint(m: string) {
  html.dataset.mode = m;
  $$('[data-mode-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === m)));
  try { localStorage.pilasMode = m; } catch {}
}
function setMode(m: string, x?: number, y?: number) {
  if (html.dataset.mode === m) return;
  const d = document as any;
  if (!d.startViewTransition || reduce || x === undefined || y === undefined) return paint(m);
  const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
  d.startViewTransition(() => paint(m)).ready.then(() =>
    html.animate(
      { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
      { duration: 750, easing: 'cubic-bezier(.22,1,.36,1)', pseudoElement: '::view-transition-new(root)' },
    ),
  );
}
paint(html.dataset.mode || 'espe');
$$('[data-mode-btn]').forEach((b) =>
  b.addEventListener('click', () => {
    const r = b.getBoundingClientRect();
    setMode(b.dataset.modeBtn, r.left + r.width / 2, r.top + r.height / 2);
  }),
);


---
import LinkStateCard from '../components/links/LinkStateCard.astro';
import PlatformActions from '../components/links/PlatformActions.astro';
import UniversalLinkLayout from '../layouts/UniversalLinkLayout.astro';
import {
  decodePilasParam,
  safeJsonScriptContent,
  type JuntaPayload,
} from '../lib/pilasCodec';
import { buildPublicOgMeta } from '../lib/pilasLinks/og-meta';
import { getSampleEncodedParam } from '../lib/pilasLinks/sample-payloads';
import { formatDurationCompact } from '../lib/pilasLinks/schedule-compare';
import {
  applyUniversalLinkResponseHeaders,
  extractRawDFromUrl,
} from '../lib/pilasLinks/ssr-helpers';

export const prerender = false;

const rawD = extractRawDFromUrl(Astro.url);
const siteOrigin = Astro.url.origin || 'https://pilas-ec.vercel.app';
const pageUrl = new URL('/junta', siteOrigin);
if (rawD) pageUrl.searchParams.set('d', rawD);

const decoded = rawD ? await decodePilasParam(rawD, 'junta') : null;
const isOk = Boolean(decoded && decoded.ok);
const demoParam = !isOk ? await getSampleEncodedParam('junta') : null;

applyUniversalLinkResponseHeaders(Astro.response.headers, !rawD || isOk);
const meta = buildPublicOgMeta('junta', decoded, siteOrigin, rawD);

const payload: JuntaPayload | null = decoded && decoded.ok ? decoded.payload : null;

function formatEcuadorDate(iso: string): string {
  const ms = Date.parse(iso);
  if (Number.isNaN(ms)) return iso;
  return new Intl.DateTimeFormat('es-EC', {
    timeZone: 'America/Guayaquil',
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(new Date(ms));
}

function formatEcuadorHHMM(iso: string): string {
  const ms = Date.parse(iso);
  if (Number.isNaN(ms)) return '--:--';
  return new Intl.DateTimeFormat('es-EC', {
    timeZone: 'America/Guayaquil',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).format(new Date(ms));
}

const dateLabel = payload ? formatEcuadorDate(payload.startAt) : '';
const startLabel = payload ? formatEcuadorHHMM(payload.startAt) : '';
const endLabel = payload ? formatEcuadorHHMM(payload.endAt) : '';
---

<UniversalLinkLayout meta={meta} pageUrl={pageUrl.toString()}>
  {!rawD ? (
    <div class="ul-grid-two">
      <LinkStateCard
        kind="junta"
        mode="empty"
        demoParam={demoParam}
        titleEmpty="Invitación a hueco libre / reunión de estudio Pilas!"
        descriptionEmpty="Abre una invitación /junta?d=... para ver modalidad Virtual o Presencial, lugar o enlace Meet y añadir el encuentro directo a Google Calendar o Apple Calendar (.ics)."
      />
      <PlatformActions
        deepPath="junta"
        routePath="/junta"
        rawD={rawD}
        openAppLabel="Abrir en Pilas!"
      />
    </div>
  ) : !payload ? (
    <LinkStateCard
      kind="junta"
      mode="error"
      errorCode={decoded && !decoded.ok ? decoded.code : 'INVALID_PAYLOAD'}
      errorMessage={decoded && !decoded.ok ? decoded.message : undefined}
      detectedKind={decoded && !decoded.ok ? decoded.detectedKind : undefined}
      rawD={rawD}
      demoParam={demoParam}
      titleEmpty=""
      descriptionEmpty=""
    />
  ) : (
    <>
      <section class="ul-card is-live" aria-labelledby="junta-heading">
        <div class="ul-route-hero">
          <div class="ul-route-hero-copy">
            <div class="ul-badge-row">
              <span class="ul-badge is-success">
                {payload.isVirtual ? 'Virtual' : 'Presencial'}
              </span>
              {payload.campus && (
                <span class="ul-badge is-info">{payload.campus}</span>
              )}
              <span class="ul-badge ul-tabular">
                {formatDurationCompact(payload.durationMinutes)}
              </span>
            </div>

            <h1 id="junta-heading">{payload.title}</h1>

            <p class="ul-hint">
              {payload.organizer
                ? `Organiza: ${payload.organizer}`
                : 'Encuentro coordinado en hueco libre común desde Pilas!.'}
            </p>
          </div>

          <div class="ul-mascot-box">
            <img
              src="/logos/mascota_aprobacion.svg"
              alt="Pilo celebrando la invitación a junta de estudio"
              width="96"
              height="96"
              class="ul-mascot-img"
            />
          </div>
        </div>
      </section>

      <div class="ul-grid-two">
        <section class="ul-card ul-stack" aria-labelledby="junta-details-heading">
          <h2 id="junta-details-heading">Detalles del encuentro</h2>

          <div class="ul-countdown-box">
            <div class="ul-countdown-value">
              {startLabel} – {endLabel}
            </div>
            <p class="ul-hint" style="text-transform: capitalize;">
              {dateLabel} · Duración: {formatDurationCompact(payload.durationMinutes)} (Ecuador ECT)
            </p>
          </div>

          <dl style="display: grid; gap: 12px; margin: 0;">
            {payload.campus && (
              <div class="ul-item-row">
                <dt class="ul-label">Campus</dt>
                <dd style="margin: 0; font-weight: 600; text-align: right;">
                  {payload.campus}
                </dd>
              </div>
            )}

            {payload.location && (
              <div class="ul-item-row">
                <dt class="ul-label">Ubicación</dt>
                <dd style="margin: 0; font-weight: 600; text-align: right;">
                  {payload.location}
                </dd>
              </div>
            )}

            {payload.meetingUrl && (
              <div class="ul-item-row">
                <dt class="ul-label">Sala virtual</dt>
                <dd style="margin: 0;">
                  <a
                    href={payload.meetingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    referrerpolicy="no-referrer"
                    class="ul-btn ul-btn-secondary"
                  >
                    Abrir enlace Meet / Zoom
                  </a>
                </dd>
              </div>
            )}
          </dl>

          {payload.participants.length > 0 && (
            <div>
              <h3 style="margin-bottom: 8px;">Participantes ({payload.participants.length})</h3>
              <ul
                class="ul-badge-row"
                role="list"
                style="list-style: none; padding: 0; margin: 0;"
              >
                {payload.participants.map((person) => (
                  <li class="ul-badge is-info">{person}</li>
                ))}
              </ul>
            </div>
          )}

          {payload.notes && (
            <div class="ul-banner is-info">
              <p class="ul-hint" style="white-space: pre-line; color: var(--color-text-body);">
                {payload.notes}
              </p>
            </div>
          )}

          <div class="ul-btn-row">
            <button
              type="button"
              id="btn-export-junta-ics-inline"
              class="ul-btn ul-btn-primary"
            >
              <svg class="ul-ico" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              <span>Agregar a Google Calendar / Apple Calendar (.ics)</span>
            </button>
          </div>

          <p id="junta-ics-status" class="ul-hint" role="status" aria-live="polite"></p>
        </section>

        <PlatformActions
          deepPath="junta"
          routePath="/junta"
          rawD={rawD}
          openAppLabel="Abrir en Pilas!"
          openAppVariant="secondary"
          icsButtonId="btn-export-junta-ics"
          icsButtonLabel="Agregar a Google Calendar / Apple Calendar (.ics)"
          icsVariant="primary"
          actionLead="Descarga el evento para Google o Apple Calendar al instante, o ábrelo directo dentro de Pilas!."
          highlightQr={false}
        />
      </div>

      <script
        type="application/json"
        id="pilas-junta-data"
        set:html={safeJsonScriptContent(payload)}
      />
      <script src="../scripts/junta-page.ts"></script>
    </>
  )}
</UniversalLinkLayout>
